---
interface Layer {
  question: string;
  title: string;
  description: string;
  symbol?: string;
}

interface Props {
  layers: Layer[];
}

const { layers } = Astro.props;
---

{layers.length > 0 && (
  <section class="layer-reveal" data-layer-reveal>
    <div class="layer-reveal__rail" role="list" aria-label="Layers">
      {layers.map((_, index) => (
        <span role="listitem" class:list={{ 'is-active': index === 0 }} data-rail-dot></span>
      ))}
    </div>

    <div class="layer-reveal__stage">
      <div class="layer-reveal__symbol" aria-hidden="true">
        <span data-symbol>{layers[0]?.symbol ?? ''}</span>
      </div>

      <div class="layer-reveal__card">
        <span class="layer-reveal__no" data-no>01 / {String(layers.length).padStart(2, '0')}</span>
        <p class="layer-reveal__question" data-question>{layers[0]?.question}</p>
        <h3 class="layer-reveal__title" data-title>{layers[0]?.title}</h3>
        <p class="layer-reveal__desc" data-desc>{layers[0]?.description}</p>
      </div>

      <button type="button" class="layer-reveal__next" data-layer-next>
        <span data-next-label>Next layer</span>
        <b aria-hidden="true">→</b>
      </button>
    </div>

    <script type="application/json" data-layer-data set:html={JSON.stringify(layers)} />
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-layer-reveal]').forEach((root) => {
    const dataNode = root.querySelector('[data-layer-data]');
    if (!dataNode?.textContent) return;

    const layers = JSON.parse(dataNode.textContent) as Array<{
      question: string;
      title: string;
      description: string;
      symbol?: string;
    }>;

    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-rail-dot]'));
    const symbol = root.querySelector('[data-symbol]');
    const no = root.querySelector('[data-no]');
    const question = root.querySelector('[data-question]');
    const title = root.querySelector('[data-title]');
    const desc = root.querySelector('[data-desc]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-layer-next]');
    const nextLabel = root.querySelector('[data-next-label]');

    let index = 0;

    const render = () => {
      const layer = layers[index];
      if (!layer) return;

      if (symbol) symbol.textContent = layer.symbol ?? '';
      if (no) no.textContent = `${String(index + 1).padStart(2, '0')} / ${String(layers.length).padStart(2, '0')}`;
      if (question) question.textContent = layer.question;
      if (title) title.textContent = layer.title;
      if (desc) desc.textContent = layer.description;

      dots.forEach((dot, i) => dot.classList.toggle('is-active', i <= index));

      const isLast = index === layers.length - 1;
      if (nextLabel) nextLabel.textContent = isLast ? 'Start over' : 'Next layer';
    };

    nextButton?.addEventListener('click', () => {
      index = index === layers.length - 1 ? 0 : index + 1;
      render();
    });

    render();
  });
</script>

<style>
  .layer-reveal {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
  }

  .layer-reveal__rail {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 2rem;
  }

  .layer-reveal__rail span {
    width: 22px;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    transition: background 0.25s ease;
  }

  .layer-reveal__rail span.is-active {
    background: var(--cobalt);
  }

  .layer-reveal__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .layer-reveal__symbol {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, var(--cobalt-soft), var(--cobalt));
    color: #fff;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .layer-reveal__no {
    display: block;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .layer-reveal__question {
    margin: 0 0 0.35rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--saffron-deep);
  }

  .layer-reveal__title {
    margin: 0 0 0.5rem;
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
  }

  .layer-reveal__desc {
    margin: 0;
    max-width: 28rem;
    font-family: var(--sans);
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .layer-reveal__next {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: none;
    background: var(--ink);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .layer-reveal__next:hover {
    transform: translateY(-1px);
  }
</style>
