---
interface Source {
  label: string;
  url: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="sources">
    <p class="sources__label">Sources</p>
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            {source.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .sources {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 4rem;
  }

  .sources__label {
    margin: 0 0 0.6rem;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sources ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sources a {
    font-family: var(--sans);
    font-size: 0.92rem;
    color: var(--cobalt);
    text-decoration: none;
  }

  .sources a:hover {
    text-decoration: underline;
  }
</style>
