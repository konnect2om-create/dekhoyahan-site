<style>
  /* =========================================================
     THE FEATURE'S OWN MEASURE
     The picture is the hook now, so it takes the whole hero column
     instead of the 600px measure it shared with a headline — at 1440
     that is 700px against the 600 it had, half again the area. Nothing
     about the hero slot itself changes.
     ========================================================= */
  .dy-hero__ais {
    /* Scaled down ~18% from the original 720px measure: the composition
       was winning too much of the column against the copy it accompanies.
       Every percentage below (sky, quote inset) is defined off this
       variable, so the whole picture and its alignment shrink together. */
    --ais-w: min(590px, 100%);
    /* The asset's empty sky above the first painted pixel, as a share of
       width: 6.05% of a 3:2 canvas's height is 4.03% of its width. */
    --ais-sky: calc(var(--ais-w) * 0.0403);
    /* Gap from the artwork's visible bottom edge to the invitation. The
       artwork runs to the very bottom of its box, so this is the whole
       gap. Close enough that the line reads as belonging to the picture
       rather than standing on its own beneath it — the two are one
       object, and only one of them is meant to be looked at first. */
    --ais-gap-bottom: 22px;
    /* Where the painted figures start across the Scene 1 canvas, measured
       off its alpha channel: the artwork's own content begins 17.06% in,
       and everything left of that is empty. The quote lines up with the
       drawing, not with the box around it. */
    --ais-quote-inset: calc(var(--ais-w) * 0.1706);
    display: flex;
    flex-direction: column;
    /* Deeper than before. The column no longer opens with a sentence the
       eye can start on, so the picture is what arrives — and a picture
       that begins level with the headline wins the first look outright.
       This drops it to about the headline's second line, which is what
       puts the reading order back: headline, then picture, then the
       line under it. */
    padding-top: clamp(26px, calc(21vh - 108px), 92px);
  }

  /* The stage is the asset's own 3:2 frame — the painted content reaches
     the bottom edge, so unlike the Zero Trust stage there is nothing to
     trim off the box. */
  .dy-hero__ais-stage {
    position: relative;
    width: var(--ais-w);
    margin-left: auto;
    aspect-ratio: 3 / 2;
  }

  /* Two pictures, one position. Both are the same 1536x1024 canvas with the
     same painted extents, so laying them over each other and cross-fading
     puts the second exactly where the first was — no drift, no resize, no
     reflow. The technique, the 900ms and the easing are lifted from the
     "looks real, is it?" story's stage, which does the same thing. */
  .dy-hero__ais-art {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 900ms cubic-bezier(0.2, 0.72, 0.28, 1);
  }

  .dy-hero__ais-art--scene {
    opacity: 0;
  }

  [data-entered='1'] .dy-hero__ais-art--stack {
    opacity: 0;
  }

  [data-entered='1'] .dy-hero__ais-art--scene {
    opacity: 1;
  }

  /* Quieted, not removed — the picture stays present as the room the
     realisation is happening in, it just stops being the thing being
     read. Reuses .dy-hero__ais-art's own 900ms transition, so it settles
     over the same duration the cross-fade into it took. Source order is
     what lets this win over the rule above once both attributes are set,
     since data-realized is never present without data-entered. */
  [data-realized='1'] .dy-hero__ais-art--scene {
    opacity: 0.32;
  }

  /* Only once the questions are asking to coexist with the two people,
     not before: "Got it" still quiets the picture the way it always has
     (0.32, above), and this brings it most of the way back up so the
     unspoken decisions read as thoughts about a scene that's still
     clearly there, not over an image that's nearly gone. Same
     specificity as the rule above; source order is what lets this one
     win once both attributes are set, since data-unsaid is never present
     without data-realized. */
  [data-unsaid='1'] .dy-hero__ais-art--scene {
    opacity: 0.86;
  }

  /* "See where this goes" replaces the whole scene in place rather than
     adding beneath it: the picture fades out completely, the same
     700ms/900ms register everything else in this stage already fades
     on, so the new copy that follows isn't sharing the frame with a
     receding image. Same specificity as the rule above; source order is
     what lets this one win once both attributes are set, since
     data-bridge is never present without data-unsaid. */
  [data-bridge='1'] .dy-hero__ais-art--scene {
    opacity: 0;
  }

  /* =========================================================
     THE INVITATION
     ========================================================= */

  /* Carries the artwork's measure, so both the hook and the invitation
     start on the picture's own left axis. */
  /* One cell, two states. The invitation and the line that replaces it are
     stacked in the same grid area rather than following one another, so the
     picture above never moves while the words underneath change. The cell
     takes the height of the taller of the two, which is why nothing shifts
     at any point in the transition. */
  /* pointer-events:none on the wrapper itself, not just its faded-out
     children: this grid's three cells overlap in the same area (see the
     comment below), and once a cell's own content has faded to
     invisible it stops being painted — but the tail DIV that contains it
     never does, so without this it would still sit in front of anything
     positioned behind it (the whole .dy-hero__ais-close composition
     below the stage overlaps this exact area) and silently swallow
     clicks meant for what's actually showing there. Each real control
     re-enables its own pointer-events below, while it's the one
     actually visible. */
  .dy-hero__ais-tail {
    display: grid;
    justify-items: start;
    width: var(--ais-w);
    margin: calc(var(--ais-gap-bottom)) 0 0 auto;
    pointer-events: none;
  }

  .dy-hero__ais-tail > * {
    grid-area: 1 / 1;
  }

  .dy-hero__ais-invite {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* visibility is held back until the fade has finished, otherwise it
       snaps to hidden on the first frame and the opacity transition is
       never seen. */
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  /* The invitation is spent the moment it is used. visibility rather than
     opacity alone, so the button leaves the tab order and the accessibility
     tree instead of lingering as an invisible control. */
  [data-entered='1'] .dy-hero__ais-invite {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* The wrapper's own opacity is never animated — the quote and the "Got
     it" button each fade on their own timing, exactly as before. It exists
     only to put them in a normal top-to-bottom flow instead of the
     overlapping grid-area every other child of the tail uses, since these
     two are the one pair on screen together.

     pointer-events does need setting here, though: with no opacity of its
     own the wrapper is otherwise a fully hit-testable box the instant it
     paints, invisible or not, and it sits over the invitation underneath
     it in the same grid cell — it would swallow clicks meant for "See
     why" before Scene 1 even starts. */
  .dy-hero__ais-request {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    pointer-events: none;
  }

  [data-entered='1'] .dy-hero__ais-request {
    pointer-events: auto;
  }

  /* Turned back off once "Got it" has done its job: this div's own
     pointer-events:auto above was only ever meant to let that one button
     be clicked during the request beat, but [data-entered='1'] never
     stops being true afterward, so without this it kept intercepting
     clicks meant for anything positioned behind it in every later beat —
     which is exactly what made "See where this goes" unclickable once
     the composition below the tail grew tall enough to reach behind
     this grid cell. Source order, not specificity, is what lets this win
     over the rule above once both attributes are set (data-realized is
     never present without data-entered). */
  [data-realized='1'] .dy-hero__ais-request {
    pointer-events: none;
  }

  /* Scene 1's line, in Scene 1's own treatment: the site's serif at 500,
     the same line-height and letter-spacing. A little smaller than on the
     story page, because this column is 700px rather than the full measure.
     It keeps the tail's alignment — on the picture's left axis at desktop,
     centred when the hero stacks — so nothing about the composition moves. */
  .dy-hero__ais-quote {
    /* Pulled up out of the tail's own gap and held to a short measure, so
       it stops behaving like a caption under a picture.

       A caption is the full width of the frame, one line, set off from it.
       This is neither: it breaks to two short lines and sits close under
       the figures, at the same left edge the son actually stands on rather
       than the edge of the empty canvas — the transparent margin down the
       left of the asset is why a line starting at the box edge looked
       stranded beneath nothing. Read together with the picture, it is what
       is being said in the room. */
    margin: calc(var(--ais-gap-bottom) * -0.55) 0 0 var(--ais-quote-inset);
    max-width: 19ch;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    /* Reduced ~22% from the previous clamp(24px, 3.2vw, 40px): sized to
       read as belonging to the scene rather than competing with it. */
    font-size: clamp(19px, 2.5vw, 31px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    text-wrap: balance;
    opacity: 0;
    /* visibility, not opacity alone, so before the transition this line is
       neither focusable nor announced. It flips the instant the flag is set
       — only the fade is delayed — because focus has to be able to land on
       it straight away. */
    visibility: hidden;
    /* Arrives while the picture is still resolving, not after it: the
       sentence and the situation are meant to land as one thing. Fading
       out (once realised) is quick and undelayed, matching the invitation
       it once replaced. */
    transition: opacity 620ms cubic-bezier(0.2, 0.78, 0.24, 1) 420ms,
      visibility 0s linear 420ms;
  }

  .dy-hero__ais-quote:focus {
    outline: none;
  }

  [data-entered='1'] .dy-hero__ais-quote {
    opacity: 1;
    visibility: visible;
  }

  /* Spent once the realisation lands, the same way the invitation was
     spent once the request landed. */
  [data-realized='1'] .dy-hero__ais-quote {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  /* =========================================================
     "GOT IT" — the natural response, in the story's own page-turn
     idiom (not the explore grammar "See why" uses): serif text, ink,
     closed by the same saffron-circle arrow the Explore stories use to
     turn a scene over. Shared with the closing, still-inert turn button
     below via .dy-hero__ais-turn.
     ========================================================= */
  .dy-hero__ais-turn {
    display: inline-block;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    cursor: pointer;
    white-space: nowrap;
    /* "Got it" and "What's missing?" live inside .dy-hero__ais-tail,
       which is pointer-events:none (see that rule) so its own faded-out,
       overlapping grid cells never swallow clicks meant for whatever is
       positioned behind them; this is the real control and needs its
       own pointer-events back. A no-op for "See where this goes", which
       isn't inside that wrapper to begin with. */
    pointer-events: auto;
  }

  .dy-hero__ais-turn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    vertical-align: middle;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .dy-hero__ais-turn:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dy-hero__ais-turn:hover span {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .dy-hero__ais-turn:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  /* "Got it" sits directly under the quote, on the same left axis, and
     arrives once the sentence above it has had a moment to settle — said
     after the request, not with it. */
  .dy-hero__ais-turn--gotit {
    margin: 14px 0 0 var(--ais-quote-inset);
    opacity: 0;
    visibility: hidden;
    transition: opacity 480ms cubic-bezier(0.2, 0.78, 0.24, 1) 1180ms,
      visibility 0s linear 1180ms;
  }

  [data-entered='1'] .dy-hero__ais-turn--gotit {
    opacity: 1;
    visibility: visible;
  }

  [data-realized='1'] .dy-hero__ais-turn--gotit {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  /* =========================================================
     THE REALISATION
     Two lines and the question they leave open, staggered exactly like
     the Explore story's own beats: a kicker, the turn that follows it a
     beat later, and the way onward after both have been read. No base
     opacity on these three — display is governed by the wrapper below,
     and animation-fill-mode: both already holds each one at the
     keyframe's opacity 0 through its own delay, which is also what lets
     reduced motion remove the animation and land on full opacity with
     nothing further to override.
     ========================================================= */
  @keyframes dy-ais-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .dy-hero__ais-realize {
    max-width: 26ch;
    margin-left: var(--ais-quote-inset);
    opacity: 0;
    visibility: hidden;
  }

  [data-realized='1'] .dy-hero__ais-realize {
    opacity: 1;
    visibility: visible;
  }

  .dy-hero__ais-kicker {
    margin: 0;
    color: var(--cobalt);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .dy-hero__ais-kicker:focus {
    outline: none;
  }

  [data-realized='1'] .dy-hero__ais-kicker {
    animation: dy-ais-reveal 460ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 120ms;
  }

  /* Fades once its job is done — the way the request and the invitation
     before it did. The transition is declared inside this rule itself
     rather than on the base class, because it only needs to run on this
     one change, whenever [data-unsaid='1'] fires. */
  [data-unsaid='1'] .dy-hero__ais-kicker {
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  /* The bridge line. Deliberately NOT the kicker's treatment: ink-soft
     rather than cobalt, regular weight rather than bold, so it reads as
     quieter than "You know exactly what to do." rather than a second
     accent competing with it — this is the thought that undercuts the
     first one, not another headline. */
  .dy-hero__ais-turnline {
    margin: 8px 0 0;
    color: var(--ink-soft);
    font-size: clamp(15px, 1.6vw, 17px);
    font-weight: 400;
    line-height: 1.45;
  }

  [data-realized='1'] .dy-hero__ais-turnline {
    animation: dy-ais-reveal 460ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 640ms;
  }

  [data-unsaid='1'] .dy-hero__ais-turnline {
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  /* Margin is unconditional even though the button only reveals under
     [data-realized='1'] below: a grid track sizes to each item's current
     computed box, not to some union of the states it might later be in.
     Gating this spacing on the same attribute the animation uses left the
     tail undersized until the moment "Got it" was clicked, and it grew by
     exactly this margin at that instant — a small but real layout shift.
     Setting it here, unconditionally, means the cell is already sized
     correctly from the very first render, invisible or not. */
  .dy-hero__ais-realize .dy-hero__ais-turn {
    margin-top: 18px;
  }

  /* The question follows the bridge line by the same short pause the
     bridge itself follows the kicker with — three beats: the obvious
     thing, the quiet undercut, then the question it raises. */
  [data-realized='1'] .dy-hero__ais-realize .dy-hero__ais-turn {
    animation: dy-ais-reveal 460ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 1280ms;
  }

  /* Spent the moment it is used, like every other control in this
     Feature — but unlike them, what it revealed does not go with it.
     The transition is declared here rather than relying on the reveal
     keyframe's own timing, because this fade needs to run independently,
     whenever [data-unsaid='1'] fires, not on a fixed schedule from
     [data-realized='1']. */
  .dy-hero__ais-turn--next {
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  [data-unsaid='1'] .dy-hero__ais-turn--next {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* =========================================================
     THE UNSPOKEN DECISIONS
     This beat transforms the picture's own box rather than the column
     beneath it — nothing here can grow the page. Five short lines sit
     directly over the artwork's own empty margins (the same alpha-
     channel measurement that placed the quote earlier: the painted
     figures run from about 17% to 87% across the canvas, so the columns
     either side of them are genuinely empty — not text over faces), and
     the realisation lands at the centre once they've all been read.
     Nothing here recedes once shown.
     ========================================================= */
  /* Absolutely positioned over the stage, so it shares the artwork's own
     box exactly rather than adding to the layout beneath it. Hidden until
     earned, the same way every other beat in this Feature is: without an
     explicit display:none, the questions — which only get their own
     opacity from a keyframe that never runs until [data-unsaid='1']
     exists — would sit at their plain default opacity of 1 from the very
     first render. pointer-events:none because nothing inside is
     interactive; it must never sit between a click and the picture
     beneath it. */
  .dy-hero__ais-unsaid {
    position: absolute;
    inset: 0;
    display: none;
    pointer-events: none;
  }

  [data-unsaid='1'] .dy-hero__ais-unsaid {
    display: block;
  }

  .dy-hero__ais-unsaid:focus {
    outline: none;
  }

  /* Each question its own beat, arriving after the one before it rather
     than as a block. No base opacity here on purpose: animation-fill-mode:
     both already holds each one at the keyframe's opacity 0 through its
     own delay, and it's what lets reduced motion remove the animation
     below and land on full opacity with nothing further to override.
     Plain text, nothing drawn around it — no card, no bubble, no line
     connecting it to anything, which is what would turn this into a
     diagram rather than a thought becoming visible. */
  .dy-hero__ais-ask {
    position: absolute;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(13px, 1.5vw, 15.5px);
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Positioned close against the two people, each one measured (off the
     scene's own alpha channel) to land 35–70px from the nearest visible
     edge of the figure it belongs to, not from the stage's own edge. top
     values are set once per question and translateY(-50%) centres each
     line on that point, the same way a label centres on the thing it is
     next to. white-space:nowrap keeps every question a single natural
     phrase rather than a narrow stack — deliberately no max-width here:
     with nowrap already guaranteeing one line, a max-width narrower than
     the phrase's own natural width doesn't wrap it, it silently overflows
     past the box in whichever direction alignment pushes it, which is
     exactly what made the 35–70px figure distances unreliable to hit. */
  .dy-hero__ais-ask[data-ask='1'] { top: 14%; left: 3%; text-align: left; transform: translateY(-50%); }
  .dy-hero__ais-ask[data-ask='3'] { top: 45%; left: -1%; text-align: left; transform: translateY(-50%); }
  .dy-hero__ais-ask[data-ask='4'] { top: 76%; left: -17%; text-align: left; transform: translateY(-50%); }
  .dy-hero__ais-ask[data-ask='2'] { top: 12%; right: -5.5%; text-align: right; transform: translateY(-50%); }
  .dy-hero__ais-ask[data-ask='5'] { top: 58%; right: -12%; text-align: right; transform: translateY(-50%); }

  [data-unsaid='1'] .dy-hero__ais-ask {
    animation: dy-ais-reveal 460ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
  }

  [data-unsaid='1'] .dy-hero__ais-ask[data-ask='1'] { animation-delay: 150ms; }
  [data-unsaid='1'] .dy-hero__ais-ask[data-ask='2'] { animation-delay: 700ms; }
  [data-unsaid='1'] .dy-hero__ais-ask[data-ask='3'] { animation-delay: 1250ms; }
  [data-unsaid='1'] .dy-hero__ais-ask[data-ask='4'] { animation-delay: 1800ms; }
  [data-unsaid='1'] .dy-hero__ais-ask[data-ask='5'] { animation-delay: 2350ms; }

  /* "How do you pay?" is the one phrase in this set whose natural single-
     line width doesn't fit the 35–55px target distance from the mother's
     figure inside the room actually available at ordinary laptop widths:
     the column right of the stage only opens up past roughly 1550–1600px
     (measured directly — 33–36px of it from 1320px up to ~1500px, only
     widening after that), and 1366/1440/1536 are exactly the widths most
     desktop visitors actually have. Below that room, holding the single-
     line position would either crowd the figure far under 35px or clip
     against the viewport's own edge — both worse than two short natural
     lines. Wrapped only in this band; wide enough screens keep the single
     line, since there both the distance and the safety margin fit. */
  @media (min-width: 1320px) and (max-width: 1599px) {
    .dy-hero__ais-ask[data-ask='5'] {
      right: -2.7%;
      max-width: 8ch;
      white-space: normal;
      text-align: right;
    }
  }

  /* The connector: one thin curved stroke per question, no arrowhead, no
     fill — a suggestion that the thought belongs to the scene beside it,
     not a diagram pointing at a specific part of it. Understated on
     purpose: the text is what matters, this is just a hint underneath it.
     Positioned per question below so each one leans toward the picture
     rather than away from it. */
  .dy-hero__ais-ask-line {
    position: absolute;
    width: 13px;
    height: 8px;
    overflow: visible;
  }

  .dy-hero__ais-ask-line path {
    fill: none;
    stroke: rgba(17, 21, 28, 0.22);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  /* Shorter reach to match the tighter placement above — each still sits
     just off the text's own edge nearest the people, angled the same
     direction the question's own position already leans. */
  [data-ask='1'] .dy-hero__ais-ask-line { right: -14px; bottom: -5px; }
  [data-ask='2'] .dy-hero__ais-ask-line { left: -14px; bottom: -5px; }
  [data-ask='3'] .dy-hero__ais-ask-line { right: -13px; top: 50%; margin-top: -3px; }
  [data-ask='4'] .dy-hero__ais-ask-line { right: -14px; top: -5px; }
  [data-ask='5'] .dy-hero__ais-ask-line { left: -13px; top: 50%; margin-top: -3px; }

  /* THE CLOSE — one local coordinate system shared with the picture and
     the questions around it: this wrapper is positioned against
     .dy-hero__ais-stage itself (top: 100% = the artwork's own visible
     bottom edge, the painted content runs flush to it), not against
     whatever .dy-hero__ais-tail below is doing. That is what keeps the
     gap to the realisation an actual, fixed small distance instead of
     "however tall the tail's reserved states happen to be" — the tail
     reserves its own height for the invite/request/realise states
     regardless of which is showing, and a sibling placed after it used
     to inherit that reserved height as extra, unintended distance from
     the figures. Absolutely positioned, so it doesn't add to the stage's
     own aspect-ratio height, and it renders in front of whatever the
     tail shows beneath it — safe here because by the time this is
     visible ([data-unsaid='1']), the tail's own kicker/turnline/button
     have already faded to nothing.

     padding-top is the 24–32px target itself; the flex gap below is the
     14–18px between the realisation and the CTA — both requested as an
     exact small distance, not a fraction of the picture's height, so
     both are plain clamps against the viewport rather than percentages
     of --ais-w. */
  /* pointer-events:none for the same reason .dy-hero__ais-tail carries
     it: this box's own overlap with the tail below (see the comment
     above) is normally harmless because the tail's static content
     simply paints on top of it — but that ordering turns out to depend
     on .dy-hero__ais-stage staying an active animation target, which
     stops being true the moment [prefers-reduced-motion] turns that
     entrance animation off. Without an active animation forcing stage
     into its own stacking context, this absolutely positioned box wins
     the overlap instead and silently swallows clicks meant for "See
     why" underneath it. Not worth depending on an animation side effect
     either way: this stays click-through unconditionally, and its own
     real control (.dy-hero__ais-turn, further down) re-enables its own
     pointer-events the same way every other control in this Feature
     does. */
  .dy-hero__ais-close {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(20px, 2.4vw, 28px);
    gap: clamp(12px, 1.2vw, 16px);
    pointer-events: none;
  }

  /* The realisation this beat has been walking toward, once all five
     questions have had a moment to be read. Full width of its wrapper so
     text-align:center centres it under the picture as a whole, matching
     "beneath the people/questions" rather than sitting off to one side
     of them. Restrained rather than oversized: weight 500 and a modest
     size, the same register the story's own realisations use elsewhere,
     not a second headline. Explicit opacity/visibility here, not the "no
     base opacity" shortcut the rest of this file uses: that shortcut
     relies on an ancestor staying hidden until the exact moment a child
     should appear, and this element no longer has one dedicated to it —
     it is gated purely by its own rule below. */
  .dy-hero__ais-final {
    width: 100%;
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(18px, 2.2vw, 23px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-align: center;
    opacity: 0;
    visibility: hidden;
  }

  [data-unsaid='1'] .dy-hero__ais-final {
    opacity: 1;
    visibility: visible;
    animation: dy-ais-reveal 620ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3100ms;
  }

  /* THE NEXT TURN — intentionally inert. A real control, styled and
     focusable exactly like every other page-turn in this Feature, but
     with no handler behind it: it is what "See why" and "What's missing?"
     both were for a time, waiting for the beat it leads to. Centred like
     the realisation above it, on the same width and the same axis, so
     the two read as one closing thought rather than two unrelated lines. */
  .dy-hero__ais-final-next {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0;
    opacity: 0;
    visibility: hidden;
  }

  [data-unsaid='1'] .dy-hero__ais-final-next {
    opacity: 1;
    visibility: visible;
    animation: dy-ais-reveal 560ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3550ms;
  }

  /* Spent the moment it is used, the same idiom "What's missing?" and
     "Got it" already established: the control that opens a beat fades
     once that beat has landed, so the composition below it reads as the
     answer rather than sitting under a button still asking to be
     pressed. The transition is declared here, not on the base class, so
     it only runs on this one change. */
  .dy-hero__ais-turn--bridge {
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  [data-bridge='1'] .dy-hero__ais-turn--bridge {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Fades out completely, not to a quieter register: this beat replaces
     the scene rather than annotating it, so nothing from the previous
     beat should linger on screen once it's gone, faded or otherwise. The
     transition lives in these rules rather than the base classes, for
     the same reason every other fade in this file keeps its transition
     local: it only has to run on this one change, and an animation
     still holds these elements' resting opacity via fill-mode — a
     transition is a higher-priority effect than that held animation
     value, which is what actually lets this override it. */
  [data-bridge='1'] .dy-hero__ais-ask {
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
  }

  [data-bridge='1'] .dy-hero__ais-final {
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
  }

  /* THE SWAP — takes over the picture's own box once it and everything
     around it has faded, rather than sitting in the column beneath it:
     inset:0 against .dy-hero__ais-stage (its nearest positioned
     ancestor) is what makes this the exact same area the artwork
     occupied, and flex-centering both axes is what puts the line in the
     middle of that area instead of pinned to one edge of it. display:none
     until earned, the same reason .dy-hero__ais-unsaid uses it: nothing
     else hides this before [data-bridge='1'] exists, so without it the
     line would sit at its own default opacity of 1, fully visible, from
     the very first render. */
  .dy-hero__ais-swap {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 0 6%;
    text-align: center;
  }

  [data-bridge='1'] .dy-hero__ais-swap {
    display: flex;
    animation: dy-ais-reveal 620ms cubic-bezier(0.2, 0.78, 0.24, 1) 420ms both;
  }

  /* Fades out completely once "Show me" is used, the same full-fade
     .dy-hero__ais-ask and .dy-hero__ais-final use for the beat before
     this one: nothing from Scene 4 should linger once Scene 5 takes the
     same box. The transition lives here, not on the base rule, for the
     same reason it does everywhere else in this file — it only needs to
     run on this one change, and it's what lets it override the
     [data-bridge='1'] animation's own held opacity above. */
  [data-showme='1'] .dy-hero__ais-swap {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
  }

  .dy-hero__ais-swap:focus {
    outline: none;
  }

  /* Wraps just the two existing lines, now that .dy-hero__ais-swap holds
     the new button as a third piece too — margin:0 so this <p>'s own
     default browser spacing doesn't add anything beyond the 10px the two
     lines already had between them. */
  .dy-hero__ais-swap-text {
    margin: 0;
  }

  /* The quiet setup — the site's own body copy, small and unremarkable
     on purpose: this is the callback, not the point. Same family, size
     register and weight the rest of this Feature's own quiet asides use
     (.dy-hero__ais-turnline, .dy-hero__ais-bridge-sub before it), so it
     reads as a continuation of the same voice rather than a new one. */
  .dy-hero__ais-swap-setup {
    display: block;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(14px, 1.4vw, 16px);
    font-weight: 400;
    line-height: 1.4;
  }

  /* The payoff — the site's own display register: Georgia, the same
     family and weight (500, "normal/medium", never the sans's own bold)
     the homepage's own hero headline uses for the line it wants read
     first. Clearly larger than the setup above it, so the two read as
     quiet question then the actual point, not two lines of equal
     weight. No colour accent on "AI" — this turn doesn't introduce the
     cobalt "explorable" grammar, it's still the same plain ink the rest
     of this beat has used throughout. */
  .dy-hero__ais-swap-payoff {
    display: block;
    /* Replaces the flex gap the two lines used to share directly on
       .dy-hero__ais-swap, now that it holds the new button as well —
       same 10px, so this pairing's own spacing is exactly what it was
       before. */
    margin-top: 10px;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  /* THE PROMPT — takes over the same box .dy-hero__ais-swap just
     vacated, the same technique: display:none until earned, inset:0
     against the stage, centred both ways. pointer-events:none since
     nothing in here is interactive yet (no next control this beat) —
     costs nothing now and avoids this box ever silently intercepting a
     click meant for whatever eventually sits behind or after it, the
     same lesson .dy-hero__ais-tail and .dy-hero__ais-close were both
     fixed for. */
  .dy-hero__ais-prompt {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 0 6%;
    text-align: center;
    pointer-events: none;
  }

  [data-showme='1'] .dy-hero__ais-prompt {
    display: flex;
  }

  /* Fades out completely once "But that wasn't enough" is used, the
     same full-fade every prior scene in this sequence uses for the beat
     before it. Transition lives here, not the base rule, so it only
     runs on this one change and can override the [data-showme='1']
     display swap's own held state the same way it does everywhere else
     in this file. */
  [data-context='1'] .dy-hero__ais-prompt {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
  }

  .dy-hero__ais-prompt:focus {
    outline: none;
  }

