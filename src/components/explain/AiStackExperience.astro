  [data-finale='1'] .dy-hero__ais-art--stack,
  [data-finale='1'] .dy-hero__ais-decode,
  [data-finale='1'] .dy-hero__ais-whole {
    display: none;
  }

  /* THE FINALE — takes over the same box the artwork just vacated, the
     same technique throughout: display:none until earned, inset:0
     against the stage, centred both ways. No card, no recap, no
     saffron term: this beat names nothing new, it only closes the one
     already spoken. */
  .dy-hero__ais-finale {
    display: none;
    position: absolute;
    inset: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 0;
    padding: 0 6%;
    text-align: center;
    pointer-events: none;
