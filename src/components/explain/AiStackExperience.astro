    if (gotit instanceof HTMLElement) {
      gotit.addEventListener('click', () => {
        // Gated on the beat before it: this can't fire before entry, and
        // can't fire twice.
        if (root.dataset.entered !== '1' || root.dataset.realized === '1') return;
        root.dataset.realized = '1';

        focusInPlace(kicker);
      });
    }

    if (unsaid instanceof HTMLElement) {
      unsaid.addEventListener('click', () => {
        // Gated on the beat before it: this can't fire before "Got it",
        // and can't fire twice.
        if (root.dataset.realized !== '1' || root.dataset.unsaid === '1') return;
        root.dataset.unsaid = '1';

        // Synchronous, not the retried requestAnimationFrame version the
        // two beats above use: this button's own disappearance is what was
        // producing an unwanted scroll here, not the focus target. Once
        // this button is clicked, Chromium's own "the focused control just
        // became unfocusable" recovery reassigns focus on its own — and
        // does so a frame or more later, scrolling the page to whatever it
        // lands on, regardless of any preventScroll this script requests.
        // Claiming focus immediately, in the same tick as the click and
        // the attribute change, is what pre-empts that recovery from ever
        // running; forcing a layout read first is what lets the
        // just-applied display:block actually take effect before focus()
        // is asked to use it.
        if (unsaidPanel instanceof HTMLElement) {
          void unsaidPanel.offsetWidth;
          unsaidPanel.focus({ preventScroll: true });
        }
