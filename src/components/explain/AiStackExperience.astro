    .dy-hero__ais-turnline,
    .dy-hero__ais-ask,
    .dy-hero__ais-final,
    .dy-hero__ais-final-next,
    .dy-hero__ais-swap,
    .dy-hero__ais-prompt-quote,
    .dy-hero__ais-prompt-line,
    .dy-hero__ais-prompt-next,
    .dy-hero__ais-context-fact,
    .dy-hero__ais-context-line,
    .dy-hero__ais-context-next,
    .dy-hero__ais-memory-fact,
    .dy-hero__ais-memory-line,
    .dy-hero__ais-memory-next,
    .dy-hero__ais-lookup-fact,
    .dy-hero__ais-lookup-line,
    .dy-hero__ais-lookup-next,
    .dy-hero__ais-retrieval-fact,
    .dy-hero__ais-retrieval-line,
    .dy-hero__ais-retrieval-next,
    .dy-hero__ais-rag-fact,
    .dy-hero__ais-rag-line,
    .dy-hero__ais-rag-next,
