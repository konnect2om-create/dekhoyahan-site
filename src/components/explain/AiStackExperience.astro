    }

    if (bridge instanceof HTMLElement) {
      bridge.addEventListener('click', () => {
        // Gated on the beat before it: this can't fire before "What's
        // missing?", and can't fire twice.
        if (root.dataset.unsaid !== '1' || root.dataset.bridge === '1') return;
        root.dataset.bridge = '1';

        // Same synchronous claim as the panel above, for the same reason:
        // this button disappears the instant the click is handled, and
        // claiming focus in the same tick pre-empts Chromium's own
        // recovery from scrolling the page to wherever it would otherwise
        // land.
        if (bridgePanel instanceof HTMLElement) {
          void bridgePanel.offsetWidth;
          bridgePanel.focus({ preventScroll: true });
        }
      });
    }

    if (showme instanceof HTMLElement) {
      showme.addEventListener('click', () => {
        // Gated on the beat before it: this can't fire before "See where
        // this goes", and can't fire twice.
        if (root.dataset.bridge !== '1' || root.dataset.showme === '1') return;
        root.dataset.showme = '1';

        // Same synchronous claim as the two panels above, for the same
        // reason: this button disappears the instant the click is
        // handled, and claiming focus in the same tick pre-empts
        // Chromium's own recovery from scrolling the page to wherever it
        // would otherwise land.
        if (promptPanel instanceof HTMLElement) {
          void promptPanel.offsetWidth;
          promptPanel.focus({ preventScroll: true });
        }
      });
    }

    if (context instanceof HTMLElement) {
      context.addEventListener('click', () => {
        // Gated on the beat before it: this can't fire before "Show
        // me", and can't fire twice.
        if (root.dataset.showme !== '1' || root.dataset.context === '1') return;
        root.dataset.context = '1';

        // Same synchronous claim as every panel before it, for the same
        // reason: this button disappears the instant the click is
        // handled, and claiming focus in the same tick pre-empts
        // Chromium's own recovery from scrolling the page to wherever it
        // would otherwise land.
        if (contextPanel instanceof HTMLElement) {
          void contextPanel.offsetWidth;
          contextPanel.focus({ preventScroll: true });
        }
      });
    }

