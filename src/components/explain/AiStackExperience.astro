<script>
  // Two beats, two flags, each set once and each gated on the one before
  // it — the same one-way pattern the Explore story's own script uses.
  // Every part of what each beat changes — the pictures, the copy, the
  // controls — hangs off the flag in CSS; the script only sets the flag,
  // hands descriptions between elements, and moves focus to where the
  // change happened. Nothing here navigates, loads or reads anything
  // outside this component, and there is no analytics: the Feature is not
  // registered and the story is not finished.
  document.querySelectorAll('[data-ais]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;

    // Everywhere else in this Feature, a reduced-motion visitor gets the
    // same held-back timing collapsed to instant purely through CSS
    // (killing the transition/animation the delay lives on). The two
    // waits below are plain JS timers instead, since what they gate is a
    // display:none swap rather than a fade — so this is checked once and
    // used to zero both, keeping that same "instant, nothing skipped"
    // behaviour for those two waits.
    const prefersReducedMotion =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const enter = root.querySelector('[data-enter]');
    const gotit = root.querySelector('[data-gotit]');
    const unsaid = root.querySelector('[data-unsaid]');
    const stack = root.querySelector('[data-art="stack"]');
    const scene = root.querySelector('[data-art="scene"]');
    const quote = root.querySelector('[data-quote]');
    const kicker = root.querySelector('[data-kicker]');
    const unsaidPanel = root.querySelector('[data-unsaid-panel]');
    const bridge = root.querySelector('[data-bridge]');
    const bridgePanel = root.querySelector('[data-bridge-panel]');
    const showme = root.querySelector('[data-showme]');
    const promptPanel = root.querySelector('[data-prompt-panel]');
    const context = root.querySelector('[data-context]');
    const contextPanel = root.querySelector('[data-context-panel]');
    const memory = root.querySelector('[data-memory]');
    const memoryPanel = root.querySelector('[data-memory-panel]');
    const lookup = root.querySelector('[data-lookup]');
    const lookupPanel = root.querySelector('[data-lookup-panel]');
    const retrieval = root.querySelector('[data-retrieval]');
    const retrievalPanel = root.querySelector('[data-retrieval-panel]');
    const rag = root.querySelector('[data-rag]');
    const ragPanel = root.querySelector('[data-rag-panel]');
    const tools = root.querySelector('[data-tools]');
    const toolsPanel = root.querySelector('[data-tools-panel]');
    const plan = root.querySelector('[data-plan]');
    const planPanel = root.querySelector('[data-plan-panel]');
    const agentic = root.querySelector('[data-agentic]');
    const agenticPanel = root.querySelector('[data-agentic-panel]');
    const recap = root.querySelector('[data-recap]');
    const recapPanel = root.querySelector('[data-recap-panel]');
    const orchestration = root.querySelector('[data-orchestration]');
    const orchestrationPanel = root.querySelector('[data-orchestration-panel]');
    const whole = root.querySelector('[data-whole]');
    const wholePanel = root.querySelector('[data-whole-panel]');
    const decode = root.querySelector('[data-decode]');
    const decodePanel = root.querySelector('[data-decode-panel]');
    const finale = root.querySelector('[data-finale]');
    const finalePanel = root.querySelector('[data-finale-panel]');

    // Moves focus without letting the browser's own scroll-into-view undo
    // the "nothing about this transition moves the page" rule.
    //
    // Retried on requestAnimationFrame, over a real span of time rather
    // than a fixed number of frames, because the two things this focuses
    // become focusable on two different schedules: the quote's own
    // visibility rule is deliberately held back until its 420ms fade-in
    // delay elapses (so it isn't focusable while still invisible), while
    // the kicker's focusability depends on an ancestor's inherited
    // visibility, which empirically has landed within about one frame —
    // but not reliably the very first one, even after forcing a
    // synchronous layout read. A single cutoff comfortably past the
    // longer of the two covers both without a fixed frame-count guessing
    // at a machine's actual refresh rate. The control that had focus
    // before this runs is normally still focusable for a beat after the
    // click (also intentional, for the same reason), so there's no
    // dead moment with focus nowhere in between.
    const focusInPlace = (el, deadline = performance.now() + 800) => {
      if (!(el instanceof HTMLElement)) return;
      requestAnimationFrame(() => {
        el.focus({ preventScroll: true });
        if (document.activeElement !== el && performance.now() < deadline) {
          focusInPlace(el, deadline);
        }
      });
    };

    if (enter instanceof HTMLElement) {
      enter.addEventListener('click', () => {
        if (root.dataset.entered === '1') return;
        root.dataset.entered = '1';

        // Hand the description over with the picture, so what is announced
        // is always the picture actually being shown.
