---
interface Props {
  title?: string;
}

const { title = 'Go deeper' } = Astro.props;
---

<details class="deep-dive">
  <summary>
    <span>{title}</span>
    <b aria-hidden="true">→</b>
  </summary>
  <div class="deep-dive__body">
    <slot />
  </div>
</details>

<style>
  .deep-dive {
    max-width: 40rem;
    margin: 0 auto 3rem;
    padding: 0 1.5rem;
  }

  .deep-dive summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    list-style: none;
  }

  .deep-dive summary::-webkit-details-marker {
    display: none;
  }

  .deep-dive summary b {
    transition: transform 0.2s ease;
    color: var(--cobalt);
  }

  .deep-dive[open] summary b {
    transform: rotate(90deg);
  }

  .deep-dive__body {
    padding: 1.5rem 1.25rem 0.5rem;
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .deep-dive__body :global(h2) {
    font-family: var(--serif);
    color: var(--ink);
    margin-top: 1.5rem;
  }
</style>
