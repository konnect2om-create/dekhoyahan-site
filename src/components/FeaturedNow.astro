---
// The homepage "Featured now" slot.
// Content decides what appears here: the most recently published topic that
// carries a `featured` block wins. Publishing a newer one rotates this
// automatically — the previous feature simply stays under /explore.
import PhotoJourney from './explain/PhotoJourney.astro';

interface Props {
  topic: any;
}

const { topic } = Astro.props;
const featured = topic.data.featured;
const href = `/explore/${topic.id}/`;
---

<aside class="feat">
  <p class="feat__eyebrow"><span aria-hidden="true"></span> Featured now</p>

  <a class="feat__visual" href={href} aria-label={`${featured.headline} — read the full story`}>
    {featured.image ? (
      <img src={featured.image} alt="" loading="eager" decoding="async" />
    ) : topic.data.scene === 'photo-journey' ? (
      <PhotoJourney mode="still" />
    ) : null}
  </a>

  <div class="feat__copy">
    <h2 class="feat__headline">{featured.headline}</h2>
    <p class="feat__teaser">{featured.teaser}</p>
    <a class="feat__cta" href={href}>
      Look closer
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<style>
  .feat {
    min-width: 0;
  }

  .feat__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .feat__eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 5px rgba(232, 117, 36, 0.1);
  }

  .feat__visual {
    display: block;
    border-radius: 26px;
    text-decoration: none;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  .feat__visual:hover {
    transform: translateY(-3px);
  }

  .feat__visual:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 6px;
  }

  .feat__visual img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
    box-shadow: 0 30px 70px rgba(28, 34, 52, 0.14);
  }

  .feat__copy {
    margin-top: 22px;
  }

  .feat__headline {
    margin: 0;
    max-width: 24ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(22px, 1.95vw, 28px);
    font-weight: 560;
    line-height: 1.14;
    letter-spacing: -0.034em;
    text-wrap: balance;
  }

  .feat__teaser {
    margin: 10px 0 0;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: 14.5px;
    line-height: 1.55;
  }

  .feat__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 640;
    text-decoration: none;
  }

  .feat__cta span {
    color: var(--saffron);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  .feat__cta:hover span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .feat__visual,
    .feat__cta span {
      transition: none;
    }
  }
</style>
