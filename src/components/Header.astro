---
const navItems = [
  {
    label: 'Explore',
    href: '/explore/',
  },
  {
    label: 'About',
    href: '/about',
  },
];
---

<header class="site-header shell">
  <a
    class="brand"
    href="/"
    aria-label="DekhoYahan home"
  >
    <span class="brand-rays" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>

    <span class="brand-dekho">Dekho</span>
    <span class="brand-yahan">Yahan</span>
  </a>

  <nav
    class="primary-nav"
    aria-label="Primary navigation"
  >
    {
      navItems.map((item) => (
        <a href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <a
    class="header-join"
    href="/#early-access"
  >
    Join early
    <span aria-hidden="true">→</span>
  </a>
</header>

<script>
  // Analytics: fires `join_early_click` through Cloudflare Zaraz the
  // instant the header's "Join early" CTA is activated, right before its
  // existing <a href="/#early-access"> navigation takes over. No
  // preventDefault, no new navigation logic — this is the site's only
  // "Join early" CTA (present in the header on every page), so `location`
  // is always 'header'.
  document.querySelector('.header-join')?.addEventListener('click', () => {
    window.zaraz?.track('join_early_click', { location: 'header' });
  });
</script>