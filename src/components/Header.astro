---
const navItems = [
  {
    label: 'Explore',
    href: '/explore',
  },
  {
    label: 'About',
    href: '/about',
  },
];
---

<header class="site-header shell">
  <a
    class="brand"
    href="/"
    aria-label="DekhoYahan home"
  >
    <span class="brand-rays" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>

    <span class="brand-dekho">Dekho</span>
    <span class="brand-yahan">Yahan</span>
  </a>

  <nav
    class="primary-nav"
    aria-label="Primary navigation"
  >
    {
      navItems.map((item) => (
        <a href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <a
    class="header-join"
    href="/#early-access"
  >
    Join early
    <span aria-hidden="true">→</span>
  </a>
</header>