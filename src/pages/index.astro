  /* =========================================================
     SCENE 4 — the company stopped fitting inside the boundary
     The dome is not broken, cracked or removed: it stays exactly as
     the visitor found it. What changes is what is standing outside it.
     ========================================================= */

  /* The threat side steps further back — Scene 4 is not about anyone
     getting through the firewall — while the dome's edge and the space
     beyond it come forward. It is quieted, never erased. */
  .dy-hero__zt-s4 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 3 / 2;
    pointer-events: none;
  }

  .dy-hero__zt-s4-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(248, 245, 239, 0.34) 0 24%,
      rgba(248, 245, 239, 0) 42%
    );
    opacity: 0;
  }

  .dy-hero__zt-s4-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  /* Drawn in the same hairline language as everything else the visitor
     has been shown, and in the illustration's own blue — these are
     ordinary, allowed relationships, not attacks. */
  .dy-hero__zt-s4-mark path {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 0.42;
    stroke-opacity: 0.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dy-hero__zt-s4-mark {
    opacity: 0;
  }

  .dy-hero__zt-s4-link {
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  /* The gradients carry the opacity, so the stroke itself only sets
     weight. The white underlay is there for the stretch that runs over
     the illustration and fades out at both ends, where it would only
     be a pale line on empty paper. */
  .dy-hero__zt-s4-stop--halo {
    stop-color: #fff;
  }

  .dy-hero__zt-s4-stop--line {
    stop-color: var(--cobalt);
  }

  .dy-hero__zt-s4-link--halo {
    stroke-width: 1.1;
  }

  .dy-hero__zt-s4-link--line {
    stroke-width: 0.36;
  }

  .dy-hero__zt-s4-link--halo.dy-hero__zt-s4-link--worker {
    stroke: url(#dyZtHaloWorker);
  }

  .dy-hero__zt-s4-link--line.dy-hero__zt-s4-link--worker {
    stroke: url(#dyZtLineWorker);
  }

  .dy-hero__zt-s4-link--halo.dy-hero__zt-s4-link--saas {
    stroke: url(#dyZtHaloSaas);
  }

  .dy-hero__zt-s4-link--line.dy-hero__zt-s4-link--saas {
    stroke: url(#dyZtLineSaas);
  }

  .dy-hero__zt-s4-link--halo.dy-hero__zt-s4-link--cloud {
    stroke: url(#dyZtHaloCloud);
  }

  .dy-hero__zt-s4-link--line.dy-hero__zt-s4-link--cloud {
    stroke: url(#dyZtLineCloud);
  }

  /* Outside the old outline the sky is empty paper, so these names need
     no ground of their own. They sit beside the thing they name, on its
     own line — a name belonging to a small drawn object, not a chip
     hovering at the end of a leader. */
  .dy-hero__zt-s4-tag {
    padding: 0;
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-size: clamp(11px, 1.1vw, 12.5px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
    transform: translateY(-50%);
    /* Insurance only: the paper behind them, in case a name ever
       reaches the artwork at a width we have not measured. */
    text-shadow:
      0 0 3px var(--cream),
      0 0 7px var(--cream);
  }

  /* Each name takes the side its own object leaves open — the worker's
     and the cloud's to their left, the app's to its right — and sits on
     the object's centre line rather than above it. */
  .dy-hero__zt-s4-tag--worker {
    left: auto;
    right: 50.7%;
    top: 11.6%;
  }

  .dy-hero__zt-s4-tag--saas {
    left: 69.7%;
    top: 10%;
  }

  .dy-hero__zt-s4-tag--cloud {
    left: auto;
    right: 13.9%;
    top: 11.2%;
  }

  /* The setup line: the quietest thing in the state — same sans as the
     question, a step smaller and softer, so the question it introduces
     is plainly the more prominent of the two. */
  .dy-hero__zt-setup {
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(12px, 1.15vw, 13px);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .dy-hero__zt-onward {
    position: static;
    width: 100%;
    margin-top: 26px;
    align-items: flex-end;
    text-align: right;
    gap: 4px;
  }

  .dy-hero__zt-onward .dy-hero__zt-question {
    max-width: 82%;
    color: var(--ink);
    font-size: clamp(14px, 1.4vw, 15.5px);
  }

  .dy-hero__zt-onward .dy-hero__zt-cue {
    margin-top: 4px;
  }

  .dy-hero__zt-onward {
    opacity: 0;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-veil {
    animation: dy-s2-fade 800ms ease 260ms both;
  }

  /* One at a time, each with its connection drawn after it arrives, so
     the visitor sees a thing appear outside and then watches the line
     cross the old boundary. */
  .dy-hero__zt.is-s4 .dy-hero__zt-s4-mark--worker {
    animation: dy-s2-fade 420ms ease 800ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-link--worker {
    animation: dy-s2-draw 620ms cubic-bezier(0.3, 0.7, 0.3, 1) 1100ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-tag--worker {
    animation: dy-s4-tag-in 340ms ease 1400ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-mark--saas {
    animation: dy-s2-fade 420ms ease 1750ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-link--saas {
    animation: dy-s2-draw 560ms cubic-bezier(0.3, 0.7, 0.3, 1) 2000ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-tag--saas {
    animation: dy-s4-tag-in 340ms ease 2250ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-mark--cloud {
    animation: dy-s2-fade 420ms ease 2600ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-link--cloud {
    animation: dy-s2-draw 560ms cubic-bezier(0.3, 0.7, 0.3, 1) 2850ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-tag--cloud {
    animation: dy-s4-tag-in 340ms ease 3100ms both;
  }

  /* These names are centred on their object rather than on themselves,
     so their entrance keeps that centring instead of resetting it. */
  @keyframes dy-s4-tag-in {
    from {
      opacity: 0;
      transform: translateY(calc(-50% + 4px));
    }
    to {
      opacity: 1;
      transform: translateY(-50%);
    }
  }

  @keyframes dy-s4-tag-fade {
    from {
      opacity: 0;
      transform: translateY(-50%);
    }
    to {
      opacity: 1;
      transform: translateY(-50%);
    }
  }

  /* The writing waits until all three are standing there with their
     connections drawn — it names what has already been noticed. */
  .dy-hero__zt.is-s4 .dy-hero__zt-s3-copy {
    opacity: 0;
    transition: opacity 400ms ease 3400ms;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-copy .dy-hero__zt-s2-lead {
    animation: dy-s2-in 440ms ease 3700ms both;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-s4-copy .dy-hero__zt-s2-close {
    animation: dy-s2-in 440ms ease 4150ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__zt-s4-link {
      stroke-dashoffset: 0;
    }

    .dy-hero__zt.is-s4 .dy-hero__zt-s4-link--worker,
    .dy-hero__zt.is-s4 .dy-hero__zt-s4-link--saas,
    .dy-hero__zt.is-s4 .dy-hero__zt-s4-link--cloud,
    .dy-hero__zt.is-s4 .dy-hero__zt-s4-copy .dy-hero__zt-s2-lead,
    .dy-hero__zt.is-s4 .dy-hero__zt-s4-copy .dy-hero__zt-s2-close {
      animation-name: dy-s2-fade;
      animation-duration: 220ms;
    }

    .dy-hero__zt.is-s4 .dy-hero__zt-s4-tag--worker,
    .dy-hero__zt.is-s4 .dy-hero__zt-s4-tag--saas,
    .dy-hero__zt.is-s4 .dy-hero__zt-s4-tag--cloud {
      animation-name: dy-s4-tag-fade;
      animation-duration: 220ms;
    }
  }

  /* =========================================================
     SCENE 5 — being inside stops making the decision
     Everything the visitor has been shown steps back to a ghost, and
     one clean boundary is drawn where the dome always stood, so
     "inside" and "outside" keep the meaning they were given. Then two
     people ask for the same thing and only one of them is inside.
     ========================================================= */

  /* The historical detail is not deleted — it is put behind glass, so
     the visitor can still see this is the same place. */
  .dy-hero__zt.is-s5 .dy-hero__zt-art {
    opacity: 0.075;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s2,
  .dy-hero__zt.is-s5 .dy-hero__zt-s3,
  .dy-hero__zt.is-s5 .dy-hero__zt-s4 {
    opacity: 0;
    transition: opacity 760ms ease 120ms;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-find {
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .dy-hero__zt-find {
    position: static;
    width: 100%;
    margin-top: 26px;
    align-items: flex-end;
    text-align: right;
    gap: 7px;
    opacity: 0;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-find {
    animation: dy-s2-in 440ms ease 5400ms both;
  }

  .dy-hero__zt-s5 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 3 / 2;
    pointer-events: none;
  }

  .dy-hero__zt-s5-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  /* The boundary itself — the only line in the scene that is not about
     a person or a request. */
  .dy-hero__zt-s5-dome {
    stroke: var(--cobalt);
    stroke-width: 0.5;
    stroke-opacity: 0.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .dy-hero__zt-s5-mark path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.42;
    stroke-opacity: 0.78;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The destination is the one thing here that belongs to the company,
     so it carries the company's colour. */
  .dy-hero__zt-s5-mark--vault path {
    stroke: var(--cobalt);
    stroke-opacity: 0.85;
  }

  .dy-hero__zt-s5-mark {
    opacity: 0;
  }

  .dy-hero__zt-s5-ask {
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .dy-hero__zt-s5-ask--halo {
    stroke: var(--cream);
    stroke-width: 1;
    stroke-opacity: 0.85;
  }

  .dy-hero__zt-s5-ask--line {
    stroke: var(--cobalt);
    stroke-width: 0.34;
    stroke-opacity: 0.8;
  }

