    top: 81%;
  }

  .dy-hero__zt-s6-out {
    left: 70%;
    top: 58.4%;
    color: var(--cobalt);
  }

  /* Pacing. Each boundary is given time to be understood as smaller
     than the one before it, and each one quiets as the next arrives —
     so what the visitor watches is one boundary shrinking, not three
     boxes accumulating. Then all of it steps back and the request the
     whole story was heading toward is left on its own. */
  .dy-hero__zt.is-s6 .dy-hero__zt-s6-ring--co {
    animation: dy-s2-draw 700ms cubic-bezier(0.3, 0.7, 0.3, 1) 400ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-name--co {
    animation: dy-s2-in 340ms ease 650ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-ring--dmz {
    animation: dy-s2-draw 700ms cubic-bezier(0.3, 0.7, 0.3, 1) 1690ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-name--dmz {
    animation: dy-s2-in 340ms ease 1940ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-ring--fin {
    animation: dy-s2-draw 700ms cubic-bezier(0.3, 0.7, 0.3, 1) 2980ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-name--fin {
    animation: dy-s2-in 340ms ease 3230ms both;
  }

  /* The boundaries stop being the subject. This has to be an animation
     rather than a plain opacity: the entrances above are filled `both`,
     so anything not animated never gets a say. The keyframes hold the
     drawn state so the rings do not spring back to undrawn. */
  .dy-hero__zt.is-s6-quiet .dy-hero__zt-s6-ring--co,
  .dy-hero__zt.is-s6-quiet .dy-hero__zt-s6-ring--dmz,
  .dy-hero__zt.is-s6-quiet .dy-hero__zt-s6-name--co,
  .dy-hero__zt.is-s6-quiet .dy-hero__zt-s6-name--dmz {
