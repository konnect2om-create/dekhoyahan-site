    .dy-hero__zt.is-s5 .dy-hero__zt-idea,
    .dy-hero__zt.is-s6 .dy-hero__zt-s6-ring--co,
    .dy-hero__zt.is-s6 .dy-hero__zt-s6-ring--dmz,
    .dy-hero__zt.is-s6 .dy-hero__zt-s6-ring--fin,
    .dy-hero__zt.is-s6 .dy-hero__zt-s6-name--co,
