  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-ques--b {
    animation: dy-s5-ques 1700ms ease 7600ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-ques--c {
