  }

  .dy-hero__zt-s5-ques {
    left: 55%;
    top: 81.5%;
  }

  .dy-hero__zt-s5-out,
  .dy-hero__zt-s6-out {
    font-size: clamp(11px, 1.1vw, 12.5px);
    font-weight: 700;
    letter-spacing: 0.055em;
  }

  /* The two small verdicts carried by each line of the comparison. The
     tick is the company's own blue; the cross is plain ink rather than
     an alarm colour — this is a request that did not go through, not an
     attack. */
  .dy-hero__zt-s5-tick {
    color: var(--cobalt);
    font-weight: 700;
  }

  .dy-hero__zt-s5-cross {
    color: var(--ink);
    font-weight: 700;
  }

  .dy-hero__zt-s5-out--open {
    left: 87.5%;
    top: 49.6%;
    color: var(--cobalt);
  }

  .dy-hero__zt-s5-out--stop {
    left: 77%;
    top: 60.4%;
    color: var(--ink);
  }

  .dy-hero__zt-s5-name--home {
    left: 19.1%;
    top: 39.5%;
  }

  .dy-hero__zt-s5-name--office {
    left: 46%;
    top: 62%;
  }

  .dy-hero__zt-s5-name--vault {
    left: 72.8%;
    top: 42.4%;
  }

  .dy-hero__zt-s5-said--h1 {
    left: 19.1%;
    top: 46.5%;
  }

  .dy-hero__zt-s5-said--h2 {
    left: 19.1%;
    top: 52.5%;
  }

  .dy-hero__zt-s5-said--o1 {
