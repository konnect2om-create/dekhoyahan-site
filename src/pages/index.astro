     ground arc above and the separation below. */
  .dy-hero__zt-s3-tag--a {
    left: 82%;
    top: 55.5%;
  }

  .dy-hero__zt-s3-tag--b {
    left: 77.83%;
    top: 71.5%;
  }

  /* The longest word in the smallest segment: sat well inside it, away
     from the separation on its left and the dome's own edge on its
     right. */
  .dy-hero__zt-s3-tag--c {
    left: 89.3%;
    top: 68%;
  }



  /* Pacing: the ground past the boundary appears whole, holds for a
     beat, then divides — and only once it has divided does anything
     get a name. Click to segmented reads in about 2.9s, with the
     writing following it. */
  @keyframes dy-s3-in {
    from {
      opacity: 0;
      transform: translate(-50%, 4px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-s3-veil {
    animation: dy-s2-fade 800ms ease 300ms both;
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-s3-cut--one {
    animation: dy-s2-draw 620ms cubic-bezier(0.3, 0.7, 0.3, 1) 1480ms both;
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-s3-cut--two {
