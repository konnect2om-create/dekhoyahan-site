  .dy-hero__zt-s5-verdict--stop path {
    stroke: var(--ink);
    stroke-width: 0.7;
    stroke-opacity: 0.85;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  /* All of Scene 5's writing sits on nearly blank paper, so none of it
     needs a ground of its own. The same three roles as everywhere
     else: the names and the outcome are what to notice, what each
     request answered is quieter, and the questions quieter still. */
  .dy-hero__zt-s5-name,
  .dy-hero__zt-s5-said,
  .dy-hero__zt-s5-ques,
  .dy-hero__zt-s5-out,
  .dy-hero__zt-s6-name,
  .dy-hero__zt-s6-ques,
  .dy-hero__zt-s6-out {
    position: absolute;
    margin: 0;
    font-family: var(--sans);
    letter-spacing: 0;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    text-shadow:
      0 0 3px var(--cream),
      0 0 7px var(--cream);
  }

  .dy-hero__zt-s5-name,
  .dy-hero__zt-s6-name {
    color: var(--ink);
    font-size: clamp(11px, 1.1vw, 12.5px);
    font-weight: 600;
  }

  .dy-hero__zt-s5-said {
    color: var(--ink-soft);
    font-size: clamp(10.5px, 1.05vw, 12px);
    font-weight: 400;
  }

  .dy-hero__zt-s5-ques,
  .dy-hero__zt-s6-ques {
    color: var(--ink-soft);
    font-size: clamp(11px, 1.1vw, 12.5px);
