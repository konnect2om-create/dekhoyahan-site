---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.jsx';
import DiscoveryGrid from '../components/DiscoveryGrid.jsx';

const around = [
  {
    title: 'Your phone knows where you are.',
    question: 'But GPS may not be doing what you think.',
    action: 'See how',
  },
  {
    title: 'You tapped your card.',
    question: 'What happened before the machine said “Approved”?',
    action: 'Follow the payment',
  },
  {
    title: 'Your map knew there was traffic ahead.',
    question: 'How did it know before you got there?',
    action: 'Find out',
  },
];

const ahead = [
  {
    title: 'A voice may stop being proof of who called you.',
    question: 'What changed?',
    action: 'See why',
  },
  {
    title: 'Your glasses may understand what you’re looking at.',
    question: 'What could they actually see?',
    action: 'Take a look',
  },
  {
    title: 'Software is beginning to do things for you, not just answer you.',
    question: 'What’s the difference?',
    action: 'See it happen',
  },
];
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <h1>Understand the world that’s <em>arriving.</em></h1>
      <p>
        <span>Some of it is already around us.</span>
        <span>Some of it is just beginning.</span>
      </p>
      <p class="hero-question">Let’s see what’s actually happening.</p>
      <a class="hero-cta" href="#around">Take a look <span>↓</span></a>
    </div>

    <div class="hero-visual">
      <HeroScene client:load />
    </div>
  </section>

  <section class="discovery-section" id="around">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Look around</p>
          <h2>Around You</h2>
        </div>
        <p>A lot happens around us without us noticing.</p>
      </div>
      <DiscoveryGrid items={around} client:load />
    </div>
  </section>

  <section class="discovery-section discovery-section-dark" id="ahead">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Look ahead</p>
          <h2>Ahead of You</h2>
        </div>
        <p>Some things are about to feel completely normal.</p>
      </div>
      <DiscoveryGrid items={ahead} dark client:load />
    </div>
  </section>
</BaseLayout>
