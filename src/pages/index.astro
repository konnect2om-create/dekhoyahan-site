    top: 75%;
  }

  /* Pacing. The place is drawn, then the two people, then what each of
     them is asking for — and then the scene stops for a moment with
     both requests on the canvas and nothing said about either. That
     pause is the point: the visitor gets to notice on their own that
     one came from outside and one from inside, before anything
     suggests that settles it. Only then do the questions start. Click
     to the last word reads in about 11.3s. */
  .dy-hero__zt.is-s5 .dy-hero__zt-s5-dome {
    animation: dy-s2-draw 900ms cubic-bezier(0.3, 0.7, 0.3, 1) 420ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-mark--vault {
    animation: dy-s2-fade 420ms ease 1200ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-name--vault {
    animation: dy-s2-in 340ms ease 1450ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-mark--home {
    animation: dy-s2-fade 420ms ease 1800ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-name--home {
    animation: dy-s2-in 340ms ease 2050ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-mark--office {
    animation: dy-s2-fade 420ms ease 2350ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-name--office {
    animation: dy-s2-in 340ms ease 2600ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-ask--home {
    animation: dy-s2-draw 800ms cubic-bezier(0.3, 0.7, 0.3, 1) 3000ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-ask--office {
    animation: dy-s2-draw 700ms cubic-bezier(0.3, 0.7, 0.3, 1) 3500ms both;
  }

  /* The pause: 4.2s to 4.6s, nothing arrives. */
  .dy-hero__zt.is-s5 .dy-hero__zt-s5-ques--a {
    animation: dy-s5-ques 1900ms ease 4600ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-said--h1,
  .dy-hero__zt.is-s5 .dy-hero__zt-s5-said--o1 {
    animation: dy-s2-in 340ms ease 5150ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-ques--b {
    animation: dy-s5-ques 1900ms ease 6500ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-said--h2,
  .dy-hero__zt.is-s5 .dy-hero__zt-s5-said--o2 {
    animation: dy-s2-in 340ms ease 7050ms both;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-s5-verdict--open {
