    font-size: 16.5px;
    font-weight: 640;
    line-height: 1.24;
    letter-spacing: -0.005em;
  }


  /* Card 1's title carries an intentional two-line composition on
     desktop — recognition, then the curiosity gap. The break is only
     rendered once the grid has room for it (see the 981px breakpoint
     below); at narrower widths it's suppressed so the sentence just
     wraps naturally instead of forcing an awkward split. */
  .dy-explore__label-break {
    display: none;
  }
@media (min-width: 981px) {
    .dy-explore__label-break {
      display: block;
    }
}


  /* The same quiet page-turn idiom used throughout the Explore stories
     (5G, the photo journey): serif text, ink, a small saffron circle
     carrying the arrow. Pinned to the bottom of the card via the flex
     column's own margin-top: auto, so it lines up across all four cards
     regardless of whether a label wraps to one line or two. */
  .dy-explore__see {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: auto 20px 14px;
    color: var(--ink);
