  /* =========================================================
     HERO — right-side stage, Scene 1: Zero Trust / SecurityDome
     One object, not three stacked ones. The title drops down INTO the
     illustration's own empty sky (negative margin below), and the
     question is an annotation anchored to the painted dome boundary:
     marker on the rim → hairline → question → cue. Everything after
     the title is positioned in percentages of the stage, and the
     stage matches the illustration's 3:2 frame exactly, so those
     coordinates land on the same painted pixels at any size.
     ========================================================= */
  /* Every vertical relationship here is measured against the
     ARTWORK'S VISIBLE PIXELS, not the PNG's box. Measured from the
     asset's alpha channel: the painted illustration starts 17.25%
     down the canvas and ends at 87.5%, so at any rendered size the
     canvas carries 0.115 x its own width of empty sky above the
     artwork and 0.0833 x below it. Those two constants are what the
     title's overlap and the stage's height are derived from, so the
     gaps below stay true at every viewport instead of drifting with
     the invisible padding. */
  .dy-hero__zt {
    --zt-w: min(600px, 88%);
    /* Empty canvas above the first painted pixel, as a share of width. */
    --zt-sky: calc(var(--zt-w) * 0.115);
    /* Gap from the headline down to the artwork's visible top edge. */
    --zt-gap-top: 24px;
    /* Gap from the artwork's visible bottom edge down to the question —
       wide enough that the invitation reads as its own editorial beat
       rather than as a caption hanging off the picture. */
    --zt-gap-bottom: 22px;
    display: flex;
    flex-direction: column;
    /* Starts the whole Feature below the left headline's own first
       line, so "Understand the world that's arriving." establishes the
       page and this reads as the story noticed next. The ceiling is
       set by two things at once: the left column's own height (the
       hero row must not grow) and the hero's bottom padding, which is
       the space the invitation below the artwork sits in — .dy-hero
       clips its overflow, so the invitation may not cross that edge.
       Expressed in vh because that second ceiling is itself vertical
       and closes up as the window gets shorter; this curve is tuned to
       sit just inside both limits at every window height. */
    padding-top: clamp(10px, calc(21vh - 146px), 66px);
  }

  /* =========================================================
     THE ADAPTIVE CANVAS
     The Feature's height is its content's height. Each later state
     brings its own row, collapsed to nothing until that state opens
     it — so Scene 1 keeps exactly the compact hero it has always had,
     and a state that needs more room takes only what its own writing
     asks for. Because these are flow rows inside the hero's own grid
     column, the hero grows and the section below it simply moves down;
     nothing is ever positioned over it.
     ========================================================= */
  .dy-hero__zt-tail {
    display: grid;
    /* Spans the column even where the Feature centres its children,
       so the writing wraps against the picture's width rather than
       shrink-wrapping to a narrow box of its own. */
    width: 100%;
    grid-template-rows: 0fr;
    transition: grid-template-rows 640ms cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .dy-hero__zt-tail-in {
    overflow: hidden;
    min-height: 0;
  }

  /* The canvas opens just before the writing that needs it arrives, so
     the space is never empty for long and never larger than the story.
     Each state opens only its own row. */
  .dy-hero__zt.is-s2 .dy-hero__zt-tail--copy {
    grid-template-rows: 1fr;
    transition-delay: 2500ms;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-tail--next {
    grid-template-rows: 1fr;
    transition-delay: 4160ms;
  }

  /* Each scene consumes the invitation that led to it, so the canvas
     gives that room back rather than leaving a hole where it was. */
  .dy-hero__zt.is-s3 .dy-hero__zt-tail--next {
    grid-template-rows: 0fr;
    transition-delay: 700ms;
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-tail--onward {
    grid-template-rows: 1fr;
    transition-delay: 4840ms;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-tail--onward {
    grid-template-rows: 0fr;
    transition-delay: 700ms;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-tail--find {
    grid-template-rows: 1fr;
    transition-delay: 5200ms;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-tail--find {
    grid-template-rows: 0fr;
    transition-delay: 700ms;
  }

  .dy-hero__zt.is-s5 .dy-hero__zt-tail--idea {
    grid-template-rows: 1fr;
    transition-delay: 11700ms;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-tail--idea {
    grid-template-rows: 0fr;
    transition-delay: 700ms;
  }

  /* The epilogue takes back the room the invitation before it gave up,
     so the section below never sits lower than it already did while
     the story was running. */
  .dy-hero__zt.is-s6 .dy-hero__zt-tail--again {
    grid-template-rows: 1fr;
    transition-delay: 17500ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__zt-tail {
      transition: none;
    }
  }

  /* Shares the illustration's own box, so the title's left edge sits
     on the artwork's left visual axis (the painted content runs the
     full canvas width — measured 0.3% to 99.7% — so the box edge IS
     the visual edge here). It belongs to the whole
     outside → firewall → dome composition, not to the dome alone. */
  .dy-hero__zt-title {
    width: var(--zt-w);
    /* Sits --zt-gap-top above the artwork's first visible pixel: the
       overlap cancels exactly the transparent sky beneath it. */
    margin: 0 0 calc(var(--zt-gap-top) - var(--zt-sky)) auto;
    position: relative;
    z-index: 1;
  }

  /* Side-by-side only: the title moves off its flow position into the
     artwork's own empty upper-left sky — the open area above the
     threat cloud and left of the dome. Done with relative offsets, so
     nothing else in the composition shifts: the illustration and the
     invitation keep the exact positions they had. Both offsets are
     fractions of the illustration's width, so the title lands on the
     same painted region at every desktop size.

     The drop is padding rather than a `top` offset on purpose: --zt-w
     carries a percentage, and a percentage in `top` resolves against
     the container's height — which is auto here, so it comes out as
     zero. Padding percentages resolve against WIDTH, like every other
     measurement in this composition, and the same amount is taken back
     out of the margin below so the flow is unchanged and the
     illustration and invitation stay exactly where they were. */
  @media (min-width: 1320px) {
    .dy-hero__zt-title {
      left: calc(var(--zt-w) * 0.051);
      padding-top: calc(var(--zt-w) * 0.145);
      margin-bottom: calc(var(--zt-gap-top) - var(--zt-sky) - var(--zt-w) * 0.145);
    }
  }

  /* "Zero Trust" carries the hierarchy — larger, heavier — while the
     completing clause reads as a quieter continuation, the reverse of
     the left title's own emphasis pattern (there the SECOND line gets
     the colour accent); here the FIRST word pair does, in weight
     rather than colour. Both sizes stay well under the left hero's
     72px ceiling so it never competes as a second homepage headline. */
  .dy-hero__zt-title-lead {
    display: block;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 620;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .dy-hero__zt-title-swap {
    display: block;
    position: relative;
  }

  .dy-hero__zt-title-was {
    display: block;
  }

  /* Out of flow, so it contributes nothing to the title's height. */
  .dy-hero__zt-title-now {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
  }

  .dy-hero__zt-title-rest {
    display: block;
    margin-top: 2px;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-weight: 450;
    font-size: clamp(16px, 1.7vw, 20.5px);
    line-height: 1.2;
    letter-spacing: -0.016em;
  }

  /* The illustration, large enough that outside → firewall → inside
     is inspectable at a glance. Its own transparency is what lets it
     sit directly on the page, so nothing here draws a card, panel or
     border behind it. */
  /* The stage box ends where the ARTWORK ends, not where the PNG
     does: 87.5% of the image's own 3:2 height (0.875 x 2/3 = 0.5833
     of the width). The image itself still renders at full size and
     simply overflows the box with its transparent lower band, so
     nothing is cropped, scaled or moved — but "100%" of this box now
     means the artwork's real bottom edge, which is what the question
     below is spaced against. */
  .dy-hero__zt-stage {
    position: relative;
    width: var(--zt-w);
    margin-left: auto;
    aspect-ratio: 600 / 350;
  }

  /* Overflows its box with the transparent lower band, so it must not
     swallow pointer events meant for the invitation sitting there. */
  .dy-hero__zt-stage img {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  /* Question + invitation as one control, sitting under the lower-right
     of the artwork. Because the stage box above ends at the artwork's
     VISIBLE bottom, this margin is a real perceptual gap, not a gap to
     the PNG's transparent edge. No pill, border, card or background —
     it's type, and the whole thing is the link. */
  /* Hung off the stage rather than stacked in flow: the stage box ends
     at the artwork's visible bottom, so "100%" here is the painted
     edge — and because it doesn't add to the column's height, the hero
     row keeps the height the left column sets for it. */
  .dy-hero__zt-callout {
    position: absolute;
    right: 0;
    top: calc(100% + var(--zt-gap-bottom));
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 9px;
    text-align: right;
    cursor: pointer;
  }

  /* A question is not a revelation. The serif is reserved for the
     sentences the visitor should carry away; everything that sets up,
     explains or asks is the page's own sans at ordinary weight, so the
     three roles stay legible as roles rather than as sizes. */
  .dy-hero__zt-question {
    max-width: 74%;
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(14px, 1.4vw, 15.5px);
    line-height: 1.4;
    letter-spacing: 0;
  }

  /* The word the question turns on, picked out in the site's cobalt
     the same way "arriving." is on the left hero. */
  .dy-hero__zt-question-em {
    color: var(--cobalt);
  }

  /* The invitation: the question raises the curiosity, this says there
     is somewhere to go. Same sans as the question it belongs to, so
     the two read as one thought — but in DekhoYahan blue at a heavier
     weight, and carrying the exact saffron circular-arrow used by the
     Explore CTA and the discovery cards. That is enough to be
     recognised as an action without becoming a button. */
  .dy-hero__zt-cue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--cobalt);
    font-family: var(--sans);
    font-size: clamp(14px, 1.4vw, 15.5px);
    font-weight: 700;
    letter-spacing: 0;
  }

  .dy-hero__zt-cue-arrow {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
    transition: transform 160ms ease;
  }

  /* Restrained hover: the arrow takes the same 2px step it does
     everywhere else on the site, and the question warms toward the
     link colour. Nothing else moves. */
  .dy-hero__zt-callout:hover .dy-hero__zt-cue-arrow,
  .dy-hero__zt-callout:focus-visible .dy-hero__zt-cue-arrow {
    transform: translateX(2px);
  }

  .dy-hero__zt-question {
    transition: color 160ms ease;
  }

  .dy-hero__zt-callout:hover .dy-hero__zt-question,
  .dy-hero__zt-callout:focus-visible .dy-hero__zt-question {
    color: var(--cobalt);
  }

  .dy-hero__zt-callout:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 8px;
    border-radius: 2px;
  }

  /* =========================================================
     SCENE 2 — the boundary inside the boundary
     Everything here lives inside the same stage box Scene 1 uses, so
     the hero's height, the section below it and the left column are
     untouched by the transition.
     ========================================================= */

  /* The protected inside settles back — far enough to stop competing,
     not so far that the visitor loses the system they were looking at.
     The layer above keeps the outside and the firewall at full
     strength, so the picture still reads as the same one. */
  .dy-hero__zt-art,
  .dy-hero__zt-art-keep {
    transition: opacity 760ms cubic-bezier(0.3, 0.7, 0.3, 1) 120ms;
  }

  .dy-hero__zt-art-keep {
    opacity: 0;
    /* Full strength through the globe and the firewall (which end at
       47% of the artwork's width), then handed back to the settled
       layer across the dome's own left rim. */
    -webkit-mask-image: linear-gradient(to right, #000 0 44%, transparent 62%);
    mask-image: linear-gradient(to right, #000 0 44%, transparent 62%);
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-art {
    opacity: 0.52;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-art-keep {
    opacity: 1;
  }

  /* Scene 1's invitation leaves first, in place, before anything is
     drawn — the visitor's own question is what the scene answers. */
  .dy-hero__zt.is-s2 [data-zt-open] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  /* The overlay carries the illustration's own 3:2 frame rather than
     the stage's cropped box, so a percentage here is a percentage of
     the picture. It never takes pointer events. */
  .dy-hero__zt-s2 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 3 / 2;
    pointer-events: none;
  }

  /* Beat 2: attention is walked to the space immediately behind the
     firewall before anything is drawn there — a soft breath of the
     page's own paper over everything else, which then lifts. No
     marker, no outline, nothing left behind. */
  .dy-hero__zt-s2-focus {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 22% 28% at 56% 65%,
      rgba(248, 245, 239, 0) 52%,
      rgba(248, 245, 239, 0.62) 100%
    );
    opacity: 0;
  }

  .dy-hero__zt-s2-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  /* The intermediate ground: a strip of the dome's own floor, lifted
     just enough to read as its own place. Its edges are chords of the
     base ellipse, so it lies in the scene's perspective instead of
     floating over it. */
  .dy-hero__zt-s2-zone {
    fill: rgba(248, 245, 239, 0.52);
    opacity: 0;
  }

  /* The second boundary: a pane of the same translucent material the
     original dome is made of, standing across the scene where that
     ground strip ends — so what separates the services from the
     deeper systems belongs to the same world as the first boundary. */
  .dy-hero__zt-s2-wall {
    fill: rgba(36, 92, 255, 0.22);
    opacity: 0;
  }

  /* Its leading edge, drawn rather than faded — this is the moment the
     visitor is meant to catch. pathLength normalises it to 1 so a
     single dash draws the whole line in. */
  .dy-hero__zt-s2-edge {
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  /* A breath of light carried under the line, the same way the site's
     other hairlines sit over imagery: it keeps the boundary readable
     across the bright parts of the illustration without thickening it
     or fencing the zone off with a fill. */
  .dy-hero__zt-s2-edge--halo {
    stroke: #fff;
    stroke-width: 1.3;
    stroke-opacity: 0.62;
  }

  .dy-hero__zt-s2-edge--line {
    stroke: var(--cobalt);
    stroke-width: 0.46;
    stroke-opacity: 0.95;
  }

  .dy-hero__zt-s2-nodes,
  .dy-hero__zt-s2-label {
    position: absolute;
    margin: 0;
  }

  /* Standing on the intermediate ground, between the firewall and the
     new wall — centred on that strip, so the two services stay inside
     it at any stage width. */
  .dy-hero__zt-s2-nodes {
    left: 57%;
    top: 60%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
  }

  /* Small paper chips rather than boxes on a diagram: they carry their
     own ground so they read against the settled illustration, with no
     border or shadow to make the scene look like network topology. */
  .dy-hero__zt-s2-chip {
    padding: 0.42em 0.6em;
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(9.5px, 1vw, 11px);
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1.1;
    white-space: nowrap;
    opacity: 0;
  }

  /* Metadata, not a headline: the smallest type in the scene, sitting
     quietly under what it names. */
  .dy-hero__zt-s2-label {
    left: 57%;
    top: 70.5%;
    transform: translateX(-50%);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(9px, 0.95vw, 10.5px);
    font-weight: 600;
    letter-spacing: 0.08em;
    opacity: 0;
  }

  /* The writing takes the slot the visitor was already reading, below
     the picture — so Scene 2 puts nothing on top of the illustration
     it is asking them to look at. Same geometry as Scene 1's
     invitation, so the hero's height is unaffected. */
  /* The realisations sit in flow directly under the picture, hard
     against its right edge, so they read as the conclusion reached on
     the internal side rather than a caption centred beneath it. The
     stage box ends at the artwork’s deepest painted pixel (87.6% of
     the canvas, under the dome’s base), so this margin is a real
     measured gap. */
  .dy-hero__zt-copies {
    display: grid;
    margin-top: 12px;
  }

  .dy-hero__zt-s2-copy,
  .dy-hero__zt-s3-copy,
  .dy-hero__zt-s4-copy,
  .dy-hero__zt-s5-copy,
  .dy-hero__zt-s6-copy {
    grid-area: 1 / 1;
    width: 100%;
    text-align: right;
    pointer-events: none;
  }

  /* One rule for the whole Feature's writing. The revelation — the
     sentence the scene exists to earn — is set in the serif the story
     is told in. Everything that explains, names or invites is set in
     the sans the rest of the page already uses for that job. Nothing
     here is italic: these are sentences to read at normal homepage
     size, not asides. */
  .dy-hero__zt-s2-lead,
  .dy-hero__zt-s2-close {
    margin: 0 0 0 auto;
    opacity: 0;
  }

  .dy-hero__zt-s2-lead {
    font-family: var(--serif);
    letter-spacing: -0.012em;
  }

  .dy-hero__zt-s2-lead {
    max-width: 66%;
    color: var(--ink);
    font-weight: 550;
    font-size: clamp(16px, 1.7vw, 19.5px);
    line-height: 1.24;
  }

  /* The word the whole scene turned on, in the same cobalt Scene 1
     used to ask about it. */
  .dy-hero__zt-s2-em {
    color: var(--cobalt);
  }

  .dy-hero__zt-s2-close {
    margin-top: 7px;
    max-width: 82%;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(12.5px, 1.25vw, 13.5px);
    line-height: 1.45;
    letter-spacing: 0;
  }

  /* Pacing: the picture explains itself first, and in the order the
     idea has to land. Attention moves to the ground immediately past
     the firewall, that ground separates out, the two services resolve
     standing on it, it gets its quiet name — and only then does the
     second boundary rise between them and everything deeper in. That
     is the moment of the scene, so nothing is written until it has
     happened. Click to settled reads in about 3.7s. */
  @keyframes dy-s2-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dy-s2-fade-x {
    from {
      opacity: 0;
      transform: translateX(-50%);
    }
    to {
      opacity: 1;
      transform: translateX(-50%);
    }
  }

  @keyframes dy-s2-focus {
    0% {
      opacity: 0;
    }
    38% {
      opacity: 1;
    }
    62% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes dy-s2-draw {
    from {
      opacity: 0;
      stroke-dashoffset: 1;
    }
    16% {
      opacity: 1;
    }
    to {
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  @keyframes dy-s2-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* translateX is already carrying these two onto the boundary's axis,
     so their entrance keeps it rather than resetting it. */
  @keyframes dy-s2-in-x {
    from {
      opacity: 0;
      transform: translate(-50%, 5px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-focus {
    animation: dy-s2-focus 1000ms ease 300ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-zone {
    animation: dy-s2-fade 520ms ease 900ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-chip--web {
    animation: dy-s2-in 340ms ease 1350ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-chip--mail {
    animation: dy-s2-in 340ms ease 1480ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-label {
    animation: dy-s2-in-x 340ms ease 1720ms both;
  }

  /* The reveal: the wall's material settles in as its leading edge
     draws down through the scene. */
  .dy-hero__zt.is-s2 .dy-hero__zt-s2-wall {
    animation: dy-s2-fade 640ms ease 2100ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-edge {
    animation: dy-s2-draw 840ms cubic-bezier(0.3, 0.7, 0.3, 1) 2060ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-copy .dy-hero__zt-s2-lead {
    animation: dy-s2-in 440ms ease 3020ms both;
  }

  .dy-hero__zt.is-s2 .dy-hero__zt-s2-copy .dy-hero__zt-s2-close {
    animation: dy-s2-in 440ms ease 3460ms both;
  }

  /* The continuation arrives once the realisation has had a moment to
     land — a separate beat, not part of the reveal. */
  .dy-hero__zt.is-s2 .dy-hero__zt-deeper {
    animation: dy-s2-in 440ms ease 4320ms both;
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-onward {
    animation: dy-s2-in 440ms ease 5000ms both;
  }

  /* Reduced motion: the same sequence, the same order, but nothing
     draws or travels — each part simply becomes present. */
  @media (prefers-reduced-motion: reduce) {
    .dy-hero__zt-s2-edge {
      stroke-dashoffset: 0;
    }

    .dy-hero__zt.is-s2 .dy-hero__zt-s2-edge,
    .dy-hero__zt.is-s2 .dy-hero__zt-s2-chip--web,
    .dy-hero__zt.is-s2 .dy-hero__zt-s2-chip--mail,
    .dy-hero__zt.is-s2 .dy-hero__zt-s2-copy .dy-hero__zt-s2-lead,
    .dy-hero__zt.is-s2 .dy-hero__zt-s2-copy .dy-hero__zt-s2-close {
      animation-name: dy-s2-fade;
      animation-duration: 220ms;
    }

    .dy-hero__zt.is-s2 .dy-hero__zt-s2-label {
      animation-name: dy-s2-fade-x;
      animation-duration: 220ms;
    }

    /* The attention pass is motion for its own sake; without it the
       boundary simply appears where it belongs. */
    .dy-hero__zt.is-s2 .dy-hero__zt-s2-focus {
      animation: none;
      opacity: 0;
    }

    .dy-hero__zt-art,
    .dy-hero__zt-art-keep {
      transition-duration: 220ms;
      transition-delay: 0ms;
    }
  }

  /* =========================================================
     SCENE 3 — the deeper inside divides again
     Same stage box, same ground plane, same boundary language as
     Scene 2. Nothing here contributes layout, so the hero's height,
     the section below it and the left column are untouched.
     ========================================================= */

  /* Scene 2's continuation: an ordinary block in the flow, below the
     realisation it follows from and aligned to the same right edge, so
     the eye carries on through the second boundary instead of turning
     back toward the globe. Same control as Scene 1's invitation — the
     whole thing is the link, and nothing about it is a card or a
     button. The space above it is the beat between understanding and
     acting. */
  .dy-hero__zt-deeper {
    position: static;
    width: 100%;
    margin-top: 26px;
    align-items: flex-end;
    text-align: right;
    gap: 7px;
    opacity: 0;
  }

  /* Quieter than the realisation above it, but plainly readable — the
     next thought, not a second conclusion. */
  .dy-hero__zt-deeper .dy-hero__zt-question {
    max-width: 76%;
    color: var(--ink-soft);
    font-size: clamp(13px, 1.3vw, 14.5px);
  }

  /* Through the wall: the outside, the firewall and the DMZ step back
     under a breath of the page's own paper. They stay legible — they
     are where the visitor has just been — while the ground beyond the
     boundary comes forward. */
  .dy-hero__zt-s3 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 3 / 2;
    pointer-events: none;
  }

  .dy-hero__zt-s3-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(248, 245, 239, 0.44) 0 38%,
      rgba(248, 245, 239, 0) 62%
    );
    opacity: 0;
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-art {
    opacity: 0.78;
  }

  .dy-hero__zt.is-s3 .dy-hero__zt-art-keep {
    opacity: 0;
  }

  /* What the visitor already found stays on the page, quieter. */
  .dy-hero__zt.is-s3 .dy-hero__zt-s2-chip,
  .dy-hero__zt.is-s3 .dy-hero__zt-s2-label,
  .dy-hero__zt.is-s3 .dy-hero__zt-s2-zone {
    opacity: 0.5;
    transition: opacity 700ms ease 260ms;
  }

  .dy-hero__zt.is-s4 .dy-hero__zt-onward,
  .dy-hero__zt.is-s3 .dy-hero__zt-s2-copy,
  .dy-hero__zt.is-s3 .dy-hero__zt-deeper {
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .dy-hero__zt-s3-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  /* One area first: the ground past the boundary, shown whole, so what
     happens next is visibly a division of something that was single. */
  .dy-hero__zt-s3-whole {
    fill: rgba(248, 245, 239, 0.4);
    opacity: 0;
  }

  /* Then the same ground as separate places — differently tinted, so
     they read as areas under their own control rather than as one
     floor with lines ruled across it. */
  .dy-hero__zt-s3-plot {
    stroke: var(--cobalt);
    stroke-width: 0.22;
    stroke-opacity: 0.5;
    stroke-linejoin: round;
    opacity: 0;
  }

  .dy-hero__zt-s3-plot--a {
    fill: rgba(248, 245, 239, 0.38);
  }

  .dy-hero__zt-s3-plot--b {
    fill: rgba(36, 92, 255, 0.17);
  }

  .dy-hero__zt-s3-plot--c {
    fill: rgba(248, 245, 239, 0.34);
  }

  /* The separations themselves, in the second boundary's own hairline
     language but thinner — smaller boundaries, of the same kind. */
  .dy-hero__zt-s3-cut {
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .dy-hero__zt-s3-cut--halo {
    stroke: #fff;
    stroke-width: 1.05;
    stroke-opacity: 0.6;
  }

  .dy-hero__zt-s3-cut--line {
    stroke: var(--cobalt);
    stroke-width: 0.4;
    stroke-opacity: 0.92;
