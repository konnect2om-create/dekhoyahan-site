  .dy-hero__zt.is-s6 .dy-hero__zt-s6-yes {
    animation: dy-s2-draw 460ms ease 11400ms both;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-out {
    animation: dy-s2-in 340ms ease 11600ms both;
  }

  /* Scene 5's realisation leaves, and then nothing is written for a
     moment: the answered request is left holding the canvas on its own
     before anything names what it means. */
  .dy-hero__zt.is-s6 .dy-hero__zt-s5-copy {
    opacity: 0;
    transition: opacity 400ms ease 12100ms;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-s6-copy--b .dy-hero__zt-s2-lead {
