---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredStories } from '../data/stories';
import { featuredFeature } from '../features/registry';

// The homepage renders whichever story is currently marked as the
// featured Feature. It never imports a specific Feature itself, so
// swapping the story is a change to the registry, not to this page.
const Feature = featuredFeature.Component;
---

<BaseLayout>
  <!-- ============================================================
       HERO — the brand statement, plus the feature stage beside it
       ============================================================ -->
  <section class="dy-hero">
    <div class="shell dy-hero__grid">
      <div class="dy-hero__brand">
        <h1 class="dy-hero__title">
          Understand the world
          <span>that's <em>arriving.</em></span>
        </h1>

        <p class="dy-hero__intro">
          See how technology works —<br />
          and understand why it matters.
        </p>

        <p class="dy-hero__subintro">
          <span>You don't need a technical background.<br />Just curiosity.</span>
        </p>

        <div class="dy-hero__signature">
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 3.5a5.5 5.5 0 0 1 3 10.1c-.6.4-1 1.1-1 1.9v.5H10v-.5c0-.8-.4-1.5-1-1.9A5.5 5.5 0 0 1 12 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M10 18.5h4M10.6 20.5h2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span>Understand it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See differently.</span>
        </div>

        <!-- Quiet editorial CTA, not the old black "See how" button — the
             hero's own story action now lives beside the featured story
             on the right (see .dy-hero__feature-row below). This one just
             takes the visitor to the Explore library; it never starts the
             hero sequence and fires no hero_start analytics. -->
        <a class="dy-hero__explore-cta" href="/explore/">
          Explore
          <span class="dy-hero__explore-cta__arrow" aria-hidden="true">→</span>
        </a>
      </div>


      <!-- The right hero stage: the slot the featured Feature runs in.
           Which story that is comes from the registry, and how the story
           behaves is entirely the Feature's own business — this page
           only gives it the column. -->
      <div class="dy-hero__feature">
        <Feature />
      </div>
    </div>
  </section>

  <!-- ============================================================
       LOOK CLOSER — explore-preview cards (Card 1 of eventual 4)
       ============================================================ -->
  <section class="dy-explore">
    <div class="shell">
      <!-- The chapter break: the featured story above is the flagship
           moment on this page; this is the secondary, browsable
           section beneath it. A quiet rule plus reduced heading weight
           is enough to say "new chapter" without a label or a box. -->
      <span class="dy-explore__divider" aria-hidden="true"></span>

      <header class="dy-explore__head">
        <h2 class="dy-explore__title">There's <span class="dy-explore__title-accent">more</span> to understand.</h2>
        <p class="dy-explore__sub">Pick one and see what's really happening.</p>
      </header>

      <!-- The four featured stories come from src/data/stories.ts, which is
           the same list /explore/ reads. The markup below is exactly what
           was here before, emitted once per entry — no card gains or loses
           anything by being driven from the manifest. -->
      <ul class="dy-explore__grid">
        {featuredStories.map((story) => (
          <li class="dy-explore__card">
            <a class="dy-explore__link" href={`/explore/${story.slug}/`}>
              <span class="dy-explore__art">
                <img src={story.thumb} alt="" width="720" height="480" loading="lazy" decoding="async" />
              </span>
              <span class="dy-explore__label">{story.title}<br class="dy-explore__label-break" /> {story.line}</span>
              <span class="dy-explore__see">See what's really happening <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <a class="dy-explore__cta" href="/explore/">
        Explore everything
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============================================================
       JOIN
       ============================================================ -->
  <section class="dy-join" id="early-access">
    <div class="shell">
      <div class="dy-join__panel">
        <div class="dy-join__copy">
          <p class="dy-eyebrow"><span></span> DekhoYahan, as it grows</p>
          <h2>Be part of what we're building.</h2>
          <p class="dy-join__desc">
            Get new explanations as they arrive — and occasionally help shape what we explain next.
          </p>
        </div>

        <form class="dy-form" id="join-form" novalidate>
          <label for="join-email">Your email</label>

          <div class="dy-form__row">
            <input
              id="join-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            />
            <button type="submit">
              <span class="dy-form__label">Join</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <p class="dy-form__status" id="join-status" role="status" aria-live="polite"></p>

          <p class="dy-form__note">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3l7 3v6c0 4.4-3 8.1-7 9-4-0.9-7-4.6-7-9V6z" />
              <path d="M9 12.2l2.1 2.1L15.2 10" />
            </svg>
            Just DekhoYahan updates. Unsubscribe anytime.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>


<script>
  const form = document.querySelector('#join-form');
  const emailInput = document.querySelector('#join-email');
  const status = document.querySelector('#join-status');

  // Arriving via "Join early" should leave the cursor ready in the field,
  // whether that is a same-page jump or a landing from another page.
  const focusJoin = () => {
    if (location.hash !== '#early-access' || !(emailInput instanceof HTMLInputElement)) return;
    // Wait for the smooth scroll to settle before taking focus, so the
    // browser does not jump the viewport a second time.
    setTimeout(() => emailInput.focus({ preventScroll: true }), 600);
  };

  window.addEventListener('hashchange', focusJoin);
  focusJoin();

  if (
    form instanceof HTMLFormElement &&
    emailInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonText = form.querySelector('.dy-form__label');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      status.textContent = '';
      status.dataset.state = '';

      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please check your email address.';
        status.dataset.state = 'error';
        emailInput.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (buttonText instanceof HTMLElement) buttonText.textContent = 'Joining…';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data?.message || 'Something went wrong. Please try again.');
        }

        status.textContent = data.message || 'Done. We will email you when the next topic is ready.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (buttonText instanceof HTMLElement) buttonText.textContent = 'Join';
      }
    });
  }
</script>


<script>
  // Analytics: fires `hero_view` through Cloudflare Zaraz once the hero
  // section has been at least 50% visible in the viewport for a
  // continuous second. Isolated from the hero's own visual/interaction
  // script above — this only observes visibility and never touches the
  // hero's markup, layout, or behavior.
  const heroSection = document.querySelector('.dy-hero');

  if (heroSection instanceof HTMLElement) {
    let visibleTimer = null;
    let fired = false;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (visibleTimer === null) {
            visibleTimer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('hero_view');
              observer.disconnect();
            }, 1000);
          }
        } else if (visibleTimer !== null) {
          clearTimeout(visibleTimer);
          visibleTimer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(heroSection);
  }
</script>

<style>
  /* =========================================================
     HERO — original DekhoYahan typography, restored
     ========================================================= */
  .dy-hero {
    position: relative;
    padding: clamp(38px, 5.5vh, 60px) 0 clamp(54px, 7vh, 76px);
    overflow: hidden;
  }


  .dy-hero__grid {
    display: grid;
    grid-template-columns: minmax(460px, 0.92fr) minmax(0, 1.08fr);
    /* Top-aligned: centring dropped the headline well below the
       feature stage and left the top-left of the page empty. */
    align-items: start;
    gap: clamp(40px, 5vw, 78px);
  }


  .dy-hero__brand {
    max-width: 650px;
    /* Sits just below the top of the feature stage opposite it. */
    padding-top: clamp(6px, 3.4vh, 34px);
  }

  /* Quiet editorial CTA replacing the old black "See how" pill on the
     left: text + the same small saffron circular-arrow language now
     used on the Explore cards, reusing var(--saffron) rather than a new
     colour. The whole element is the link. */
  .dy-hero__explore-cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    margin-top: clamp(26px, 3.5vh, 32px);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 15px;
    font-weight: 620;
    text-decoration: none;
    letter-spacing: -0.006em;
  }

  .dy-hero__explore-cta__arrow {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .dy-hero__explore-cta:hover .dy-hero__explore-cta__arrow {
    transform: translateX(2px);
  }

  .dy-hero__explore-cta:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }



  .dy-hero__title {
    margin: 0;
    max-width: 650px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(54px, 4.4vw, 72px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }


  .dy-hero__title span {
    display: block;
  }


  .dy-hero__title em {
    color: var(--cobalt);
    font-style: normal;
  }


  .dy-hero__intro {
    max-width: 545px;
    margin: clamp(21px, 2.5vh, 27px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.58;
    letter-spacing: -0.012em;
  }


  .dy-hero__brandword {
    font-weight: 700;
  }


  .dy-hero__subintro {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 545px;
    margin: clamp(22px, 2.8vh, 30px) 0 0;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }


  .dy-hero__subintro-icon {
    flex: none;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    color: var(--cobalt);
  }


  .dy-hero__signature {
    display: flex;
    width: fit-content;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: clamp(22px, 2.8vh, 30px) 0 0;
    padding: 12px 20px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }


  .dy-hero__signature-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--cobalt);
  }


  .dy-hero__signature-arrow {
    color: var(--ink-soft);
  }

  /* =========================================================
     LOOK CLOSER (explore-preview cards)
     ========================================================= */
  .dy-explore {
    padding: clamp(28px, 4vh, 48px) 0 clamp(50px, 7.5vh, 84px);
  }

  /* A short, quiet hairline marking the chapter break between the
     featured story above and this secondary, browsable section — not
     a label, just enough of a pause for the eye. */
  .dy-explore__divider {
    display: block;
    width: 44px;
    height: 1px;
    margin: 0 auto clamp(28px, 4.4vh, 44px);
    background: var(--line);
  }


  .dy-explore__head {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }


  /* Deliberately a step down from the featured story's headline above
     — smaller and a touch lighter — so this reads as the secondary
     exploration section, not a second flagship moment. */
  .dy-explore__title {
    margin: 0 auto;
    white-space: nowrap;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(24px, 2.5vw, 33px);
    font-weight: 480;
    line-height: 1.08;
    letter-spacing: -0.038em;
  }


  .dy-explore__title-accent {
    color: var(--cobalt);
  }


  .dy-explore__sub {
    margin: clamp(10px, 1.4vh, 14px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(14.5px, 1.1vw, 16px);
    line-height: 1.5;
  }


  .dy-explore__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin: clamp(28px, 4vh, 44px) 0 0;
    padding: 0;
    list-style: none;
  }


  .dy-explore__card {
    min-width: 0;
  }


  .dy-explore__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--paper);
    text-decoration: none;
    overflow: hidden;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 240ms ease,
      border-color 240ms ease;
  }


  .dy-explore__link:hover {
    transform: translateY(-3px);
    border-color: rgba(232, 117, 36, 0.34);
    box-shadow: 0 16px 36px rgba(72, 56, 38, 0.09);
  }


  .dy-explore__art {
    display: block;
    aspect-ratio: 3 / 2;
    line-height: 0;
    background: var(--cream);
    overflow: hidden;
  }


  .dy-explore__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .dy-explore__label {
    margin: 18px 20px 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 16.5px;
    font-weight: 640;
    line-height: 1.24;
    letter-spacing: -0.005em;
  }


  /* Card 1's title carries an intentional two-line composition on
     desktop — recognition, then the curiosity gap. The break is only
     rendered once the grid has room for it (see the 981px breakpoint
     below); at narrower widths it's suppressed so the sentence just
     wraps naturally instead of forcing an awkward split. */
  .dy-explore__label-break {
    display: none;
  }
@media (min-width: 981px) {
    .dy-explore__label-break {
      display: block;
    }
  }


  /* The same quiet page-turn idiom used throughout the Explore stories
     (5G, the photo journey): serif text, ink, a small saffron circle
     carrying the arrow. Pinned to the bottom of the card via the flex
     column's own margin-top: auto, so it lines up across all four cards
     regardless of whether a label wraps to one line or two. */
  .dy-explore__see {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: auto 20px 14px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.006em;
  }


  .dy-explore__see span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    transition: transform 160ms ease;
  }


  .dy-explore__link:hover .dy-explore__see span {
    transform: translateX(2px);
  }


  .dy-explore__cta {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    margin: clamp(30px, 4.5vh, 44px) auto 0;
    padding: 12px 22px;
    border: 1.5px solid var(--cobalt);
    border-radius: 999px;
    color: var(--cobalt);
    font-size: 14.5px;
    font-weight: 640;
    text-decoration: none;
    transition: background 200ms ease, transform 200ms ease;
  }


  .dy-explore__cta:hover {
    background: rgba(36, 92, 255, 0.08);
    transform: translateY(-1px);
  }


  .dy-explore__cta:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }


  /* =========================================================
     SHARED — eyebrow label (used by LOOK CLOSER and JOIN)
     ========================================================= */
  .dy-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


  .dy-eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 5px rgba(232, 117, 36, 0.1);
  }


  /* =========================================================
     JOIN
     ========================================================= */
  .dy-join {
    padding: clamp(50px, 7.5vh, 84px) 0 clamp(70px, 10vh, 116px);
  }


  .dy-join__panel {
    position: relative;
    /* Narrower than the page grid so the copy + form read as one focused
       action rather than a full-width band — no boxed card chrome, so the
       section continues the same open, editorial feel as the ones above.
       Left-aligned (not centered) within the shell so its left edge sits
       on the same content spine as the Discovery card grid above and the
       footer below, rather than floating independently centered. */
    max-width: 1180px;
    margin-right: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(28px, 4vw, 64px);
  }


  .dy-join__copy h2 {
    margin: 0;
    max-width: 15ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(30px, 3.1vw, 42px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }


  .dy-join__desc {
    margin: 14px 0 0;
    max-width: 34ch;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.6;
  }


  .dy-form label {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 620;
    letter-spacing: 0.02em;
  }


  .dy-form__row {
    display: flex;
    gap: 9px;
  }


  .dy-form input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }


  .dy-form input::placeholder {
    color: var(--muted-light);
  }


  /* Focus is interface state, so it carries the brand colour —
     saffron stays reserved for discovery. */
  .dy-form input:focus {
    outline: none;
    border-color: var(--cobalt);
    box-shadow: 0 0 0 3px rgba(36, 92, 255, 0.16);
  }


  .dy-form button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 22px;
    border: 0;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 640;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
  }


  .dy-form button:hover:not(:disabled) {
    background: #000;
    transform: translateY(-1px);
  }


  .dy-form button:disabled {
    opacity: 0.62;
    cursor: progress;
  }


  .dy-form__status {
    margin: 0;
    max-height: 0;
    overflow: hidden;
    font-size: 13.5px;
    line-height: 1.45;
    transition: max-height 260ms ease, margin 260ms ease;
  }


  .dy-form__status[data-state] {
    margin-top: 12px;
    max-height: 5rem;
  }


  .dy-form__status[data-state='error'] {
    color: #c0442d;
  }


  .dy-form__status[data-state='success'] {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border-radius: 10px;
    background: rgba(31, 122, 77, 0.09);
    color: #17603b;
    font-weight: 560;
  }


  .dy-form__status[data-state='success']::before {
    content: '✓';
    display: grid;
    place-items: center;
    flex: none;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: #1f7a4d;
    color: #fff;
    font-size: 11px;
  }


  .dy-form__note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: 14px 0 0;
    color: var(--muted-light);
    font-size: 12.5px;
    line-height: 1.45;
  }


  .dy-form__note svg {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 1px;
    fill: none;
