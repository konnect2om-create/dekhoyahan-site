  }

  .dy-hero__zt.is-s6-still .dy-hero__zt-s6-ring--co,
  .dy-hero__zt.is-s6-still .dy-hero__zt-s6-ring--dmz,
  .dy-hero__zt.is-s6-still .dy-hero__zt-s6-name--co,
  .dy-hero__zt.is-s6-still .dy-hero__zt-s6-name--dmz {
    animation: dy-s6-hush 700ms ease both;
  }

  @keyframes dy-s6-hush-mid {
    from {
      opacity: 1;
      stroke-dashoffset: 0;
    }
    to {
      opacity: 0.32;
      stroke-dashoffset: 0;
    }
  }

  @keyframes dy-s6-hush {
