  /* =========================================================
     SCENE 6 — the pattern, and the name
     Nothing new is built here. What the visitor walked through is
     redrawn as the one shape it always had, and then set aside so the
     single request at the end of it can be seen on its own.
     ========================================================= */

  /* Scene 5's comparison does not vanish — it settles back into the
     paper, so the pattern is visibly drawn over the thing it came
     from rather than replacing it. */
  .dy-hero__zt.is-s6 .dy-hero__zt-s5 {
    opacity: 0;
    transition: opacity 900ms ease 120ms;
  }

  .dy-hero__zt.is-s6 .dy-hero__zt-idea {
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
