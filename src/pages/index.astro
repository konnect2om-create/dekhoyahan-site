<script>
  const form = document.querySelector('#join-form');
  const emailInput = document.querySelector('#join-email');
  const status = document.querySelector('#join-status');

  // Arriving via "Join early" should leave the cursor ready in the field,
  // whether that is a same-page jump or a landing from another page.
  const focusJoin = () => {
    if (location.hash !== '#early-access' || !(emailInput instanceof HTMLInputElement)) return;
    // Wait for the smooth scroll to settle before taking focus, so the
    // browser does not jump the viewport a second time.
    setTimeout(() => emailInput.focus({ preventScroll: true }), 600);
  };

  window.addEventListener('hashchange', focusJoin);
  focusJoin();

  if (
    form instanceof HTMLFormElement &&
    emailInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonText = form.querySelector('.dy-form__label');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      status.textContent = '';
      status.dataset.state = '';

      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please check your email address.';
        status.dataset.state = 'error';
        emailInput.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (buttonText instanceof HTMLElement) buttonText.textContent = 'Joining…';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data?.message || 'Something went wrong. Please try again.');
        }

        status.textContent = data.message || 'Done. We will email you when the next topic is ready.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (buttonText instanceof HTMLElement) buttonText.textContent = 'Join';
      }
    });
  }
</script>

<script>
  // Zero Trust feature. The whole transition is CSS; this only flips
  // the state, hands the invitation slot over from one control to the
  // next, and keeps the keyboard path intact.
  const ztFeature = document.querySelector('.dy-hero__zt');

  if (ztFeature instanceof HTMLElement) {
    // The Feature exactly as it looks before anyone has touched it.
    // Replay restores this rather than trying to undo six scenes of
    // state one property at a time: every hidden attribute, every
    // animation, the original title and the collapsed rows all come
    // back because the nodes themselves are new.
    const pristine = ztFeature.innerHTML;
    const states = [
      'is-s2',
      'is-s3',
      'is-s4',
      'is-s5',
      'is-s6',
      'is-s6-quiet',
      'is-s6-still',
    ];

    // Every deferred step is tracked, so a replay can cancel whatever
    // the finished run still had pending.
    let timers = [];
    const later = (fn, ms) => timers.push(window.setTimeout(fn, ms));

    // Reachability follows the scene rather than a timetable. A
    // continuation row is inert — untabbable, unreadable to assistive
    // technology and unclickable — until it has actually opened, and
    // becomes inert again the moment it closes. Watching the rendered
    // height rather than the clock means this holds however the row got
    // its size: animated open, or opened instantly under reduced motion.
    let rowGuard = null;
    const guardRows = () => {
      if (rowGuard) rowGuard.disconnect();
      if (typeof ResizeObserver !== 'function') return;
      rowGuard = new ResizeObserver((entries) => {
        for (const entry of entries) {
          entry.target.inert = entry.target.getBoundingClientRect().height <= 1;
        }
      });
      for (const row of ztFeature.querySelectorAll('.dy-hero__zt-tail')) {
        row.inert = true;
        rowGuard.observe(row);
      }
    };

    // Each scene works the same way: put its markup in the document,
    // then — on the next frame, so the collapsed rows have a height to
    // animate from — flip the state class that runs the CSS timeline,
    // and retire the control that got the visitor here so it does not
    // linger in the tab order.
    const openScene = (button, state, reveal, retire, retireAfter = 320) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener(
        'click',
        () => {
          for (const part of reveal) {
            if (part instanceof HTMLElement) part.hidden = false;
          }

          requestAnimationFrame(() =>
            requestAnimationFrame(() => ztFeature.classList.add(state))
          );

          later(() => {
            button.hidden = true;
          }, 320);

          // The outgoing realisation leaves the flow only once it has
          // faded, so the canvas never jumps between the two.
          later(() => {
            for (const part of retire) {
              if (part instanceof HTMLElement) part.hidden = true;
            }
          }, retireAfter);
        },
        { once: true }
      );
    };

    const wire = () => {
      const q = (selector) => ztFeature.querySelector(selector);
      const tails = ztFeature.querySelectorAll('.dy-hero__zt-tail');
      const idea = q('[data-zt-idea]');

      openScene(q('[data-zt-open]'), 'is-s2', [q('.dy-hero__zt-s2'), ...tails], []);
      openScene(
        q('[data-zt-deeper]'),
        'is-s3',
        [q('.dy-hero__zt-s3'), q('.dy-hero__zt-s3-copy')],
        [q('.dy-hero__zt-s2-copy')]
      );
      // Scene 4's writing waits for the three outside examples to
      // arrive, so Scene 3's realisation holds the slot until then.
      openScene(
        q('[data-zt-onward]'),
        'is-s4',
        [q('.dy-hero__zt-s4'), q('.dy-hero__zt-s4-copy')],
        [q('.dy-hero__zt-s3-copy')],
        3850
      );
      // Scene 5 holds the previous realisation right through the
      // comparison, so the canvas is never blank while the two
      // requests are being drawn and answered.
      openScene(
        q('[data-zt-find]'),
        'is-s5',
        [q('.dy-hero__zt-s5'), q('.dy-hero__zt-s5-copy')],
        [q('.dy-hero__zt-s4-copy')],
        10800
      );
      openScene(
        idea,
        'is-s6',
        [q('.dy-hero__zt-s6'), q('.dy-hero__zt-s6-copy--b')],
        [q('.dy-hero__zt-s5-copy')],
        12600
      );

      // The two moments where the boundaries stop being the subject.
      // They are state rather than entrances, so they ride on the same
      // click instead of on a timeline of their own.
      if (idea instanceof HTMLButtonElement) {
        idea.addEventListener(
          'click',
          () => {
            later(() => ztFeature.classList.add('is-s6-quiet'), 4200);
            later(() => ztFeature.classList.add('is-s6-still'), 15000);
          },
          { once: true }
        );
      }

      guardRows();

      const again = q('[data-zt-again]');

      if (again instanceof HTMLButtonElement) {
        again.addEventListener(
          'click',
          () => {
            for (const id of timers) window.clearTimeout(id);
            timers = [];
            ztFeature.classList.remove(...states);
            ztFeature.innerHTML = pristine;
            wire();

            // The control that now stands where this one did takes the
            // focus, so a keyboard visitor carries straight on instead
            // of being dropped at the top of the document. Scrolling is
            // suppressed: nothing has moved, so nothing should jump.
            const open = ztFeature.querySelector('[data-zt-open]');
            if (open instanceof HTMLElement) open.focus({ preventScroll: true });
          },
          { once: true }
        );
      }
    };

    wire();
  }
</script>

<script>
  // Analytics: fires `hero_view` through Cloudflare Zaraz once the hero
  // section has been at least 50% visible in the viewport for a
  // continuous second. Isolated from the hero's own visual/interaction
  // script above — this only observes visibility and never touches the
  // hero's markup, layout, or behavior.
  const heroSection = document.querySelector('.dy-hero');

  if (heroSection instanceof HTMLElement) {
    let visibleTimer = null;
    let fired = false;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (visibleTimer === null) {
            visibleTimer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('hero_view');
              observer.disconnect();
            }, 1000);
          }
        } else if (visibleTimer !== null) {
          clearTimeout(visibleTimer);
          visibleTimer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(heroSection);
  }
</script>

<style>
