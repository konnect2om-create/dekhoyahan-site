---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import laptop1 from '../assets/laptop1.png';
import { featuredStories } from '../data/stories';
---

<BaseLayout>
  <!-- ============================================================
       HERO — the brand statement, plus the feature stage beside it
       ============================================================ -->
  <section class="dy-hero">
    <div class="shell dy-hero__grid">
      <div class="dy-hero__brand">
        <h1 class="dy-hero__title">
          Understand the world
          <span>that's <em>arriving.</em></span>
        </h1>

        <p class="dy-hero__intro">
          See how technology works —<br />
          and understand why it matters.
        </p>

        <p class="dy-hero__subintro">
          <span>You don't need a technical background.<br />Just curiosity.</span>
        </p>

        <div class="dy-hero__signature">
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 3.5a5.5 5.5 0 0 1 3 10.1c-.6.4-1 1.1-1 1.9v.5H10v-.5c0-.8-.4-1.5-1-1.9A5.5 5.5 0 0 1 12 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M10 18.5h4M10.6 20.5h2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span>Understand it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See differently.</span>
        </div>

        <!-- Quiet editorial CTA, not the old black "See how" button — the
             hero's own story action now lives beside the featured story
             on the right (see .dy-hero__feature-row below). This one just
             takes the visitor to the Explore library; it never starts the
             hero sequence and fires no hero_start analytics. -->
        <a class="dy-hero__explore-cta" href="/explore/">
          Explore
          <span class="dy-hero__explore-cta__arrow" aria-hidden="true">→</span>
        </a>
      </div>


      <div class="dy-hero__feature">
        <!-- The featured curiosity hook for the AI-agent story, sitting
             directly above the laptop it introduces. "See how" is the
             exact same control (same id, same data-mode/data-state
             toggling) that used to live in the brand column on the
             left — moved here, restyled as a quiet label + small saffron
             circular arrow rather than a black pill, but wired to the
             identical click handler and analytics further down this
             script/file. Nothing about the hero sequence itself, its
             stages, or hero_start/hero_complete changed — only where this
             control visually sits. -->
        <div class="dy-hero__feature-intro">
          <p class="dy-eyebrow"><span></span> LOOK CLOSER</p>
          <p class="dy-hero__feature-hook">
            You gave it one instruction.<br />
            Why did it keep going?
          </p>
          <div class="dy-hero__feature-row">
            <span class="dy-hero__feature-label">AI agents</span>
            <button type="button" class="dy-hero__cta" id="dy-hero-see-how" data-mode="see-how">
              <span class="dy-hero__cta__label dy-hero__cta__label--see-how">See how</span>
              <span class="dy-hero__cta__label dy-hero__cta__label--replay">Replay</span>
              <span class="dy-hero__cta__icon dy-hero__cta__icon--arrow" aria-hidden="true">→</span>
              <span class="dy-hero__cta__icon dy-hero__cta__icon--replay" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" width="15" height="15" focusable="false">
                  <path
                    d="M3 12a9 9 0 0 1 15.5-6.3M21 12a9 9 0 0 1-15.5 6.3"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                  <path
                    d="M18.5 3v4.5H14M5.5 21v-4.5H10"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </button>
          </div>
        </div>

        <div class="dy-hero__visual" id="dy-hero-visual" data-stage="photo">
        <!-- The photographed laptop + its screen overlay, grouped so the
             pair can fade out together as one layer once the visitor
             clicks "See how" — see .dy-hero__explain-stage below, and the
             data-stage toggle in the script. Nothing about this layer's
             own animation changes; it simply becomes hidden underneath
             the explanation stage once that stage is active. -->
        <div class="dy-hero__photo-layer">
          <Image
            src={laptop1}
            alt=""
            widths={[640, 900, 1200, 1536]}
            sizes="(min-width: 1320px) 640px, 100vw"
            format="webp"
            quality={86}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />

          <div class="dy-hero__screen">
            <div class="dy-hero__screen-plane">
              <div class="dy-hero__screen-layout">
                <p class="dy-hero__goal" data-goal="0"><span data-goal-typed>Plan my trip to Tokyo next month.</span><span class="dy-hero__goal-cursor" data-goal-cursor aria-hidden="true"></span></p>
                <div class="dy-hero__goal-rule" aria-hidden="true"></div>
                <p class="dy-hero__activity" data-activity="0" data-activity-state="working" data-activity-done="Flight found"><span data-activity-text>Finding a flight…</span><span class="dy-hero__activity-check" data-activity-check aria-hidden="true">✓</span></p>
                <p class="dy-hero__activity" data-activity="0" data-activity-state="working" data-activity-done="Hotel available"><span data-activity-text>Checking places to stay…</span><span class="dy-hero__activity-check" data-activity-check aria-hidden="true">✓</span></p>
                <p class="dy-hero__activity" data-activity="0" data-activity-state="working" data-activity-done="Dates work"><span data-activity-text>Checking your calendar…</span><span class="dy-hero__activity-check" data-activity-check aria-hidden="true">✓</span></p>
                <div class="dy-hero__boundary" data-boundary="0">
                  <p class="dy-hero__boundary-title" data-boundary-title>Waiting for you.</p>
                  <p class="dy-hero__boundary-sub">Payment approval required.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- The first familiar-analogy state: headline + quote anchored
             upper-left, caption anchored lower-left, the travel-agent
             object placed mid/right (all at once — no per-element
             animation yet, only the stage swap itself is animated, see
             the fade above). The area beneath the agent stays open on
             purpose for the Flights/Hotels/Schedule branches a later
             step adds. Occupies the same box as the photo layer
             (absolute, inset: 0) so the surrounding grid never reflows
             on click. -->
        <div class="dy-hero__explain-stage">
          <div class="dy-hero__explain-inner">
            <div class="dy-hero__explain-top">
              <p class="dy-hero__explain-title" data-reveal>This way of working isn't entirely new.</p>

              <!-- Goal, handoff and recipient share one row so the rule
                   always runs along the goal's own optical centre, and
                   the whitespace between them is whatever is actually
                   left over at that width rather than a fixed guess. -->
              <div class="dy-hero__handoff-row">
                <p class="dy-hero__explain-quote" data-reveal>&ldquo;Plan my trip to Tokyo next month.&rdquo;</p>

                <!-- Its own element rather than part of the agent, so the
                     agent can later become software without this
                     connector being rebuilt — and because the line
                     flexes, that change won't move the goal either.
                     Not animated yet. -->
                <div class="dy-hero__handoff" aria-hidden="true">
                  <span class="dy-hero__handoff-line" data-draw="x"></span>
                  <svg class="dy-hero__handoff-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal>
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>

                <!-- Typographic for now — no pill, button, or card around
                     it. Kept as its own component for the later
                     transformation into software. -->
                <div class="dy-hero__agent" data-agent-state="travel-agent">
                  <p class="dy-hero__agent-label" data-reveal><span class="dy-hero__agent-name dy-hero__agent-name--current">Travel agent</span><span class="dy-hero__agent-name dy-hero__agent-name--next" aria-hidden="true">Software</span></p>
                  <!-- Drops from the label's own centre, and is absolutely
                       positioned so adding it leaves the row's layout
                       untouched. Its height and the branch's top margin
                       share one custom property, so the stem always ends
                       exactly on the rail below. -->
                  <span class="dy-hero__agent-stem" aria-hidden="true" data-draw="y"></span>
                </div>
              </div>

              <!-- What the agent handles: one rail beneath TRAVEL AGENT
                   dividing into three destinations. Explanatory objects,
                   not controls — no boxes, pills or backgrounds. Static
                   for now. -->
              <div class="dy-hero__branch">
                <span class="dy-hero__branch-rail" aria-hidden="true" data-draw="x"></span>

                <div class="dy-hero__branch-item">
                  <span class="dy-hero__branch-drop" aria-hidden="true" data-draw="y"></span>
                  <svg class="dy-hero__branch-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" data-reveal>
                    <path d="M10.5 3a1.5 1.5 0 0 1 3 0v6l7.5 4.5v2L13.5 13v4.6l2.5 1.9V21L12 20l-4 1v-1.5l2.5-1.9V13L3 15.5v-2L10.5 9V3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
                  </svg>
                  <p class="dy-hero__branch-label" data-reveal>Flights</p>
                </div>

                <div class="dy-hero__branch-item">
                  <span class="dy-hero__branch-drop" aria-hidden="true" data-draw="y"></span>
                  <svg class="dy-hero__branch-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" data-reveal>
                    <path d="M6 20.5V4.5h12v16" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    <path d="M3.5 20.5h17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    <path d="M10.2 20.5v-4h3.6v4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    <path d="M9.6 8.4h.01M14.4 8.4h.01M9.6 12.4h.01M14.4 12.4h.01" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                  </svg>
                  <p class="dy-hero__branch-label" data-reveal>Hotels</p>
                </div>

                <div class="dy-hero__branch-item">
                  <span class="dy-hero__branch-drop" aria-hidden="true" data-draw="y"></span>
                  <svg class="dy-hero__branch-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" data-reveal>
                    <rect x="3.5" y="5.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.4" />
                    <path d="M3.5 10h17" stroke="currentColor" stroke-width="1.4" />
                    <path d="M8 3.2v4M16 3.2v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                  <p class="dy-hero__branch-label" data-reveal>Schedule</p>
                </div>

              </div>
            </div>
            <!-- The realization + its continuation, as one small unit in
                 the lower-left — not the branch. Wrapped together (rather
                 than left as two direct children of .dy-hero__explain-
                 inner) so the space-between above only opens a gap
                 between the goal/diagram and this whole unit, not between
                 the takeaway and its own continuation. The saffron rule
                 beside the text is the site's recurring "notice this"
                 marker (now used in both states, not just the SOFTWARE
                 one); "See what changed" then sits directly beneath in
                 the same unit, plain sans-serif + the small saffron
                 circular arrow the Explore cards use — "discover the next
                 change." Two different marks, two different jobs.
                 Left-aligned, not centred under the diagram, and not
                 another pill CTA. -->
            <div class="dy-hero__realize">
              <p class="dy-hero__explain-caption"><span class="dy-hero__explain-caption-current"><span class="dy-hero__realize-mark" data-reveal aria-hidden="true"></span><span class="dy-hero__realize-lines"><span class="dy-hero__realize-line" data-reveal>You gave someone the goal.</span><span class="dy-hero__realize-line" data-reveal>They handled the steps.</span></span></span><span class="dy-hero__explain-caption-next" aria-hidden="true"><span class="dy-hero__realize-mark" aria-hidden="true"></span><span class="dy-hero__realize-lines"><span class="dy-hero__realize-line dy-hero__realize-line--one">The goal stayed the same.</span><span class="dy-hero__realize-line dy-hero__realize-line--two">What changed is <span class="dy-hero__realize-accent">who &mdash; or what</span> does the work.</span></span></span></p>

              <!-- Two states, one control, swapped by the script below.
                   First state: "See what changed", plain dark sans-serif +
                   the small saffron circle — the same interaction language
                   as the Explore cards' "See what's really happening →".
                   Second state, once SOFTWARE is showing: the realization's
                   own continuation. Normal flow (not anchored to the
                   branch), so it stacks directly under the takeaway. It
                   retires only once Scene 2 itself is showing. -->
              <button type="button" class="dy-hero__look-again" id="dy-explain-more" data-reveal>
                <span class="dy-hero__look-again-changed">
                  <span class="dy-hero__look-again-label">See what changed</span>
                  <span class="dy-hero__look-again-circle" aria-hidden="true">&rarr;</span>
                </span>
                <span class="dy-hero__look-again-invite" aria-hidden="true">
                  <span class="dy-hero__look-again-invite-lead">But software has always helped us.</span>
                  <span class="dy-hero__look-again-invite-cue">
                    <span class="dy-hero__look-again-invite-cue-text">So what&rsquo;s different?</span>
                    <span class="dy-hero__look-again-circle" aria-hidden="true">&rarr;</span>
                  </span>
                </span>
              </button>
            </div>
          </div>

          <!-- Scene 2 — the already-built "Software used to wait for you"
               moment, reused exactly (title, loop, caption) with one
               change scoped to this step: the old closing line ("Now,
               something is changing.") is replaced by the next narrative
               continuation, inert for now — its click behaviour isn't
               implemented yet. A second absolute layer in this same
               stage box (like .dy-hero__photo-layer / .dy-hero__explain-
               stage above it), so revealing it is a restrained crossfade
               against .dy-hero__explain-inner: the SOFTWARE scene and its
               realization fade out, this fades in, same stage dimensions
               throughout. Hidden until the script sets data-scene="2" on
               the stage, on the second click of the button above. -->
          <div class="dy-hero__scene2">
            <div class="dy-shift__inner">
              <h2 class="dy-shift__title">Software used to wait for you.</h2>

              <!-- The main experience: a progressive, animated handoff
                   rather than five labels shown at once. Each actor and
                   connector starts hidden/undrawn and is revealed in turn
                   by runScene2Sequence() below, reusing the exact
                   [data-reveal]/[data-draw] devices already used for the
                   goal->agent connector and the branch above — same
                   vocabulary, no new animation primitives. The two
                   saffron .dy-shift__flow-wait dots are the only new
                   element: a restrained "waiting for you" cue shown only
                   for the pause after each SOFTWARE turn, then removed. -->
              <div class="dy-shift__flow" aria-label="You, then software, then you, then software, then you">
                <div class="dy-shift__flow-actor dy-shift__flow-actor--you" data-reveal>You</div>
                <div class="dy-shift__flow-connector" aria-hidden="true">
                  <span class="dy-shift__flow-connector-line" data-draw="x"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal>
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-shift__flow-actor dy-shift__flow-actor--software" data-reveal>
                  Software
                  <span class="dy-shift__flow-wait" aria-hidden="true"></span>
                </div>
                <div class="dy-shift__flow-connector" aria-hidden="true">
                  <span class="dy-shift__flow-connector-line" data-draw="x"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal>
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-shift__flow-actor dy-shift__flow-actor--you" data-reveal>You</div>
                <div class="dy-shift__flow-connector" aria-hidden="true">
                  <span class="dy-shift__flow-connector-line" data-draw="x"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal>
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-shift__flow-actor dy-shift__flow-actor--software" data-reveal>
                  Software
                  <span class="dy-shift__flow-wait" aria-hidden="true"></span>
                </div>
                <div class="dy-shift__flow-connector" aria-hidden="true">
                  <span class="dy-shift__flow-connector-line" data-draw="x"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal>
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-shift__flow-actor dy-shift__flow-actor--you" data-reveal>You</div>
              </div>

              <!-- The takeaway from watching the sequence, using the same
                   short saffron marker as the SOFTWARE-state realization
                   in the scene before this one — one grammar for "this is
                   what to notice" throughout the stage. Held back until
                   the whole flow above has finished. -->
              <p class="dy-shift__caption" data-reveal>
                <span class="dy-hero__realize-mark" aria-hidden="true"></span>
                <span>You chose each next step.</span>
              </p>

              <!-- Scene 2's continuation into Scene 3 — same dark
                   sans-serif label + saffron circular arrow grammar as
                   "See what changed" earlier in this stage. Held back
                   until the caption above has landed, then clickable
                   right away. -->
              <button type="button" class="dy-hero__scene2-next" id="dy-scene2-next" data-reveal>
                <span class="dy-hero__scene2-next-label">What if software could keep going?</span>
                <span class="dy-hero__scene2-next-circle" aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </div>

          <!-- Scene 3 — the resolution of the whole hero: the sequence
               the visitor just learned turning into an agent. A third
               absolute layer in this stage, but deliberately NOT a
               crossfade into unrelated content: it opens holding the
               exact same YOU → SOFTWARE → YOU → SOFTWARE → YOU row
               Scene 2 ends on (same .dy-shift__flow classes, same sizes,
               already revealed via data-reveal="in"/data-drawn="1"), so
               the handover reads as the diagram the visitor is already
               looking at, not a new picture.

               Everything that only existed because software kept handing
               the work back — the intermediate YOU, the second SOFTWARE
               and the connectors between them — is marked
               data-agent-transient and collapses away
               (.dy-agent__cell / .dy-agent__link below), while the
               agent's own working surface, the link onward and the goal
               are marked data-shut and open in their place. Nothing here
               fades the stage out and fades a diagram back in.

               The agent itself is HTML/CSS only, in this site's own
               language: a small softly-rounded working surface, warm and
               semi-transparent against the stage canvas rather than a
               pasted white card, graphite hairline structure, cobalt for
               the work in progress, and saffron used exactly once — on
               the one step that didn't go to plan. -->
          <div class="dy-hero__scene3">
            <div class="dy-shift__inner">
              <!-- One slot, two occupants stacked on top of each other:
                   the diagram, and — once the whole run and its
                   explanation have landed — the familiar laptop returning
                   for a decision. Grid-stacked rather than sequential so
                   the handover is a crossfade in place at a fixed height,
                   which is what keeps the three closing lines beneath it
                   from moving at all. -->
              <div class="dy-agent__slot">
              <div class="dy-shift__flow dy-agent__row" aria-label="You, then an agent working toward the goal">
                <!-- Persists: the person, and the one handoff they make. -->
                <div class="dy-shift__flow-actor dy-shift__flow-actor--you" data-reveal="in">You</div>
                <div class="dy-shift__flow-connector dy-agent__link" aria-hidden="true">
                  <span class="dy-shift__flow-connector-line" data-draw="x" data-drawn="1"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal="in">
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>

                <!-- The first SOFTWARE retires as the agent's own working
                     surface opens in the same slot — two adjacent cells,
                     one closing while the other opens, so the row never
                     jumps. -->
                <div class="dy-agent__cell" data-agent-transient data-agent-word>
                  <div class="dy-shift__flow-actor dy-shift__flow-actor--software" data-reveal="in">Software</div>
                </div>
                <div class="dy-agent__cell" data-agent-core data-shut>
                  <!-- The agent itself: a round working object rather than
                       a panel of text. The three symbols are the ones this
                       page already established for what a trip is made of
                       (the Flights / Hotels / Schedule icons from the
                       travel-agent scene, same paths, same stroke), and
                       the story is told by the route between them — a
                       cobalt line that enters from YOU, lights each symbol
                       as it reaches it, then meets the one thing that
                       doesn't work out and visibly turns back on itself to
                       reach a second flight before leaving toward GOAL.
                       That change of direction is the whole point of the
                       object, so nothing else in here competes with it:
                       no labels, no rows, no ticks except on the flight
                       that finally worked. -->
                  <div class="dy-agent__core" role="img" aria-label="An agent working toward the goal: it takes the flight, then the hotel, then the dates — finds the flight is unavailable, changes course to a second flight, and carries on toward the goal.">
                    <svg class="dy-agent__orbit" viewBox="0 0 132 132" fill="none" focusable="false" aria-hidden="true">
                      <!-- Alive rather than animated-at: one faint ring
                           breathing slowly around the working surface. -->
                      <circle class="dy-agent__orbit-halo" cx="66" cy="66" r="60" />
                      <circle class="dy-agent__orbit-face" cx="66" cy="66" r="60" />

                      <!-- The route, drawn one segment at a time. The
                           fourth is the reroute: it runs back the way the
                           signal came rather than onward, which is what
                           makes the change of course readable without a
                           word of explanation. -->
                      <path class="dy-agent__route" d="M6 66C10 60 16 55 23 52" pathLength="1" />
                      <path class="dy-agent__route" d="M45 43C48 40 50 38 53 35" pathLength="1" />
                      <path class="dy-agent__route" d="M73 33C78 35 83 38 88 41" pathLength="1" />
                      <path class="dy-agent__route dy-agent__route--reroute" d="M90 57C81 70 71 79 61 85" pathLength="1" />
                      <path class="dy-agent__route" d="M65 94C88 98 112 88 126 66" pathLength="1" />

                      <g class="dy-agent__node dy-agent__node--flight">
                        <circle class="dy-agent__node-ring" cx="36" cy="52" r="13" />
                        <svg class="dy-agent__node-glyph" x="28.5" y="44.5" width="15" height="15" viewBox="0 0 24 24" fill="none">
                          <path d="M10.5 3a1.5 1.5 0 0 1 3 0v6l7.5 4.5v2L13.5 13v4.6l2.5 1.9V21L12 20l-4 1v-1.5l2.5-1.9V13L3 15.5v-2L10.5 9V3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" />
                        </svg>
                      </g>

                      <g class="dy-agent__node dy-agent__node--hotel">
                        <circle class="dy-agent__node-ring" cx="62" cy="26" r="13" />
                        <svg class="dy-agent__node-glyph" x="54.5" y="18.5" width="15" height="15" viewBox="0 0 24 24" fill="none">
                          <path d="M6 20.5V4.5h12v16" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                          <path d="M3.5 20.5h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                          <path d="M10.2 20.5v-4h3.6v4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                          <path d="M9.6 8.4h.01M14.4 8.4h.01M9.6 12.4h.01M14.4 12.4h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                        </svg>
                      </g>

                      <g class="dy-agent__node dy-agent__node--calendar">
                        <circle class="dy-agent__node-ring" cx="99" cy="48" r="13" />
                        <svg class="dy-agent__node-glyph" x="91.5" y="40.5" width="15" height="15" viewBox="0 0 24 24" fill="none">
                          <rect x="3.5" y="5.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.8" />
                          <path d="M3.5 10h17" stroke="currentColor" stroke-width="1.8" />
                          <path d="M8 3.2v4M16 3.2v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                      </g>

                      <!-- The flight it settled on. The one tick in the
                           object, because it is the only step that was
                           reached by working around something. -->
                      <g class="dy-agent__node dy-agent__node--flight-alt">
                        <circle class="dy-agent__node-ring" cx="52" cy="94" r="13" />
                        <svg class="dy-agent__node-glyph" x="44.5" y="86.5" width="15" height="15" viewBox="0 0 24 24" fill="none">
                          <path d="M10.5 3a1.5 1.5 0 0 1 3 0v6l7.5 4.5v2L13.5 13v4.6l2.5 1.9V21L12 20l-4 1v-1.5l2.5-1.9V13L3 15.5v-2L10.5 9V3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" />
                        </svg>
                        <circle class="dy-agent__node-check-bg" cx="41.4" cy="84.2" r="5.6" />
                        <path class="dy-agent__node-check" d="M38.7 84.3 40.8 86.4l4.2-4.7" />
                      </g>
                    </svg>
                  </div>
                </div>

                <!-- Everything that only existed because software came
                     back to the person after every step. -->
                <div class="dy-shift__flow-connector dy-agent__link" aria-hidden="true" data-agent-transient>
                  <span class="dy-shift__flow-connector-line" data-draw="x" data-drawn="1"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal="in">
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-agent__cell" data-agent-transient>
                  <div class="dy-shift__flow-actor dy-shift__flow-actor--you" data-reveal="in">You</div>
                </div>
                <div class="dy-shift__flow-connector dy-agent__link" aria-hidden="true" data-agent-transient>
                  <span class="dy-shift__flow-connector-line" data-draw="x" data-drawn="1"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal="in">
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-agent__cell" data-agent-transient>
                  <div class="dy-shift__flow-actor dy-shift__flow-actor--software" data-reveal="in">Software</div>
                </div>
                <div class="dy-shift__flow-connector dy-agent__link" aria-hidden="true" data-agent-transient>
                  <span class="dy-shift__flow-connector-line" data-draw="x" data-drawn="1"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal="in">
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-agent__cell" data-agent-transient>
                  <div class="dy-shift__flow-actor dy-shift__flow-actor--you" data-reveal="in">You</div>
                </div>

                <!-- Where the work was actually going all along. Opens
                     only once the agent's own run has finished, so the
                     row resolves as YOU → [agent working] → GOAL. The
                     goal line is the same Tokyo sentence, in the same
                     .dy-hero__explain-quote treatment it already carries
                     everywhere else in this stage — real typography, not
                     an image. -->
                <div class="dy-shift__flow-connector dy-agent__link" aria-hidden="true" data-agent-out data-shut>
                  <span class="dy-shift__flow-connector-line" data-draw="x"></span>
                  <svg class="dy-shift__flow-connector-head" viewBox="0 0 8 12" fill="none" focusable="false" data-reveal>
                    <path d="M1.4 1.4 6 6l-4.6 4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="dy-agent__cell" data-agent-goal data-shut>
                  <div class="dy-agent__goal">
                    <p class="dy-agent__goal-label">Goal</p>
                    <p class="dy-hero__explain-quote dy-agent__goal-text">&ldquo;Plan my trip to Tokyo next month.&rdquo;</p>
                  </div>
                </div>
              </div>

              <!-- The same laptop the visitor met at the top of the page,
                   returning to this stage once the agent's run and its
                   explanation have both landed. Same photograph, same
                   .dy-hero__screen geometry and the same permission
                   boundary treatment (warm amber line, quiet second line,
                   the existing fade-and-rise entrance) — nothing new is
                   introduced here, which is the point: the visitor should
                   recognise it rather than read it. The screen carries
                   only the approval state; no goal line, no completed
                   steps, nothing else. Its own container-type is what
                   lets the screen's cqw type scale against this smaller
                   laptop instead of the whole stage. -->
              <div class="dy-agent__laptop" data-agent-laptop>
                <Image
                  src={laptop1}
                  alt=""
                  widths={[300, 450, 600]}
                  sizes="(min-width: 1320px) 296px, 46vw"
                  format="webp"
                  quality={86}
                  loading="lazy"
                  decoding="async"
                />
                <div class="dy-hero__screen">
                  <div class="dy-hero__screen-plane">
                    <div class="dy-hero__screen-layout">
                      <div class="dy-hero__boundary" data-boundary="0" data-agent-boundary>
                        <p class="dy-hero__boundary-title" data-agent-boundary-title>Waiting for your approval</p>
                        <p class="dy-hero__boundary-sub">Review and confirm payment.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              </div>

              <!-- The explanation is held back until the visitor has
                   already watched the thing it describes. Two wrappers
                   rather than one so the composition makes room for each
                   beat in turn (grid-template-rows 0fr → 1fr) instead of
                   reserving empty space beneath the diagram from the
                   start. -->
              <div class="dy-agent__reveal" data-agent-realize data-shut>
                <div class="dy-agent__reveal-inner">
                  <p class="dy-agent__realize" data-reveal>
                    <span class="dy-hero__realize-mark" aria-hidden="true"></span>
                    <span>You gave it the goal.<br />It figured out what to do next.</span>
                  </p>
                </div>
              </div>

              <!-- The payoff of the whole hero journey — the visitor has
                   understood what it does before being told its name.
                   Serif, with the term itself in cobalt: the same
                   editorial grammar the rest of the site already uses for
                   its emphasis, not a new component. Nothing follows
                   this: no further question, no further state. -->
              <div class="dy-agent__reveal" data-agent-payoff data-shut>
                <div class="dy-agent__reveal-inner">
                  <p class="dy-agent__name" data-reveal>What you just watched? That&rsquo;s an <em>AI agent</em>.</p>
                  <p class="dy-agent__support" data-reveal>Software that can work toward a goal without waiting for every next instruction.</p>
                </div>
              </div>

              <!-- The laptop is no longer something that simply arrives:
                   it waits to be asked for. Same dark-label + saffron
                   circular arrow grammar as "See what changed" and "What
                   if software could keep going?" earlier in this stage —
                   the established way this hero hands the next step back
                   to the visitor — and it opens its own room the same way
                   the two beats above it do. -->
              <div class="dy-agent__reveal" data-agent-ask data-shut>
                <div class="dy-agent__reveal-inner">
                  <button type="button" class="dy-agent__ask" id="dy-agent-next" data-reveal>
                    <span class="dy-agent__ask-label">So when does it need you?</span>
                    <span class="dy-agent__ask-circle" aria-hidden="true">&rarr;</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <script>
    // The whole right-hand experience — the idle laptop preview, the
    // travel-agent/software explanation, both scene transformations and
    // the laptop's return at the end — lives inside #dy-hero-visual and
    // is wired up by initHeroVisual() below. A pristine copy of its
    // markup is taken here, before anything runs or mutates it, so the
    // now-subdued "See how" control (see its own listener at the bottom
    // of this script) can later restore that exact starting markup and
    // call initHeroVisual() again — a real restart, not a page reload,
    // and not a hand-written reset of every data-attribute this file
    // has accumulated across the whole journey.
    const heroVisual = document.getElementById('dy-hero-visual');
    const heroVisualPristineHTML = heroVisual instanceof HTMLElement ? heroVisual.innerHTML : null;
    let currentRunExplainSequence = null;
    // Scene 3's own resize listener (see runAgentScene below) would
    // otherwise accumulate one extra, stale copy of itself — pointing at
    // detached elements from the previous run — every time the
    // experience is restarted; this tracks the current one so it can be
    // removed before the next is added.
    let cellsResizeHandler = null;
    // Tracks "has this control been used at all yet" independently of
    // its own data-state — that attribute now also gets removed once
    // the final AI-agent beat reveals itself (see revealSeeHow() further
    // down), specifically so the button returns to full visibility
    // there, which would otherwise be indistinguishable from its
    // original, pre-first-click state.
    let heroActivated = false;

    function initHeroVisual() {
    // Types the laptop screen's goal line in on page load: a short pause,
    // then the sentence fills in left to right at a restrained, slightly
    // uneven pace (real typing isn't metronomic), a caret sitting right
    // after the last character throughout. Once complete the caret blinks
    // briefly, like an idling cursor, then stops for good — and after one
    // more brief pause, the first activity line fades/slides in beneath
    // it, as though the software has picked up the request.
    //
    // Each activity line then follows the same shape: fade/slide in, stay
    // up long enough to actually read, resolve in place — the same line,
    // not a new one — from its working label to its `data-activity-done`
    // text via a brief quiet dip, not a celebration. The next line (if
    // any) only starts its own entrance once the one before it has
    // finished resolving, so they always read top to bottom in order.
    //
    // Once every activity has resolved, a longer pause than any of those
    // (this is a different kind of moment, not another line of progress)
    // is followed by the permission boundary: both of its lines fade/
    // slide in together, then the amber line gets two brief, one-shot
    // attention pulses — the second visibly quieter than the first —
    // and then nothing further animates, ever, on this page load.
    document.querySelectorAll('[data-goal]').forEach((goal) => {
      const typed = goal.querySelector('[data-goal-typed]');
      if (!(typed instanceof HTMLElement)) return;
      const layout = goal.closest('.dy-hero__screen-layout');
      const activities = layout instanceof HTMLElement
        ? [...layout.querySelectorAll('[data-activity]')].filter((el) => el instanceof HTMLElement)
        : [];
      const boundary = layout instanceof HTMLElement ? layout.querySelector('[data-boundary]') : null;

      const BETWEEN_DELAY = 550; // same brief pause before every line's entrance, goal's included

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        // The CSS reduced-motion rules already show the full sentence with
        // no caret, every activity line with no fade/slide/dip, and the
        // boundary with no fade/slide/pulse — jump straight to the
        // finished state throughout, skipping every transient.
        goal.dataset.goal = 'settled';
        activities.forEach((el) => {
          el.dataset.activity = 'visible';
          const textEl = el.querySelector('[data-activity-text]');
          const doneText = el.dataset.activityDone;
          if (textEl instanceof HTMLElement && doneText) textEl.textContent = doneText;
          el.dataset.activityState = 'done';
        });
        if (boundary instanceof HTMLElement) boundary.dataset.boundary = 'visible';
        return;
      }

      const fullText = typed.textContent || '';
      typed.textContent = '';

      const START_DELAY = 650;
      const MIN_CHAR_DELAY = 45;
      const MAX_CHAR_DELAY = 95;
      const CURSOR_LINGER = 1400;

      const typeNext = (index) => {
        typed.textContent = fullText.slice(0, index);
        if (index >= fullText.length) {
          goal.dataset.goal = 'done';
          setTimeout(() => {
            goal.dataset.goal = 'settled';
            // The ambient preview stops here — the first indication of
            // activity, not the full mechanism. Every step resolving and
            // the permission boundary only play out once the visitor
            // clicks "See how"; that's what the explanation stage is for.
            setTimeout(() => {
              if (activities[0]) activities[0].dataset.activity = 'visible';
            }, BETWEEN_DELAY);
          }, CURSOR_LINGER);
          return;
        }
        const delay = MIN_CHAR_DELAY + Math.random() * (MAX_CHAR_DELAY - MIN_CHAR_DELAY);
        setTimeout(() => typeNext(index + 1), delay);
      };

      setTimeout(() => {
        goal.dataset.goal = 'typing';
        typeNext(1);
      }, START_DELAY);
    });

    // "See how" keeps the visitor inside the hero: it swaps the
    // right-side photo for the travel-agent explanation stage occupying
    // the same box, via the data-stage toggle and the CSS transition on
    // .dy-hero__photo-layer / .dy-hero__explain-stage below.
    //
    // The stage's own content is then revealed in causal order rather
    // than all at once: the premise, then the goal being handed over
    // (the rule draws toward the recipient, who appears as it lands),
    // then the work itself branching out one destination at a time, and
    // only once all three are up, the closing line. Runs once per page
    // load and schedules nothing afterwards — the stage is final when
    // the last line lands.
    const explainStage = document.querySelector('.dy-hero__explain-stage');

    if (explainStage instanceof HTMLElement) {
      // Arms the CSS above. Set from script so that if this never runs,
      // the stage still renders complete instead of blank.
      explainStage.dataset.explain = 'idle';
    }

    const runExplainSequence = () => {
      if (!(explainStage instanceof HTMLElement)) return;
      if (explainStage.dataset.explain === 'running') return;
      explainStage.dataset.explain = 'running';

      const one = (sel) => explainStage.querySelector(sel);
      const all = (sel) => [...explainStage.querySelectorAll(sel)];

      const show = (el) => { if (el instanceof HTMLElement || el instanceof SVGElement) el.setAttribute('data-reveal', 'in'); };
      const draw = (el) => { if (el instanceof HTMLElement || el instanceof SVGElement) el.setAttribute('data-drawn', '1'); };

      const title = one('.dy-hero__explain-title');
      const quote = one('.dy-hero__explain-quote');
      const line = one('.dy-hero__handoff-line');
      const head = one('.dy-hero__handoff-head');
      const label = one('.dy-hero__agent-label');
      const stem = one('.dy-hero__agent-stem');
      const rail = one('.dy-hero__branch-rail');
      const drops = all('.dy-hero__branch-drop');
      const icons = all('.dy-hero__branch-icon');
      const names = all('.dy-hero__branch-label');
      const closingMark = one('.dy-hero__explain-caption-current .dy-hero__realize-mark');
      const closingLines = all('.dy-hero__explain-caption-current .dy-hero__realize-line');

      const steps = [
        // 1. Premise.
        [250, () => show(title)],
        [620, () => show(quote)],
        // 2. Delegation — the rule travels, then its destination lands.
        [1000, () => draw(line)],
        [1330, () => show(head)],
        [1420, () => show(label)],
        // 3. The work, one destination at a time as the rail reaches it.
        [1700, () => draw(stem)],
        [1940, () => draw(rail)],
        [2000, () => draw(drops[0])],
        [2090, () => { show(icons[0]); show(names[0]); }],
        [2180, () => draw(drops[1])],
        [2270, () => { show(icons[1]); show(names[1]); }],
        [2360, () => draw(drops[2])],
        [2450, () => { show(icons[2]); show(names[2]); }],
        // 4. Meaning, and then the continuation once the whole familiar
        // sequence has landed. Flights/Hotels/Schedule and the takeaway
        // stay at their normal completed-state contrast throughout — the
        // sequence ends here: the frame is complete and still, and
        // nothing changes again until the visitor asks.
        [2800, () => { show(closingMark); show(closingLines[0]); }],
        [3050, () => show(closingLines[1])],
        [3400, () => show(one('.dy-hero__look-again'))],
      ];

      // Reduced motion: the CSS above already renders every element of
      // this state, so there is nothing to schedule.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      steps.forEach(([at, run]) => setTimeout(run, at));
    };

    // The actual "See how" click handling — including what happens on a
    // restart — lives outside initHeroVisual() (see the bottom of this
    // script): it's the one thing that must never be re-wired on every
    // reset, since it's the only thing that can trigger one. This just
    // hands that listener the current run's copy of the sequence.
    currentRunExplainSequence = runExplainSequence;

    // The change of hands, now on request rather than on a timer. Only
    // one button, two jobs, in sequence. First click: Travel Agent →
    // Software, sequenced (see runAgentSwap below) rather than an
    // instant crossfade — the branch dims, the outgoing actor visibly
    // fades, a short beat holds, then the incoming actor arrives and
    // settles before the branch returns and the realization is allowed
    // to appear. Second click, once SOFTWARE (and its realization) is
    // already showing: Scene 2 replaces it in the same stage box via
    // the same technique — .dy-hero__explain-inner fades out,
    // .dy-hero__scene2 fades in, both absolute layers at the same
    // dimensions, so nothing scrolls and the left side never moves.
    // Nothing follows this; the frame is final once Scene 2 settles.

    // Runs once per page load. `agentSwapBusy` (separate from the
    // `data-agent-swap` CSS hook, which clears a beat before `finish`
    // runs) covers the whole sequence end-to-end, so a second click
    // partway through — the button stays interactive throughout — can't
    // restart or overlap it.
    let agentSwapBusy = false;
    const runAgentSwap = () => {
      if (!(explainStage instanceof HTMLElement) || agentSwapBusy) return;
      agentSwapBusy = true;

      const finish = () => {
        explainStage.dataset.state = 'software';
        explainStage.querySelectorAll('.dy-hero__agent-name--current, .dy-hero__explain-caption-current, .dy-hero__look-again-changed')
          .forEach((el) => el.setAttribute('aria-hidden', 'true'));
        explainStage.querySelectorAll('.dy-hero__agent-name--next, .dy-hero__explain-caption-next, .dy-hero__look-again-invite')
          .forEach((el) => el.removeAttribute('aria-hidden'));
        agentSwapBusy = false;
      };

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // The change of state still happens — it's the point of the
        // frame, not decoration — it just happens instantly, exactly
        // like the rest of this stage under reduced motion.
        delete explainStage.dataset.agentSwap;
        finish();
        return;
      }

      // 1. Subdue the branch and fade the outgoing actor out.
      explainStage.dataset.agentSwap = 'dimming';

      // 2. Once TRAVEL AGENT has fully faded (320ms), a short beat with
      // nothing visible in the actor position — then SOFTWARE arrives
      // and settles into place (320ms).
      setTimeout(() => { explainStage.dataset.agentSwap = 'revealing'; }, 470);

      // 3. Once SOFTWARE has visually settled, restore the branch —
      // it never changed — and only then let the realization appear.
      setTimeout(() => { delete explainStage.dataset.agentSwap; }, 790);
      setTimeout(finish, 850);
    };

    // Scene 2's own demonstration: YOU -> SOFTWARE -> YOU -> SOFTWARE ->
    // YOU, revealed one handoff at a time rather than all five labels at
    // once. Runs once (guarded by data-flow-started on the scene2
    // element itself); under reduced motion it does nothing because the
    // stage-wide [data-reveal]/[data-draw] overrides already render
    // every actor and connector in its settled state — the only thing
    // that still needs an explicit reduced-motion rule is the transient
    // saffron "waiting" dot, which has no meaning once there is no pause
    // to mark (see its own reduced-motion CSS rule).
    const runScene2Sequence = () => {
      if (!(explainStage instanceof HTMLElement)) return;
      const scene2 = explainStage.querySelector('.dy-hero__scene2');
      if (!(scene2 instanceof HTMLElement) || scene2.dataset.flowStarted) return;
      scene2.dataset.flowStarted = '1';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const all = (sel) => [...scene2.querySelectorAll(sel)];
      const show = (el) => { if (el instanceof HTMLElement || el instanceof SVGElement) el.setAttribute('data-reveal', 'in'); };
      const draw = (el) => { if (el instanceof HTMLElement) el.setAttribute('data-drawn', '1'); };
      const setWaiting = (el, on) => { if (el instanceof HTMLElement) el.toggleAttribute('data-waiting', on); };

      const actors = all('.dy-shift__flow-actor');
      const lines = all('.dy-shift__flow-connector-line');
      const heads = all('.dy-shift__flow-connector-head');
      const waitDots = all('.dy-shift__flow-wait');
      const caption = scene2.querySelector('.dy-shift__caption');
      const nextButton = scene2.querySelector('.dy-hero__scene2-next');

      // The point of this scene isn't the diagram, it's the wait — so the
      // pause at each SOFTWARE has to actually register as a stop, not a
      // brief flicker between two faster motions. Each SOFTWARE gets a
      // settle beat after it arrives, then the saffron cue holds for
      // 850ms once fully visible (was 550ms total, cue included, which
      // read as a transition rather than a stop), then another beat
      // after it clears before motion resumes toward the next YOU. That
      // in/hold/out/gap rhythm is what should land as "software waited,"
      // not the fact that a dot appeared at all.
      const steps = [
        // 1. Reveal YOU — you instruct.
        [0, () => show(actors[0])],
        // 2. Software works: a directional signal progresses toward it.
        [300, () => draw(lines[0])],
        // 3. SOFTWARE becomes active.
        [700, () => { show(heads[0]); show(actors[1]); }],
        // 4. Software waits — held long enough to actually perceive as
        // stopped, not just a passing beat.
        [1190, () => setWaiting(waitDots[0], true)],
        [2040, () => setWaiting(waitDots[0], false)],
        // 5. You decide: the next YOU becomes active.
        [2520, () => draw(lines[1])],
        [2970, () => { show(heads[1]); show(actors[2]); }],
        // 6. Software works again, toward the second SOFTWARE.
        [3410, () => draw(lines[2])],
        [3860, () => { show(heads[2]); show(actors[3]); }],
        // 7. Software waits again.
        [4300, () => setWaiting(waitDots[1], true)],
        [5150, () => setWaiting(waitDots[1], false)],
        // 8. You decide once more: the final YOU appears.
        [5630, () => draw(lines[3])],
        [6080, () => { show(heads[3]); show(actors[4]); }],
        // Only once the whole journey — including its two waits — has
        // visibly settled: the takeaway.
        [6520, () => show(caption)],
        // ...and only once that takeaway itself has landed: the
        // continuation into Scene 3.
        [6920, () => show(nextButton)],
      ];

      steps.forEach(([at, run]) => setTimeout(run, at));
    };

    // Scene 3: the transformation the whole hero has been building to.
    // It does not start by showing something new — it starts holding the
    // exact row Scene 2 ended on, so the first thing that changes is the
    // diagram itself. Then, in order: the steps that only existed
    // because software came back to the person after every turn collapse
    // away and the remaining work consolidates into one agent surface in
    // the centre; the agent runs familiar steps, hits one that doesn't go
    // to plan, adapts and carries on; the goal it was working toward
    // opens on the right; and only once all of that has been watched does
    // any explanatory language appear. Runs once (guarded by
    // data-flow-started); under reduced motion it does nothing, because
    // the CSS renders this scene's settled end state directly.
    const runAgentScene = () => {
      if (!(explainStage instanceof HTMLElement)) return;
      const scene = explainStage.querySelector('.dy-hero__scene3');
      if (!(scene instanceof HTMLElement) || scene.dataset.flowStarted) return;
      scene.dataset.flowStarted = '1';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const one = (sel) => scene.querySelector(sel);
      const all = (sel) => [...scene.querySelectorAll(sel)];
      const show = (el) => { if (el instanceof HTMLElement || el instanceof SVGElement) el.setAttribute('data-reveal', 'in'); };
      const draw = (el) => { if (el instanceof HTMLElement || el instanceof SVGElement) el.setAttribute('data-drawn', '1'); };
      const mark = (el, state) => { if (el instanceof SVGElement) el.setAttribute('data-state', state); };
      const open = (el) => { if (el instanceof HTMLElement) el.removeAttribute('data-shut'); };
      const shut = (el) => { if (el instanceof HTMLElement) el.setAttribute('data-shut', ''); };

      // The first SOFTWARE is a transient too, but it retires on its own
      // beat — handing its slot straight to the agent's surface — rather
      // than with the repetition that only existed around it.
      const word = one('[data-agent-word]');
      const transients = all('[data-agent-transient]:not([data-agent-word])');
      const core = one('[data-agent-core]');
      const outLink = one('[data-agent-out]');
      const outLine = one('[data-agent-out] .dy-shift__flow-connector-line');
      const outHead = one('[data-agent-out] .dy-shift__flow-connector-head');
      const goalCell = one('[data-agent-goal]');
      const goal = one('.dy-agent__goal');
      const routes = all('.dy-agent__route');
      const nodeFlight = one('.dy-agent__node--flight');
      const nodeHotel = one('.dy-agent__node--hotel');
      const nodeCalendar = one('.dy-agent__node--calendar');
      const nodeFlightAlt = one('.dy-agent__node--flight-alt');
      const askBlock = one('[data-agent-ask]');

      // Each cell's own width, published to CSS so max-width has a
      // concrete value to animate between instead of `none` (which
      // cannot transition). scrollWidth reads the content width whether
      // the cell is currently clipped or not, so this is also what keeps
      // the measurement honest across a resize.
      const cells = all('.dy-agent__cell');
      const measureCells = () => cells.forEach((cell) => {
        if (cell instanceof HTMLElement) cell.style.setProperty('--dy-cell-w', cell.scrollWidth + 'px');
      });
      measureCells();
      if (cellsResizeHandler) window.removeEventListener('resize', cellsResizeHandler);
      cellsResizeHandler = measureCells;
      window.addEventListener('resize', cellsResizeHandler);

      const steps = [
        // 1. A short hold on the pattern the visitor just learned, so
        // they are still reading it when it starts to change — then the
        // repeated hand-back disappears.
        [220, () => { scene.dataset.consolidated = '1'; transients.forEach(shut); }],
        // 2. Only once that room has actually been given up does the one
        // remaining SOFTWARE hand its slot to the agent's own surface,
        // in place. Opening it any earlier widens the row past the stage
        // while the old members are still standing there.
        [700, () => { shut(word); open(core); }],
        // 3. The signal arrives from YOU and the object goes to work:
        // the route reaches a symbol, the symbol lights, the route moves
        // on. No labels — what is happening is where the line is.
        [1250, () => draw(routes[0])],
        [1550, () => mark(nodeFlight, 'active')],
        [1800, () => draw(routes[1])],
        [2080, () => mark(nodeHotel, 'active')],
        [2320, () => draw(routes[2])],
        [2600, () => mark(nodeCalendar, 'active')],
        // 4. The interruption: the flight it had is gone. A brief saffron
        // moment on that symbol — the only saffron in the object — and
        // then the route does the thing this whole scene exists to show,
        // turning back on itself instead of carrying on forward.
        [2880, () => mark(nodeFlight, 'blocked')],
        [3260, () => { mark(nodeFlight, 'dropped'); draw(routes[3]); }],
        [3650, () => mark(nodeFlightAlt, 'active')],
        // 5. Resolved, the signal leaves the object — and only now does
        // the destination it was working toward appear, resolving the row
        // into YOU -> [agent working] -> GOAL.
        [3980, () => draw(routes[4])],
        [4300, () => { open(outLink); draw(outLine); }],
        [4560, () => { show(outHead); open(goalCell); }],
        [5100, () => { if (goal instanceof HTMLElement) goal.setAttribute('data-reached', ''); }],
        // 6. The run is over. Nothing is named here — what this was is
        // held back for the laptop to answer — so the diagram simply
        // settles and then asks. Nothing further happens on this stage
        // until the visitor uses that; see the handler below.
        [5400, () => { scene.dataset.settled = '1'; }],
        [5900, () => { open(askBlock); show(one('.dy-agent__ask')); }],
      ];

      steps.forEach(([at, run]) => setTimeout(run, at));
    };

    // "So when does it need you?" — the laptop the visitor already knows,
    // returning to this stage on request rather than on a timer. The
    // supporting sentence ("Software that can work...") is still
    // deliberately NOT triggered here — reserved for a later step, once
    // this naming beat has had its own review. This click brings the
    // laptop in, lets its own moment ("Waiting for your approval")
    // register on its own, brings the first realization in beneath it,
    // and — once that has had time to register in turn — names what was
    // just watched.
    //
    // The diagram and the laptop share one grid cell, so the diagram is
    // faded out first and only then taken out of the slot's own sizing
    // ([data-collapsed]) — by which point nothing in that slot is visible
    // and the height it gives up costs no visible movement.
    //
    // Below the slot, .dy-shift__inner is still a single flex child of
    // .dy-hero__scene3 (align-items: center) — so once the slot itself
    // has stopped changing height (right when it collapses to the
    // laptop's own fixed height below), the moment each new beat below
    // it opens its own room, the whole column's growing height would
    // ordinarily re-centre and drag the laptop and every beat already
    // on screen upward with it. freezeAnchor() below measures exactly
    // where the top of that column sits at that moment and pins it
    // there (align-items: flex-start + a matching margin-top) — so every
    // beat that follows only ever grows downward, into the stage's own
    // spare room beneath it, and nothing already visible ever moves.
    document.getElementById('dy-agent-next')?.addEventListener('click', () => {
      if (!(explainStage instanceof HTMLElement)) return;
      const scene = explainStage.querySelector('.dy-hero__scene3');
      if (!(scene instanceof HTMLElement) || scene.dataset.handover) return;
      scene.dataset.handover = '1';

      const one = (sel) => scene.querySelector(sel);
      const show = (el) => { if (el instanceof HTMLElement) el.setAttribute('data-reveal', 'in'); };
      const open = (el) => { if (el instanceof HTMLElement) el.removeAttribute('data-shut'); };
      const boundary = one('[data-agent-boundary]');
      const boundaryTitle = one('[data-agent-boundary-title]');
      const realizeBlock = one('[data-agent-realize]');
      const payoffBlock = one('[data-agent-payoff]');
      const reveal = () => { if (boundary instanceof HTMLElement) boundary.setAttribute('data-boundary', 'visible'); };
      const pulse = () => { if (boundaryTitle instanceof HTMLElement) boundaryTitle.setAttribute('data-pulse', '2'); };
      const freezeAnchor = () => {
        const inner = scene.querySelector('.dy-shift__inner');
        if (!(inner instanceof HTMLElement)) return;
        // align-items: flex-start positions the flex item right after
        // the scene's own top padding, then this margin adds further
        // offset on top of that — so the padding has to be subtracted
        // back out of the raw top-to-top measurement here, or it would
        // otherwise be counted twice (once by flex-start's own layout,
        // once again inside the raw offset) and inner would land that
        // much further down than its current, still-centred position.
        const paddingTop = parseFloat(getComputedStyle(scene).paddingTop) || 0;
        const offset = inner.getBoundingClientRect().top - scene.getBoundingClientRect().top - paddingTop;
        inner.style.setProperty('--dy-inner-anchor', offset + 'px');
        scene.dataset.anchored = '1';
      };

      // Once this whole state has finished revealing itself, "See how"
      // returns to full visibility — the same restrained cue every other
      // continuation in this stage already uses (a plain control simply
      // becoming available again), and the signal that there is
      // something left to do here: click it again to watch the whole
      // thing from the start. Its own listener (see the bottom of this
      // script) already treats any click at this point as a restart.
      const revealSeeHow = () => {
        const seeHow = document.getElementById('dy-hero-see-how');
        if (seeHow instanceof HTMLElement) seeHow.removeAttribute('data-state');
      };

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        scene.dataset.collapsed = '1';
        reveal();
        open(realizeBlock); show(one('.dy-agent__realize'));
        // Freezes the column exactly as it already sits with the laptop
        // and the realization both settled — the same moment the
        // animated branch below freezes it — so the naming beat that
        // follows only ever grows downward from there.
        freezeAnchor();
        open(payoffBlock); show(one('.dy-agent__name'));
        revealSeeHow();
        return;
      }

      // Once the diagram has fully faded, and before anything else is
      // visible in that slot, it stops holding the slot open.
      setTimeout(() => { scene.dataset.collapsed = '1'; }, 470);
      // Held until the laptop itself has finished arriving, so the line
      // it is waiting on lands on a settled screen rather than riding in
      // with it.
      setTimeout(reveal, 900);
      setTimeout(pulse, 1500);
      // A real pause once the pulse has settled — long enough that
      // "Waiting for your approval" has actually registered on its own —
      // before the first realization opens its own room beneath the
      // laptop and fades in slowly (see .dy-agent__realize's own,
      // longer-than-usual opacity transition below), rather than
      // snapping in the moment it's given room.
      setTimeout(() => { open(realizeBlock); show(one('.dy-agent__realize')); }, 2900);
      // Another real pause, this one long enough for the realization
      // itself (a 1100ms fade, landing around 4000ms) to have settled
      // and been read. By now the column has stopped growing on its
      // own (the realization's own 520ms open finished around 3420ms) —
      // exactly the moment to freeze the anchor above, using the
      // position everything already on screen is actually resting at,
      // before the naming beat opens its own room the same way and
      // fades in with the same slow, deliberate pace (see
      // .dy-agent__name's own transition below).
      setTimeout(() => { freezeAnchor(); open(payoffBlock); show(one('.dy-agent__name')); }, 5500);
      // A last, short beat once the naming line has finished its own
      // 1100ms fade (landing around 6600ms) before "See how" comes back.
      setTimeout(revealSeeHow, 6900);
    });

    document.getElementById('dy-scene2-next')?.addEventListener('click', () => {
      if (!(explainStage instanceof HTMLElement)) return;
      if (explainStage.dataset.scene === '3') return;
      explainStage.dataset.scene = '3';
      // Just past the 420ms layer crossfade — Scene 3 is holding the
      // same row Scene 2 was, so nothing visibly happens until the
      // sequence above starts taking it apart.
      setTimeout(runAgentScene, 440);
    });

    document.getElementById('dy-explain-more')?.addEventListener('click', () => {
      if (!(explainStage instanceof HTMLElement)) return;

      if (explainStage.dataset.state !== 'software') {
        runAgentSwap();
        return;
      }

      if (explainStage.dataset.scene === '2') return;
      explainStage.dataset.scene = '2';

      // Fades out via the CSS opacity rule first, exactly like every
      // other retiring control in this stage — then, once that finishes,
      // this specific element also needs display:none, not just
      // opacity/pointer-events. Chromium mispositions
      // .dy-hero__explain-stage relative to .dy-hero__visual (a container
      // + aspect-ratio interaction, confirmed by testing with container
      // queries disabled) if this button is left in the layout at
      // opacity:0 with pointer-events:none; fully removing it from layout
      // avoids that without changing how the fade itself looks.
      const lookAgain = document.querySelector('.dy-hero__look-again');
      if (lookAgain instanceof HTMLElement) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        setTimeout(() => { lookAgain.style.display = 'none'; }, reduceMotion ? 0 : 320);
      }

      // Starts once the crossfade into Scene 2 has visually settled
      // (its own transition is 420ms) rather than racing it.
      setTimeout(runScene2Sequence, 500);
    });
    }

    initHeroVisual();

    // The one control for the whole journey, doing the one job it has
    // always done: hand the visitor from wherever they currently are
    // (nowhere yet, or the very end) into the explanation. Its own
    // label and subdued styling never change here — see
    // .dy-hero__cta[data-state='subdued'] below — only what a click on
    // it now does once it's already been used once.
    //
    // First click: exactly as before. Any click after that: the whole
    // #dy-hero-visual subtree is put back to the untouched markup
    // captured at the top of this script, and initHeroVisual() runs
    // again against that fresh markup — re-typing the goal, re-arming
    // every sequence, re-wiring every button inside it from scratch —
    // before the same "start the explanation" step that always follows
    // a click on this control runs again. Nothing scrolls and nothing
    // outside #dy-hero-visual is touched.
    document.getElementById('dy-hero-see-how')?.addEventListener('click', (event) => {
      const button = event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
      const visual = document.getElementById('dy-hero-visual');

      if (heroActivated) {
        if (visual instanceof HTMLElement && heroVisualPristineHTML != null) {
          visual.innerHTML = heroVisualPristineHTML;
        }
        initHeroVisual();
      }
      heroActivated = true;

      if (visual instanceof HTMLElement) visual.dataset.stage = 'explain';
      if (currentRunExplainSequence) currentRunExplainSequence();

      // Marks the click itself as done — stays subdued through the
      // travel-agent explanation and every scene up to (but not
      // including) the very end, where revealSeeHow() (see the
      // dy-agent-next handler above) removes this again so the control
      // returns to full visibility as the cue that it's ready to be
      // used once more. A restart always dims it straight back down to
      // this same state, since it's the start of the journey again.
      if (button) button.dataset.state = 'subdued';
    });
  </script>

