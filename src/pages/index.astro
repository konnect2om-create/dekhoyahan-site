    font-size: clamp(14.5px, 1.1vw, 16px);
    line-height: 1.5;
  }


  .dy-explore__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin: clamp(28px, 4vh, 44px) 0 0;
