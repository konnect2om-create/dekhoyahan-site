    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.6vh, 26px);
  }

  /* No card chrome — no border or background — so this stays a quiet
     editorial lead-in rather than a boxed component. */
  .dy-hero__feature-intro {
    max-width: 640px;
    margin-inline: auto;
    width: 100%;
  }

  .dy-hero__feature-hook {
    margin: 0;
    max-width: 34ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 560;
    line-height: 1.32;
    letter-spacing: -0.014em;
  }

  .dy-hero__feature-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
  }

  .dy-hero__feature-label {
    color: var(--muted);
    font-size: 13.5px;
    font-weight: 620;
    letter-spacing: -0.004em;
  }

  /* The right-side focal visual: a single photographic image (laptop1),
     replacing the interactive AI-agent composition this hero previously
     showed here. That composition isn't gone — see
     src/components/hero/AiAgentHeroStage.astro, where it's preserved
     whole so it can be reused and evolved into its own Explore story —
     this is just what the homepage hero shows now. It keeps the same
     box treatment the previous stage used (max-width, centering, 3:2
     aspect ratio, right-aligned lane past 1320px), so nothing about the
     grid around it needed to change. */
  .dy-hero__visual {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    aspect-ratio: 3 / 2;
    align-self: center;
    overflow: hidden;
    /* Lets the screen overlay below express its perspective distance in
       cqw — a share of this box's own rendered width — so the illusion
       of depth stays proportionally correct at any size, mobile included,
       with no JS measuring involved. */
    container-type: inline-size;
  }

  .dy-hero__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Weighted toward the laptop itself — screen and keyboard sit just
       right of the source photo's centre — so it stays the clear focal
       point at every width instead of the wider desk scene around it. */
    object-position: 54% 50%;
    /* Dissolves the photograph's own rectangle into the page rather than
       letting it sit on top as pasted media. Two gradients multiplied
       together (one per axis), applied to the photograph alone — the
       screen overlay is a separate layer and is never touched.
       The laptop itself measures roughly 13%-88% across and 9%-93% down
       this box, so every fade is kept outside those edges: it stays at
       full opacity and full sharpness, and only the room, table and the
       objects around it dissolve. Asymmetric on purpose — widest on the
       left, where the photograph meets the headline; narrow and gentle
       top and bottom; narrowest on the far right, which only needs to
       lose its edge. Every side reaches zero at the boundary, so no
       rectangular edge is left anywhere. */
    -webkit-mask-image:
      radial-gradient(ellipse 76% 86% at 51% 52%, #000 0 72%, rgba(0, 0, 0, 0.55) 88%, rgba(0, 0, 0, 0.2) 97%, rgba(0, 0, 0, 0.06) 100%),
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.05) 1.5%, rgba(0, 0, 0, 0.17) 3.5%, rgba(0, 0, 0, 0.38) 6%, rgba(0, 0, 0, 0.65) 8.5%, rgba(0, 0, 0, 0.89) 10.5%, #000 11.5%, #000 91.5%, rgba(0, 0, 0, 0.72) 94%, rgba(0, 0, 0, 0.42) 96.5%, rgba(0, 0, 0, 0.18) 98.5%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.14) 1.5%, rgba(0, 0, 0, 0.4) 3.5%, rgba(0, 0, 0, 0.74) 5.5%, #000 7.5%, #000 94.5%, rgba(0, 0, 0, 0.62) 96.5%, rgba(0, 0, 0, 0.26) 98.5%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(ellipse 76% 86% at 51% 52%, #000 0 72%, rgba(0, 0, 0, 0.55) 88%, rgba(0, 0, 0, 0.2) 97%, rgba(0, 0, 0, 0.06) 100%),
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.05) 1.5%, rgba(0, 0, 0, 0.17) 3.5%, rgba(0, 0, 0, 0.38) 6%, rgba(0, 0, 0, 0.65) 8.5%, rgba(0, 0, 0, 0.89) 10.5%, #000 11.5%, #000 91.5%, rgba(0, 0, 0, 0.72) 94%, rgba(0, 0, 0, 0.42) 96.5%, rgba(0, 0, 0, 0.18) 98.5%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.14) 1.5%, rgba(0, 0, 0, 0.4) 3.5%, rgba(0, 0, 0, 0.74) 5.5%, #000 7.5%, #000 94.5%, rgba(0, 0, 0, 0.62) 96.5%, rgba(0, 0, 0, 0.26) 98.5%, transparent 100%);
    mask-composite: intersect;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }

  /* The photographed laptop (image + its screen overlay), grouped as one
     layer so "See how" can fade it out as a unit — see the explain-stage
     rules and the data-stage toggle in the hero script above. Positioned
     to fill .dy-hero__visual exactly, so .dy-hero__screen's percentages
     (measured against that box) still land correctly nested one level
     deeper. */
  .dy-hero__photo-layer {
    position: absolute;
    inset: 0;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 420ms ease, transform 420ms ease;
  }

  .dy-hero__visual[data-stage='explain'] .dy-hero__photo-layer {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  /* Fills the same box the photo occupies so the grid never reflows on
     click. Deliberately has no background of its own — .dy-hero__visual
     and .dy-hero sit on the shared homepage canvas (see body's own
     background in global.css) same as everything else, so the stage
     dissolves into the page rather than reading as a cream sheet placed
     on top of it. */
  .dy-hero__explain-stage {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: flex;
    /* Shared by the agent's stem and the branch's top margin so the two
       always meet, whatever the stage's width. */
    --dy-branch-stem: clamp(18px, 4.2cqw, 29px);
    /* Pulls the actor and everything hanging off it in from the right
       edge as one group — applied to the agent and the branch from the
       same value so they can never drift apart. ~40px at the 640px
       desktop stage. The incoming rule needs no adjustment: it flexes,
       so it simply gives up exactly this much length and still stops
       the same distance short of the label. */
    --dy-actor-shift: 6.25cqw;
    padding: 10% 9%;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 420ms ease, transform 420ms ease;
    pointer-events: none;
  }

  .dy-hero__visual[data-stage='explain'] .dy-hero__explain-stage {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Editorial hierarchy, not a centered block: the headline/quote pair
     anchors the upper-left, the caption anchors the lower-left, and the
     centre/right plus middle-lower areas stay open on purpose — that's
     where the travel-agent visual and its three action icons land in
     later steps. Nothing here is animated yet beyond the stage swap. */
  .dy-hero__explain-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    text-align: left;
    /* Fades out once Scene 2 takes over the stage — see .dy-hero__scene2
       above, which crossfades in at the same moment. */
    transition: opacity 420ms ease;
  }

  /* Stays hidden through Scene 2 AND Scene 3 — matching data-scene='2'
     only would make this reappear the moment Scene 3 takes over, since
     that's a different attribute value, not an absence of one. */
  .dy-hero__explain-stage[data-scene='2'] .dy-hero__explain-inner,
  .dy-hero__explain-stage[data-scene='3'] .dy-hero__explain-inner {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__explain-inner {
      transition: none;
    }
  }

  /* Shifts the whole realization/continuation group slightly right of
     the takeaway's original flush-left edge — a small nudge that reads
     as "settled into place" rather than pinned to the stage's own left
     rail, without recentring it under the diagram or changing any
     internal spacing within the group. */
  .dy-hero__realize {
    margin-left: clamp(14px, 4.4cqw, 28px);
  }

  /* Sits directly under the takeaway now, in normal flow, as part of the
     same .dy-hero__realize unit — not centred, not anchored to the
     branch. An explicit width (rather than max-width alone) is what
     makes the "But software…" state actually wrap into a readable
     two-line block at the width available, instead of shrink-wrapping
     to its longest single word. */
  .dy-hero__look-again {
    display: block;
    /* +10px over the previous clamp(7px,1.6cqw,10px) — a brief pause
       between the realization and the invitation to continue, not a
       restructure of the spacing rhythm around it. */
    margin: clamp(17px, 3.4cqw, 20px) 0 0;
    width: min(85cqw, 30ch);
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    transition: opacity 320ms ease, margin-top 320ms ease;
  }

  /* The SOFTWARE-state realization runs two lines, taller than the
     familiar-state takeaway above it — the shared margin above gives
     that state a comfortable ~20px gap already, but this state needs
     its own slightly larger pause (still the same device, just tuned
     for its own content) rather than inheriting that value verbatim. */
  .dy-hero__explain-stage[data-state='software'] .dy-hero__look-again {
    margin-top: clamp(20px, 4.6cqw, 26px);
  }

  .dy-hero__look-again-changed,
  .dy-hero__look-again-invite-cue {
    display: inline-flex;
    align-items: center;
    gap: clamp(4px, 0.9cqw, 6px);
  }

  .dy-hero__look-again-changed {
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(12.5px, 2.4cqw, 15px);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  /* The realization's own continuation — now built as two distinct
     jobs rather than one run-on line: a quiet lead-in restating that
     software isn't new, then the actual curiosity trigger, which now
     carries the same dark/medium-weight + saffron-circle treatment as
     "See what changed" above. One reusable grammar for "there's more
     to discover here" instead of two different ones. */
  .dy-hero__look-again-invite {
    display: none;
    flex-direction: column;
    gap: clamp(6px, 1.3cqw, 9px);
  }

  .dy-hero__look-again-invite-lead {
    /* Matches .dy-hero__explain-caption's own size exactly — the normal
       body/ink-soft treatment already used for the takeaway above it —
       rather than a smaller annotation-style reading. Still clearly
       secondary to the bold "So what's different?" line beneath it. */
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(12.5px, 2.1cqw, 15px);
    font-weight: 500;
    line-height: 1.4;
  }

  .dy-hero__look-again-invite-cue-text {
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(12.5px, 2.4cqw, 15px);
    font-weight: 600;
    line-height: 1;
  }

  .dy-hero__explain-stage[data-state='software'] .dy-hero__look-again-changed {
    display: none;
  }

  .dy-hero__explain-stage[data-state='software'] .dy-hero__look-again-invite {
    display: flex;
  }

  .dy-hero__look-again-circle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(20px, 4cqw, 27px);
    height: clamp(20px, 4cqw, 27px);
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: clamp(10.5px, 2cqw, 13px);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .dy-hero__look-again:hover .dy-hero__look-again-circle,
  .dy-hero__look-again:focus-visible .dy-hero__look-again-circle {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }


  /* Stretches so the handoff row inside it can span the full stage
     width; the title and quote keep their own max-widths regardless. */
  .dy-hero__explain-top {
    align-self: stretch;
  }

  .dy-hero__explain-title {
    margin: 0;
    max-width: 16ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(21px, 4.2cqw, 29px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* The row carries the spacing that used to sit on the quote itself,
     so align-items: center lines the rule up with the quote's text
     rather than with the quote's text plus its top margin. */
  .dy-hero__handoff-row {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2.6cqw, 26px);
    width: 100%;
    margin-top: 2.2cqw;
  }

  .dy-hero__explain-quote {
    margin: 0;
    flex: none;
    max-width: 17ch;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: clamp(14.5px, 2.8cqw, 19px);
    font-style: italic;
    line-height: 1.4;
  }

  /* Editorial copy, not annotation — stronger than the muted grey this
     used to carry, so both the familiar takeaway and (once the actor
     becomes SOFTWARE) the realization beneath it read as intentional
     statements rather than a caption underneath the real content. */
  .dy-hero__explain-caption {
    margin: 0;
    /* Wider than the text itself needs, now that the mark + its gap
       (added this step, shared by both states) eats into the same
       budget — at 25ch that left "You gave someone the goal." only
       enough room to wrap awkwardly mid-sentence, something it never
       did before the mark existed here. */
    max-width: 30ch;
    color: var(--ink-soft);
    font-weight: 500;
    font-size: clamp(12.5px, 2.1cqw, 15px);
    line-height: 1.55;
  }

  /* Both states sit beside their own meaning-marker rather than stacked
     in the caption's own flow — a small flex row each: the marker and
     the two lines beside it. Shared here so the pre-SOFTWARE takeaway
     and the SOFTWARE realization use the exact same rhythm; only the
     line colours/weights differ, via .dy-hero__realize-line--one/--two
     below (the plain .dy-hero__realize-line the takeaway uses inherits
     the caption's own ink-soft/500 instead). */
  .dy-hero__explain-caption-current,
  .dy-hero__explain-caption-next {
    display: flex;
    align-items: flex-start;
    gap: clamp(8px, 1.6cqw, 11px);
    /* Stacked in the same grid cell (see .dy-hero__explain-caption's
       display:grid below) rather than one flowing and one absolutely
       positioned over it — the SOFTWARE realization runs a little
       taller than the familiar-state takeaway, and with only the
       shorter one contributing to the parent's height, the button
       below ended up positioned relative to the wrong content's
       bottom edge, eating most of its own top margin. Grid stacking
       sizes the parent to whichever child is tallest, so the margin
       below is always measured from what's actually visible. */
    grid-area: 1 / 1;
  }

  .dy-hero__realize-mark {
    flex: none;
    width: clamp(14px, 2.6cqw, 19px);
    height: 2px;
    margin-top: 0.6em;
    background: var(--saffron);
  }

  .dy-hero__realize-lines {
    display: flex;
    flex-direction: column;
    gap: 0.22em;
    /* Tighter than the caption's own 1.55: at the narrowest stage widths
       the second line wraps to two lines, and the default leading pushed
       the whole block a few px past .dy-hero__visual's clipped bottom
       edge even after the mobile margin/gap trim below. */
    line-height: 1.28;
  }

  .dy-hero__realize-line {
    display: block;
  }

  /* Near-black on purpose — the strongest text in the stage apart from
     the headline, since this is the sentence the whole sequence has
     been building toward. */
  .dy-hero__realize-line--one {
    color: var(--ink);
    font-weight: 600;
  }

  .dy-hero__realize-line--two {
    color: var(--ink-soft);
  }

  /* Only this phrase takes the cobalt accent — everything else in the
     realization stays ink/ink-soft, so the sentence doesn't read as
     entirely blue. */
  .dy-hero__realize-accent {
    color: var(--cobalt);
  }

  /* The travel-agent object: a small itinerary/document with a travel
     cue, standing on its own rather than living inside the headline/
     quote/caption flow above — absolutely positioned within the stage
     (not a child of .dy-hero__explain-inner) so it can later transition
     into the software state on its own, without the surrounding
     composition ever moving. Placed mid/right, with room left beneath
     it for the Flights/Hotels/Schedule branches a later step adds. */
  /* The rule takes whatever width the row has left over, so the goal
     stays put and the arrowhead always lands just short of the
     recipient — at any stage width, and after the agent itself later
     changes size. */
  .dy-hero__handoff {
    flex: 1;
    min-width: 18px;
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
  }

  .dy-hero__handoff-line {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .dy-hero__handoff-head {
    flex: none;
    width: 6px;
    height: 9px;
  }

  /* Stretched to the row's full height (with the label still centred in
     it, so nothing moves) purely so the stem below can start from the
     row's bottom edge rather than from the label's own baseline box. */
  .dy-hero__agent {
    position: relative;
    flex: none;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-right: var(--dy-actor-shift);
  }

  .dy-hero__agent-stem {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1px;
    height: var(--dy-branch-stem);
    background: var(--muted);
    opacity: 0.45;
  }

  /* Right-aligned under the agent and sized so the stem meets the rail
     clearly between two of the drops rather than doubling up with one
     of them. Sits in normal flow beneath the row, so the title, goal
     and closing line keep the exact positions they already had. */
  .dy-hero__branch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: clamp(190px, 32cqw, 215px);
    margin-top: var(--dy-branch-stem);
    margin-left: auto;
    margin-right: var(--dy-actor-shift);
    /* Dims (see [data-agent-swap] below) while the actor changes, then
       returns to full strength — geometry never moves, only strength,
       since Flights/Hotels/Schedule themselves didn't change. */
    transition: opacity 300ms ease;
  }

  /* Set from script for the duration of the "See what changed" actor
     swap only — see the click handler's runAgentSwap(). Dims the whole
     branch (rail, drops, icons, labels all fade together as one group,
     inheriting this) so attention favours the actor while it changes. */
  .dy-hero__explain-stage[data-agent-swap] .dy-hero__branch {
    opacity: 0.4;
  }

  /* Spans the outer two columns' centres — the drops fall from its ends
     and its middle, so the three destinations read as one division of
     the same line. */
  .dy-hero__branch-rail {
    position: absolute;
    top: 0;
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 1px;
    background: var(--muted);
    opacity: 0.45;
  }

  .dy-hero__branch-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dy-hero__branch-drop {
    width: 1px;
    height: clamp(13px, 2.6cqw, 19px);
    background: var(--muted);
    opacity: 0.45;
  }

  .dy-hero__branch-icon {
    display: block;
    width: clamp(19px, 4cqw, 27px);
    height: clamp(19px, 4cqw, 27px);
    margin-top: clamp(7px, 1.5cqw, 11px);
    color: var(--ink-soft);
  }

  .dy-hero__branch-label {
    margin: clamp(5px, 1.1cqw, 8px) 0 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(10px, 1.9cqw, 12.5px);
    line-height: 1.3;
  }

  /* ---- Reveal sequence -------------------------------------------
     Opacity for anything that reads as content, a scale along one axis
     for anything that reads as a line — transforms never affect layout,
     so nothing here moves a single element from where it already sits.
     The [data-explain] hook is set by script, so without JS every
     element simply stays visible rather than being stuck hidden. */
  .dy-hero__explain-stage[data-explain] [data-reveal] {
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .dy-hero__explain-stage[data-explain] [data-reveal='in'] {
    opacity: 1;
  }

  /* The connector lines keep their own 0.45 opacity throughout — they
     draw rather than fade, so they never brighten past it. */
  .dy-hero__explain-stage[data-explain] [data-draw='x'] {
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 400ms ease;
  }

  .dy-hero__explain-stage[data-explain] [data-draw='y'] {
    transform: scaleY(0);
    transform-origin: center top;
    transition: transform 240ms ease;
  }

  .dy-hero__explain-stage[data-explain] [data-draw][data-drawn='1'] {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__explain-stage[data-explain] [data-reveal] {
      opacity: 1;
      transition: none;
    }

    .dy-hero__explain-stage[data-explain] [data-draw] {
      transform: none;
      transition: none;
    }
  }

  /* A narrow stage is only ~231px tall at 3:2, which leaves about 25px
     between the goal row and the closing line — not enough for a tier
     of icons and labels, so the branch would push that line straight
     out of the stage. The stage's vertical padding (a percentage of its
     width, so it is unusually deep here) is where that room comes from;
     trimming it keeps every element inside the stage and at a readable
     size, at the cost of the composition sitting slightly taller on
     small phones than it did before this step. */
  @container (max-width: 480px) {
    .dy-hero__explain-stage {
      --dy-branch-stem: 9px;
      padding-top: 5%;
      padding-bottom: 5%;
      /* No shift here: the incoming rule is already at its minimum
         length at this width, so it cannot give up any more. Shifting
         anyway would move the branch while the label stayed put and
         pull the stem off the rail — the group would stop being a
         group. It keeps its existing right alignment instead. */
      --dy-actor-shift: 0px;
    }

    .dy-hero__branch-drop {
      height: 7px;
    }

    .dy-hero__branch-icon {
      width: 21px;
      height: 21px;
      margin-top: 3px;
    }

    .dy-hero__branch-label {
      margin-top: 2px;
      font-size: 10.5px;
    }

    /* The two-line realization plus its rule needs a little less room
       to clear than the default spacing gives it — at this stage
       height the extra margin/gap pushed its last line a few px past
       .dy-hero__visual's own bottom edge (which clips, via overflow:
       hidden), even though the line count itself doesn't change. */
    .dy-hero__realize-mark {
      margin-top: 0.5em;
    }

    .dy-hero__realize-lines {
      gap: 0.1em;
    }

    /* The takeaway now carries "See what changed" as part of the same
       unit, which is more content than this stage height had budget
       for — the branch above it is fixed (this step doesn't touch the
       diagram), so the only room left to find is here. */
    .dy-hero__explain-caption {
      font-size: 10px;
    }

    /* The 20-30px desktop nudge would eat into an already-tight mobile
       width budget (the stage is ~347px wide here) and risk pushing the
       group's right edge past .dy-hero__visual's clip — kept, but much
       smaller, so the group still shifts off the left rail without
       causing overflow. */
    .dy-hero__realize {
      margin-left: 6px;
    }

    .dy-hero__look-again {
      margin-top: 10px;
      width: 100%;
    }

    /* The desktop software-state gap (clamp up to 26px) would reopen the
       mobile vertical-space crisis this stage already runs close to —
       kept at the same compact spacing as the familiar state here. */
    .dy-hero__explain-stage[data-state='software'] .dy-hero__look-again {
      margin-top: 2px;
    }

    .dy-hero__look-again-changed {
      gap: 3px;
      font-size: 9.5px;
    }

    .dy-hero__look-again-invite {
      gap: 2px;
    }

    .dy-hero__look-again-invite-lead {
      font-size: 9.5px;
      line-height: 1.25;
    }

    .dy-hero__look-again-invite-cue-text {
      font-size: 9.5px;
    }

    .dy-hero__look-again-circle {
      width: 14px;
      height: 14px;
      font-size: 8px;
    }

    /* Same compact padding as .dy-hero__explain-stage above, so Scene 2's
       (and Scene 3's) content aligns with it rather than sitting inside
       the wider desktop padding at this stage width. */
    .dy-hero__scene2,
    .dy-hero__scene3 {
      padding: 5%;
    }
  }

  .dy-hero__agent-label {
    margin: 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(11px, 2.2cqw, 13.5px);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    /* Exactly the width this label already occupies, held in em so it
       tracks the clamped font size at every stage width. Reserving it
       means a shorter label later (the software state) centres inside
       the same box instead of pulling the actor's edges — and the stem,
       positioned at 50% of that box, stays put with it. */
    min-width: 8.27em;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__photo-layer,
    .dy-hero__explain-stage,
    .dy-hero__agent {
      transition: none;
    }
  }

  /* ---- The change of hands ---------------------------------------
     Only two things differ between the two states: who the actor is,
     and what the closing line says. Both incoming texts are stacked
     over their outgoing ones rather than replacing them, so the
     diagram itself is never rebuilt — the goal, both connectors and
     the three destinations are untouched DOM that simply stays on
     screen. These rules sit after the reveal and reduced-motion rules
     above because they share their specificity and must win. */
  .dy-hero__agent-label {
    position: relative;
  }

  .dy-hero__explain-caption {
    position: relative;
    display: grid;
  }

  .dy-hero__agent-name--next {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    opacity: 0;
    pointer-events: none;
  }

  .dy-hero__explain-caption-next {
    opacity: 0;
    /* Previously harmless (nothing else sat near where this invisible
       overlay could reach) — now that .dy-hero__look-again sits directly
       below the caption instead of off under the branch, this box (sized
       to the SOFTWARE realization's own content, which can run taller
       than the takeaway it's stacked over) can extend down far enough to
       sit on top of the button and swallow its clicks while still
       invisible. */
    pointer-events: none;
  }

  .dy-hero__explain-stage[data-state='software'] .dy-hero__explain-caption-next {
    pointer-events: auto;
  }

  .dy-hero__agent-name,
  .dy-hero__explain-caption-current,
  .dy-hero__explain-caption-next {
    transition: opacity 320ms ease;
  }

  .dy-hero__explain-stage[data-state='software'] .dy-hero__agent-name--current,
  .dy-hero__explain-stage[data-state='software'] .dy-hero__explain-caption-current {
    opacity: 0;
  }

  .dy-hero__explain-stage[data-state='software'] .dy-hero__agent-name--next,
  .dy-hero__explain-stage[data-state='software'] .dy-hero__explain-caption-next {
    opacity: 1;
  }

  /* ---- The actor swap itself, sequenced -----------------------------
     "See what changed" no longer swaps the actor and the realization in
     one indistinguishable instant. Driven by `data-agent-swap` (set from
     script, cleared once the swap settles): TRAVEL AGENT visibly fades
     out first, a short beat holds the empty label, then SOFTWARE arrives
     in cobalt with a brief settle-in scale — the same transform already
     used for reveals and hover elsewhere in this stage, not a new
     effect. `data-state='software'` (set slightly after, unchanged
     from before) is what then lets the realization appear, and also
     what keeps SOFTWARE resting at its arrived scale permanently once
     `data-agent-swap` is cleared. */
  .dy-hero__explain-stage[data-agent-swap] .dy-hero__agent-name--current {
    opacity: 0;
  }

  .dy-hero__agent-name--next {
    color: var(--cobalt);
    transform: scale(0.94);
    transition: opacity 320ms ease, transform 320ms ease;
  }

  .dy-hero__explain-stage[data-agent-swap='revealing'] .dy-hero__agent-name--next {
    opacity: 1;
    transform: scale(1);
  }

  .dy-hero__explain-stage[data-state='software'] .dy-hero__agent-name--next {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__branch,
    .dy-hero__agent-name--next {
      transition: none;
    }
  }

  /* One-shot: once Scene 2 has taken over there is nothing left for this
     control to do, so it retires rather than sitting there
     re-triggerable. (It stays active through the SOFTWARE state itself —
     that's its second job, see the markup comment.) Has to live here,
     after the reveal rules — it ties with them on specificity, so source
     order is what decides it. */
  .dy-hero__explain-stage[data-scene='2'] .dy-hero__look-again {
    opacity: 0;
    pointer-events: none;
  }

  /* The change of state still happens under reduced motion — it is the
     point of the frame, not decoration — it just happens instantly. */
  @media (prefers-reduced-motion: reduce) {
    .dy-hero__agent-name,
    .dy-hero__explain-caption-current,
    .dy-hero__explain-caption-next {
      transition: none;
    }
  }

  /* The laptop's own screen, isolated within the photograph: positioned
     to sit inside that surface's own visible bounds (measured directly
     off the source photo) rather than floating over the photograph at
     large. The screen's own photographed tilt is left to the photo
     itself — content here stays flat/horizontal (see .dy-hero__screen-
     plane) rather than matching that tilt, which read as slanted and
     hard to parse. */
  .dy-hero__screen {
    position: absolute;
    left: 33.3%;
    top: 15.2%;
    width: 50%;
    height: 49%;
  }

  /* A permanent screen layout, not a one-off overlay — this is the fixed
     surface every later activity state gets laid onto, so it establishes
     structure (an upper-left goal line, the rest of the screen left
     empty) rather than any one state's content. Deliberately unrotated:
     an earlier version tilted this to match the photographed screen's
     own perspective, but at this content size that read as slanted and
     distorted rather than natural, so it stays flat and horizontal to
     the visitor while still sitting inside the screen's own bounds. */
  .dy-hero__screen-plane {
    position: absolute;
    inset: 0;
    /* Top padding trimmed from its original 13%: that was tuned when the
       screen held only the goal line, and left too little room below for
       the activity/boundary lines this content now includes — without
       this, the later lines were landing past the photographed screen's
       own bottom edge, onto the keyboard. */
    padding: 9% 14% 0 9%;
  }

  /* Anchored top-left, not centered. Wide enough for the goal sentence
     to clear one line at desktop/tablet sizes (measured against its own
     rendered width, not guessed) while still stopping well short of the
     screen's full width — real software puts a goal/title line in a
     content column, not spanning edge to edge. Everything below stays
     empty on purpose, reserved for the activity states that follow. */
  .dy-hero__screen-layout {
    max-width: 97%;
  }

  .dy-hero__goal {
    margin: 0;
    /* A soft off-white rather than paper-white, closer to how a real
       dark-mode UI renders primary text on a near-black surface. */
    color: rgba(255, 255, 255, 0.9);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    /* cqw keeps this proportionate to the screen at typical sizes, but the
       hero visual itself shrinks below its 640px design width on narrow
       phones — the clamp() floor is what keeps the text legible there
       rather than following the container down to a few px. */
    font-size: clamp(12px, 2.1cqw, 13.5px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.002em;
  }

  /* Understated, on purpose: a hairline at low opacity, not a component
     border — just enough to read as "the goal line is settled, the rest
     of this screen is still to come." */
  .dy-hero__goal-rule {
    margin-top: 1.6cqw;
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
  }

  /* Typed in, not just shown: the sentence itself lives in the markup
     (so it's there with or without JS/CSS), but starts hidden — the
     script below reveals it character by character. `[data-goal='0']`
     is the state already baked into the HTML, so there's nothing to
     flash before the script takes over. */
  [data-goal='0'] [data-goal-typed] {
    opacity: 0;
  }

  /* A thin, steady caret — present only while the state machine below
     says something is actively happening (typing, or the brief pause
     right after), not a permanent decoration. */
  .dy-hero__goal-cursor {
    display: inline-block;
    width: 1px;
    height: 0.95em;
    margin-left: 1px;
    vertical-align: -0.1em;
    background: rgba(255, 255, 255, 0.9);
    opacity: 0;
  }

  [data-goal='typing'] .dy-hero__goal-cursor {
    opacity: 1;
  }

  /* Once the sentence is complete, the caret blinks briefly — a real
     cursor idling at the end of a line — then the 'settled' state (set
     a moment later by the same script) stops it for good. */
  [data-goal='done'] .dy-hero__goal-cursor {
    opacity: 1;
    /* The keyframes below are two flat, matching-value plateaus (0%/49%
       both opaque, 50%/100% both transparent) with no in-between value to
       interpolate, so a crisp on/off blink falls out of any timing
       function — no steps() needed (and a stray steps(1, jump-none) here
       previously made the whole shorthand invalid, silently dropping the
       animation entirely). */
    animation: dy-goal-cursor-blink 1s infinite;
  }

  @keyframes dy-goal-cursor-blink {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }

  /* Reduced motion: the sentence is simply present, complete, from the
     first paint — no typing, no caret. This rule's selector is exactly
     as specific as the ones it needs to override, so it wins regardless
     of which data-goal state the script (which checks the same media
     query before doing anything) leaves the element in. */
  /* The first activity line: same restrained approach as the goal text —
     same family, same understated treatment — but visibly secondary, not
     a second headline. Smaller, dimmer, lighter-weight than the goal, and
     revealed with a short fade/slide rather than typed in, so it reads
     as the software quietly reporting progress rather than something the
     visitor is entering themselves. */
  .dy-hero__activity {
    margin: 1.5cqw 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(10.5px, 1.85cqw, 12px);
    font-weight: 450;
    line-height: 1.4;
    letter-spacing: -0.002em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 420ms ease, transform 420ms ease;
  }

  .dy-hero__activity[data-activity='visible'] {
    opacity: 1;
    transform: translateY(0);
    /* Once the line has entered, its own working/resolving/done beats
       are quick, restrained state changes, not a second slow entrance —
       overriding to a shorter transition here (rather than editing the
       entrance transition above) keeps the two feelings distinct. */
    transition: opacity 180ms ease, color 180ms ease;
  }

  /* A brief, quiet dip — not a bounce or a flash — while the line's own
     text swaps underneath from the working label to the completed one.
     Restrained specifically means this never reads as celebratory. */
  .dy-hero__activity[data-activity-state='resolving'] {
    opacity: 0.32;
  }

  /* Completed: slightly brighter than the dim working colour (still
     secondary to the goal above it, just no longer "in progress"). Any
     colour lives on the check mark alone — see below — never here. */
  .dy-hero__activity[data-activity-state='done'] {
    opacity: 1;
    color: rgba(255, 255, 255, 0.82);
  }

  .dy-hero__activity-check {
    margin-left: 0.35em;
    color: inherit;
    opacity: 0;
    transition: opacity 180ms ease, color 180ms ease;
  }

  /* The one place colour appears, and only once the line has actually
     resolved: a small, muted, natural green — not a saturated "success"
     green — restricted to this glyph alone. */
  .dy-hero__activity[data-activity-state='done'] .dy-hero__activity-check {
    opacity: 1;
    color: rgba(140, 190, 156, 0.9);
  }

  /* The permission boundary: deliberately a different shape from the
     three completed actions above it — two lines revealed together, not
     a working state that resolves — so it reads as a genuinely different
     kind of moment (something needs the visitor, not just progress),
     while still using the same restrained entrance the activity lines
     use. No button, icon, or card here — just the two lines. */
  .dy-hero__boundary {
    margin: 1.5cqw 0 0;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 420ms ease, transform 420ms ease;
  }

  .dy-hero__boundary[data-boundary='visible'] {
    opacity: 1;
    transform: translateY(0);
  }

  /* Warm amber, not the activity lines' green — and used on the text
     itself rather than a small glyph, which is what makes this line
     read as waiting on the visitor rather than reporting progress. Kept
     muted (not saturated/neon) so it stays restrained. */
  .dy-hero__boundary-title {
    margin: 0;
    color: rgba(230, 158, 79, 0.95);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(10.5px, 1.85cqw, 12px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.002em;
  }

  .dy-hero__boundary-sub {
    margin: 0.5cqw 0 0;
    color: rgba(255, 255, 255, 0.5);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(9.5px, 1.6cqw, 10.5px);
    font-weight: 450;
    line-height: 1.4;
    letter-spacing: -0.002em;
  }

  /* Two restrained attention pulses on the amber line only — a brief dip
     in brightness and back, no scale/bounce/glow — the second visibly
     quieter than the first. Both are one-shot (triggered by adding the
     attribute, spent once the animation finishes) rather than looping. */
  .dy-hero__boundary-title[data-pulse='1'] {
    animation: dy-boundary-pulse-strong 640ms ease;
  }

  .dy-hero__boundary-title[data-pulse='2'] {
    animation: dy-boundary-pulse-soft 640ms ease;
  }

  @keyframes dy-boundary-pulse-strong {
    0%, 100% {
      opacity: 1;
    }
    45% {
      opacity: 0.55;
    }
  }

  @keyframes dy-boundary-pulse-soft {
    0%, 100% {
      opacity: 1;
    }
    45% {
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-goal] [data-goal-typed] {
      opacity: 1;
    }

    .dy-hero__goal-cursor {
      display: none;
    }

    .dy-hero__activity,
    .dy-hero__activity[data-activity='visible'],
    .dy-hero__activity-check {
      transition: none;
    }

    .dy-hero__activity[data-activity='visible'] {
      opacity: 1;
      transform: none;
    }

    .dy-hero__activity[data-activity-state='resolving'] {
      opacity: 1;
    }

    .dy-hero__boundary {
      transition: none;
    }

    .dy-hero__boundary[data-boundary='visible'] {
      opacity: 1;
      transform: none;
    }

    .dy-hero__boundary-title[data-pulse='1'],
    .dy-hero__boundary-title[data-pulse='2'] {
      animation: none;
    }
  }

  @media (min-width: 1320px) {
    .dy-hero__visual {
      justify-self: end;
    }
  }



  .dy-hero__title {
    margin: 0;
    max-width: 650px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(54px, 4.4vw, 72px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }


  .dy-hero__title span {
    display: block;
  }


  .dy-hero__title em {
    color: var(--cobalt);
    font-style: normal;
  }


  .dy-hero__intro {
    max-width: 545px;
    margin: clamp(21px, 2.5vh, 27px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.58;
    letter-spacing: -0.012em;
  }


  .dy-hero__brandword {
    font-weight: 700;
  }


  .dy-hero__subintro {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 545px;
    margin: clamp(22px, 2.8vh, 30px) 0 0;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }


  .dy-hero__subintro-icon {
    flex: none;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    color: var(--cobalt);
  }


  .dy-hero__signature {
    display: flex;
    width: fit-content;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: clamp(22px, 2.8vh, 30px) 0 0;
    padding: 12px 20px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }


  .dy-hero__signature-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--cobalt);
  }


  .dy-hero__signature-arrow {
    color: var(--ink-soft);
  }


  /* Same control as before (id, data-mode/data-state, click handler and
     analytics all unchanged) — restyled from a black pill into the
     quiet label + small saffron circular arrow now used on the Explore
     cards, so it reads as part of the editorial row beside "AI agents"
     rather than a standalone button. */
  .dy-hero__cta {
    width: fit-content;
    /* "Replay" is shorter than "See how" — keeps the row from narrowing
       by a few px when the label swaps. */
    min-width: 78px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: none;
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-family: inherit;
    font-size: 14px;
    font-weight: 620;
    text-decoration: none;
    cursor: pointer;
    box-shadow: none;
    transition: opacity 220ms ease;
  }


  .dy-hero__cta:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  /* Set the instant "See how" is clicked: the CTA remains on screen as a
     completed step — same position, same size — but reads as no longer
     the active action once the explanation stage takes over. Disabling
     pointer-events also removes :hover/:focus-visible for free, so no
     separate override is needed for those. */
  /* Stays clickable once subdued — see the restart branch of its own
     click handler in the script above — so only the visual dimming
     carries over here now, not the pointer-events:none that used to
     make this state permanently inert. */
  .dy-hero__cta[data-state='subdued'] {
    opacity: 0.38;
  }


  /* Renamed from the old bare `.dy-hero__cta span` — now that the
     button holds two label spans alongside the icon (for the
     See how / Replay swap below), a selector matching any span would
     wrongly circle-style the label text too. Sized to match the small
     saffron circular arrow used on the Explore cards (~19px) rather
     than the old button's larger 31px version; hover only shifts it
     ~2px right, no scale/shadow. */
  .dy-hero__cta__icon {
    width: 19px;
    height: 19px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 10px;
    transition: transform 160ms ease;
  }


  .dy-hero__cta:hover .dy-hero__cta__icon {
    transform: translateX(2px);
  }


  /* Both labels and both icons exist in the markup at all times; only
     one label/icon pair is ever shown, switched purely by the button's
     own data-mode (set in the script alongside the rest of this hero's
     state). Nothing here moves the button itself. */
  .dy-hero__cta[data-mode='see-how'] .dy-hero__cta__label--replay,
  .dy-hero__cta[data-mode='see-how'] .dy-hero__cta__icon--replay {
    display: none;
  }


  .dy-hero__cta[data-mode='replay'] .dy-hero__cta__label--see-how,
  .dy-hero__cta[data-mode='replay'] .dy-hero__cta__icon--arrow {
    display: none;
  }


  /* =========================================================
     SCENE 2 — "Software used to wait for you." Lives inside the same
     fixed stage box as the SOFTWARE scene it replaces, so every size
     here is cqw-scaled against that box rather than the vw-based sizing
     a full-page section would use. No background/border/shadow of its
     own — the shared stage canvas carries through underneath it, same
     as everywhere else in this stage.
     ========================================================= */
  .dy-hero__scene2 {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    padding: 10% 9%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
  }

  .dy-hero__explain-stage[data-scene='2'] .dy-hero__scene2 {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__scene2 {
      transition: none;
    }
  }

  .dy-hero__scene2 .dy-shift__inner {
    width: 100%;
    text-align: center;
  }

  .dy-hero__scene2 .dy-shift__title {
    margin: 0 auto;
    max-width: 15ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(15px, 3.1cqw, 20px);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* The main experience: a large horizontal handoff, not five small-caps
     labels shown at once. Every actor and connector below starts
     invisible/undrawn and is revealed in sequence by runScene2Sequence()
     in the script above, reusing the exact [data-reveal]/[data-draw]
     devices already used for the goal->agent connector and the branch
     in the scene before this one — same vocabulary, no new animation
     primitives. */
  .dy-hero__scene2 .dy-shift__flow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: clamp(20px, 5cqw, 34px) 0 0;
  }

  .dy-hero__scene2 .dy-shift__flow-actor {
    position: relative;
    flex: none;
    font-family: var(--sans);
    font-size: clamp(13px, 3.4cqw, 20px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .dy-hero__scene2 .dy-shift__flow-actor--you {
    color: var(--ink);
  }

  /* The one place this sequence takes the cobalt accent — software's own
     recurring colour through the rest of this stage — so the two actors
     stay visually distinct without needing an icon for either. */
  .dy-hero__scene2 .dy-shift__flow-actor--software {
    color: var(--cobalt);
  }

  /* Same thin-line-plus-chevron vocabulary as .dy-hero__handoff, just
     stretched across the space between each pair of actors instead of
     between the goal and the agent. */
  .dy-hero__scene2 .dy-shift__flow-connector {
    flex: 1;
    min-width: 14px;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 clamp(4px, 1.4cqw, 10px);
    color: var(--muted);
  }

  .dy-hero__scene2 .dy-shift__flow-connector-line {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .dy-hero__scene2 .dy-shift__flow-connector-head {
    flex: none;
    width: 6px;
    height: 9px;
  }

  /* The restrained "waiting" cue — the one meaningful use of saffron in
     this sequence beyond the closing realization mark. A small dot
     beneath whichever actor just finished its turn, present only for
     the pause before the next handoff (toggled via [data-waiting] from
     script), not a permanent decoration. */
  .dy-hero__scene2 .dy-shift__flow-wait {
    position: absolute;
    left: 50%;
    top: 100%;
    margin-top: clamp(5px, 1.2cqw, 8px);
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--saffron);
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .dy-hero__scene2 .dy-shift__flow-wait[data-waiting] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    /* No pause to mark once nothing animates, so this stays hidden
       rather than sitting there as an unexplained permanent dot. */
    .dy-hero__scene2 .dy-shift__flow-wait {
      display: none;
    }
  }

  /* The takeaway from watching the sequence — same short saffron marker
     and dark/medium-weight treatment as the SOFTWARE-state realization
     in the scene before this one, so it reads as the same kind of
     moment: "this is what to notice," not just a caption. */
  .dy-hero__scene2 .dy-shift__caption {
    display: inline-flex;
    align-items: center;
    gap: clamp(8px, 1.6cqw, 11px);
    margin: clamp(16px, 3.6cqw, 24px) 0 0;
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(12.5px, 2.4cqw, 15px);
    line-height: 1.3;
  }

  .dy-hero__scene2 .dy-shift__caption .dy-hero__realize-mark {
    margin-top: 0;
  }

  /* Scene 2's continuation — same dark-label + saffron-circle grammar
     as "See what changed" in the SOFTWARE scene, kept as its own
     freestanding button (Scene 2 has no second state to toggle back
     into, unlike that earlier control). */
  .dy-hero__scene2 .dy-hero__scene2-next {
    /* flex, not inline-flex: .dy-shift__caption right above this is
       itself inline-level (inline-flex), so without this the two would
       share the same line box and run into each other side by side
       instead of the button starting its own line beneath it. */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, 0.9cqw, 6px);
    margin: clamp(16px, 3.6cqw, 24px) 0 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dy-hero__scene2 .dy-hero__scene2-next-label {
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(12.5px, 2.4cqw, 15px);
    line-height: 1.3;
  }

  .dy-hero__scene2 .dy-hero__scene2-next-circle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(20px, 4cqw, 27px);
    height: clamp(20px, 4cqw, 27px);
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: clamp(10.5px, 2cqw, 13px);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .dy-hero__scene2 .dy-hero__scene2-next:hover .dy-hero__scene2-next-circle,
  .dy-hero__scene2 .dy-hero__scene2-next:focus-visible .dy-hero__scene2-next-circle {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .dy-hero__explain-stage[data-scene='3'] .dy-hero__scene2-next {
    pointer-events: none;
  }

  /* =========================================================
     SCENE 3 — YOU → [agent working] → GOAL. Same fixed stage box and
     cqw-scaled sizing as Scene 2, and deliberately built on Scene 2's
     own row: the .dy-shift__flow / -actor / -connector rules below are
     exact copies of Scene 2's, so the row this scene opens holding is
     pixel-identical to the one Scene 2 ends on and the handover reads as
     the same diagram rather than a new one. Everything prefixed
     .dy-agent__ is what's new: the two collapse primitives that take the
     old sequence apart, the agent's working surface, the goal, and the
     closing language.
     ========================================================= */
  .dy-hero__scene3 {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    /* Shallower than Scene 2's 10% top/bottom. The horizontal 9% is
       Scene 2's exactly, so the row this scene opens holding is the same
       width as the row Scene 2 ends on and its end actors don't shift
       outward at the handover — see [data-consolidated] below, which
       gives some of that side margin back once the handover is safely
       past and the agent needs the width. */
    padding: 7% 9%;
    transition: padding 560ms cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
  }

  .dy-hero__explain-stage[data-scene='3'] .dy-hero__scene3 {
    opacity: 1;
    pointer-events: auto;
  }

  /* Once the repeated hand-back has collapsed there is no longer any
     reason to hold Scene 2's side margin, and the agent is the only
     thing left worth giving the width to. Set from script at the same
     moment the collapse starts, so the composition reads as expanding
     into the space the repetition just gave up. */
  .dy-hero__scene3[data-consolidated] {
    padding-left: 6%;
    padding-right: 6%;
  }

  @media (prefers-reduced-motion: reduce) {
    .dy-hero__scene3 {
      transition: none;
    }
  }

  .dy-hero__scene3 .dy-shift__inner {
    width: 100%;
    text-align: center;
  }

  /* Freezes the vertical anchor of this column once the laptop has
     settled (see freezeAnchor() in the click handler above), so that
     every beat revealed after that point — the realization, the naming
     line, and whatever follows — only ever grows the column downward
     into the stage's own spare room, instead of the flex parent's
     align-items: center recalculating around a taller box and dragging
     everything already on screen upward with it. Before that point
     (and for every earlier scene, and this one before the laptop is
     asked for) [data-anchored] is absent and normal centring applies
     exactly as before. */
  .dy-hero__scene3[data-anchored] {
    align-items: flex-start;
  }

  .dy-hero__scene3[data-anchored] .dy-shift__inner {
    margin-top: var(--dy-inner-anchor, 0px);
  }


  /* ---- Scene 2's row, carried over unchanged --------------------- */
  .dy-hero__scene3 .dy-shift__flow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .dy-hero__scene3 .dy-shift__flow-actor {
    position: relative;
    flex: none;
    font-family: var(--sans);
    font-size: clamp(13px, 3.4cqw, 20px);
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: font-size 560ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* The person grows with the composition, but only after the handover
     is past — at Scene 2's size the row it opens holding is identical to
     the row Scene 2 ends on, which is the whole basis of that handover. */
  .dy-hero__scene3[data-consolidated] .dy-shift__flow-actor {
    font-size: clamp(13px, 4cqw, 25px);
  }

  .dy-hero__scene3 .dy-shift__flow-actor--you {
    color: var(--ink);
  }

  .dy-hero__scene3 .dy-shift__flow-actor--software {
    color: var(--cobalt);
  }

  .dy-hero__scene3 .dy-shift__flow-connector {
    flex: 1;
    min-width: 14px;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 clamp(4px, 1.4cqw, 10px);
    color: var(--muted);
  }

  .dy-hero__scene3 .dy-shift__flow-connector-line {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .dy-hero__scene3 .dy-shift__flow-connector-head {
    flex: none;
    width: 6px;
    height: 9px;
  }

  /* Scene 2's row carries no title above it here, so its own top margin
     goes; the bottom offset instead holds the row at the same optical
     height Scene 2 left it at (Scene 2's row sits above its box's centre
     because of the caption and button beneath it), and is released the
     moment the closing language starts making room for itself. Carried by
     the slot rather than the row itself, since the row no longer owns
     that space on its own. */
  .dy-hero__scene3 .dy-agent__slot {
    position: relative;
    display: grid;
    margin: 0 0 clamp(6px, 2.1cqw, 13.5px);
    transition: margin-bottom 520ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Both occupants share one grid cell, so the slot is always as tall as
     the taller of them and the handover moves nothing. */
  .dy-hero__scene3 .dy-agent__slot > * {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
  }

  .dy-hero__scene3[data-settled] .dy-agent__slot {
    margin-bottom: 0;
  }

  .dy-hero__scene3 .dy-agent__row {
    width: 100%;
    margin: 0;
    transition: opacity 420ms ease;
  }

  /* The diagram has said everything it has to say by this point; it steps
     aside rather than competing with the laptop for the same space. */
  .dy-hero__scene3[data-handover] .dy-agent__row {
    opacity: 0;
    pointer-events: none;
  }

  /* ...and then stops sizing the slot at all. The diagram is much taller
     than the laptop that replaces it, so if it kept contributing height
     the laptop would sit marooned in the middle of the room the diagram
     used to need. Set a beat after [data-handover], once the diagram has
     fully faded and the laptop has not yet arrived, so the height the
     slot gives up costs no visible movement. */
  .dy-hero__scene3[data-collapsed] .dy-agent__row {
    position: absolute;
    inset: 0;
  }

  .dy-hero__scene3[data-handover] .dy-agent__laptop {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---- The two collapse primitives -------------------------------
     One for content-sized members of the row (the actors, the agent's
     surface, the goal): a max-width animated between the member's own
     width and nothing, so a member can leave or arrive without the row
     ever jumping. The width itself comes from --dy-cell-w, which the
     script measures once before the transformation starts (a 0fr grid
     track — the horizontal twin of the usual animate-to-auto-height
     trick — does not collapse here: the cell is a flex:none item, so it
     is sized under a max-content constraint that floors the track at its
     content width).

     The other is for the connectors, which are flexible rather than
     content-sized, so they give up their flex-grow, their minimum and
     their margins instead.

     Both are used in both directions: [data-shut] is set from script on
     what the old sequence no longer needs, and removed from what the new
     one does.

     Each state carries its own timing, because a width animation and a
     fade have to be ordered differently in each direction: a member
     leaving fades out first and only then gives up its width (otherwise
     its label is visibly sliced in half mid-word), while a member
     arriving opens its room first and fades in once it has it. */
  .dy-hero__scene3 .dy-agent__cell {
    flex: none;
    overflow: hidden;
    max-width: var(--dy-cell-w, none);
    transition: max-width 420ms cubic-bezier(0.4, 0, 0.2, 1), opacity 240ms ease 320ms;
  }

  .dy-hero__scene3 .dy-agent__cell[data-shut] {
    max-width: 0;
    opacity: 0;
    transition: max-width 420ms cubic-bezier(0.4, 0, 0.2, 1) 240ms, opacity 240ms ease;
  }

  .dy-hero__scene3 .dy-agent__link {
    overflow: hidden;
    transition: flex-grow 420ms cubic-bezier(0.4, 0, 0.2, 1), flex-basis 420ms cubic-bezier(0.4, 0, 0.2, 1), min-width 420ms cubic-bezier(0.4, 0, 0.2, 1), margin 420ms cubic-bezier(0.4, 0, 0.2, 1), opacity 240ms ease 320ms;
  }

  .dy-hero__scene3 .dy-agent__link[data-shut] {
    flex-grow: 0;
    flex-basis: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    opacity: 0;
    transition: flex-grow 420ms cubic-bezier(0.4, 0, 0.2, 1) 240ms, flex-basis 420ms cubic-bezier(0.4, 0, 0.2, 1) 240ms, min-width 420ms cubic-bezier(0.4, 0, 0.2, 1) 240ms, margin 420ms cubic-bezier(0.4, 0, 0.2, 1) 240ms, opacity 240ms ease;
  }

  /* Until the transformation starts, the connectors are flex:1 and share
     out the row's leftover width exactly as they do in Scene 2 — which
     is what makes the handover pixel-identical. Once the repetition has
     been removed, though, that same rule would stretch the one remaining
     connector across everything the departed members gave up and shove
     the agent hard against the right edge. From that point on they take
     a fixed length (the same ~46px they were already sitting at on
     desktop), so what's left of the sequence stays a centred group. */
  .dy-hero__scene3[data-consolidated] .dy-shift__flow-connector:not([data-shut]) {
    flex-grow: 0;
    /* Shorter than the ~46px they sat at in Scene 2: the connectors are
       the least important thing in the resolved row, so the length they
       give up here is what lets the agent itself be as large as it is. */
    flex-basis: clamp(16px, 5cqw, 32px);
    margin-left: clamp(3px, 1cqw, 7px);
    margin-right: clamp(3px, 1cqw, 7px);
  }

  /* ---- The agent's working object ---------------------------------
     Round rather than rectangular, and built out of what this page has
     already taught: the same flight / hotel / calendar symbols as the
     travel-agent scene, cobalt for the work in progress, saffron for the
     one moment that doesn't go to plan. Warm and semi-transparent so the
     stage canvas reads through it rather than a card sitting on top, one
     graphite hairline for structure, and a single slow-breathing ring —
     the only thing here that moves on its own — so the object feels
     alive while it works instead of merely animated at. */
  .dy-hero__scene3 .dy-agent__core {
    /* The dominant object on this stage. It can be this large because
       nothing else is competing for the height any more — the naming and
       the definition that used to sit beneath the diagram are held back
       for the laptop now — and because the connectors and the stage's own
       side padding both give up width to it once the row has resolved.
       Sized so the row still clears the stage at its narrowest: You (34)
       + two connectors (46 each) + goal (148) leaves this the rest. */
    width: clamp(104px, 41cqw, 262px);
  }

  .dy-hero__scene3 .dy-agent__orbit {
    display: block;
    width: 100%;
    height: auto;
    /* The breathing ring grows past r=60 and the route's round caps sit
       right on the edge; neither should be clipped. */
    overflow: visible;
  }

  .dy-hero__scene3 .dy-agent__orbit-face {
    fill: rgba(255, 253, 250, 0.55);
    stroke: rgba(17, 21, 28, 0.09);
    stroke-width: 1;
  }

  .dy-hero__scene3 .dy-agent__orbit-halo {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1;
    opacity: 0.2;
    transform-box: view-box;
    transform-origin: 66px 66px;
    animation: dy-agent-breathe 3.4s ease-in-out infinite;
  }

  @keyframes dy-agent-breathe {
    0%, 100% { transform: scale(1); opacity: 0.13; }
    50% { transform: scale(1.05); opacity: 0.32; }
  }

  /* The route. Each segment is drawn by running its own dash back to
     zero — pathLength="1" in the markup means the same transition works
     for every segment whatever its real length. The fourth segment is
     the reroute; it carries no special styling because the direction it
     travels is the signal, not its colour. */
  .dy-hero__scene3 .dy-agent__route {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.8;
    transition: stroke-dashoffset 460ms ease;
  }

  .dy-hero__scene3 .dy-agent__route[data-drawn='1'] {
    stroke-dashoffset: 0;
  }

  /* Idle: present but dormant, so the object reads as one thing before
     anything happens in it. Active: cobalt, at full strength. Blocked:
     the brief saffron moment. Dropped: it stays saffron but recedes —
     the still frame should keep saying "this one didn't work out", which
     is what makes the reroute legible after the motion has finished. */
  .dy-hero__scene3 .dy-agent__node {
    color: var(--muted);
    opacity: 0.5;
    transition: color 300ms ease, opacity 300ms ease;
  }

  .dy-hero__scene3 .dy-agent__node-ring {
    fill: rgba(255, 253, 250, 0.92);
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.55;
  }

  .dy-hero__scene3 .dy-agent__node-glyph {
    overflow: visible;
  }

  .dy-hero__scene3 .dy-agent__node[data-state='active'] {
    color: var(--cobalt);
    opacity: 1;
  }

  .dy-hero__scene3 .dy-agent__node[data-state='blocked'] {
    color: var(--saffron);
    opacity: 1;
  }

  .dy-hero__scene3 .dy-agent__node[data-state='dropped'] {
    color: var(--saffron);
    opacity: 0.42;
  }

  .dy-hero__scene3 .dy-agent__node-check-bg {
    fill: rgba(255, 253, 250, 0.96);
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .dy-hero__scene3 .dy-agent__node-check {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .dy-hero__scene3 .dy-agent__node[data-state='active'] .dy-agent__node-check,
  .dy-hero__scene3 .dy-agent__node[data-state='active'] .dy-agent__node-check-bg {
    opacity: 1;
  }

  /* ---- The destination -------------------------------------------
     A label and the same Tokyo sentence in the same
     .dy-hero__explain-quote treatment it already carries earlier in this
     stage — native type, no image, and no saffron: this is where the
     work was going, not an alert. The label lifts from muted to ink at
     the moment the agent's run reaches it. */
  .dy-hero__scene3 .dy-agent__goal {
    width: clamp(88px, 23cqw, 148px);
    text-align: left;
  }

  .dy-hero__scene3 .dy-agent__goal-label {
    margin: 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: clamp(8px, 1.75cqw, 11px);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color 320ms ease;
  }

  .dy-hero__scene3 .dy-agent__goal[data-reached] .dy-agent__goal-label {
    color: var(--ink);
  }

  .dy-hero__scene3 .dy-agent__goal-text {
    margin: clamp(4px, 1.3cqw, 9px) 0 0;
    max-width: none;
    font-size: clamp(9.5px, 2.25cqw, 14.5px);
    line-height: 1.35;
  }

  /* The invitation to the laptop — the same control Scene 2 ends on,
     restated here rather than shared so this scene keeps evolving on its
     own. Retires on click by fading rather than collapsing: its row of
     space stays reserved, which is what stops the three lines above it
     from drifting while the laptop is arriving. */
  .dy-hero__scene3 .dy-agent__ask {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, 0.9cqw, 6px);
    margin: clamp(13px, 3.2cqw, 22px) auto 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: opacity 300ms ease;
  }

  .dy-hero__scene3 .dy-agent__ask-label {
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(11px, 2.2cqw, 14px);
    line-height: 1.3;
  }

  .dy-hero__scene3 .dy-agent__ask-circle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(18px, 3.7cqw, 25px);
    height: clamp(18px, 3.7cqw, 25px);
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: clamp(10px, 1.9cqw, 12.5px);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .dy-hero__scene3 .dy-agent__ask:hover .dy-agent__ask-circle,
  .dy-hero__scene3 .dy-agent__ask:focus-visible .dy-agent__ask-circle {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .dy-hero__scene3[data-handover] .dy-agent__ask {
    opacity: 0;
    pointer-events: none;
  }

  /* ---- The laptop returning for a decision -------------------------
     The same photograph as the top of the page, at the size that makes it
     exactly as tall as the diagram it replaces (the source is 1672x941,
     so the wrapper carries that ratio and the image fills it). The
     screen's own percentages were originally measured against the 3:2
     stage box rather than the photo, so they are restated here against
     this photo-shaped box — same place on the same laptop, different
     containing block. */
  .dy-hero__scene3 .dy-agent__laptop {
    position: relative;
    /* Driven by the scene's own handover state rather than [data-reveal],
       so it stays hidden until the visitor asks for it — including under
       reduced motion, where the stage-wide [data-reveal] override would
       otherwise render it straight away, stacked over the diagram. */
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
    /* ~18% larger than the previous size (and, on top of that, a
       further ~15% here) — the dominant object in this state now that
       the diagram has fully retired. */
    width: clamp(204px, 59cqw, 375px);
    /* The same 3:2 box the photograph occupies at the top of the page,
       which is what lets it keep .dy-hero__visual img's own crop
       (object-position 54%) and its edge-dissolving mask untouched — that
       mask's protected region was measured against this framing, so any
       other box shape leaves the photo sitting on the stage as a pasted
       rectangle. .dy-hero__screen's percentages land correctly for the
       same reason. */
    aspect-ratio: 3 / 2;
    /* Lets .dy-hero__screen's cqw-based type scale against this laptop
       rather than the whole stage, which would size the screen's text as
       though it were still the full-width photograph. */
    container-type: inline-size;
  }

  /* .dy-hero__visual img's own edge-dissolving mask carries through to
     this copy unchanged — same three layers, same stops. The one thing
     restated is its radial term, tightened to start falling off much
     earlier: those stops are percentages, so at roughly two-fifths the
     photograph's original width every fade band is also two-fifths as
     wide in actual pixels, and what reads as a dissolve at 640px reads
     as an edge at 276px. The laptop itself sits inside 13%-88% across
     and 9%-93% down, so this still leaves it at full opacity and only
     takes the room and table around it. */
  .dy-hero__scene3 .dy-agent__laptop img {
    -webkit-mask-image:
      radial-gradient(ellipse 74% 84% at 51% 52%, #000 0 46%, rgba(0, 0, 0, 0.62) 72%, rgba(0, 0, 0, 0.2) 90%, transparent 100%),
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.05) 1.5%, rgba(0, 0, 0, 0.17) 3.5%, rgba(0, 0, 0, 0.38) 6%, rgba(0, 0, 0, 0.65) 8.5%, rgba(0, 0, 0, 0.89) 10.5%, #000 11.5%, #000 91.5%, rgba(0, 0, 0, 0.72) 94%, rgba(0, 0, 0, 0.42) 96.5%, rgba(0, 0, 0, 0.18) 98.5%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.14) 1.5%, rgba(0, 0, 0, 0.4) 3.5%, rgba(0, 0, 0, 0.74) 5.5%, #000 7.5%, #000 94.5%, rgba(0, 0, 0, 0.62) 96.5%, rgba(0, 0, 0, 0.26) 98.5%, transparent 100%);
    mask-image:
      radial-gradient(ellipse 74% 84% at 51% 52%, #000 0 46%, rgba(0, 0, 0, 0.62) 72%, rgba(0, 0, 0, 0.2) 90%, transparent 100%),
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.05) 1.5%, rgba(0, 0, 0, 0.17) 3.5%, rgba(0, 0, 0, 0.38) 6%, rgba(0, 0, 0, 0.65) 8.5%, rgba(0, 0, 0, 0.89) 10.5%, #000 11.5%, #000 91.5%, rgba(0, 0, 0, 0.72) 94%, rgba(0, 0, 0, 0.42) 96.5%, rgba(0, 0, 0, 0.18) 98.5%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.14) 1.5%, rgba(0, 0, 0, 0.4) 3.5%, rgba(0, 0, 0, 0.74) 5.5%, #000 7.5%, #000 94.5%, rgba(0, 0, 0, 0.62) 96.5%, rgba(0, 0, 0, 0.26) 98.5%, transparent 100%);
  }

  /* One message on an otherwise empty screen sits centred rather than
     pinned to the top-left, where the goal line and the completed steps
     used to hold it up. Narrower side padding than the full-size screen
     carries, so the approval line still clears one line at this width. */
  .dy-hero__scene3 .dy-agent__laptop .dy-hero__screen-plane {
    display: flex;
    align-items: center;
    padding: 0 7% 0 8%;
  }

  /* The boundary keeps its own established treatment — warm amber
     colour, fade-and-rise entrance — but sized up from the type this
     smaller screen carried before: at the previous sizes (8.6px title,
     7.5px sub, at this laptop's own largest) the line was legible but
     not comfortable at a normal viewing distance. cqw is scoped to the
     laptop wrapper's own width (see its container-type above), so this
     scales down correctly for the same laptop at mobile sizes rather
     than needing a separate breakpoint. */
  .dy-hero__scene3 .dy-agent__laptop .dy-hero__boundary {
    margin: 0;
  }

  /* The one line this whole state exists to deliver — noticeably bolder
     and larger than the sub-line below, not just longer. */
  .dy-hero__scene3 .dy-agent__laptop .dy-hero__boundary-title {
    font-size: clamp(11px, 4.6cqw, 15px);
    font-weight: 650;
    line-height: 1.3;
  }

  /* Subordinate to the title — smaller, lighter weight, a plainer
     colour — but a visitor should still read it without leaning in, so
     it keeps more presence than the original 0.5-opacity treatment this
     line carries at the top of the page. */
  .dy-hero__scene3 .dy-agent__laptop .dy-hero__boundary-sub {
    margin-top: 0.9cqw;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(9px, 3.6cqw, 11.5px);
    font-weight: 500;
    line-height: 1.35;
  }

  /* ---- The closing language ---------------------------------------
     Each beat opens its own room beneath the diagram rather than the
     scene reserving empty space for both from the start — which would
     have put the row well off Scene 2's own height at the handover. */
  .dy-hero__scene3 .dy-agent__reveal {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 520ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dy-hero__scene3 .dy-agent__reveal[data-shut] {
    grid-template-rows: 0fr;
  }

  .dy-hero__scene3 .dy-agent__reveal-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* Same saffron mark and dark/medium-weight sans as every other
     realization in this stage — noticed, but still quieter than the
     serif payoff below it. */
  .dy-hero__scene3 .dy-agent__realize {
    display: inline-flex;
    align-items: flex-start;
    gap: clamp(8px, 1.6cqw, 11px);
    margin: clamp(16px, 4cqw, 28px) 0 0;
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(10.5px, 2.2cqw, 14.5px);
    line-height: 1.35;
    text-align: left;
  }

  /* Its fade is slower than the generic 220ms [data-reveal] transition
     this stage uses everywhere else. The [data-reveal] attribute is
     included here purely to match that generic rule's specificity
     (two classes alone loses to one class + two attributes) so this,
     appearing later in the file, wins on source order. The brief pause
     already built into the click handler above lets "Waiting for your
     approval" register on its own first; this line should then visibly
     settle in rather than snap — "slowly reveal", not a new visual
     language. */
  .dy-hero__scene3 .dy-agent__realize[data-reveal] {
    transition: opacity 1100ms ease;
  }

  .dy-hero__scene3 .dy-agent__realize .dy-hero__realize-mark {
    margin-top: 0.55em;
  }

  /* The payoff of the entire hero journey — the site's own serif at
     headline weight with the term itself in cobalt, the same emphasis
     grammar the rest of the page already uses. No new component. */
  .dy-hero__scene3 .dy-agent__name {
    /* A real gap above this line, not the next line of the realization
       above it — enough that it reads as the concluding reveal of the
       whole sequence, not a third clause of "It figured out what to do
       next." A touch smaller than this rule first carried: the naming
       beat is new room being added below content that must not move
       (see freezeAnchor() in the click handler above), and the stage
       only has a fixed amount of spare room beneath it — this size,
       measured against .dy-agent__name's own actual bottom edge (the
       only thing here that's genuinely visible; the retired "So when
       does it need you?" control still occupies invisible flow space
       past it, which isn't a real constraint), is what that spare room
       actually holds with this larger gap above it. */
    margin: clamp(16px, 4cqw, 24px) 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(14px, 3.5cqw, 22px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .dy-hero__scene3 .dy-agent__name em {
    color: var(--cobalt);
    font-style: normal;
  }

  /* Same slow, deliberate fade as .dy-agent__realize above, and the same
     reason the [data-reveal] attribute is included: to match the generic
     220ms [data-reveal] rule's specificity (two classes alone loses to
     one class + two attributes) so this, appearing later in the file,
     wins on source order rather than being silently overridden by it. */
  .dy-hero__scene3 .dy-agent__name[data-reveal] {
    transition: opacity 1100ms ease;
  }

  .dy-hero__scene3 .dy-agent__support {
    margin: clamp(6px, 1.6cqw, 11px) auto 0;
    max-width: 40ch;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(9.5px, 1.95cqw, 13.5px);
    line-height: 1.45;
    /* Not part of this state yet — the click handler above never calls
       show() on it (see "Do not add the supporting sentence yet"). Taken
       out of layout entirely, not just faded to opacity 0: the payoff
       wrapper's grid-template-rows: 1fr sizes to whatever is inside it,
       and reserving this paragraph's own height (it wraps to two lines)
       would overflow the naming line past the stage's own bottom edge
       for a sentence nobody can see yet. A later step that adds this
       line back can remove this rule at the same time it starts
       revealing the paragraph. */
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Nothing takes the sequence apart when there's no motion, so this
       scene has to render its settled end state directly: the members
       the transformation removes are simply not there, the members it
       brings in are already open, every step is already complete, and
       the closing language already has its room. */
    .dy-hero__scene3 [data-agent-transient] {
      display: none;
    }

    .dy-hero__scene3 .dy-agent__cell[data-shut] {
      max-width: none;
      opacity: 1;
    }

    .dy-hero__scene3 .dy-agent__link[data-shut] {
      flex-basis: clamp(16px, 5cqw, 32px);
      min-width: 14px;
      margin-left: clamp(3px, 1cqw, 7px);
      margin-right: clamp(3px, 1cqw, 7px);
      opacity: 1;
    }

    /* The script never sets [data-consolidated] here, so the connectors
       and the stage's own side padding need the settled values it would
       have given them — otherwise this state renders with the agent
       pushed to the far right and short of the width it is sized for. */
    .dy-hero__scene3 .dy-shift__flow-connector:not([data-shut]) {
      flex-grow: 0;
      flex-basis: clamp(16px, 5cqw, 32px);
    }

    .dy-hero__scene3 {
      padding-left: 6%;
      padding-right: 6%;
    }

    .dy-hero__scene3 .dy-shift__flow-actor {
      font-size: clamp(13px, 4cqw, 25px);
    }

    .dy-hero__scene3 .dy-agent__reveal[data-shut] {
      grid-template-rows: 1fr;
    }

    /* ...except these two, both for the same reason: neither is part
       of this state until the laptop is asked for — before that click
       both must stay closed, rather than the generic [data-shut] rule
       above rendering them the instant the scene appears. Once
       [data-handover] is set neither rule matches any more, so both
       fall through to that generic rule and open — instantly, like
       everything else under reduced motion, since the click handler's
       reduced-motion branch sets data-handover and calls open() on both
       in the same synchronous click. */
    .dy-hero__scene3:not([data-handover]) .dy-agent__reveal[data-agent-realize],
    .dy-hero__scene3:not([data-handover]) .dy-agent__reveal[data-agent-payoff] {
      grid-template-rows: 0fr;
    }

    /* The payoff wrapper now opens for its first line; the second
       ("Software that can work...") isn't part of this state yet and is
       display: none at the base rule above, in every motion mode — so
       there's nothing further to override here under reduced motion. */

    .dy-hero__scene3 .dy-agent__slot {
      margin-bottom: 0;
    }

    /* The diagram, and the invitation to move past it, are both showing;
       the laptop is not, and does not until that invitation is used. */
    .dy-hero__scene3 .dy-agent__laptop .dy-hero__boundary {
      opacity: 1;
      transform: none;
    }

    /* The whole route is already travelled, every symbol it reached is
       lit, the flight that fell through is shown as having fallen
       through, and the object holds still rather than breathing. */
    .dy-hero__scene3 .dy-agent__route {
      stroke-dashoffset: 0;
    }

    .dy-hero__scene3 .dy-agent__node {
      color: var(--cobalt);
      opacity: 1;
    }

    .dy-hero__scene3 .dy-agent__node--flight {
      color: var(--saffron);
      opacity: 0.42;
    }

    .dy-hero__scene3 .dy-agent__node-check,
    .dy-hero__scene3 .dy-agent__node-check-bg {
      opacity: 1;
    }

    .dy-hero__scene3 .dy-agent__orbit-halo {
      animation: none;
      opacity: 0.16;
    }

    .dy-hero__scene3 .dy-agent__goal-label {
      color: var(--ink);
    }

    .dy-hero__scene3,
    .dy-hero__scene3 .dy-shift__flow-actor,
    .dy-hero__scene3 .dy-agent__cell,
    .dy-hero__scene3 .dy-agent__link,
    .dy-hero__scene3 .dy-agent__reveal,
    .dy-hero__scene3 .dy-agent__slot,
    .dy-hero__scene3 .dy-agent__row,
    .dy-hero__scene3 .dy-agent__laptop,
    .dy-hero__scene3 .dy-agent__ask,
    .dy-hero__scene3 .dy-agent__route,
    .dy-hero__scene3 .dy-agent__node,
    .dy-hero__scene3 .dy-agent__node-check,
    .dy-hero__scene3 .dy-agent__node-check-bg,
    .dy-hero__scene3 .dy-agent__goal-label {
      transition: none;
    }
  }

  /* Scene 3 resolves into a full composition (row + realization +
     payoff) inside a stage barely 230px tall and 350px wide here, so the
     row's members give up what they can: the agent's surface and the
     goal take fixed narrow widths instead of their cqw share, and the
     connectors stop reserving a minimum. Kept here rather than in the
     stage's main @container block above, which the Scene 3 rules would
     otherwise override on source order. Desktop is untouched. */
  @container (max-width: 480px) {
    /* The naming and the definition no longer sit under the diagram
       before the laptop, so the agent takes that room here as well —
       still inside what the row can carry at this width: You (~22) +
       two connectors (~22 each) + goal (80) leaves it the rest. */
    .dy-hero__scene3 .dy-agent__core {
      width: 136px;
    }

    .dy-hero__scene3 .dy-agent__goal {
      width: 80px;
    }

    .dy-hero__scene3 .dy-shift__flow-connector {
      min-width: 8px;
      margin: 0 3px;
    }

    .dy-hero__scene3 .dy-agent__link[data-shut] {
      min-width: 0;
      margin-left: 0;
      margin-right: 0;
    }

    /* The margin moved to the slot when the laptop joined the row in it;
       this is the same compaction, retargeted. */
    .dy-hero__scene3 .dy-agent__slot {
      margin-bottom: 6px;
    }

    /* The invitation is one more tier than this stage height had budget
       for — at 231px tall it pushed the composition past
       .dy-hero__visual's own clip. The diagram and the copy are already
       at their floors here, so the room comes out of the gaps between
       them. Desktop keeps its own spacing untouched. */
    .dy-hero__scene3 .dy-agent__realize {
      margin-top: 8px;
    }

    .dy-hero__scene3 .dy-agent__name {
      margin-top: 13px;
    }

    .dy-hero__scene3 .dy-agent__ask {
      margin-top: 5px;
    }

    .dy-hero__scene3 .dy-agent__ask-label {
      font-size: 10.5px;
    }

    .dy-hero__scene3 .dy-agent__ask-circle {
      width: 16px;
      height: 16px;
      font-size: 9px;
    }
  }
  /* =========================================================
     LOOK CLOSER (explore-preview cards)
     ========================================================= */
  .dy-explore {
    padding: clamp(28px, 4vh, 48px) 0 clamp(50px, 7.5vh, 84px);
  }


  .dy-explore__head {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }


  .dy-explore__title {
    margin: 0 auto;
    white-space: nowrap;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.042em;
  }


  .dy-explore__title-accent {
    color: var(--cobalt);
  }


  .dy-explore__sub {
    margin: clamp(10px, 1.4vh, 14px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(14.5px, 1.1vw, 16px);
    line-height: 1.5;
  }


  .dy-explore__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin: clamp(28px, 4vh, 44px) 0 0;
    padding: 0;
    list-style: none;
  }


  .dy-explore__card {
    min-width: 0;
  }


  .dy-explore__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--paper);
    text-decoration: none;
    overflow: hidden;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 240ms ease,
      border-color 240ms ease;
  }


  .dy-explore__link:hover {
    transform: translateY(-3px);
    border-color: rgba(232, 117, 36, 0.34);
    box-shadow: 0 16px 36px rgba(72, 56, 38, 0.09);
  }


  .dy-explore__art {
    display: block;
    aspect-ratio: 3 / 2;
    line-height: 0;
    background: var(--cream);
    overflow: hidden;
  }


  .dy-explore__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .dy-explore__label {
    margin: 18px 20px 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 16.5px;
    font-weight: 640;
    line-height: 1.24;
    letter-spacing: -0.005em;
  }


  /* Card 1's title carries an intentional two-line composition on
     desktop — recognition, then the curiosity gap. The break is only
     rendered once the grid has room for it (see the 981px breakpoint
     below); at narrower widths it's suppressed so the sentence just
     wraps naturally instead of forcing an awkward split. */
  .dy-explore__label-break {
    display: none;
  }
@media (min-width: 981px) {
    .dy-explore__label-break {
      display: block;
    }
}


  /* The same quiet page-turn idiom used throughout the Explore stories
     (5G, the photo journey): serif text, ink, a small saffron circle
     carrying the arrow. Pinned to the bottom of the card via the flex
     column's own margin-top: auto, so it lines up across all four cards
     regardless of whether a label wraps to one line or two. */
  .dy-explore__see {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: auto 20px 14px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.006em;
  }


  .dy-explore__see span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    transition: transform 160ms ease;
  }


  .dy-explore__link:hover .dy-explore__see span {
    transform: translateX(2px);
  }


  .dy-explore__cta {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    margin: clamp(30px, 4.5vh, 44px) auto 0;
    padding: 12px 22px;
    border: 1.5px solid var(--cobalt);
    border-radius: 999px;
    color: var(--cobalt);
    font-size: 14.5px;
    font-weight: 640;
    text-decoration: none;
    transition: background 200ms ease, transform 200ms ease;
  }


  .dy-explore__cta:hover {
    background: rgba(36, 92, 255, 0.08);
    transform: translateY(-1px);
  }


  .dy-explore__cta:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }


  /* =========================================================
     SHARED — eyebrow label (used by LOOK CLOSER and JOIN)
     ========================================================= */
  .dy-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


  .dy-eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 5px rgba(232, 117, 36, 0.1);
  }


  /* =========================================================
     JOIN
     ========================================================= */
  .dy-join {
    padding: clamp(50px, 7.5vh, 84px) 0 clamp(70px, 10vh, 116px);
  }


  .dy-join__panel {
    position: relative;
    /* Narrower than the page grid so the copy + form read as one focused
       action rather than a full-width band — no boxed card chrome, so the
       section continues the same open, editorial feel as the ones above.
       Left-aligned (not centered) within the shell so its left edge sits
       on the same content spine as the Discovery card grid above and the
       footer below, rather than floating independently centered. */
    max-width: 1180px;
    margin-right: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(28px, 4vw, 64px);
  }


  .dy-join__copy h2 {
    margin: 0;
    max-width: 15ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(30px, 3.1vw, 42px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }


  .dy-join__desc {
    margin: 14px 0 0;
    max-width: 34ch;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.6;
  }


  .dy-form label {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 620;
    letter-spacing: 0.02em;
  }


  .dy-form__row {
    display: flex;
    gap: 9px;
  }


  .dy-form input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }


  .dy-form input::placeholder {
    color: var(--muted-light);
  }


  /* Focus is interface state, so it carries the brand colour —
     saffron stays reserved for discovery. */
  .dy-form input:focus {
    outline: none;
    border-color: var(--cobalt);
    box-shadow: 0 0 0 3px rgba(36, 92, 255, 0.16);
  }


  .dy-form button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 22px;
    border: 0;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 640;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
  }


  .dy-form button:hover:not(:disabled) {
    background: #000;
    transform: translateY(-1px);
  }


  .dy-form button:disabled {
    opacity: 0.62;
    cursor: progress;
  }


  .dy-form__status {
    margin: 0;
    max-height: 0;
    overflow: hidden;
    font-size: 13.5px;
    line-height: 1.45;
    transition: max-height 260ms ease, margin 260ms ease;
  }


  .dy-form__status[data-state] {
    margin-top: 12px;
    max-height: 5rem;
  }


  .dy-form__status[data-state='error'] {
    color: #c0442d;
  }


  .dy-form__status[data-state='success'] {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border-radius: 10px;
    background: rgba(31, 122, 77, 0.09);
    color: #17603b;
    font-weight: 560;
  }


  .dy-form__status[data-state='success']::before {
    content: '✓';
    display: grid;
    place-items: center;
    flex: none;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: #1f7a4d;
    color: #fff;
    font-size: 11px;
  }


  .dy-form__note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: 14px 0 0;
    color: var(--muted-light);
    font-size: 12.5px;
    line-height: 1.45;
  }


  .dy-form__note svg {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 1px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
@media (max-width: 1319px) {
    .dy-hero__grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .dy-hero__brand {
      max-width: none;
    }
}
@media (max-width: 1319px) {
    /* The grid is reserved for 4 columns once each card has enough width
       to hold its title on two lines (measured directly: card width stays
       just under what the longest titles need until the viewport clears
       1320px — the same crossover already used for the hero stage above).
       Below that it degrades to 2-up (and 1-up further down) so a single
       card never gets squeezed to a quarter-width sliver with 3-4 line
       titles. */
    .dy-explore__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 980px) {
    .dy-join__panel {
      grid-template-columns: 1fr;
      gap: 26px;
