---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentStage from '../components/hero/AgentStage.astro';
import { getCollection } from 'astro:content';

const published = (
  await getCollection('topics', ({ data }) => data.status === 'published')
).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

// The hero's right side is an experience now, not a topic slot. The `featured`
// topic is still held out of the list below so that section keeps showing
// exactly what it showed before.
const featuredTopic = published.find((topic) => topic.data.featured);

// Everything else lines up below — the previous feature simply moves down here.
const topics = published.filter((topic) => topic.id !== featuredTopic?.id).slice(0, 3);

const categoryLabel = {
  'identity-security': 'Identity & security',
  networks: 'Networks',
  'ai-agents': 'AI agents',
  'money-payments': 'Money & payments',
  'everyday-tech': 'Everyday tech',
};

---

<BaseLayout>
  <!-- ============================================================
       HERO — the brand statement, plus the feature stage beside it
       ============================================================ -->
  <section class="dy-hero">
    <div class="shell dy-hero__grid">
      <div class="dy-hero__brand">
        <p class="dy-hero__thought">
          There's more happening around you than you realize.
        </p>

        <h1 class="dy-hero__title">
          Understand the world
          <span>that's <em>arriving.</em></span>
        </h1>

        <p class="dy-hero__intro">
          Technology makes more sense when you understand why it exists,
          see how it works, and know where it matters.
        </p>

        <a class="dy-hero__cta" href="/explore">
          See what's happening
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <AgentStage />
    </div>
  </section>


  <!-- ============================================================
       METHOD
       ============================================================ -->
  <section class="dy-method">
    <div class="shell dy-method__inner">
      <h2 class="dy-method__title">
        How <span class="brand-inline"><span class="brand-inline__dekho">Dekho</span><span class="brand-inline__yahan">Yahan</span></span> makes things click
      </h2>

      <ul class="dy-method__list">
        <li>
          <span class="dy-method__icon" data-tone="blue" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z" /><circle cx="12" cy="12" r="3.2" /></svg>
          </span>
          <strong>See what you know.</strong>
          <span>Start from something ordinary.</span>
        </li>
        <li>
          <span class="dy-method__icon" data-tone="orange" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l2.1 5.6L20 10.6l-5.2 2.9L13.4 20 12 14.6 6.6 16l3.1-4.6L6 6.9l5 1.1z" /></svg>
          </span>
          <strong>Reveal what’s underneath.</strong>
          <span>We show the real mechanism.</span>
        </li>
        <li>
          <span class="dy-method__icon" data-tone="ink" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M15.5 20.5v-3a5.6 5.6 0 0 0 3-4.9 6.5 6.5 0 1 0-9.9 5.6v2.3" /><path d="M9 20.5h6.5" /></svg>
          </span>
          <strong>Understand why it matters.</strong>
          <span>So it actually stays with you.</span>
        </li>
      </ul>

      <p class="dy-method__path" aria-hidden="true">
        See it <i>→</i> Get it <i>→</i> Look deeper
      </p>
    </div>
  </section>

  <!-- ============================================================
       TOPICS
       ============================================================ -->
  {topics.length > 0 && (
    <section class="dy-topics">
      <div class="shell">
        <header class="dy-topics__head">
          <p class="dy-eyebrow"><span></span> Start looking</p>
          <h2>Pick something you use every day.</h2>
        </header>

        <ul class="dy-topics__grid">
          {topics.map((topic) => (
            <li>
              <a href={`/explore/${topic.id}/`}>
                <span class="dy-topics__cat">{categoryLabel[topic.data.category] ?? topic.data.category}</span>
                <h3>{topic.data.title}</h3>
                <p>{topic.data.hook}</p>
                <span class="dy-topics__go" aria-hidden="true">Look closer →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============================================================
       JOIN
       ============================================================ -->
  <section class="dy-join" id="early-access">
    <div class="shell">
      <div class="dy-join__panel">
        <div class="dy-join__copy">
          <p class="dy-eyebrow"><span></span> Join DekhoYahan</p>
          <h2>Get new topics by email.</h2>
          <p class="dy-join__desc">
            When we add a new topic, we send you one short email.
            Nothing else.
          </p>
        </div>

        <form class="dy-form" id="join-form" novalidate>
          <label for="join-email">Your email</label>

          <div class="dy-form__row">
            <input
              id="join-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            />
            <button type="submit">
              <span class="dy-form__label">Join</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <p class="dy-form__status" id="join-status" role="status" aria-live="polite"></p>

          <p class="dy-form__note">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3l7 3v6c0 4.4-3 8.1-7 9-4-0.9-7-4.6-7-9V6z" />
              <path d="M9 12.2l2.1 2.1L15.2 10" />
            </svg>
            We use your email only for this. You can stop any time.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('#join-form');
  const emailInput = document.querySelector('#join-email');
  const status = document.querySelector('#join-status');

  // Arriving via "Join early" should leave the cursor ready in the field,
  // whether that is a same-page jump or a landing from another page.
  const focusJoin = () => {
    if (location.hash !== '#early-access' || !(emailInput instanceof HTMLInputElement)) return;
    // Wait for the smooth scroll to settle before taking focus, so the
    // browser does not jump the viewport a second time.
    setTimeout(() => emailInput.focus({ preventScroll: true }), 600);
  };

  window.addEventListener('hashchange', focusJoin);
  focusJoin();

  if (
    form instanceof HTMLFormElement &&
    emailInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonText = form.querySelector('.dy-form__label');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      status.textContent = '';
      status.dataset.state = '';

      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please check your email address.';
        status.dataset.state = 'error';
        emailInput.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (buttonText instanceof HTMLElement) buttonText.textContent = 'Joining…';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data?.message || 'Something went wrong. Please try again.');
        }

        status.textContent = data.message || 'Done. We will email you when the next topic is ready.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (buttonText instanceof HTMLElement) buttonText.textContent = 'Join';
      }
    });
  }
</script>

<style>
  /* `hidden` must win over the display rules below */
  [hidden] {
    display: none !important;
  }

  /* =========================================================
     HERO — original DekhoYahan typography, restored
     ========================================================= */
  .dy-hero {
    position: relative;
    padding: clamp(38px, 5.5vh, 60px) 0 clamp(54px, 7vh, 76px);
    overflow: hidden;
  }

  .dy-hero::before {
    content: '';
    position: absolute;
    inset: -12% 40% 42% -22%;
    z-index: -1;
    background: radial-gradient(circle at 42% 46%, rgba(36, 92, 255, 0.055), transparent 62%);
    pointer-events: none;
  }

  .dy-hero__grid {
    display: grid;
    grid-template-columns: minmax(460px, 0.92fr) minmax(0, 1.08fr);
    /* Top-aligned: centring dropped the headline well below the
       feature stage and left the top-left of the page empty. */
    align-items: start;
    gap: clamp(40px, 5vw, 78px);
  }

  .dy-hero__brand {
    max-width: 650px;
    /* Sits just below the top of the feature stage opposite it. */
    padding-top: clamp(6px, 3.4vh, 34px);
  }

  .dy-hero__thought {
    max-width: 540px;
    margin: 0 0 clamp(16px, 1.9vh, 21px);
    color: #3f4854;
    font-size: clamp(15px, 1.05vw, 16px);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .dy-hero__title {
    margin: 0;
    max-width: 650px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(54px, 4.4vw, 72px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }

  .dy-hero__title span {
    display: block;
  }

  .dy-hero__title em {
    color: var(--cobalt);
    font-style: normal;
  }

  .dy-hero__intro {
    max-width: 545px;
    margin: clamp(21px, 2.5vh, 27px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.58;
    letter-spacing: -0.012em;
  }

  .dy-hero__cta {
    width: fit-content;
    margin-top: clamp(26px, 3.5vh, 32px);
    display: inline-flex;
    align-items: center;
    gap: 13px;
    padding: 11px 12px 11px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    font-weight: 720;
    text-decoration: none;
    box-shadow: 0 11px 28px rgba(17, 21, 28, 0.1);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .dy-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 17px 36px rgba(17, 21, 28, 0.15);
  }

  .dy-hero__cta:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .dy-hero__cta span {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 15px;
  }

  /* =========================================================
     METHOD
     ========================================================= */
  .dy-method {
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: linear-gradient(180deg, rgba(255, 253, 250, 0.6), rgba(246, 240, 231, 0.5));
  }

  .dy-method__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    padding: clamp(26px, 4vh, 40px) 0;
  }

  .dy-method__title {
    margin: 0;
    max-width: 16ch;
    color: var(--ink);
    font-size: 16px;
    font-weight: 660;
    line-height: 1.32;
    letter-spacing: -0.022em;
  }

  .dy-method__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 30px);
    margin: 0;
    padding: 0 clamp(6px, 2vw, 26px);
    list-style: none;
    border-left: 1px solid var(--line-soft);
    border-right: 1px solid var(--line-soft);
  }

  .dy-method__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 12px;
  }

  .dy-method__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
  }

  .dy-method__icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dy-method__icon[data-tone='blue'] {
    background: #eaf0ff;
  }
  .dy-method__icon[data-tone='blue'] svg {
    stroke: var(--cobalt);
  }
  .dy-method__icon[data-tone='orange'] {
    background: #fff1e5;
  }
  .dy-method__icon[data-tone='orange'] svg {
    stroke: var(--saffron-deep);
    fill: var(--saffron);
    stroke-width: 1.2;
  }
  .dy-method__icon[data-tone='ink'] {
    background: #eef0f4;
  }
  .dy-method__icon[data-tone='ink'] svg {
    stroke: #3d4757;
  }

  .dy-method__list strong {
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 640;
    letter-spacing: -0.015em;
  }

  .dy-method__list li > span:last-child {
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.35;
  }

  .dy-method__path {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 15px;
    font-style: italic;
    white-space: nowrap;
  }

  .dy-method__path i {
    color: var(--saffron);
    font-style: normal;
  }

  /* =========================================================
     TOPICS
     ========================================================= */
  .dy-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dy-eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 5px rgba(232, 117, 36, 0.1);
  }

  .dy-topics {
    padding: clamp(54px, 8vh, 88px) 0;
  }

  .dy-topics__head h2 {
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.042em;
  }

  .dy-topics__grid {
    display: grid;
    /* auto-fill, not auto-fit: a single card keeps its natural width
       instead of stretching across the whole row. */
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
    gap: 16px;
    margin: clamp(26px, 4vh, 40px) 0 0;
    padding: 0;
    list-style: none;
  }

  .dy-topics__grid a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 22px 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--paper);
    text-decoration: none;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 240ms ease,
      border-color 240ms ease;
  }

  .dy-topics__grid a:hover {
    transform: translateY(-3px);
    border-color: rgba(232, 117, 36, 0.34);
    box-shadow: 0 18px 40px rgba(72, 56, 38, 0.09);
  }

  /* A category is classification, not a discovery cue. */
  .dy-topics__cat {
    color: var(--cobalt);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .dy-topics__grid h3 {
    margin: 10px 0 8px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 560;
    line-height: 1.18;
    letter-spacing: -0.028em;
  }

  .dy-topics__grid p {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .dy-topics__go {
    margin-top: auto;
    color: var(--ink);
    font-size: 12.5px;
    font-weight: 640;
  }

  /* =========================================================
     JOIN
     ========================================================= */
  .dy-join {
    padding: clamp(46px, 7vh, 76px) 0 clamp(56px, 9vh, 92px);
    border-top: 1px solid var(--line-soft);
  }

  .dy-join__panel {
    position: relative;
    overflow: hidden;
    /* Narrower than the page grid so the panel reads as one focused
       action rather than a full-width band. */
    max-width: 1020px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.94fr);
    align-items: center;
    gap: clamp(28px, 4vw, 64px);
    padding: clamp(28px, 4vw, 52px);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(150deg, rgba(255, 253, 250, 0.96), rgba(250, 245, 236, 0.78));
    box-shadow: 0 24px 60px rgba(72, 56, 38, 0.07);
  }

  .dy-join__panel::before {
    content: '';
    position: absolute;
    inset: -40% -20% 40% 55%;
    z-index: 0;
    background: radial-gradient(circle at 50% 60%, rgba(36, 92, 255, 0.05), transparent 62%);
    pointer-events: none;
  }

  .dy-join__copy,
  .dy-form {
    position: relative;
    z-index: 1;
  }

  .dy-join__copy h2 {
    margin: 0;
    max-width: 15ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .dy-join__desc {
    margin: 12px 0 0;
    max-width: 34ch;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.6;
  }

  .dy-form label {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 620;
    letter-spacing: 0.02em;
  }

  .dy-form__row {
    display: flex;
    gap: 9px;
  }

  .dy-form input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .dy-form input::placeholder {
    color: var(--muted-light);
  }

  /* Focus is interface state, so it carries the brand colour —
     saffron stays reserved for discovery. */
  .dy-form input:focus {
    outline: none;
    border-color: var(--cobalt);
    box-shadow: 0 0 0 3px rgba(36, 92, 255, 0.16);
  }

  .dy-form button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 22px;
    border: 0;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 640;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
  }

  .dy-form button:hover:not(:disabled) {
    background: #000;
    transform: translateY(-1px);
  }

  .dy-form button:disabled {
    opacity: 0.62;
    cursor: progress;
  }

  .dy-form__status {
    margin: 0;
    max-height: 0;
    overflow: hidden;
    font-size: 13.5px;
    line-height: 1.45;
    transition: max-height 260ms ease, margin 260ms ease;
  }

  .dy-form__status[data-state] {
    margin-top: 12px;
    max-height: 5rem;
  }

  .dy-form__status[data-state='error'] {
    color: #c0442d;
  }

  .dy-form__status[data-state='success'] {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 13px;
    border-radius: 10px;
    background: rgba(31, 122, 77, 0.09);
    color: #17603b;
    font-weight: 560;
  }

  .dy-form__status[data-state='success']::before {
    content: '✓';
    display: grid;
    place-items: center;
    flex: none;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: #1f7a4d;
    color: #fff;
    font-size: 11px;
  }

  .dy-form__note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: 14px 0 0;
    color: var(--muted-light);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .dy-form__note svg {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 1px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */
  @media (max-width: 1180px) {
    .dy-hero__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }

  @media (max-width: 980px) {
    .dy-hero__grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .dy-hero__brand {
      max-width: none;
    }

    .dy-method__inner {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .dy-method__list {
      padding: 0;
      border: 0;
    }

    .dy-method__path {
      display: none;
    }

    .dy-join__panel {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .dy-join__copy h2,
    .dy-join__desc {
      max-width: none;
    }
  }

  @media (max-width: 680px) {
    .dy-hero__title {
      font-size: clamp(42px, 11vw, 56px);
    }

    .dy-method__list {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .dy-form__row {
      flex-direction: column;
    }

    .dy-form button {
      justify-content: center;
      padding: 14px 22px;
    }
  }
</style>
