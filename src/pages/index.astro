  .dy-hero__zt-s6-mark {
    opacity: 0;
  }

  .dy-hero__zt-s6-ask {
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .dy-hero__zt-s6-ask--halo {
    stroke: var(--cream);
    stroke-width: 1;
    stroke-opacity: 0.85;
  }

  .dy-hero__zt-s6-ask--line {
    stroke: var(--cobalt);
    stroke-width: 0.34;
    stroke-opacity: 0.8;
  }

  .dy-hero__zt-s6-yes {
    stroke: var(--cobalt);
    stroke-width: 0.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .dy-hero__zt-s6-name--co {
    left: 45.7%;
    top: 38%;
  }

  .dy-hero__zt-s6-name--dmz {
    left: 53.7%;
    top: 45.5%;
  }

  .dy-hero__zt-s6-name--fin {
