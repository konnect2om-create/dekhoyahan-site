<script>
  const form = document.querySelector('#join-form');
  const emailInput = document.querySelector('#join-email');
  const status = document.querySelector('#join-status');

  // Arriving via "Join early" should leave the cursor ready in the field,
  // whether that is a same-page jump or a landing from another page.
  const focusJoin = () => {
    if (location.hash !== '#early-access' || !(emailInput instanceof HTMLInputElement)) return;
    // Wait for the smooth scroll to settle before taking focus, so the
    // browser does not jump the viewport a second time.
    setTimeout(() => emailInput.focus({ preventScroll: true }), 600);
  };

  window.addEventListener('hashchange', focusJoin);
  focusJoin();

  if (
    form instanceof HTMLFormElement &&
    emailInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonText = form.querySelector('.dy-form__label');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      status.textContent = '';
      status.dataset.state = '';

      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please check your email address.';
        status.dataset.state = 'error';
        emailInput.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (buttonText instanceof HTMLElement) buttonText.textContent = 'Joining…';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data?.message || 'Something went wrong. Please try again.');
        }

        status.textContent = data.message || 'Done. We will email you when the next topic is ready.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (buttonText instanceof HTMLElement) buttonText.textContent = 'Join';
      }
    });
  }
</script>

<script>
  // Analytics: fires `hero_view` through Cloudflare Zaraz once the hero
  // section has been at least 50% visible in the viewport for a
  // continuous second. Isolated from the hero's own visual/interaction
  // script above — this only observes visibility and never touches the
  // hero's markup, layout, or behavior.
  const heroSection = document.querySelector('.dy-hero');

  if (heroSection instanceof HTMLElement) {
    let visibleTimer = null;
    let fired = false;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (visibleTimer === null) {
            visibleTimer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('hero_view');
              observer.disconnect();
            }, 1000);
          }
        } else if (visibleTimer !== null) {
          clearTimeout(visibleTimer);
          visibleTimer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(heroSection);
  }
</script>

<script>
  // Analytics: fires `hero_start` through Cloudflare Zaraz the first time
  // the hero's "See how" CTA is activated. Isolated from the hero's own
  // click/animation handler above — this listener only reports the click,
  // it never touches the CTA's markup, styling, or behavior. `{ once:
  // true }` guarantees it fires at most once per page load even though
  // the same button later doubles as "Replay" and can be clicked again.
  document.getElementById('dy-hero-see-how')?.addEventListener(
    'click',
    () => window.zaraz?.track('hero_start'),
    { once: true }
  );
</script>

<script>
  // Analytics: fires `hero_complete` through Cloudflare Zaraz once the
  // hero's own transition logic actually opens the closing "AI agent"
  // payoff block — the same `open()` call (removing data-shut from
  // [data-agent-payoff]) the hero's own script above already uses to
  // mark that beat as reached, so this reuses that real state change
  // instead of a timer guessing when the sequence finished. Isolated
  // from the hero's own scripts: it only observes, never mutates.
  // Watching the persistent #dy-hero-visual container (rather than the
  // payoff element itself) means this keeps working even after a
  // restart replaces the hero's inner markup. Fires at most once per
  // page load; does nothing if the visitor abandons the sequence before
  // this beat is reached.
  const heroVisual = document.getElementById('dy-hero-visual');

  if (heroVisual instanceof HTMLElement) {
    let fired = false;

    const checkPayoff = () => {
      if (fired) return;
      const payoff = heroVisual.querySelector('[data-agent-payoff]');
      if (payoff instanceof HTMLElement && !payoff.hasAttribute('data-shut')) {
        fired = true;
        window.zaraz?.track('hero_complete');
        observer.disconnect();
      }
    };

    const observer = new MutationObserver(checkPayoff);
    observer.observe(heroVisual, { attributes: true, attributeFilter: ['data-shut'], subtree: true });
  }
</script>

