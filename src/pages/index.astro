---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { featuredStories } from '../data/stories';
import securityDome from '../assets/security-dome.png';
---

<BaseLayout>
  <!-- ============================================================
       HERO — the brand statement, plus the feature stage beside it
       ============================================================ -->
  <section class="dy-hero">
    <div class="shell dy-hero__grid">
      <div class="dy-hero__brand">
        <h1 class="dy-hero__title">
          Understand the world
          <span>that's <em>arriving.</em></span>
        </h1>

        <p class="dy-hero__intro">
          See how technology works —<br />
          and understand why it matters.
        </p>

        <p class="dy-hero__subintro">
          <span>You don't need a technical background.<br />Just curiosity.</span>
        </p>

        <div class="dy-hero__signature">
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 3.5a5.5 5.5 0 0 1 3 10.1c-.6.4-1 1.1-1 1.9v.5H10v-.5c0-.8-.4-1.5-1-1.9A5.5 5.5 0 0 1 12 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M10 18.5h4M10.6 20.5h2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span>Understand it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See differently.</span>
        </div>

        <!-- Quiet editorial CTA, not the old black "See how" button — the
             hero's own story action now lives beside the featured story
             on the right (see .dy-hero__feature-row below). This one just
             takes the visitor to the Explore library; it never starts the
             hero sequence and fires no hero_start analytics. -->
        <a class="dy-hero__explore-cta" href="/explore/">
          Explore
          <span class="dy-hero__explore-cta__arrow" aria-hidden="true">→</span>
        </a>
      </div>


      <!-- The right hero stage — Scene 1 of the Zero Trust story, read
           as one editorial object in four beats: the provocation, the
           visual evidence (outside → firewall → inside), the
           unresolved question, and the invitation to enter it. The
           title belongs to the WHOLE illustration, not just the dome,
           so it's aligned on the artwork's own left axis; every
           vertical gap below is measured against the artwork's
           VISIBLE pixels, not the PNG's transparent box. -->
      <div class="dy-hero__feature">
        <div class="dy-hero__zt">
          <!-- The Feature's question and, at the very end, its answer.
               The second block is taken out of flow so the title keeps
               exactly the height it has always had - Scene 1's geometry
               is measured off it. -->
          <p class="dy-hero__zt-title">
            <span class="dy-hero__zt-title-swap">
              <span class="dy-hero__zt-title-was">
                <span class="dy-hero__zt-title-lead">Zero Trust</span>
                <span class="dy-hero__zt-title-rest">is older than Zero Trust.</span>
              </span>
              <span class="dy-hero__zt-title-now" aria-live="polite">
                <span class="dy-hero__zt-title-lead">The name came later.</span>
              </span>
            </span>
          </p>

          <div class="dy-hero__zt-stage">
            <Image
              class="dy-hero__zt-art"
              src={securityDome}
              alt=""
              widths={[600, 760, 920, 1120]}
              sizes="(min-width: 1320px) 600px, 86vw"
              format="webp"
              quality={90}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />

            <!-- Scene 2 keeps the visitor inside the same picture. The
                 broad company boundary settles back to context, but the
                 outside and the firewall must stay as sharp as they
                 were — so the same artwork is laid over itself, masked
                 to just the internet/firewall side, and fades up as the
                 layer beneath it dims. Identical src and sizes, so the
                 browser reuses the image it already has. -->
            <Image
              class="dy-hero__zt-art-keep"
              src={securityDome}
              alt=""
              widths={[600, 760, 920, 1120]}
              sizes="(min-width: 1320px) 600px, 86vw"
              format="webp"
              quality={90}
              loading="eager"
              decoding="async"
              aria-hidden="true"
            />

            <!-- Not a ring drawn around two things — a place, with a
                 wall behind it. A strip of ground immediately past the
                 firewall carries the publicly reachable services; a
                 second boundary then stands across the scene between
                 that strip and everything deeper in. Both shapes are
                 plotted on the illustration's own ground plane (the
                 dome's base ellipse) inside a viewBox 150x100 over its
                 3:2 frame, so they sit in the picture rather than on
                 top of it, at any size. -->
            <div class="dy-hero__zt-s2" hidden>
              <span class="dy-hero__zt-s2-focus" aria-hidden="true"></span>

              <svg class="dy-hero__zt-s2-svg" viewBox="0 0 150 100" aria-hidden="true" focusable="false">
                <path
                  class="dy-hero__zt-s2-zone"
                  d="M70.5 66 C74 73 80 76.5 99 80.4 L99 51.6 C80 55.5 74 59 70.5 66 Z"
                />
                <path
                  class="dy-hero__zt-s2-wall"
                  d="M99 78 C96.5 60 97 44 101 33 L110 33 C106 44 105.5 60 108 78 Z"
                />
                <path
                  class="dy-hero__zt-s2-edge dy-hero__zt-s2-edge--halo"
                  pathLength="1"
                  d="M99 78 C96.5 60 97 44 101 33"
                />
                <path
                  class="dy-hero__zt-s2-edge dy-hero__zt-s2-edge--line"
                  pathLength="1"
                  d="M99 78 C96.5 60 97 44 101 33"
                />
              </svg>

              <span class="dy-hero__zt-s2-nodes">
                <span class="dy-hero__zt-s2-chip dy-hero__zt-s2-chip--web">Web</span>
                <span class="dy-hero__zt-s2-chip dy-hero__zt-s2-chip--mail">Mail</span>
              </span>

              <span class="dy-hero__zt-s2-label">DMZ</span>
            </div>

            <!-- Scene 3 goes THROUGH the second boundary. The outside,
                 the firewall and the DMZ stay in the picture but step
                 back under a soft veil — they are the visitor's history
                 here, not the subject. The ground beyond the wall then
                 shows itself as one area, and divides. Every shape is
                 plotted on the same ground plane (the dome's base
                 ellipse) as Scene 2's DMZ strip, in the same viewBox. -->
            <div class="dy-hero__zt-s3" hidden>
              <span class="dy-hero__zt-s3-veil" aria-hidden="true"></span>

              <svg class="dy-hero__zt-s3-svg" viewBox="0 0 150 100" aria-hidden="true" focusable="false">
                <path
                  class="dy-hero__zt-s3-whole"
                  d="M109.5 51 C124 51.6 138 55.5 148.5 66 C145 72 139 75.8 130.5 78.6 C126 79.8 118 80.7 109.5 81 Z"
                />

                <path class="dy-hero__zt-s3-plot dy-hero__zt-s3-plot--a" d="M109.5 51 C124 51.6 138 55.5 148.5 66 L109.5 66 Z" />
                <path class="dy-hero__zt-s3-plot dy-hero__zt-s3-plot--b" d="M109.5 66 L124 66 L124 79.9 C120 80.5 116 80.9 109.5 81 Z" />
                <path class="dy-hero__zt-s3-plot dy-hero__zt-s3-plot--c" d="M124 66 L148.5 66 C145 72 137 76.8 124 79.9 Z" />

                <path class="dy-hero__zt-s3-cut dy-hero__zt-s3-cut--halo dy-hero__zt-s3-cut--one" pathLength="1" d="M109.5 66 L148.5 66" />
                <path class="dy-hero__zt-s3-cut dy-hero__zt-s3-cut--line dy-hero__zt-s3-cut--one" pathLength="1" d="M109.5 66 L148.5 66" />
                <path class="dy-hero__zt-s3-cut dy-hero__zt-s3-cut--halo dy-hero__zt-s3-cut--two" pathLength="1" d="M124 66 L124 79.9" />
                <path class="dy-hero__zt-s3-cut dy-hero__zt-s3-cut--line dy-hero__zt-s3-cut--two" pathLength="1" d="M124 66 L124 79.9" />
              </svg>

              <span class="dy-hero__zt-s3-tag dy-hero__zt-s3-tag--a">Users</span>
              <span class="dy-hero__zt-s3-tag dy-hero__zt-s3-tag--b">Finance</span>
              <span class="dy-hero__zt-s3-tag dy-hero__zt-s3-tag--c">Production</span>
            </div>

            <!-- Scene 4. The company outgrew the outline. Nothing here
                 breaks the dome — it stays exactly where it was, still
                 doing its job. What changes is that legitimate work now
                 sits outside it and reaches across it, drawn in the
                 same blue the illustration already uses for normal
                 traffic. Three examples is the whole point; a fourth
                 would be inventory, not understanding. -->
            <div class="dy-hero__zt-s4" hidden>
              <span class="dy-hero__zt-s4-veil" aria-hidden="true"></span>

              <svg class="dy-hero__zt-s4-svg" viewBox="0 0 150 100" aria-hidden="true" focusable="false">
                <!-- Each connection runs from the object outside, across
                     the old outline, and dissolves once it is properly
                     inside — so it reads as something arriving in the
                     company rather than an annotation pointing at a
                     picture. No arrowheads, no notation: the fade is
                     what says "and it ends up in here". -->
                <defs>
                  <linearGradient id="dyZtHaloWorker" gradientUnits="userSpaceOnUse" x1="81" y1="15.6" x2="85" y2="43">
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0" stop-opacity="0" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0.26" stop-opacity="0.55" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0.52" stop-opacity="0.55" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="1" stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id="dyZtLineWorker" gradientUnits="userSpaceOnUse" x1="81" y1="15.6" x2="85" y2="43">
                    <stop class="dy-hero__zt-s4-stop--line" offset="0" stop-opacity="0.85" />
                    <stop class="dy-hero__zt-s4-stop--line" offset="0.5" stop-opacity="0.85" />
                    <stop class="dy-hero__zt-s4-stop--line" offset="1" stop-opacity="0" />
                  </linearGradient>

                  <linearGradient id="dyZtHaloSaas" gradientUnits="userSpaceOnUse" x1="99" y1="13.8" x2="112" y2="41">
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0" stop-opacity="0" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0.26" stop-opacity="0.55" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0.52" stop-opacity="0.55" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="1" stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id="dyZtLineSaas" gradientUnits="userSpaceOnUse" x1="99" y1="13.8" x2="112" y2="41">
                    <stop class="dy-hero__zt-s4-stop--line" offset="0" stop-opacity="0.85" />
                    <stop class="dy-hero__zt-s4-stop--line" offset="0.5" stop-opacity="0.85" />
                    <stop class="dy-hero__zt-s4-stop--line" offset="1" stop-opacity="0" />
                  </linearGradient>

                  <linearGradient id="dyZtHaloCloud" gradientUnits="userSpaceOnUse" x1="137" y1="15.8" x2="131.5" y2="50">
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0" stop-opacity="0" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0.26" stop-opacity="0.55" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="0.52" stop-opacity="0.55" />
                    <stop class="dy-hero__zt-s4-stop--halo" offset="1" stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id="dyZtLineCloud" gradientUnits="userSpaceOnUse" x1="137" y1="15.8" x2="131.5" y2="50">
                    <stop class="dy-hero__zt-s4-stop--line" offset="0" stop-opacity="0.85" />
                    <stop class="dy-hero__zt-s4-stop--line" offset="0.5" stop-opacity="0.85" />
                    <stop class="dy-hero__zt-s4-stop--line" offset="1" stop-opacity="0" />
                  </linearGradient>
                </defs>

                <path class="dy-hero__zt-s4-link dy-hero__zt-s4-link--halo dy-hero__zt-s4-link--worker" pathLength="1" d="M81 15.6 C81.4 24 82.6 34 85 43" />
                <path class="dy-hero__zt-s4-link dy-hero__zt-s4-link--line dy-hero__zt-s4-link--worker" pathLength="1" d="M81 15.6 C81.4 24 82.6 34 85 43" />
                <path class="dy-hero__zt-s4-link dy-hero__zt-s4-link--halo dy-hero__zt-s4-link--saas" pathLength="1" d="M99 13.8 C99.4 24 101.4 32 112 41" />
                <path class="dy-hero__zt-s4-link dy-hero__zt-s4-link--line dy-hero__zt-s4-link--saas" pathLength="1" d="M99 13.8 C99.4 24 101.4 32 112 41" />
                <path class="dy-hero__zt-s4-link dy-hero__zt-s4-link--halo dy-hero__zt-s4-link--cloud" pathLength="1" d="M137 15.8 C136.2 24 134.4 37 131.5 50" />
                <path class="dy-hero__zt-s4-link dy-hero__zt-s4-link--line dy-hero__zt-s4-link--cloud" pathLength="1" d="M137 15.8 C136.2 24 134.4 37 131.5 50" />

                <g class="dy-hero__zt-s4-mark dy-hero__zt-s4-mark--worker">
                  <path d="M78.2 8.5 H83.8 A0.8 0.8 0 0 1 84.6 9.3 V13 H77.4 V9.3 A0.8 0.8 0 0 1 78.2 8.5 Z" />
                  <path d="M75.8 13 H86.2 L85.4 14.6 H76.6 Z" />
                </g>

                <g class="dy-hero__zt-s4-mark dy-hero__zt-s4-mark--saas">
                  <path d="M96 7 H102 A0.8 0.8 0 0 1 102.8 7.8 V12.2 A0.8 0.8 0 0 1 102 13 H96 A0.8 0.8 0 0 1 95.2 12.2 V7.8 A0.8 0.8 0 0 1 96 7 Z" />
                  <path d="M95.2 9.2 H102.8" />
                </g>

                <g class="dy-hero__zt-s4-mark dy-hero__zt-s4-mark--cloud">
                  <path d="M134 15 C131.8 15 131.4 12 133.4 11.4 C133.2 8.6 136.8 7.4 138.4 9.6 C140.2 8.4 142.6 9.8 142.2 11.9 C143.6 12.4 143.2 15 141.6 15 Z" />
                </g>
              </svg>

              <span class="dy-hero__zt-s3-tag dy-hero__zt-s4-tag dy-hero__zt-s4-tag--worker">Remote worker</span>
              <span class="dy-hero__zt-s3-tag dy-hero__zt-s4-tag dy-hero__zt-s4-tag--saas">SaaS</span>
              <span class="dy-hero__zt-s3-tag dy-hero__zt-s4-tag dy-hero__zt-s4-tag--cloud">Cloud</span>
            </div>

            <!-- Scene 5. One decision, looked at closely. Everything the
                 visitor has already been shown steps back to a ghost —
                 the globe, the firewall, the DMZ, the segments — and a
                 single clean boundary is drawn over where the dome
                 always was, so "inside" and "outside" still mean what
                 they meant. Two people want the same thing. Only one
                 of them is inside. That is the whole picture. -->
            <div class="dy-hero__zt-s5" hidden>
              <svg class="dy-hero__zt-s5-svg" viewBox="0 0 150 100" aria-hidden="true" focusable="false">
                <path class="dy-hero__zt-s5-dome" pathLength="1" d="M46 84 C46 48 70 34 96 34 C122 34 146 48 146 84" />

                <!-- The place they both want to reach. -->
                <g class="dy-hero__zt-s5-mark dy-hero__zt-s5-mark--vault">
                  <path d="M109 47 H121 A1 1 0 0 1 122 48 V55 A1 1 0 0 1 121 56 H109 A1 1 0 0 1 108 55 V48 A1 1 0 0 1 109 47 Z" />
                  <path d="M112.6 51.5 H117.4" />
                </g>

                <g class="dy-hero__zt-s5-mark dy-hero__zt-s5-mark--home">
                  <path d="M15.8 39.5 H23.8 A0.9 0.9 0 0 1 24.7 40.4 V45.4 H14.9 V40.4 A0.9 0.9 0 0 1 15.8 39.5 Z" />
                  <path d="M13.4 45.4 H26.2 L25.3 47.4 H14.4 Z" />
                </g>

                <g class="dy-hero__zt-s5-mark dy-hero__zt-s5-mark--office">
                  <path d="M56.4 62 H64.4 A0.9 0.9 0 0 1 65.3 62.9 V67.9 H55.5 V62.9 A0.9 0.9 0 0 1 56.4 62 Z" />
                  <path d="M54 67.9 H66.8 L65.9 69.9 H55 Z" />
                </g>

                <!-- Two lanes, one above the other, both running left to
                     right at the same destination — so neither line ever
                     crosses the other and the eye can follow either one
                     from the person straight through to what happened.
                     The upper request has to cross the boundary to get
                     anywhere; the lower one never leaves it. -->
                <path class="dy-hero__zt-s5-ask dy-hero__zt-s5-ask--halo dy-hero__zt-s5-ask--home" pathLength="1" d="M61 41.5 C74 42.6 92 46.6 107 50.5" />
                <path class="dy-hero__zt-s5-ask dy-hero__zt-s5-ask--line dy-hero__zt-s5-ask--home" pathLength="1" d="M61 41.5 C74 42.6 92 46.6 107 50.5" />
                <path class="dy-hero__zt-s5-ask dy-hero__zt-s5-ask--halo dy-hero__zt-s5-ask--office" pathLength="1" d="M94 71 C100 68.6 104 66 107.6 63.6" />
                <path class="dy-hero__zt-s5-ask dy-hero__zt-s5-ask--line dy-hero__zt-s5-ask--office" pathLength="1" d="M94 71 C100 68.6 104 66 107.6 63.6" />

                <!-- The outcomes sit where each request actually ended:
                     one of them came out the far side of Finance, the
                     other never reached it. -->
                <path class="dy-hero__zt-s5-verdict dy-hero__zt-s5-verdict--open" pathLength="1" d="M124.5 51.5 L126.3 53.5 L129.5 49.7" />
                <g class="dy-hero__zt-s5-verdict dy-hero__zt-s5-verdict--stop">
                  <path pathLength="1" d="M110 60.6 L113.2 63.8" />
                  <path pathLength="1" d="M113.2 60.6 L110 63.8" />
                </g>
              </svg>

              <span class="dy-hero__zt-s5-name dy-hero__zt-s5-name--home">Working from home</span>
              <span class="dy-hero__zt-s5-name dy-hero__zt-s5-name--office">In the office</span>
              <span class="dy-hero__zt-s5-name dy-hero__zt-s5-name--vault">Finance</span>

              <span class="dy-hero__zt-s5-said dy-hero__zt-s5-said--h1"><span class="dy-hero__zt-s5-tick" aria-hidden="true">&#10003;</span> Right person</span>
              <span class="dy-hero__zt-s5-said dy-hero__zt-s5-said--h2"><span class="dy-hero__zt-s5-tick" aria-hidden="true">&#10003;</span> Work laptop</span>

              <span class="dy-hero__zt-s5-said dy-hero__zt-s5-said--o1"><span class="dy-hero__zt-s5-tick" aria-hidden="true">&#10003;</span> Right person</span>
              <span class="dy-hero__zt-s5-said dy-hero__zt-s5-said--o2"><span class="dy-hero__zt-s5-cross" aria-hidden="true">&#10007;</span> Unknown laptop</span>

              <!-- One slot, two questions passing through it: the picture
                   asks them one at a time rather than laying a checklist
                   over itself, and then they leave again. What each of
                   them wants is not asked, because both lines are
                   already pointing at it. -->
              <span class="dy-hero__zt-s5-ques dy-hero__zt-s5-ques--a">Who is asking?</span>
              <span class="dy-hero__zt-s5-ques dy-hero__zt-s5-ques--b">What are they using?</span>

              <span class="dy-hero__zt-s5-out dy-hero__zt-s5-out--open">OPEN</span>
              <span class="dy-hero__zt-s5-out dy-hero__zt-s5-out--stop">STOP</span>
            </div>

            <!-- Scene 6. Nothing new is introduced here. The scene the
                 visitor has been walking through is redrawn as the one
                 shape it always had — a boundary that kept getting
                 smaller — and then even that is set aside, leaving the
                 single request the whole story was heading toward. -->
            <div class="dy-hero__zt-s6" hidden>
              <svg class="dy-hero__zt-s6-svg" viewBox="0 0 150 100" aria-hidden="true" focusable="false">
                <rect class="dy-hero__zt-s6-ring dy-hero__zt-s6-ring--co" pathLength="1" x="66" y="36" width="78" height="44" rx="2.5" />
                <rect class="dy-hero__zt-s6-ring dy-hero__zt-s6-ring--dmz" pathLength="1" x="78" y="43.5" width="56" height="29.5" rx="2.5" />
                <rect class="dy-hero__zt-s6-ring dy-hero__zt-s6-ring--fin" pathLength="1" x="90" y="51" width="34" height="15" rx="2.5" />

                <g class="dy-hero__zt-s6-mark">
                  <path d="M48.4 56 H56.4 A0.9 0.9 0 0 1 57.3 56.9 V61.9 H47.5 V56.9 A0.9 0.9 0 0 1 48.4 56 Z" />
                  <path d="M46 61.9 H58.8 L57.9 63.9 H47 Z" />
                </g>

                <path class="dy-hero__zt-s6-ask dy-hero__zt-s6-ask--halo" pathLength="1" d="M61 60.4 C70 60.2 80 60 89 59.8" />
                <path class="dy-hero__zt-s6-ask dy-hero__zt-s6-ask--line" pathLength="1" d="M61 60.4 C70 60.2 80 60 89 59.8" />

                <path class="dy-hero__zt-s6-yes" pathLength="1" d="M97 60.6 L99 62.8 L103 58.2" />
              </svg>

              <span class="dy-hero__zt-s6-name dy-hero__zt-s6-name--co">Company</span>
              <span class="dy-hero__zt-s6-name dy-hero__zt-s6-name--dmz">DMZ</span>
              <span class="dy-hero__zt-s6-name dy-hero__zt-s6-name--fin">Finance</span>

              <!-- The same three questions the visitor already watched
                   decide one request, in the same one slot. -->
              <span class="dy-hero__zt-s6-ques dy-hero__zt-s6-ques--a">Who is asking?</span>
              <span class="dy-hero__zt-s6-ques dy-hero__zt-s6-ques--b">What are they using?</span>
              <span class="dy-hero__zt-s6-ques dy-hero__zt-s6-ques--c">What do they want?</span>

              <span class="dy-hero__zt-s6-out">YES</span>
            </div>

            <!-- Question and invitation are one control: the question
                 opens the gap, the invitation says it can be walked
                 through. -->
            <button type="button" class="dy-hero__zt-callout" data-zt-open>
              <span class="dy-hero__zt-question">
                But was &ldquo;<span class="dy-hero__zt-question-em">inside</span>&rdquo; ever really one thing?
              </span>
              <span class="dy-hero__zt-cue">
                Look closer
                <span class="dy-hero__zt-cue-arrow" aria-hidden="true">→</span>
              </span>
            </button>
          </div>

          <!-- The story's own space. Each of these is a collapsed row
               until the scene that needs it opens it, so Scene 1 keeps
               the compact hero it has always had and every later state
               takes only the room its own writing asks for. They are
               ordinary flow — a grid row animating 0fr to 1fr, not an
