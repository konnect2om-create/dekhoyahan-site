---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroCompanion from '../assets/hero-companion.png';
import realizeKey from '../assets/realize-key.png';
import { featuredStories } from '../data/stories';
---

<BaseLayout>
  <!-- ============================================================
       HERO — the brand statement, plus the feature stage beside it
       ============================================================ -->
  <section class="dy-hero">
    <div class="shell dy-hero__grid">
      <div class="dy-hero__brand">
        <h1 class="dy-hero__title">
          Understand the world
          <span>that's <em>arriving.</em></span>
        </h1>

        <p class="dy-hero__intro">
          See how technology works —<br />
          and understand why it matters.
        </p>

        <p class="dy-hero__subintro">
          <span>You don't need a technical background.<br />Just curiosity.</span>
        </p>

        <div class="dy-hero__signature">
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 3.5a5.5 5.5 0 0 1 3 10.1c-.6.4-1 1.1-1 1.9v.5H10v-.5c0-.8-.4-1.5-1-1.9A5.5 5.5 0 0 1 12 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M10 18.5h4M10.6 20.5h2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span>Understand it</span>
          <span class="dy-hero__signature-arrow" aria-hidden="true">→</span>
          <svg class="dy-hero__signature-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>See differently.</span>
        </div>

        <!-- One button, one position, for the whole journey — "See how"
             starts it, the same slot becomes "Replay" once the visitor
             reaches the end, and clicking it there resets the story
             rather than navigating anywhere. Both labels and both icons
             live in the markup at all times; data-mode (set by script)
             just toggles which pair is visible, so nothing about the
             button's own position/box ever changes between states. -->
        <button type="button" class="dy-hero__cta" id="dy-hero-see-how" data-mode="see-how">
          <span class="dy-hero__cta__label dy-hero__cta__label--see-how">See how</span>
          <span class="dy-hero__cta__label dy-hero__cta__label--replay">Replay</span>
          <span class="dy-hero__cta__icon dy-hero__cta__icon--arrow" aria-hidden="true">→</span>
          <span class="dy-hero__cta__icon dy-hero__cta__icon--replay" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" width="15" height="15" focusable="false">
              <path
                d="M3 12a9 9 0 0 1 15.5-6.3M21 12a9 9 0 0 1-15.5 6.3"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
              <path
                d="M18.5 3v4.5H14M5.5 21v-4.5H10"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </button>
      </div>

      <div class="dy-hero__stage" data-hero-stage data-reveal="0" data-reveal2="0" data-reveal3="0" data-realized="0" data-analogy2="0" data-advance="0" data-entry="0">
        <!-- The whole composition is authored once, at a fixed 640px width,
             with every child positioned against that box by percentage or
             pixel. Rather than re-tune any of that per breakpoint, this
             inner layer keeps the fixed 640px box exactly as designed and
             is scaled down as one rigid unit — text, dots, cards and all —
             to fit whatever width the stage actually has. See the
             `--hero-scale` custom property set by script, and
             `.dy-hero__stage`'s own aspect-ratio below, which reserves the
             correctly-scaled height in the grid without measuring anything
             in JS on the layout side. -->
        <div class="dy-hero__stage-inner" data-hero-stage-inner>
        <Image
          src={heroCompanion}
          alt=""
          widths={[640, 900, 1200, 1536]}
          sizes="640px"
          format="webp"
          quality={86}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Realization scrim: a quiet veil that only ever appears once
             the visitor has activated the continuation CTA. It covers
             just the AI-counterpart-and-layers portion of the artwork
             (left ~40% stays clear, over the seated human), easing those
             elements toward the page's own background tone rather than
             hiding them outright — the point is recession, not removal. -->
        <div class="dy-hero__realize-scrim" aria-hidden="true"></div>

        <p class="dy-hero__bubble">
          <span class="dy-hero__bubble-who">YOU</span>
          Book me the <em>best</em> flight to Tokyo.
        </p>

        <p class="dy-hero__bubble dy-hero__bubble--ai">
          <span class="dy-hero__bubble-who">AI AGENT</span>
          <span class="dy-hero__bubble-result">Flight booked! <span class="dy-hero__bubble-check">✓</span></span>
        </p>

        <div class="dy-hero__card dy-hero__card--pay">
          <svg class="dy-hero__card-icon dy-hero__card-icon--spark" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <rect x="2.5" y="5.5" width="19" height="13" rx="2.2" stroke="currentColor" stroke-width="1.5" />
            <path d="M2.5 9.5h19" stroke="currentColor" stroke-width="1.5" />
            <path d="M6 14.3h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="dy-hero__card-text">
            <span class="dy-hero__card-amount">$1,240</span>
            <span class="dy-hero__card-label">paid</span>
          </span>
        </div>

        <span class="dy-hero__discovery" aria-hidden="true"></span>
        <button
          type="button"
          class="dy-hero__discovery-hotspot"
          data-reveal-trigger="reveal"
          aria-expanded="false"
          aria-controls="dy-hero-reveal-1"
          aria-label="Reveal what the AI agent knew"
        ></button>

        <span class="dy-hero__reveal-glow" aria-hidden="true"></span>

        <div class="dy-hero__reveal" id="dy-hero-reveal-1">
          <p class="dy-hero__reveal-title">IT KNEW YOU</p>
          <p class="dy-hero__reveal-text">Your preferences,<br />context and history.</p>
        </div>

        <!-- Layer 2's own discovery point. Present in the DOM from the
             start, but invisible and inert until Layer 1 has been opened
             — gated purely in CSS off the stage's own `data-reveal`, so
             the layers are found in order without any extra script. -->
        <button
          type="button"
          class="dy-hero__discovery-hotspot dy-hero__discovery-hotspot--layer2"
          data-reveal-trigger="reveal2"
          aria-expanded="false"
          aria-controls="dy-hero-reveal-2"
          aria-label="Reveal what the middle layer could connect to"
        ></button>

        <span class="dy-hero__reveal-glow dy-hero__reveal-glow--layer2" aria-hidden="true"></span>

        <div class="dy-hero__reveal dy-hero__reveal--layer2" id="dy-hero-reveal-2">
          <p class="dy-hero__reveal-title">IT COULD CONNECT</p>
          <p class="dy-hero__reveal-text">To your apps, accounts and services.</p>
        </div>

        <!-- Layer 3's own discovery point. Present in the DOM from the
             start, but invisible and inert until Layer 2 has been opened
             — gated off the stage's own `data-reveal2`, same pattern as
             Layer 2's gating off `data-reveal`. -->
        <button
          type="button"
          class="dy-hero__discovery-hotspot dy-hero__discovery-hotspot--layer3"
          data-reveal-trigger="reveal3"
          aria-expanded="false"
          aria-controls="dy-hero-reveal-3"
          aria-label="Reveal what the bottom layer lets the AI agent do"
        ></button>

        <span class="dy-hero__reveal-glow dy-hero__reveal-glow--layer3" aria-hidden="true"></span>

        <div class="dy-hero__reveal dy-hero__reveal--layer3" id="dy-hero-reveal-3">
          <p class="dy-hero__reveal-title">IT COULD ACT FOR YOU</p>
          <p class="dy-hero__reveal-text">Because you gave it permission.</p>
        </div>

        <!-- Continuation trigger: only ever meaningful once the third and
             final layer has been reached, so it's visually gated off
             data-reveal3 (see CSS) and also genuinely disabled until then
             — disabled is only lifted once the Layer 3 hotspot fires, via
             the script below. Its own click just records that the
             journey reached this point (data-realized) for a future
             realization scene; it deliberately triggers no visual change
             yet. -->
        <button type="button" class="dy-hero__continue" data-reveal-trigger="realized" data-gate="reveal3" disabled>
          See what this really means <span aria-hidden="true">→</span>
        </button>

        <!-- The opening line of the realization itself — not another
             technical annotation, so it deliberately skips the reveal
             card/hotspot vocabulary used above it. Sits in the quiet
             space the faded layers just opened up, clear of the seated
             human. Same data-realized gate as the rest of this state;
             no new interaction. -->
        <p class="dy-hero__realize-thought">Imagine giving someone<br />your house key.</p>

        <!-- The visual for that same thought — not a separate
             illustration slot, so it's positioned to read as one
             composed idea with the sentence above it rather than as its
             own card. The source photo already fades to transparent on
             its hand side, which is what lets it sit directly over the
             faded layers/AI without a hard edge or a masking box of our
             own. Purely supportive of the sentence, so it's decorative. -->
        <Image
          src={realizeKey}
          alt=""
          widths={[320, 480, 640]}
          sizes="295px"
          format="webp"
          quality={86}
          loading="eager"
          decoding="async"
          class="dy-hero__realize-key"
        />

        <!-- The second analogy beat: withheld behind its own small
             affordance rather than appearing with the first thought, so
             the visitor keeps control of pacing — same one-way,
             click-only pattern as the discovery layers above, just
             scoped to the realization state (data-gate="realized" keeps
             it inert until that state exists at all; data-once disables
             it the moment it's used, since there's nothing further to
             press here). -->
        <button type="button" class="dy-hero__realize-next" data-reveal-trigger="analogy2" data-gate="realized" data-once disabled>
          And then? <span aria-hidden="true">→</span>
        </button>

        <div class="dy-hero__realize-next-copy">
          <p class="dy-hero__realize-next-text">They can enter your house.</p>
          <p class="dy-hero__realize-next-subtext">That doesn't mean they can do whatever they want inside.</p>

          <!-- The bridge back to the AI-agent story. Lives inside the
               same copy block as the house-key lines above it, gated by
               the same data-analogy2 state and the same single fade —
               there's no separate click for this, it simply reads on
               once the visitor gets here. Kept visually a step quieter
               than the house-key pair so the analogy still leads. -->
          <p class="dy-hero__realize-bridge-text">Your AI agent works the same way.</p>
          <p class="dy-hero__realize-bridge-subtext">It could reach your digital world — but it still needed limits on what it could do.</p>

          <!-- The closing editorial cue, not another CTA — reads as the
               last line of this thought rather than a product action.
               Only appears once the "And then?" state is already
               revealed (data-gate="analogy2"); its own click just
               records that the visitor is ready to move on
               (data-advance) for whatever comes next — nothing on the
               stage reacts to that state yet, so pressing it changes
               nothing visible beyond the control itself. data-once
               retires it the moment it's used, same as the other
               one-shot prompts above it. -->
          <button
            type="button"
            class="dy-hero__realize-turn"
            data-reveal-trigger="advance"
            data-gate="analogy2"
            data-once
            disabled
          >
            Now bring that back to the AI. <span aria-hidden="true">→</span>
          </button>
        </div>

        <!-- A deeper, layers-only recession for the final state — the
             existing realize-scrim already eases the AI counterpart and
             layers together; this adds extra fade starting to the right
             of the AI avatar (never over it, and never over the human)
             so specifically the technology layers quiet down enough for
             the realization text to sit directly on them with no
             background of its own. Soft-edged (no hard seam), and the
             layers stay visible underneath — just quieter. -->
        <div class="dy-hero__final-layer-fade" aria-hidden="true"></div>

        <!-- The payoff line. Gated on the same data-advance state that
             the turn button already sets — appears as the house-key
             visual and its copy recede. Anchored to the right of both
             figures entirely (never over the human or the AI avatar),
             in the calmer right-hand portion of the layers rather than
             their busy centre. No card, no background — editorial serif
             and one small saffron mark leading in, the same restrained
             language used everywhere else on this stage. The headline
             carries the realization; the three supporting lines
             underneath it are deliberately smaller and quieter. -->
        <div class="dy-hero__final">
          <p class="dy-hero__final-text">AI agents may seem new.<br />But the idea isn't.</p>
          <p class="dy-hero__final-support">They need to know who they're helping,<br />what they can use,<br />and what they're allowed to do.</p>
        </div>

        <div class="dy-hero__chip dy-hero__chip--calendar">
          <svg class="dy-hero__chip-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <rect x="3" y="4.5" width="18" height="16" rx="2.2" stroke="currentColor" stroke-width="1.5" />
            <path d="M3 9.5h18" stroke="currentColor" stroke-width="1.5" />
            <path d="M7.5 2.8v3.2M16.5 2.8v3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="dy-hero__chip-label">Calendar updated</span>
        </div>

        <div class="dy-hero__chip dy-hero__chip--confirmation">
          <svg class="dy-hero__chip-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <rect x="2.5" y="5" width="19" height="14" rx="2.2" stroke="currentColor" stroke-width="1.5" />
            <path d="M3 6.5 12 13l9-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="dy-hero__chip-label">Confirmation sent</span>
        </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('[data-hero-stage]').forEach((stage) => {
      if (!(stage instanceof HTMLElement)) return;

      // The composition is authored once at a fixed 640px (see
      // .dy-hero__stage-inner's own comment). Below the width the grid
      // can actually give it, --hero-scale shrinks the whole thing as one
      // rigid block instead of a per-breakpoint re-layout — this is the
      // one thing that has to be measured in script rather than expressed
      // in CSS, since it depends on the stage's real rendered width.
      const STAGE_DESIGN_WIDTH = 640;
      if ('ResizeObserver' in window) {
        const observer = new ResizeObserver((entries) => {
          const entry = entries[0];
          if (!entry) return;
          const scale = Math.min(1, entry.contentRect.width / STAGE_DESIGN_WIDTH);
          stage.style.setProperty('--hero-scale', String(scale));
        });
        observer.observe(stage);
      } else {
        // No ResizeObserver: fall back to the one state every browser can
        // still resolve cheaply — full scale above the design width,
        // otherwise sized off the viewport. Re-checked on resize since
        // there's no observer doing it continuously.
        const syncScaleFallback = () => {
          const scale = Math.min(1, stage.getBoundingClientRect().width / STAGE_DESIGN_WIDTH);
          stage.style.setProperty('--hero-scale', String(scale));
        };
        syncScaleFallback();
        window.addEventListener('resize', syncScaleFallback);
      }

      const gatedButtons = stage.querySelectorAll('[data-gate]');

      // Any button that names a `data-gate` state (the continue CTA
      // gated on reveal3, the "And then?" prompt gated on realized)
      // only becomes a real, activatable control once that state is
      // actually reached — using `disabled` (not just the CSS
      // opacity/pointer-events gate) so it's also unreachable by
      // keyboard and screen readers until then.
      const syncGatedButtons = () => {
        gatedButtons.forEach((button) => {
          if (button instanceof HTMLButtonElement) {
            const gateKey = button.getAttribute('data-gate') || '';
            button.disabled = stage.dataset[gateKey] !== '1';
          }
        });
      };

      syncGatedButtons();

      // The fully expanded realization state reaches past the hero's
      // own default height. The grid (not the stage) reserves the extra
      // room for it — see the CSS note on .dy-hero__grid — so this just
      // keeps that reservation in sync with the one state that needs it.
      const grid = stage.closest('.dy-hero__grid');
      const syncGridHeight = () => {
        if (grid instanceof HTMLElement) {
          grid.dataset.expanded = stage.dataset.analogy2 === '1' ? '1' : '0';
        }
      };

      syncGridHeight();

      // "See how" only makes sense before the visitor has actually
      // started the right-side story — once the first layer is opened,
      // the story has its own actions (and later, the analogy's own
      // controls) to carry the visitor forward, so the CTA steps aside
      // rather than sitting there competing with them. It reappears,
      // relabelled "Replay", only once the visitor has reached the very
      // end (data-advance) — same button, same position, just a
      // different label/icon pair and a different click behaviour.
      const seeHowCta = document.getElementById('dy-hero-see-how');
      const syncSeeHowVisibility = () => {
        if (!(seeHowCta instanceof HTMLElement)) return;
        if (stage.dataset.advance === '1') {
          seeHowCta.dataset.mode = 'replay';
          seeHowCta.style.display = '';
        } else if (stage.dataset.reveal === '1') {
          seeHowCta.style.display = 'none';
        } else {
          seeHowCta.dataset.mode = 'see-how';
          seeHowCta.style.display = '';
        }
      };

      syncSeeHowVisibility();

      // Puts the whole hero back exactly where it started: every
      // reveal/realization flag back to its initial value, every
      // hotspot's aria-expanded back to false (their opacity/animation
      // are already driven off that plus the flags above, so resetting
      // both is what actually restores the original AI-agent scene and
      // an unopened Layer 1 dot rather than just hiding the text), and
      // the gated buttons/grid height/CTA re-synced from that clean
      // state the same way they sync on every other change here.
      const resetStory = () => {
        ['reveal', 'reveal2', 'reveal3', 'realized', 'analogy2', 'advance', 'entry'].forEach((key) => {
          stage.dataset[key] = '0';
        });
        stage.querySelectorAll('[data-reveal-trigger][aria-controls]').forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
        });
        syncGatedButtons();
        syncGridHeight();
        syncSeeHowVisibility();
      };

      stage.querySelectorAll('[data-reveal-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const key = trigger.getAttribute('data-reveal-trigger') || 'reveal';
          // One-way: once a layer is found it stays found for the rest of
          // this journey. A second press on an already-open point is a
          // no-op rather than a collapse — only pressing the *next*
          // layer's own point, once it has unlocked, moves things on.
          if (stage.dataset[key] === '1') return;
          stage.dataset[key] = '1';
          if (trigger.hasAttribute('aria-controls')) {
            trigger.setAttribute('aria-expanded', 'true');
          }
          syncGatedButtons();
          syncGridHeight();
          syncSeeHowVisibility();
          // A handful of triggers (marked `data-once`) exist purely to
          // move the story forward one beat and have nothing left to do
          // once pressed — disable them immediately after the sync above
          // (which would otherwise re-enable them, since the gate state
          // it checks hasn't changed) rather than leaving an
          // invisible-but-focusable control behind.
          if (trigger.hasAttribute('data-once') && trigger instanceof HTMLButtonElement) {
            trigger.disabled = true;
          }
        });
      });

      // "See how" lives outside this stage (in the brand column), but
      // its whole job is to point at this stage's own first hotspot —
      // clicking it doesn't open anything itself, it just switches on a
      // brief attention cue around that one dot so a first-time visitor
      // knows it's there to press. The cue stands down the moment the
      // visitor actually presses it, the same way the hotspot's own
      // ambient breathing ring already stands down on open. Once this
      // same button has become "Replay" (data-mode), the same click
      // instead resets the whole story back to that same starting point.
      if (seeHowCta instanceof HTMLElement) {
        seeHowCta.addEventListener('click', () => {
          if (seeHowCta.dataset.mode === 'replay') {
            resetStory();
          } else {
            stage.dataset.entry = '1';
          }
        });
      }
    });
  </script>

  <!-- ============================================================
       LOOK CLOSER — explore-preview cards (Card 1 of eventual 4)
       ============================================================ -->
  <section class="dy-explore">
    <div class="shell">
      <header class="dy-explore__head">
        <h2 class="dy-explore__title">There's <span class="dy-explore__title-accent">more</span> to understand.</h2>
        <p class="dy-explore__sub">Pick one and see what's really happening.</p>
      </header>

      <!-- The four featured stories come from src/data/stories.ts, which is
           the same list /explore/ reads. The markup below is exactly what
           was here before, emitted once per entry — no card gains or loses
           anything by being driven from the manifest. -->
      <ul class="dy-explore__grid">
        {featuredStories.map((story) => (
          <li class="dy-explore__card">
            <a class="dy-explore__link" href={`/explore/${story.slug}/`}>
              <span class="dy-explore__art">
                <img src={story.thumb} alt="" width="720" height="480" loading="lazy" decoding="async" />
              </span>
              <span class="dy-explore__label">{story.title}<br class="dy-explore__label-break" /> {story.line}</span>
              <span class="dy-explore__see">See what's really happening <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <a class="dy-explore__cta" href="/explore/">
        Explore everything
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============================================================
       JOIN
       ============================================================ -->
  <section class="dy-join" id="early-access">
    <div class="shell">
      <div class="dy-join__panel">
        <div class="dy-join__copy">
          <p class="dy-eyebrow"><span></span> DekhoYahan, as it grows</p>
          <h2>Be part of what we're building.</h2>
          <p class="dy-join__desc">
            Get new explanations as they arrive — and occasionally help shape what we explain next.
          </p>
        </div>

        <form class="dy-form" id="join-form" novalidate>
          <label for="join-email">Your email</label>

          <div class="dy-form__row">
            <input
              id="join-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            />
            <button type="submit">
              <span class="dy-form__label">Join</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <p class="dy-form__status" id="join-status" role="status" aria-live="polite"></p>

          <p class="dy-form__note">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3l7 3v6c0 4.4-3 8.1-7 9-4-0.9-7-4.6-7-9V6z" />
              <path d="M9 12.2l2.1 2.1L15.2 10" />
            </svg>
            Just DekhoYahan updates. Unsubscribe anytime.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('#join-form');
  const emailInput = document.querySelector('#join-email');
  const status = document.querySelector('#join-status');

  // Arriving via "Join early" should leave the cursor ready in the field,
  // whether that is a same-page jump or a landing from another page.
  const focusJoin = () => {
    if (location.hash !== '#early-access' || !(emailInput instanceof HTMLInputElement)) return;
    // Wait for the smooth scroll to settle before taking focus, so the
    // browser does not jump the viewport a second time.
    setTimeout(() => emailInput.focus({ preventScroll: true }), 600);
  };

  window.addEventListener('hashchange', focusJoin);
  focusJoin();

  if (
    form instanceof HTMLFormElement &&
    emailInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonText = form.querySelector('.dy-form__label');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      status.textContent = '';
      status.dataset.state = '';

      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please check your email address.';
        status.dataset.state = 'error';
        emailInput.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (buttonText instanceof HTMLElement) buttonText.textContent = 'Joining…';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data?.message || 'Something went wrong. Please try again.');
        }

        status.textContent = data.message || 'Done. We will email you when the next topic is ready.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (buttonText instanceof HTMLElement) buttonText.textContent = 'Join';
      }
    });
  }
</script>

<style>
  /* `hidden` must win over the display rules below */
  [hidden] {
    display: none !important;
  }

  /* =========================================================
     HERO — original DekhoYahan typography, restored
     ========================================================= */
  .dy-hero {
    position: relative;
    padding: clamp(38px, 5.5vh, 60px) 0 clamp(54px, 7vh, 76px);
    overflow: hidden;
  }

  .dy-hero::before {
    content: '';
    position: absolute;
    inset: -12% 40% 42% -22%;
    z-index: -1;
    background: radial-gradient(circle at 42% 46%, rgba(36, 92, 255, 0.055), transparent 62%);
    pointer-events: none;
  }

  .dy-hero__grid {
    display: grid;
    grid-template-columns: minmax(460px, 0.92fr) minmax(0, 1.08fr);
    /* Top-aligned: centring dropped the headline well below the
       feature stage and left the top-left of the page empty. */
    align-items: start;
    gap: clamp(40px, 5vw, 78px);
    /* Reserves room for the fully expanded realization state (see the
       `data-expanded` toggle in the script below). The realization
       copy is absolutely positioned against .dy-hero__stage — which
       keeps every existing top/left percentage on that content exactly
       as measured — so it never contributes to this grid's own content
       height on its own. Without this, the hero's overflow: hidden
       (needed for the decorative background glow) would either clip
       the deepest realization line or let it visually crowd the
       section that follows. Zero by default; only grows once that
       state is actually reached, and eases in rather than snapping. */
    padding-bottom: 0;
    transition: padding-bottom 500ms ease;
  }

  .dy-hero__grid[data-expanded='1'] {
    /* 92px at the composition's own 1:1 scale; the overflow this reserves
       room for scales down with the rest of the stage below 1320px, so the
       reservation shrinks with it rather than over-reserving. */
    padding-bottom: calc(92px * var(--hero-scale, 1));
  }

  .dy-hero__brand {
    max-width: 650px;
    /* Sits just below the top of the feature stage opposite it. */
    padding-top: clamp(6px, 3.4vh, 34px);
  }

  /* The seated visitor, their AI-agent counterpart, and the three stacked
     layers — visible at every width now. The composition itself
     (.dy-hero__stage-inner, below) is authored once at a fixed 640px and
     scaled as a rigid unit to fit whatever width this box actually has, so
     nothing here needs its own per-breakpoint layout: the aspect-ratio
     always reserves exactly the grid space the scaled composition needs. */
  .dy-hero__stage {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    aspect-ratio: 1536 / 1024;
    align-self: center;
  }

  /* The fixed-640px composition, scaled down to fit .dy-hero__stage's own
     (possibly narrower) width. `--hero-scale` is set by script from a
     ResizeObserver on the stage itself — 1 once the stage has its full
     640px, shrinking below that — so every child inside keeps the exact
     same percentage/pixel position and proportion to every other child at
     any width; only the whole rigid block gets smaller. This is what lets
     the layer-reveal text and the composition's tiny discovery dots scale
     down together with the artwork instead of colliding with it. */
  .dy-hero__stage-inner {
    position: absolute;
    top: 0;
    left: 0;
    width: 640px;
    height: 426.667px;
    transform-origin: top left;
    transform: scale(var(--hero-scale, 1));
  }

  .dy-hero__stage-inner img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Only at the width this composition was actually designed for does it
     get the same rightward-opening treatment it always had — the
     permanent, viewport-safe lane the progressive reveals sit in. Below
     that the stage already has the whole (narrower) column to itself, so
     there is no lane to open. */
  @media (min-width: 1320px) {
    .dy-hero__stage {
      justify-self: end;
      transform: translateX(-50px);
    }
  }

  /* The one request, sitting in the clear space above the seated
