---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentStage from '../components/hero/AgentStage.astro';
import { Image } from 'astro:assets';
import somethingFamiliar from '../assets/something-familiar.png';
import seeHowItWorks from '../assets/see-how-it-works.png';
import understandWhy from '../assets/understand-why.png';
import secret from '../assets/secret.png';
import car from '../assets/car.png';
import river from '../assets/river.png';
import signing from '../assets/signing.png';
---

<BaseLayout>
  <!-- ============================================================
       HERO — the brand statement, plus the feature stage beside it
       ============================================================ -->
  <section class="dy-hero">
    <div class="shell dy-hero__grid">
      <div class="dy-hero__brand">
        <p class="dy-hero__thought">
          There's more happening around you than you realize.
        </p>

        <h1 class="dy-hero__title">
          Understand the world
          <span>that's <em>arriving.</em></span>
        </h1>

        <p class="dy-hero__intro">
          Technology makes more sense when you understand why it exists,
          see how it works, and know where it matters.
        </p>

        <a class="dy-hero__cta" href="/explore">
          See what's happening
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <AgentStage />
    </div>
  </section>


  <!-- ============================================================
       METHOD — shell and typography only for this pass. The three
       positions below hold layout-only placeholders; the illustrations,
       the connecting saffron journey between them, and any icons or
       motion are deliberately not built yet.
       ============================================================ -->
  <section class="dy-method">
    <div class="shell dy-method__inner">
      <span class="dy-method__dot" aria-hidden="true"></span>

      <h2 class="dy-method__title">
        How <span class="brand-inline"><span class="brand-inline__dekho">Dekho</span><span class="brand-inline__yahan">Yahan</span></span> makes things click
      </h2>

      <p class="dy-method__sub">We make complicated things easier to see.</p>

      <!-- `.dy-method__stage` exists only to give the saffron thread a
           positioned container to overlay — the svg has to be a sibling of
           the list, not a child of it (a ul's content model doesn't permit
           arbitrary elements), so it's absolutely positioned over a shared
           wrapper instead. -->
      <div class="dy-method__stage">
        <!-- The saffron thread. Sits behind the three illustrations
             (z-index, not a gap cut into the path) so it can genuinely pass
             under Visual 2 rather than fake the effect. Coordinates are
             plotted as percentages of the row via a 1000-wide, unscaled
             viewBox — the same technique the hero's flight path uses — so
             the curve holds its shape as the row's own width changes with
             the viewport. -->
        <svg
          class="dy-method__journey"
          viewBox="0 0 1000 335"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <radialGradient id="dyGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#e87524" stop-opacity="0.4" />
              <stop offset="100%" stop-color="#e87524" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="dyHalo" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#e87524" stop-opacity="0.22" />
              <stop offset="100%" stop-color="#e87524" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- Begins low, near Visual 1's own lower-right; the two cubics
               after it dip into Visual 2's column and pass under its
               rendered image — genuinely hidden by it, not a drawn gap. -->
          <path
            class="dy-journey-line dy-journey-line--a"
            pathLength="1000"
            d="M225,272 C265,264 288,251 323,248 C375,244 440,254 500,262 C545,268 585,240 610,222"
            vector-effect="non-scaling-stroke"
          />
          <!-- Picks up where it emerges from behind Visual 2 and carries on
               into Visual 3's own footprint, ending under its rendered
               image rather than stopping short of it — the same "hidden by
               the artwork, not a gap in the path" logic as the Visual 2
               crossing, so the thread reads as continuous through all
               three, not stopping in front of the third. -->
          <path
            class="dy-journey-line dy-journey-line--b"
            pathLength="1000"
            d="M610,222 C630,215 655,213 677,213 C705,213 735,220 763,231 C785,234 810,236 830,236"
            vector-effect="non-scaling-stroke"
          />

          <!-- The two discovery points, both sitting in the gap between
               columns — never inside an illustration's own bounds. -->
          <circle class="dy-journey-dot dy-journey-dot--1" cx="323" cy="248" r="3.2" />

          <circle class="dy-journey-halo" cx="677" cy="213" r="10" fill="url(#dyHalo)" />
          <circle class="dy-journey-dot dy-journey-dot--2" cx="677" cy="213" r="3.2" />

          <!-- The closing glow, moved to sit at the path's new end point —
               it still marks where the thread finishes, just further under
               Visual 3 than before. -->
          <circle class="dy-journey-glow" cx="830" cy="236" r="18" fill="url(#dyGlow)" />
        </svg>

        <ul class="dy-method__row">
        <li class="dy-method__item">
          <span class="dy-method__mark dy-method__mark--art" aria-hidden="true">
            <Image
              src={somethingFamiliar}
              alt=""
              widths={[220, 336, 460, 600]}
              sizes="(max-width: 680px) 45vw, 19vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
            />
          </span>
          <strong class="dy-method__label">Start with what you know.</strong>
          <span class="dy-method__note">Something familiar.</span>
        </li>
        <li class="dy-method__item">
          <span class="dy-method__mark dy-method__mark--art2" aria-hidden="true">
            <Image
              src={seeHowItWorks}
              alt=""
              widths={[220, 336, 460, 600]}
              sizes="(max-width: 680px) 45vw, 21vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
            />
          </span>
          <strong class="dy-method__label">See how it works.</strong>
          <span class="dy-method__note">What’s happening underneath.</span>
        </li>
        <li class="dy-method__item">
          <span class="dy-method__mark dy-method__mark--art3" aria-hidden="true">
            <Image
              src={understandWhy}
              alt=""
              widths={[220, 336, 460, 600]}
              sizes="(max-width: 680px) 45vw, 15vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
            />
          </span>
          <strong class="dy-method__label">Understand why it matters.</strong>
          <span class="dy-method__note">What it means for you.</span>
        </li>
        </ul>
      </div>

      <p class="dy-method__signature">
        <span class="dy-method__rule" aria-hidden="true"></span>
        <span>See it <i>→</i> Understand it <i>→</i> See differently.</span>
        <span class="dy-method__rule" aria-hidden="true"></span>
      </p>
    </div>
  </section>

  <!-- ============================================================
       LOOK CLOSER — explore-preview cards (Card 1 of eventual 4)
       ============================================================ -->
  <section class="dy-explore">
    <div class="shell">
      <header class="dy-explore__head">
        <p class="dy-eyebrow"><span></span> Look closer</p>
        <h2 class="dy-explore__title">There's <span class="dy-explore__title-accent">more</span> to understand.</h2>
        <p class="dy-explore__sub">Pick one and see what's really happening.</p>
      </header>

      <ul class="dy-explore__grid">
        <li class="dy-explore__card">
          <a class="dy-explore__link" href="/explore">
            <span class="dy-explore__art">
              <Image
                src={secret}
                alt=""
                widths={[320, 440, 560]}
                sizes="(max-width: 680px) 84vw, (max-width: 1100px) 42vw, 22vw"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="dy-explore__label">A secret you send today</span>
            <strong class="dy-explore__q">Could someone steal it now and read it years later?</strong>
            <span class="dy-explore__arrow" aria-hidden="true">↻</span>
          </a>
        </li>
        <li class="dy-explore__card">
          <a class="dy-explore__link" href="/explore">
            <span class="dy-explore__art">
              <Image
                src={car}
                alt=""
                widths={[320, 440, 560]}
                sizes="(max-width: 680px) 84vw, (max-width: 1100px) 42vw, 22vw"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="dy-explore__label">A car you can't see</span>
            <strong class="dy-explore__q">Could your car know it's there before you do?</strong>
            <span class="dy-explore__arrow" aria-hidden="true">↻</span>
          </a>
        </li>
        <li class="dy-explore__card">
          <a class="dy-explore__link" href="/explore">
            <span class="dy-explore__art">
              <Image
                src={river}
                alt=""
                widths={[320, 440, 560]}
                sizes="(max-width: 680px) 84vw, (max-width: 1100px) 42vw, 22vw"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="dy-explore__label">Where a river meets the sea</span>
            <strong class="dy-explore__q">Could the difference between fresh water and salt water make electricity?</strong>
            <span class="dy-explore__arrow" aria-hidden="true">↻</span>
          </a>
        </li>
        <li class="dy-explore__card">
          <a class="dy-explore__link" href="/explore">
            <span class="dy-explore__art">
              <Image
                src={signing}
                alt=""
                widths={[320, 440, 560]}
                sizes="(max-width: 680px) 84vw, (max-width: 1100px) 42vw, 22vw"
                format="webp"
                quality={86}
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="dy-explore__label">Signing in at work</span>
            <strong class="dy-explore__q">Why does it keep checking it's really you?</strong>
            <span class="dy-explore__arrow" aria-hidden="true">↻</span>
          </a>
        </li>
      </ul>

      <a class="dy-explore__cta" href="/explore">
        Explore everything
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ============================================================
       JOIN
       ============================================================ -->
  <section class="dy-join" id="early-access">
    <div class="shell">
      <div class="dy-join__panel">
        <div class="dy-join__copy">
          <p class="dy-eyebrow"><span></span> Join DekhoYahan</p>
          <h2>Be part of the journey.</h2>
          <p class="dy-join__desc">
            We're building this one explanation at a time. Join us.
          </p>
        </div>

        <form class="dy-form" id="join-form" novalidate>
          <label for="join-email">Your email</label>

          <div class="dy-form__row">
            <input
              id="join-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              placeholder="you@example.com"
              required
            />
            <button type="submit">
              <span class="dy-form__label">Join</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <p class="dy-form__status" id="join-status" role="status" aria-live="polite"></p>

          <p class="dy-form__note">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3l7 3v6c0 4.4-3 8.1-7 9-4-0.9-7-4.6-7-9V6z" />
              <path d="M9 12.2l2.1 2.1L15.2 10" />
            </svg>
            We use your email only for this. You can stop any time.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('#join-form');
  const emailInput = document.querySelector('#join-email');
  const status = document.querySelector('#join-status');

  // Arriving via "Join early" should leave the cursor ready in the field,
  // whether that is a same-page jump or a landing from another page.
  const focusJoin = () => {
    if (location.hash !== '#early-access' || !(emailInput instanceof HTMLInputElement)) return;
    // Wait for the smooth scroll to settle before taking focus, so the
    // browser does not jump the viewport a second time.
    setTimeout(() => emailInput.focus({ preventScroll: true }), 600);
  };

  window.addEventListener('hashchange', focusJoin);
  focusJoin();

  if (
    form instanceof HTMLFormElement &&
    emailInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    const submitButton = form.querySelector('button[type="submit"]');
    const buttonText = form.querySelector('.dy-form__label');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      status.textContent = '';
      status.dataset.state = '';

      if (!email || !emailInput.validity.valid) {
        status.textContent = 'Please check your email address.';
        status.dataset.state = 'error';
        emailInput.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (buttonText instanceof HTMLElement) buttonText.textContent = 'Joining…';

      try {
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          throw new Error(data?.message || 'Something went wrong. Please try again.');
        }

        status.textContent = data.message || 'Done. We will email you when the next topic is ready.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (buttonText instanceof HTMLElement) buttonText.textContent = 'Join';
      }
    });
  }
</script>

<script>
  // The saffron thread's entrance is passive, scroll-triggered storytelling,
  // not a gate: nothing here blocks or delays scrolling, and the resting
  // CSS state (no `[data-armed]` attribute) is already the fully-visible
  // one, so a visitor with JavaScript disabled — or one whose OS asks for
  // reduced motion — simply sees the finished section immediately.
  const methodSection = document.querySelector('.dy-method');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (methodSection instanceof HTMLElement && !reduceMotion) {
    methodSection.dataset.armed = '';

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          methodSection.dataset.inview = '';
          observer.unobserve(methodSection);
        }
      },
      { threshold: 0.25 },
    );

    observer.observe(methodSection);
  }
</script>

<style>
  /* `hidden` must win over the display rules below */
  [hidden] {
    display: none !important;
  }

  /* =========================================================
     HERO — original DekhoYahan typography, restored
     ========================================================= */
  .dy-hero {
    position: relative;
    padding: clamp(38px, 5.5vh, 60px) 0 clamp(54px, 7vh, 76px);
    overflow: hidden;
  }

  .dy-hero::before {
    content: '';
    position: absolute;
    inset: -12% 40% 42% -22%;
    z-index: -1;
    background: radial-gradient(circle at 42% 46%, rgba(36, 92, 255, 0.055), transparent 62%);
    pointer-events: none;
  }

  .dy-hero__grid {
    display: grid;
    grid-template-columns: minmax(460px, 0.92fr) minmax(0, 1.08fr);
    /* Top-aligned: centring dropped the headline well below the
       feature stage and left the top-left of the page empty. */
    align-items: start;
    gap: clamp(40px, 5vw, 78px);
  }

  .dy-hero__brand {
    max-width: 650px;
    /* Sits just below the top of the feature stage opposite it. */
    padding-top: clamp(6px, 3.4vh, 34px);
  }

  .dy-hero__thought {
    max-width: 540px;
    margin: 0 0 clamp(16px, 1.9vh, 21px);
    color: #3f4854;
    font-size: clamp(15px, 1.05vw, 16px);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .dy-hero__title {
    margin: 0;
    max-width: 650px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(54px, 4.4vw, 72px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.052em;
    text-wrap: balance;
  }

  .dy-hero__title span {
    display: block;
  }

  .dy-hero__title em {
    color: var(--cobalt);
    font-style: normal;
  }

  .dy-hero__intro {
    max-width: 545px;
    margin: clamp(21px, 2.5vh, 27px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.58;
    letter-spacing: -0.012em;
  }

  .dy-hero__cta {
    width: fit-content;
    margin-top: clamp(26px, 3.5vh, 32px);
    display: inline-flex;
    align-items: center;
    gap: 13px;
    padding: 11px 12px 11px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 14px;
    font-weight: 720;
    text-decoration: none;
    box-shadow: 0 11px 28px rgba(17, 21, 28, 0.1);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .dy-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 17px 36px rgba(17, 21, 28, 0.15);
  }

  .dy-hero__cta:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .dy-hero__cta span {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 15px;
  }

  /* =========================================================
     METHOD
     Shell and typography only, for now — see the note in the markup.
     ========================================================= */
  .dy-method {
    padding: clamp(64px, 9vh, 108px) 0 clamp(70px, 10vh, 116px);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: linear-gradient(180deg, rgba(255, 253, 250, 0.6), rgba(246, 240, 231, 0.5));
  }

  .dy-method__inner {
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
  }

  .dy-method__dot {
    display: block;
    width: 9px;
    height: 9px;
    margin: 0 auto clamp(20px, 2.6vh, 28px);
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 6px rgba(232, 117, 36, 0.12);
  }

  .dy-method__title {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(34px, 3.6vw, 48px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .dy-method__title .brand-inline {
    font-weight: 700;
  }

  .dy-method__sub {
    margin: clamp(14px, 1.8vh, 18px) 0 0;
    color: var(--ink-soft);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.5;
  }

  /* THE THREE POSITIONS.

     `.dy-method__mark` is now a shared SLOT rather than a per-image box: one
     fixed height, identical for all three, tall enough to hold the largest
     of them (Visual 3) with room to spare. Labels sit right after it, so a
     uniform slot height is what keeps the three headings level regardless
     of how the illustrations inside are sized — that sizing now happens on
     the `<img>` itself, entirely decoupled from the slot.

     Each image is centred in its slot by flexbox, then nudged with a small
     percentage-based `translateY` measured from the source file's own
     alpha channel — how far its visible subject actually sits from the
     png's geometric middle. That is what "align by visual centre, not png
     boundary" means in practice: Visual 1's content sits a little low in
     its frame, Visual 2's is already close to centred, Visual 3's sits a
     little high — three different corrections for three different files,
     landing all three subjects on the same line regardless. */
  /* Exists only to give the saffron thread's svg a positioned ancestor to
     overlay — it isn't a grid or flex container itself, so it adds nothing
     to the row's own layout. `z-index: 0` forces it to own its stacking
     context locally, so the thread's negative z-index is guaranteed to
     resolve against the three illustrations right here, not against
     something further up the page.

     The row's own top margin moved here (off `.dy-method__row`, onto its
     wrapper): a margin on the row could collapse through this plain div and
     land outside it, which would leave the svg's `inset: 0` — measured
     against the wrapper's own box — sitting above where the row actually
     starts. Owning the spacing here instead removes the ambiguity. */
  .dy-method__stage {
    position: relative;
    z-index: 0;
    margin-top: clamp(56px, 8vh, 84px);
  }

  .dy-method__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dy-method__item {
    display: grid;
    justify-items: center;
  }

  .dy-method__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: clamp(269px, 24.9vw, 336px);
    margin-bottom: clamp(24px, 3vh, 32px);
    border: 0;
    background: none;
  }

  /* Visual 1 — familiar, calm: the smallest of the three, ~90% of Visual
     2's weight. No frame: the bounding box is feathered into the page with
     a mask, same as before, so it reads as art sitting on the cream rather
     than a photo in a rectangle. */
  .dy-method__mark--art img {
    display: block;
    height: clamp(209px, 19.6vw, 274px);
    width: auto;
    translate: 0 -3.5%;
    mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
    -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
  }

  /* Visual 2 — discovery, the most prominent of the three, unchanged in
     size from before. Bounded on both axes, since its frame is landscape
     and would otherwise spill past the column. */
  .dy-method__mark--art2 img {
    display: block;
    max-width: clamp(244px, 22.8vw, 320px);
    max-height: clamp(244px, 22.8vw, 320px);
    width: auto;
    height: auto;
    translate: 0 -0.2%;
  }

  /* Visual 3 — realization: a step past Visual 2's weight, but visually
     the simplest of the three, so the extra size reads as presence rather
     than clutter. */
  .dy-method__mark--art3 img {
    display: block;
    height: clamp(252px, 23.5vw, 329px);
    width: auto;
    translate: 0 1%;
  }

  /* =========================================================
     THE SAFFRON THREAD
     A quiet line behind the three illustrations, not a diagram: no
     arrowheads, no numbers, no repeating connector shape. It sits exactly
     over the row's own artwork band (same height as `.dy-method__mark`)
     and stops well short of the labels beneath.
     ========================================================= */
  .dy-method__journey {
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(269px, 24.9vw, 336px);
    z-index: -1;
    overflow: visible;
    pointer-events: none;
  }

  .dy-journey-line {
    fill: none;
    stroke: var(--saffron);
    stroke-opacity: 0.5;
    stroke-width: 1.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1000;
    stroke-dashoffset: 0;
  }

  .dy-journey-dot {
    fill: var(--saffron);
    opacity: 0.65;
  }

  /* ---------- entrance choreography ----------
     Everything above (the fully-drawn line, the settled dots and glow, the
     illustrations and signature at rest) is also the resting state here —
     it's what renders with no JavaScript and what `prefers-reduced-motion`
