---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features, canonicalUrl, pageTitle, type Feature } from '../features/registry';

// Every Feature in the registry gets its own permanent page here, whether
// or not it is the one currently on the homepage. Changing the homepage's
// featured story does not touch these routes, so an address that has been
// shared once keeps working.
export function getStaticPaths() {
  return features.map((feature) => ({
    params: { feature: feature.slug },
    props: { feature },
  }));
}

const { feature } = Astro.props as { feature: Feature };
const FeatureComponent = feature.Component;

// The share card, generated from the story's own picture rather than a
// second file kept in step by hand. A centre crop: the artwork's painted
// content is shorter than the 1200x630 window, so nothing is lost. JPEG
// because the source has transparency and several platforms composite
// that onto black — flattening onto the site's own cream avoids it, and
// keeps the file an order of magnitude smaller than PNG.
const share = await getImage({
  src: feature.socialImage.src,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  background: '#f8f5ef',
  format: 'jpeg',
  quality: 82,
});
---

<BaseLayout
  title={pageTitle(feature)}
  description={feature.description}
  canonical={canonicalUrl(feature)}
  image={{
    src: new URL(share.src, Astro.site).href,
    alt: feature.socialImage.alt,
    width: 1200,
    height: 630,
  }}
>
  <article class="dy-feature-page">
    <div class="shell dy-feature-page__frame">
      <!-- The page's heading. The Feature renders this same sentence as
           its own title, so showing it twice would break the composition —
           this exists to give the document the outline it needs, and to
           give a screen reader something to land on. It is clipped, not
           hidden: the identical text is on screen directly below. -->
      <h1 class="dy-feature-page__h1">{feature.headline}</h1>

      <!-- The story, and nothing else. It is an experience, not an
           article: no introduction, no contents, no second telling of
           what it just showed. -->
      <FeatureComponent />

      <!-- A short reference note, not a seventh scene. It is here from
           the moment the page loads, so it never arrives as a second
           ending, and it is set entirely in the page's sans — no serif,
           no cobalt, no saffron, no arrow, no motion — so it reads as
           context beside the story rather than as part of it. -->
      <section class="dy-feature-coda">
        <p class="dy-feature-coda__label">In short</p>
        <h2 class="dy-feature-coda__question">{feature.question}</h2>
        <p class="dy-feature-coda__answer">{feature.shortAnswer}</p>
        <p class="dy-feature-coda__takeaway">{feature.keyTakeaway}</p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .dy-feature-page {
    padding: 0 0 clamp(72px, 10vh, 128px);
  }

  /* Wide enough that the Feature's own `min(600px, 88%)` resolves to the
     same 600px it has in the hero, so the story runs at exactly the size
     it was designed and approved at. */
  .dy-feature-page__frame {
    width: min(720px, calc(100% - clamp(34px, 5vw, 72px)));
    margin-inline: auto;
  }

  /* Present for the document outline and for assistive technology; the
     same sentence is visible on screen immediately below. */
  .dy-feature-page__h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* -------- The reference note --------
     Takes the Feature's own measure and alignment: 600px, sitting on the
     artwork's left axis on wide screens and centring below 1320px, which
     is exactly where the Feature itself centres. Nothing here animates. */
  .dy-feature-coda {
    max-width: 600px;
    margin: clamp(40px, 6vh, 72px) 0 0;
    padding-top: clamp(22px, 3vh, 30px);
    border-top: 1px solid rgba(17, 21, 28, 0.1);
  }

  .dy-feature-coda__label {
    margin: 0 0 10px;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* A question is not a revelation: the same sans the rest of the site
     uses to explain things, at ordinary weight. */
  .dy-feature-coda__question {
    margin: 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.008em;
  }

  .dy-feature-coda__answer {
    margin: 12px 0 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
  }

  /* The line worth carrying away. Distinguished by ink and weight rather
     than by the serif, which belongs to the story's own revelations. */
  .dy-feature-coda__takeaway {
    margin: 14px 0 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.5;
  }

  @media (max-width: 1319px) {
    .dy-feature-coda {
      margin-inline: auto;
    }
  }
</style>
