---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — DekhoYahan"
  description="Get in touch with DekhoYahan."
>
  <article class="contact">
    <header class="contact-hero shell">
      <p class="contact-kicker">CONTACT</p>

      <h1 class="contact-title">Say hello.</h1>

      <p class="contact-intro">
        Have a question, spotted something we should correct, or have an
        idea for something DekhoYahan should explain?
      </p>

      <p class="contact-email">
        <a class="contact-email__link" href="mailto:hello@dekhoyahan.com">
          hello@dekhoyahan.com<span class="contact-email__arrow" aria-hidden="true">→</span>
        </a>
      </p>

      <p class="contact-social">
        <a
          class="contact-social__link"
          href="https://www.linkedin.com/company/dekhoyahan/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="contact-social__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
            />
          </svg>
          LinkedIn<span class="contact-social__arrow" aria-hidden="true">↗</span>
        </a>
      </p>
    </header>
  </article>
</BaseLayout>

<style>
  /* Scoped to this page only. Values match the approved Privacy/Terms
     document-page family (.privacy-*/.terms-*) so Contact reads as part
     of the same quiet system — nothing here touches those files. */

  .contact {
    padding: clamp(56px, 8vh, 96px) 0 clamp(84px, 11vh, 132px);
  }

  .contact-kicker {
    margin: 0 0 18px;
    color: var(--cobalt);
    font-size: 14px;
    font-weight: 720;
    letter-spacing: 0.05em;
  }

  .contact-title {
    margin: 0;
    max-width: 16ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.032em;
  }

  .contact-intro {
    margin: clamp(22px, 3.5vh, 32px) 0 0;
    max-width: 640px;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.65;
  }

  /* The explicit action the page exists for — a deliberate DekhoYahan
     text action (sans, cobalt, arrow), not a browser-default link and
     not a filled/outlined button. */
  .contact-email {
    margin: clamp(28px, 4.5vh, 40px) 0 0;
  }

  .contact-email__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--cobalt);
    font-family: var(--sans);
    font-size: 17.5px;
    font-weight: 640;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .contact-email__arrow {
    transition: transform 160ms ease;
  }

  /* Understated: an underline appears rather than a color/weight jump,
     with the arrow nudging forward slightly. */
  .contact-email__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-email__link:hover .contact-email__arrow {
    transform: translateX(2px);
  }

  .contact-email__link:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Secondary to the email above it: the same text-action construction,
     a step down in size and weight and carried in the quieter ink rather
     than cobalt, so the address stays the page's one primary action. */
  .contact-social {
    margin: clamp(12px, 1.8vh, 16px) 0 0;
  }

  .contact-social__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 160ms ease;
  }

  /* Takes the link's own colour rather than LinkedIn blue, so the mark
     darkens with the text on hover and stays secondary to the email. */
  .contact-social__icon {
    flex: none;
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .contact-social__arrow {
    transition: transform 160ms ease;
  }

  .contact-social__link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-social__link:hover .contact-social__arrow {
    transform: translate(1px, -1px);
  }

  .contact-social__link:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 680px) {
    .contact-title {
      max-width: none;
    }

    .contact-intro {
      font-size: 16.5px;
    }
  }
</style>
