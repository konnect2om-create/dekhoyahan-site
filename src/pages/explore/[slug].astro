---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptHero from '../../components/explain/ConceptHero.astro';
import LayerReveal from '../../components/explain/LayerReveal.astro';
import DecisionMoment from '../../components/explain/DecisionMoment.astro';
import DeepDive from '../../components/explain/DeepDive.astro';
import Sources from '../../components/explain/Sources.astro';
import PhotoJourney from '../../components/explain/PhotoJourney.astro';
import AgentStage from '../../components/explain/AgentStage.astro';
import PhotoStory from '../../components/explain/PhotoStory.astro';
import { storyPageMeta } from '../../data/storyMeta';

// A topic opts into a signature scene by naming it in frontmatter. Topics
// without one fall through to the standard template.
const scenes: Record<string, any> = {
  'photo-journey': PhotoJourney,
  'agent-stage': AgentStage,
};

export async function getStaticPaths() {
  const topics = await getCollection('topics', ({ data }) => data.status === 'published');
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const Scene = topic.data.scene ? scenes[topic.data.scene] : undefined;

// Topics that have been rebuilt as scene-by-scene stories open on their own
// Scene 1 composition instead of the generic ConceptHero + scene + layers
// stack. Everything below is still imported and still wired — it is gated off
// while the story sits at Scene 1, not removed.
const storyOpenings: Record<string, any> = {
  'how-your-photo-travels': PhotoStory,
};

const StoryOpening = storyOpenings[topic.id];

// A topic that is also a published story takes its title, description and
// share card from src/data/stories.ts, the same single source every other
// story page now reads. `ai-agent-permissions` has no entry there — it is
// deliberately unlisted — so it keeps the frontmatter-derived metadata it
// has always had, unchanged.
const meta = await storyPageMeta(topic.id, Astro.site);

const categoryLabel: Record<string, string> = {
  'identity-security': 'Identity & security',
  networks: 'Networks',
  'ai-agents': 'AI agents',
  'money-payments': 'Money & payments',
  'everyday-tech': 'Everyday tech',
};
---

<BaseLayout
  title={meta ? meta.title : `${topic.data.title} — DekhoYahan`}
  description={meta ? meta.description : topic.data.summary}
  image={meta ? meta.image : undefined}
>
  <main class="topic-page">
    {StoryOpening ? (
      <StoryOpening />
    ) : (
      <Fragment>
        <ConceptHero
          eyebrow={categoryLabel[topic.data.category] ?? topic.data.category}
          title={topic.data.title}
          hook={topic.data.hook}
        />

        {Scene && (
          <div class="topic-scene">
            <Scene mode="story" />
          </div>
        )}

        <LayerReveal layers={topic.data.layers} />

        {topic.data.decision && (
          <DecisionMoment prompt={topic.data.decision.prompt} options={topic.data.decision.options} />
        )}

        <DeepDive>
          <Content />
        </DeepDive>

        <Sources sources={topic.data.sources} />
      </Fragment>
    )}
  </main>
</BaseLayout>

{StoryOpening && (
  <script define:vars={{ topic: 'photo-sharing', rootSelector: '[data-photo]', finalAttr: 'familiar' }}>
    // Analytics: story_view (visibility, same pattern as hero_view/
    // explore_view) and story_complete (driven by this story's own existing
    // completion flag — root.dataset[finalAttr] reaching '1', the same
    // signal PhotoStory.astro's own script already uses to gate its closing
    // content — not a timer). Isolated from that script; only observes,
    // never mutates. Only 'how-your-photo-travels' currently uses a
    // StoryOpening component, so this is scoped to that case.
    const root = document.querySelector(rootSelector);
    if (root instanceof HTMLElement) {
      let viewFired = false;
      let viewTimer = null;
      const viewObserver = new IntersectionObserver(
        (entries) => {
          if (viewFired) return;
          const entry = entries[0];
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            if (viewTimer === null) {
              viewTimer = window.setTimeout(() => {
                viewFired = true;
                window.zaraz?.track('story_view', { topic });
                viewObserver.disconnect();
              }, 1000);
            }
          } else if (viewTimer !== null) {
            clearTimeout(viewTimer);
            viewTimer = null;
          }
        },
        { threshold: 0.5 }
      );
      viewObserver.observe(root);

      let completeFired = false;
      const completeObserver = new MutationObserver(() => {
        if (completeFired) return;
        if (root.dataset[finalAttr] === '1') {
          completeFired = true;
          window.zaraz?.track('story_complete', { topic });
          completeObserver.disconnect();
        }
      });
      completeObserver.observe(root, { attributes: true, attributeFilter: ['data-' + finalAttr] });
    }
  </script>
)}

<style>
  .topic-scene {
    max-width: 62rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 2.5rem;
  }
</style>
