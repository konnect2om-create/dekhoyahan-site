---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { stories } from '../../data/stories';

// The library is every published story, in manifest order: the four the
// homepage features first (same order as the homepage), then the
// Explore-only ones. Each story is listed once — being featured on the
// homepage does not earn a second entry here.
//
// This used to read the `topics` content collection and hard-code the one
// story that wasn't in it. Both surfaces now read src/data/stories.ts, so
// there is a single place a story is described. The `topics` collection is
// still what /explore/[slug].astro renders its two pages from; only this
// listing stopped depending on it.
---

<BaseLayout
  title="Explore — DekhoYahan"
  description="Find something you didn't know you wanted to understand."
>
  <article class="explore-index">
    <header class="explore-index__intro shell">
      <p class="explore-index__eyebrow">EXPLORE</p>

      <h1 class="explore-index__title">See what catches your attention.</h1>

      <p class="explore-index__lede">
        Technology is full of things we use every day without really seeing
        what's happening underneath.
      </p>

      <p class="explore-index__start">Start anywhere.</p>
    </header>

    <section class="explore-index__library shell">
      <ul class="explore-index__grid">
        {stories.map((story) => (
          <li class="explore-index__item">
            <a href={`/explore/${story.slug}/`}>
              <span class="explore-index__glyph" aria-hidden="true">
                <img src={story.thumb} alt="" width="720" height="480" loading="lazy" decoding="async" />
              </span>
              <h3>{story.title}<span class="explore-index__arrow" aria-hidden="true">&rarr;</span></h3>
              <p>{story.line}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<script>
  // Analytics: fires `explore_view` through Cloudflare Zaraz once the
  // page's main Explore content has been at least 50% visible in the
  // viewport for a continuous second. Targets the existing
  // .explore-index article (no markup added for this) and is isolated
  // from the cards' own markup/links above — it only observes
  // visibility and never touches layout, styling, or navigation.
  const exploreMain = document.querySelector('.explore-index');

  if (exploreMain instanceof HTMLElement) {
    let visibleTimer = null;
    let fired = false;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (visibleTimer === null) {
            visibleTimer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('explore_view');
              observer.disconnect();
            }, 1000);
          }
        } else if (visibleTimer !== null) {
          clearTimeout(visibleTimer);
          visibleTimer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(exploreMain);
  }
</script>

<style>
  /* Scoped to this page only. First visual checkpoint for the Explore
     Library: a compact opening, a library opening, and the first row of
     entries — reusing the two existing published topics as-is. Their own
     detail routes/content/scenes are untouched by anything here. */

  .explore-index {
    padding: clamp(28px, 4vh, 44px) 0 clamp(80px, 10vh, 120px);
  }

  /* -------- Explore opening: kept compact on purpose, so the library
     opening below is already visible on a normal desktop/laptop
     viewport without scrolling. -------- */

  .explore-index__intro {
    max-width: 720px;
  }

  .explore-index__eyebrow {
    margin: 0 0 14px;
    color: var(--cobalt);
    font-size: 14px;
    font-weight: 720;
    letter-spacing: 0.05em;
  }

  .explore-index__title {
    margin: 0;
    max-width: 22ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .explore-index__lede {
    margin: 16px 0 0;
    max-width: 56ch;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.6;
  }

  .explore-index__start {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 15px;
    font-weight: 620;
  }

  /* -------- Library row --------
     The heading and sub-line that used to sit here are gone, so the grid
     now follows "Start anywhere." directly — the gap is carried by this
     one margin instead of stacking with the grid's own former top margin. */

  .explore-index__library {
    max-width: 1100px;
    margin-top: clamp(20px, 3vh, 28px);
  }

  .explore-index__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 3vw, 48px);
  }

  /* Deliberately no card chrome — no border, background, or shadow.
     Whitespace and typography carry the separation; the whole item is
     the link, with a quiet colour shift as the only hover affordance. */
  .explore-index__item a {
    display: block;
    text-decoration: none;
  }

  /* One treatment for every item now that each story supplies the same
     720x480 thumbnail: the rounded, softly-shadowed window the 5G item
     established, at the thumbnails' own 3:2 ratio. The per-story rules
     this replaces — a vector-scaling rule for the Photo item and a
     hand-tuned zoom for the 5G one — existed only because those two
     entries carried different kinds of art. No card chrome beyond the
     image itself; whitespace and typography still carry the separation. */
  .explore-index__glyph {
    display: block;
    width: 100%;
    max-width: 220px;
    margin: 0 0 16px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(28, 34, 52, 0.14);
  }

  .explore-index__glyph img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Title/support treatment is informed by the homepage "There's more to
     understand." discovery cards (.dy-explore__label / .dy-explore__q) —
     the same serif weight step-up and tightened line-height that gives
     those titles their editorial pull, and the same quiet, close-set
     supporting line under it — just re-scaled for the Explore library's
     larger, unboxed presentation rather than that card's compact type. */
  .explore-index__item h3 {
    margin: 0;
    max-width: 21ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(21px, 2vw, 25px);
    font-weight: 640;
    line-height: 1.18;
    letter-spacing: -0.024em;
    transition: color 160ms ease;
  }

  .explore-index__item a:hover h3 {
    color: var(--cobalt);
  }

  /* Small, refined affordance sitting right beside each title — the
     same saffron used for the homepage discovery cards' arrow, just
     scaled down and placed inline rather than pinned to a fixed
     position. Purely visual: the whole card is already the link. */
  .explore-index__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
    vertical-align: middle;
    transition: transform 160ms ease;
  }

  .explore-index__item a:hover .explore-index__arrow {
    transform: translateX(2px);
  }

  .explore-index__item p {
    margin: 8px 0 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.48;
    letter-spacing: -0.003em;
  }

  .explore-index__item a:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 6px;
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    .explore-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .explore-index__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
