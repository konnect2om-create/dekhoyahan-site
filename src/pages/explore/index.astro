---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoJourney from '../../components/explain/PhotoJourney.astro';

// The AI Agent story keeps its own detail route and content untouched
// (see AgentStage.astro / [slug].astro) — it is only removed from this
// library listing because it currently overlaps with the homepage Feature.
// It stays published so its route keeps resolving.
const topics = (await getCollection('topics', ({ data }) => data.status === 'published'))
  .filter((topic) => topic.id !== 'ai-agent-permissions')
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

// The library's supporting line is a tighter, library-specific edit of the
// story's own hook — not the hook itself, which stays untouched on the
// detail page (ConceptHero reads `topic.data.hook` directly there). Only
// items that need a different line from their hook go here.
const librarySupportingCopy: Record<string, string> = {
  'how-your-photo-travels': "You press send. Seconds later, it's somewhere else.",
};
---

<BaseLayout
  title="Explore — DekhoYahan"
  description="Find something you didn't know you wanted to understand."
>
  <article class="explore-index">
    <header class="explore-index__intro shell">
      <p class="explore-index__eyebrow">EXPLORE</p>

      <h1 class="explore-index__title">See what catches your attention.</h1>

      <p class="explore-index__lede">
        Technology is full of things we use every day without really seeing
        what's happening underneath.
      </p>

      <p class="explore-index__start">Start anywhere.</p>
    </header>

    <section class="explore-index__library shell">
      <ul class="explore-index__grid">
        {topics.map((topic) => (
          <li class="explore-index__item">
            <a href={`/explore/${topic.id}/`}>
              {topic.id === 'how-your-photo-travels' && (
                /* Reuses the PhotoJourney component's opening state (the
                   same phone/person/send beat used on the topic page and
                   the homepage feature) instead of a bespoke asset — just
                   cropped tight via mode="opening" so only the familiar
                   moment shows, not the mechanism. */
                <span class="explore-index__glyph" aria-hidden="true">
                  <PhotoJourney mode="opening" />
                </span>
              )}
              <h3>{topic.data.title}</h3>
              {topic.data.hook && <p>{librarySupportingCopy[topic.id] ?? topic.data.hook}</p>}
            </a>
          </li>
        ))}

        <!-- New Explore-only story (Scene 1 only for now — see
             /explore/where-is-the-5g/). Not part of the topics collection,
             so it's placed here directly rather than through the map above;
             it takes the second grid position the AI Agent item vacated. -->
        <li class="explore-index__item">
          <a href="/explore/where-is-the-5g/">
            <span class="explore-index__glyph explore-index__glyph--5g" aria-hidden="true">
              <img src="/images/5G.webp" alt="" loading="lazy" decoding="async" />
            </span>
            <h3>Your phone says 5G. Where is the 5G?</h3>
            <p>You see it every day. But where is it?</p>
          </a>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  /* Scoped to this page only. First visual checkpoint for the Explore
     Library: a compact opening, a library opening, and the first row of
     entries — reusing the two existing published topics as-is. Their own
     detail routes/content/scenes are untouched by anything here. */

  .explore-index {
    padding: clamp(28px, 4vh, 44px) 0 clamp(80px, 10vh, 120px);
  }

  /* -------- Explore opening: kept compact on purpose, so the library
     opening below is already visible on a normal desktop/laptop
     viewport without scrolling. -------- */

  .explore-index__intro {
    max-width: 720px;
  }

  .explore-index__eyebrow {
    margin: 0 0 14px;
    color: var(--cobalt);
    font-size: 14px;
    font-weight: 720;
    letter-spacing: 0.05em;
  }

  .explore-index__title {
    margin: 0;
    max-width: 22ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .explore-index__lede {
    margin: 16px 0 0;
    max-width: 56ch;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.6;
  }

  .explore-index__start {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 15px;
    font-weight: 620;
  }

  /* -------- Library row --------
     The heading and sub-line that used to sit here are gone, so the grid
     now follows "Start anywhere." directly — the gap is carried by this
     one margin instead of stacking with the grid's own former top margin. */

  .explore-index__library {
    max-width: 1100px;
    margin-top: clamp(20px, 3vh, 28px);
  }

  .explore-index__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 3vw, 48px);
  }

  /* Deliberately no card chrome — no border, background, or shadow.
     Whitespace and typography carry the separation; the whole item is
     the link, with a quiet colour shift as the only hover affordance. */
  .explore-index__item a {
    display: block;
    text-decoration: none;
  }

  /* Prototype glyph for the one story using it — no box, no background,
     just whitespace above the title, same as the rest of this list. */
  .explore-index__glyph {
    display: block;
    width: 100%;
    max-width: 220px;
    margin: 0 0 16px;
  }

  .explore-index__glyph svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The 5G asset — a photo rather than the PhotoJourney SVG, so it gets its
     own crop instead of the shared `svg` rule above. Same visual weight as
     the Photo item's glyph (rounded, softly shadowed), just a fixed-ratio
     window onto the source image rather than a scaled vector. */
  .explore-index__glyph--5g {
    aspect-ratio: 6 / 5;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(28, 34, 52, 0.14);
  }

  .explore-index__glyph--5g img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* `object-fit: cover` alone only crops this image horizontally (it's
       proportionally wider than this 6:5 box, so cover is height-bound and
       always shows the asset's full height). The extra `scale()` pushes
       past that baseline to crop vertically too, so the "5G" glyph reads
       at library-preview size instead of sharing the frame with the
       wallpaper below it. Both this anchor and `transform-origin` target
       the same point — the centre of the 5G/signal/battery cluster,
       measured directly off the source asset — so the zoom lands exactly
       there rather than drifting off it. */
    object-position: 44.6% 32%;
    transform: scale(1.736);
    transform-origin: 44.6% 32%;
  }

  /* Title/support treatment is informed by the homepage "There's more to
     understand." discovery cards (.dy-explore__label / .dy-explore__q) —
     the same serif weight step-up and tightened line-height that gives
     those titles their editorial pull, and the same quiet, close-set
     supporting line under it — just re-scaled for the Explore library's
     larger, unboxed presentation rather than that card's compact type. */
  .explore-index__item h3 {
    margin: 0;
    max-width: 21ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(21px, 2vw, 25px);
    font-weight: 640;
    line-height: 1.18;
    letter-spacing: -0.024em;
    transition: color 160ms ease;
  }

  .explore-index__item a:hover h3 {
    color: var(--cobalt);
  }

  .explore-index__item p {
    margin: 8px 0 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.48;
    letter-spacing: -0.003em;
  }

  .explore-index__item a:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 6px;
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    .explore-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .explore-index__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
