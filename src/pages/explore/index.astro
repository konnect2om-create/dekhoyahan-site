---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const topics = (await getCollection('topics', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
  title="Explore — DekhoYahan"
  description="See how the technology around you actually works, one idea at a time."
>
  <main class="explore-index">
    <header class="explore-index__header">
      <p class="explore-index__eyebrow">Explore</p>
      <h1>See how it actually works.</h1>
    </header>

    <ul class="explore-index__grid">
      {topics.map((topic) => (
        <li>
          <a href={`/explore/${topic.id}/`}>
            <span class="explore-index__category">{topic.data.category.replace('-', ' ')}</span>
            <h2>{topic.data.title}</h2>
            <p>{topic.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .explore-index {
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 1.5rem 5rem;
  }

  .explore-index__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .explore-index__eyebrow {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cobalt);
  }

  .explore-index__header h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    color: var(--ink);
    margin: 0.4rem 0 0;
  }

  .explore-index__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .explore-index__grid a {
    display: block;
    height: 100%;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--paper);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .explore-index__grid a:hover {
    border-color: var(--cobalt-soft);
    transform: translateY(-2px);
  }

  .explore-index__category {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--saffron-deep);
  }

  .explore-index__grid h2 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0.5rem 0 0.4rem;
  }

  .explore-index__grid p {
    font-family: var(--sans);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }
</style>
