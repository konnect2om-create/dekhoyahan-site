    [data-changed='1'] .answer__sentence2,
    [data-changed='1'] .answer__sentence2 > .answer__reveal-kicker,
    [data-changed='1'] .answer__sentence2 > .answer__turn,
    [data-chosen='1'] .answer__sentence3,
    [data-chosen='1'] .answer__sentence3 > .answer__reveal-kicker,
    [data-chosen='1'] .answer__sentence3 > .answer__reveal-text,
    [data-chosen='1'] .answer__sentence3 > .answer__turn,
    [data-final='1'] .answer__sentence4,
    [data-final='1'] .answer__sentence4 > .answer__reveal-kicker,
    [data-final='1'] .answer__sentence4 > .answer__reveal-text,
    [data-final='1'] .answer__sentence4 > .answer__turn,
    [data-tokens='1'] .answer__sentence5,
    [data-tokens='1'] .answer__sentence5 > .answer__reveal-kicker--1,
    [data-tokens='1'] .answer__sentence5 > .answer__tokens,
    [data-tokens='1'] .answer__sentence5 > .answer__reveal-kicker--2,
    [data-tokens='1'] .answer__sentence5 > .answer__reveal-text,
    [data-tokens='1'] .answer__sentence5 > .answer__turn,
    [data-patterns='1'] .answer__sentence6,
    [data-patterns='1'] .answer__sentence6 > .answer__reveal-kicker,
    [data-patterns='1'] .answer__sentence6 > .answer__reveal-text,
    [data-patterns='1'] .answer__sentence6 > .answer__turn,
    [data-trained='1'] .answer__sentence6 > .answer__sentence7,
    [data-trained='1'] .answer__sentence7 > .answer__verdict,
    [data-trained='1'] .answer__sentence7 > .answer__reveal-text--support,
    [data-trained='1'] .answer__sentence7 > .answer__reveal-text--term,
    [data-trained='1'] .answer__sentence7 > .answer__turn,
    [data-context='1'] .answer__sentence7 > .answer__sentence8,
    [data-context='1'] .answer__sentence8 > .answer__prompt,
    [data-context='1'] .answer__sentence8 > .answer__ranking--prompt,
    [data-context='1'] .answer__sentence8 > .answer__reveal-kicker,
    [data-context='1'] .answer__sentence8 > .answer__reveal-text,
    [data-context='1'] .answer__sentence8 > .answer__turn,
    [data-grow='1'] .answer__sentence8 > .answer__sentence9,
    [data-grow='1'] .answer__sentence9 > .answer__reveal-kicker,
    [data-grow='1'] .answer__sentence9 > .answer__reveal-text,
    [data-grow='1'] .answer__sentence9 > .answer__realise,
    [data-grow='1'] .answer__sentence9 > .answer__turn,
    [data-close='1'] .answer__sentence9 > .answer__sentence10,
    [data-close='1'] .answer__sentence10 > .answer__echo,
    [data-close='1'] .answer__closing-a,
    [data-close='1'] .answer__closing-b,
    [data-close='1'] .answer__sentence10 > .answer__reveal-text,
    [data-close='1'] .answer__last-a,
    [data-close='1'] .answer__last-b,
    [data-close='1'] .answer__sentence10 > .answer__turn {
      animation: none;
    }

    /* The completed answer, immediately: every piece already in the
       sentence and already settled to ink, with none of the staged build
       to sit through. Matched to the forward rule's own [data-grow-piece]
       selector so it actually outweighs it — the same specificity lesson
       as the fallbacks above. */
    [data-grow='1'] .answer__prompt [data-grow-piece] {
      animation: none;
      opacity: 1;
    }

    [data-grow='1'] .answer__sentence8 .answer__prompt-next {
      transition: none;
    }

    /* The appended token and its ellipsis are shown at their finished
       width outright — the same lesson as the split marks above, since
       switching the animation off alone would leave them stuck at zero
       width. Matched to each forward rule's own specificity. */
    [data-context='1'] .answer__sentence8 .answer__prompt-next {
      animation: none;
      width: 4.163em;
      opacity: 1;
    }

    [data-context='1'] .answer__sentence8 .answer__prompt-more {
      animation: none;
      width: 0.993em;
      opacity: 1;
    }

    /* No animation to carry the delayed lean, so the pick is simply
       marked outright — the same fallback "mat" and "moon" already use. */
    [data-context='1'] .answer__rank-word--pick {
      animation: none;
      color: var(--ink);
      font-weight: 700;
    }

    /* The words' fade is a real transition, so collapsing its duration and
       delay is enough to clear them outright. The values' own surfacing is
       a fill:both keyframe, though — the same lesson as the piece and
       split-mark fallbacks above — so each staggered wave is matched at
       its own specificity and shown at its finished opacity instead of
       being left stuck at zero. */
    [data-trained='1'] .answer__field .answer__frag,
    [data-trained='1'] .answer__field .answer__pair,
    [data-trained='1'] .answer__field-stage > .answer__field {
      transition-duration: 1ms;
      transition-delay: 0ms;
    }

    [data-trained='1'] .answer__value:nth-child(4n + 1),
    [data-trained='1'] .answer__value:nth-child(4n + 2),
    [data-trained='1'] .answer__value:nth-child(4n + 3),
    [data-trained='1'] .answer__value:nth-child(4n) {
      animation: none;
      opacity: 0.78;
    }

    /* Matched to [data-piece]'s own attribute selector (not just the bare
       class) so this actually outweighs each numbered piece's individual
       animation rule — a same-specificity contest that a plain
       `.answer__piece` selector was losing, leaving every piece stuck at
       its pre-delay opacity:0 instead of the completed sentence this rule
       means to show. No staged build to skip past: every piece is simply
       shown at full opacity outright. */
    [data-final='1'] .answer__piece[data-piece] {
      animation: none;
      opacity: 1;
    }

    /* Same reasoning for the split marks: shown at their finished
       width/opacity outright rather than left at zero, which is what
       they'd be stuck at if just the animation were switched off. Matched
       to .answer__token--word/--punct's own specificity, the same
       lesson as the piece-fallback above — a bare .answer__token-sep
       selector here would lose to the more specific forward rules and
       leave both marks stuck invisible. */
    [data-tokens='1'] .answer__token--word .answer__token-sep,
    [data-tokens='1'] .answer__token--punct .answer__token-sep {
      animation: none;
      width: 0.9em;
      opacity: 1;
    }

    /* Same fallback logic as the two rules above: the field's own recede
       and the three pairs' emphasis are both shown at their finished
       state outright, matched to each rule's own specificity so neither
       gets stuck at its pre-delay value. */
    [data-patterns='1'] .answer__field .answer__frag {
      animation: none;
      opacity: 0.38;
    }

    [data-patterns='1'] .answer__field .answer__pair {
      animation: none;
      color: var(--ink);
      font-weight: 700;
      opacity: 1;
    }

    .answer__word {
      transition-duration: 1ms;
    }

    /* No animation to carry the delayed lean, so the emphasis is simply
       applied outright — "mat" (Scene 2) and "moon" (Scene 3) still end
       up marked, just without the beat of noticing it happen. */
    [data-stage='2'] .answer__word--mat,
    [data-changed='1'] .answer__word--moon {
      animation: none;
      color: var(--ink);
      font-weight: 700;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-answer]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;

    // One way, one time: Scene 1 → Scene 2. There is nothing before it to
    // return to, so a second click is simply a no-op.
    root.querySelector('[data-show]')?.addEventListener('click', () => {
      if (root.dataset.stage !== '1') return;
      root.dataset.stage = '2';
    });

    // Scene 3. A flag of its own rather than a bumped stage, so everything
    // Scene 2 turned on stays on underneath it — the same reason every
    // other Explore story's later beats each get their own flag instead of
    // a rising stage number.
    root.querySelector('[data-change]')?.addEventListener('click', () => {
      if (root.dataset.stage !== '2' || root.dataset.changed === '1') return;
      root.dataset.changed = '1';
    });

    // Scene 4. A flag of its own rather than a bumped stage, so everything
    // Scene 3 turned on stays on underneath it.
    root.querySelector('[data-choose]')?.addEventListener('click', () => {
      if (root.dataset.changed !== '1' || root.dataset.chosen === '1') return;
      root.dataset.chosen = '1';
    });

    // Scene 5. A flag of its own rather than a bumped stage, so everything
    // Scene 4 turned on stays on underneath it.
    root.querySelector('[data-again]')?.addEventListener('click', () => {
      if (root.dataset.chosen !== '1' || root.dataset.final === '1') return;
      root.dataset.final = '1';
    });

    // Scene 6. A flag of its own rather than a bumped stage, so everything
    // Scene 5 turned on stays on underneath it.
    root.querySelector('[data-answer-final]')?.addEventListener('click', () => {
      if (root.dataset.final !== '1' || root.dataset.tokens === '1') return;
      root.dataset.tokens = '1';
    });

    root.querySelector('[data-why]')?.addEventListener('click', () => {
      if (root.dataset.tokens !== '1' || root.dataset.patterns === '1') return;
      root.dataset.patterns = '1';
    });

    // Scene 8. A flag of its own rather than a bumped stage, so everything
    // Scene 7 turned on stays on underneath it.
    root.querySelector('[data-learn]')?.addEventListener('click', () => {
      if (root.dataset.patterns !== '1' || root.dataset.trained === '1') return;
      root.dataset.trained = '1';
    });

    // Scene 9. A flag of its own rather than a bumped stage, so everything
    // Scene 8 turned on stays on underneath it.
    root.querySelector('[data-become]')?.addEventListener('click', () => {
      if (root.dataset.trained !== '1' || root.dataset.context === '1') return;
      root.dataset.context = '1';
    });

    // Scene 10. A flag of its own rather than a bumped stage, so everything
    // Scene 9 turned on stays on underneath it.
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      if (root.dataset.context !== '1' || root.dataset.grow === '1') return;
      root.dataset.grow = '1';
    });

    // Scene 11 — the last beat of the card.
    root.querySelector('[data-understand]')?.addEventListener('click', () => {
      if (root.dataset.grow !== '1' || root.dataset.close === '1') return;
      root.dataset.close = '1';
    });

    // The end of Card 2. Every flag is cleared rather than a "replay" flag
    // added, so the story genuinely returns to Scene 1 — each beat's
    // display:none comes back, which is also what lets its animations run
    // again from the start rather than staying at their finished state.
    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      if (root.dataset.close !== '1') return;

      for (const flag of [
        'changed',
        'chosen',
        'final',
        'tokens',
        'patterns',
        'trained',
        'context',
        'grow',
        'close',
      ]) {
        delete root.dataset[flag];
      }

      root.dataset.stage = '1';

      // The reader is far down the page by now; without this the story
      // would restart out of sight above them.
      root.scrollIntoView({ block: 'start' });
      root.querySelector('[data-show]')?.focus();
    });
  });
</script>

<script define:vars={{ topic: 'ai-answered-you', rootSelector: '[data-answer]', finalAttr: 'final' }}>
  // Analytics: story_view (visibility, same pattern as hero_view/explore_view)
  // and story_complete (driven by this story's own existing completion flag —
  // root.dataset[finalAttr] reaching '1', the same signal the script above
  // already uses to gate the closing content — not a timer). Isolated from
  // the story's own script; only observes, never mutates.
  const root = document.querySelector(rootSelector);
  if (root instanceof HTMLElement) {
    let viewFired = false;
    let viewTimer = null;
    const viewObserver = new IntersectionObserver(
      (entries) => {
        if (viewFired) return;
        const entry = entries[0];
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (viewTimer === null) {
            viewTimer = window.setTimeout(() => {
              viewFired = true;
              window.zaraz?.track('story_view', { topic });
              viewObserver.disconnect();
            }, 1000);
          }
        } else if (viewTimer !== null) {
          clearTimeout(viewTimer);
          viewTimer = null;
        }
      },
      { threshold: 0.5 }
    );
    viewObserver.observe(root);

    let completeFired = false;
    const completeObserver = new MutationObserver(() => {
      if (completeFired) return;
      if (root.dataset[finalAttr] === '1') {
        completeFired = true;
        window.zaraz?.track('story_complete', { topic });
        completeObserver.disconnect();
      }
    });
    completeObserver.observe(root, { attributes: true, attributeFilter: ['data-' + finalAttr] });
  }
</script>
