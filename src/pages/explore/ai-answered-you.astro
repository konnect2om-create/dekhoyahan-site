     deeper and so is untouched by this child combinator. */
  [data-patterns='1'] .answer__sentence5 > .answer__reveal-kicker--1,
  [data-patterns='1'] .answer__sentence5 > .answer__tokens,
  [data-patterns='1'] .answer__sentence5 > .answer__reveal-kicker--2,
  [data-patterns='1'] .answer__sentence5 > .answer__reveal-text,
  [data-patterns='1'] .answer__sentence5 > .answer__turn {
    display: none;
  }

  [data-patterns='1'] .answer__sentence6 {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 240ms;
  }

  /* A loose run of ordinary fragments, never a grid of cards — reads as
     language met in passing, not data laid out for inspection. */
  .answer__field {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 16px;
    margin: clamp(20px, 3vh, 28px) 0 0;
    max-width: 46em;
  }

  .answer__frag {
    color: var(--muted-light);
    font-size: 13.5px;
    line-height: 1.6;
    opacity: 0.7;
    transition: opacity 700ms ease;
  }

  /* Once the field has had a moment to be read as undifferentiated
     language, the rest of it quietly recedes... */
  [data-patterns='1'] .answer__field .answer__frag {
    animation: answer-recede 1ms linear both;
    animation-delay: 900ms;
  }

  @keyframes answer-recede {
    to {
      opacity: 0.38;
    }
  }

  /* Four relationships, revealed one at a time rather than all at once —
     astronaut/space, then astronaut/moon, then moon/Earth, then
     moon/orbit — each pair gaining the sentence's own ink colour and
     weight together on its own beat, half a second apart, so the build
     reads as a sequence of separate noticings rather than one moment.
     "Astronaut" and "moon" are each written into more than one fragment
     on purpose: seeing the same word light up again, beside a different
     neighbour each time, is what makes a relationship read as recurring
     rather than a single coincidence. Nothing moves, nothing is boxed or
     connected by a line — the shared timing and the repetition across
     fragments are the only things doing the work. The four pairs also
     hold their emphasis in the final static state, so the same "lots of
     language, a few words keep recurring together" reading is available
     to a reader who lands after the build finishes, or with motion
     reduced. */
  .answer__pair {
    color: inherit;
    font-weight: inherit;
    transition: color 700ms ease, font-weight 700ms ease, opacity 700ms ease;
  }

  [data-patterns='1'] .answer__field .answer__pair {
    animation: answer-emphasise 1ms linear both;
  }

  [data-patterns='1'] .answer__field [data-beat='1'] {
    animation-delay: 900ms;
  }

  [data-patterns='1'] .answer__field [data-beat='2'] {
    animation-delay: 1500ms;
  }

  [data-patterns='1'] .answer__field [data-beat='3'] {
    animation-delay: 2100ms;
  }

  [data-patterns='1'] .answer__field [data-beat='4'] {
    animation-delay: 2700ms;
  }

  @keyframes answer-emphasise {
    to {
      color: var(--ink);
      font-weight: 700;
      opacity: 1;
    }
  }

  [data-patterns='1'] .answer__sentence6 > .answer__reveal-kicker {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3500ms;
  }

  [data-patterns='1'] .answer__sentence6 > .answer__reveal-text {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3740ms;
  }

  [data-patterns='1'] .answer__sentence6 > .answer__turn {
    display: inline-block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 4220ms;
  }

  /* ====================================================
     Scene 8 — the examples are gone; something changed.
     ==================================================== */

  /* Scene 7's own kicker/text/turn — "it learned patterns," now said and
     done — are what this hand-over hides. .answer__field and
     .answer__sentence-text are deliberately left out of this list: the
     fading field is Scene 8's opening beat, not something to clear before
     it starts, and the headline has carried over since Scene 6. */
  [data-trained='1'] .answer__sentence6 > .answer__reveal-kicker,
  [data-trained='1'] .answer__sentence6 > .answer__reveal-text,
  [data-trained='1'] .answer__sentence6 > .answer__turn {
    display: none;
  }

  /* Text and values share one grid cell, so the numbers arrive in the
     exact footprint the sentences occupied rather than somewhere new. */
  .answer__field-stage {
    display: grid;
    grid-template-areas: 'stage';
    align-items: start;
  }

  .answer__field-stage > .answer__field,
  .answer__field-stage > .answer__values {
    grid-area: stage;
  }

  /* The cap is far above anything the field ever renders at, so it does
     nothing until the collapse below asks for it. */
  .answer__field-stage > .answer__field {
    max-height: 1400px;
    overflow: hidden;
    transition: max-height 600ms ease;
  }

  /* Once the words have finished fading, the space they were holding
     closes behind them and the values become the whole of the area —
     otherwise the sentences would go on occupying their full height
     invisibly, leaving the copy below stranded far down the column
     (badly so on a phone, where the field is many lines tall). */
  [data-trained='1'] .answer__field-stage > .answer__field {
    max-height: 0;
    transition-delay: 1150ms;
  }

  /* Every word in the field fades to nothing in place — colour, not
     opacity, so the text keeps its space in the flow and the area holds
     the height the sentences were holding while the values settle into
     it. Nothing reflows at any point in the transition. */
  [data-trained='1'] .answer__field .answer__frag {
    color: transparent;
    transition: color 900ms ease;
    transition-delay: 200ms;
  }

  /* The recurring words don't inherit that fade: Scene 7's own emphasis
     animation is still holding their colour at fill:both, and an
     animation's value beats any plain declaration. So the animation is
     cancelled outright here and the same fade applied directly, matched
     to that forward rule's specificity — otherwise "astronaut", "moon",
     "Earth", "space" and "orbit" would be the only text still standing
     once everything around them had gone. */
  [data-trained='1'] .answer__field .answer__pair {
    animation: none;
    color: transparent;
    transition: color 900ms ease;
    transition-delay: 200ms;
  }

  /* Loosely set, never ruled: no fixed columns, no baseline shared across
     neighbours, no monospace/terminal face, no boxes or rules — a scatter
     of quantities across the space, not a spreadsheet, matrix or block of
     code. Hidden outright until the beat starts, so it never adds height
     of its own to Scene 7. */
  .answer__values {
    display: none;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: clamp(13px, 1.9vh, 19px) clamp(20px, 2.6vw, 34px);
    /* Room for the nudges above and below the block, and clear air under
       the field once it has closed to the values' own height. */
    padding: 12px 0 clamp(26px, 4vh, 40px);
  }

  [data-trained='1'] .answer__field-stage > .answer__values {
    display: flex;
  }

  .answer__value {
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0;
  }

  /* The nudges that keep the field from settling into rows. Deliberately
     uneven periods (3/4/5/7) so no two lines drift the same way and the
     eye never finds a grid to lock onto. */
  .answer__value:nth-child(3n) {
    transform: translateY(7px);
  }

  .answer__value:nth-child(4n) {
    transform: translateY(-6px);
  }

  .answer__value:nth-child(5n) {
    transform: translateY(11px);
  }

  .answer__value:nth-child(7n) {
    transform: translateY(-10px);
  }

  /* A little colour variety for texture, in the page's own two inks —
     never a heat map, never a legend, nothing here encodes a meaning. */
  .answer__value:nth-child(5n + 1) {
    color: var(--cobalt);
  }

  .answer__value:nth-child(8n + 3) {
    color: var(--ink);
  }

  /* The values surface in four loose waves rather than all at once, so
     they read as emerging where the words were rather than being switched
     on over them. */
  [data-trained='1'] .answer__value {
    animation: answer-surface 700ms ease both;
  }

  [data-trained='1'] .answer__value:nth-child(4n + 1) {
    animation-delay: 520ms;
  }

  [data-trained='1'] .answer__value:nth-child(4n + 2) {
    animation-delay: 700ms;
  }

  [data-trained='1'] .answer__value:nth-child(4n + 3) {
    animation-delay: 880ms;
  }

  [data-trained='1'] .answer__value:nth-child(4n) {
    animation-delay: 1060ms;
  }

  @keyframes answer-surface {
    to {
      opacity: 0.78;
    }
  }

  .answer__sentence7 {
    display: none;
  }

  [data-trained='1'] .answer__sentence6 > .answer__sentence7 {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 1700ms;
  }

  /* Set in the story's own serif — the same face the sentence itself has
     worn since Scene 2 — a step down from the headline, so it reads as
     this beat's statement rather than a second title. The two halves sit
     on their own lines but in one paragraph: "gone" in ink, "remain" in
     cobalt, the turn carried entirely by the colour change. */
  .answer__verdict {
    display: none;
    margin: 0 0 clamp(20px, 3vh, 28px);
    font-family: var(--serif);
    font-size: clamp(21px, 2.4vw, 28px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.022em;
  }

  .answer__verdict-gone,
  .answer__verdict-remain {
    display: block;
  }

  .answer__verdict-gone {
    color: var(--ink);
  }

  .answer__verdict-remain {
    color: var(--cobalt);
  }

  [data-trained='1'] .answer__sentence7 > .answer__verdict {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 1700ms;
  }

  /* A short editorial rule setting the statement above apart from the
     explanation below — a hairline in the page's own border ink, kept
     well short of the column so it reads as a pause, not a divider. It
     rides on whichever line now opens that explanation, so the separator
     stays exactly where it sat. */
  .answer__sentence7 > .answer__reveal-text--support::before {
    content: '';
    display: block;
    width: 190px;
    max-width: 55%;
    height: 1px;
    margin-bottom: clamp(18px, 2.6vh, 26px);
    background: var(--line);
  }

  /* Takes the slot the removed line was holding, so the beat below the
     verdict keeps the cadence it already had rather than closing up. */
  [data-trained='1'] .answer__sentence7 > .answer__reveal-text--support {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 2120ms;
  }

  [data-trained='1'] .answer__sentence7 > .answer__reveal-text--term {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 2410ms;
  }

  /* The word itself, the first time the story uses it. */
  .answer__reveal-text--term strong {
    color: var(--ink);
    font-weight: 700;
  }

  [data-trained='1'] .answer__sentence7 > .answer__turn {
    display: inline-block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 2890ms;
  }

  /* ====================================================
     Scene 9 — the question comes back.
     ==================================================== */

  /* This hand-over clears more than the others: Scene 6's headline and
     the values field go too, since the story is leaving the model's
     insides and returning to the reader's own question — the first time
     since Scene 6 that the whole right column starts fresh. */
  [data-context='1'] .answer__sentence4 > .answer__built,
  [data-context='1'] .answer__sentence6 > .answer__sentence-text,
  [data-context='1'] .answer__sentence6 > .answer__field-stage,
  [data-context='1'] .answer__sentence7 > .answer__verdict,
  [data-context='1'] .answer__sentence7 > .answer__reveal-text--support,
  [data-context='1'] .answer__sentence7 > .answer__reveal-text--term,
  [data-context='1'] .answer__sentence7 > .answer__turn {
    display: none;
  }

  .answer__sentence8 {
    display: none;
  }

  [data-context='1'] .answer__sentence7 > .answer__sentence8 {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 240ms;
  }

  /* The question set at the story's own opening size — the largest type
     the right column has carried since Scene 1, because this is the
     reader's own question coming back, not another explanatory line. */
  .answer__prompt {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(27px, 3.4vw, 40px);
    line-height: 1.18;
    letter-spacing: -0.028em;
  }

  [data-context='1'] .answer__sentence8 > .answer__prompt {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 240ms;
  }

  /* The chosen token, appended to the question rather than restated
     below it. Zero-width until it is picked — genuinely taking up no
     space, so the question reads as finished first and is then visibly
     continued. The left margin is carried in CSS rather than a space in
     the source, since Astro compacts whitespace between tags at build
     and the words would otherwise run together. */
  .answer__prompt-next,
  .answer__prompt-more {
    display: inline-block;
    width: 0;
    overflow: hidden;
    opacity: 0;
    vertical-align: bottom;
  }

  .answer__prompt-next {
    color: var(--cobalt);
  }

  .answer__prompt-more {
    color: var(--muted-light);
  }

  [data-context='1'] .answer__sentence8 .answer__prompt-next {
    animation: answer-append 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 2900ms;
  }

  [data-context='1'] .answer__sentence8 .answer__prompt-more {
    animation: answer-append-more 420ms ease both;
    animation-delay: 3300ms;
  }

  @keyframes answer-append {
    from {
      width: 0;
      opacity: 0;
    }
    to {
      width: 4.163em;
      opacity: 1;
    }
  }

  @keyframes answer-append-more {
    from {
      width: 0;
      opacity: 0;
    }
    to {
      width: 0.993em;
      opacity: 1;
    }
  }

  /* Scene 4's ranking exactly as it was — same rows, same block
     characters, same spacing — so this reads as the mechanism already
     watched, now running on the reader's own question, not a second
     diagram. Only the top margin differs, to sit under the larger
     question above it. */
  .answer__ranking--prompt {
    display: none;
    margin-top: clamp(26px, 4vh, 38px);
  }

  [data-context='1'] .answer__sentence8 > .answer__ranking--prompt {
    display: flex;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 760ms;
  }

  /* The selection, arriving late and on its own: the same delayed lean
     every earlier candidate word in this story has used — nothing moves,
     nothing is boxed or ticked, the favoured word simply takes on the
     weight and colour the others don't have. */
  [data-context='1'] .answer__rank-word--pick {
    animation: answer-lean 1ms linear both;
    animation-delay: 2700ms;
  }

  [data-context='1'] .answer__sentence8 > .answer__reveal-kicker {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 1800ms;
  }

  [data-context='1'] .answer__sentence8 > .answer__reveal-text {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 2040ms;
  }

  [data-context='1'] .answer__sentence8 > .answer__turn {
    display: inline-block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3700ms;
  }

  /* ====================================================
     Scene 10 — the answer takes shape.
     ==================================================== */

  /* The ranking and its bars have said what they had to say; the sentence
     is deliberately the only thing left in the column, which is what gives
     the growth below something to be watched against. .answer__prompt is
     kept, since it is the thing that continues. */
  [data-grow='1'] .answer__sentence8 > .answer__ranking--prompt,
  [data-grow='1'] .answer__sentence8 > .answer__reveal-kicker,
  [data-grow='1'] .answer__sentence8 > .answer__reveal-text,
  [data-grow='1'] .answer__sentence8 > .answer__turn {
    display: none;
  }

  /* The trailing ellipsis goes: real words are arriving after it now. */
  [data-grow='1'] .answer__prompt-more {
    display: none;
  }

  /* The previously chosen piece settles from cobalt to ink as the next one
     arrives — the visible form of "what was just generated becomes
     ordinary context." Colour only: the append animation holding this
     span's width never touches colour, so the two don't contend. */
  [data-grow='1'] .answer__sentence8 .answer__prompt-next {
    color: var(--ink);
    transition: color 700ms ease 400ms;
  }

  /* Whole pieces, not characters, and no space held before one arrives —
     each simply joins the sentence at its own moment. */
  .answer__grow {
    display: none;
  }

  [data-grow='1'] .answer__prompt [data-grow-piece] {
    display: inline;
    animation: answer-grow 1000ms ease both;
  }

  [data-grow='1'] .answer__prompt [data-grow-piece='1'] {
    animation-delay: 500ms;
  }

  [data-grow='1'] .answer__prompt [data-grow-piece='2'] {
    animation-delay: 1150ms;
  }

  [data-grow='1'] .answer__prompt [data-grow-piece='3'] {
    animation-delay: 1800ms;
  }

  [data-grow='1'] .answer__prompt [data-grow-piece='4'] {
    animation-delay: 2450ms;
  }

  /* Arrives in cobalt, holds there long enough to be seen as new, then
     settles to ink like the rest of the sentence. */
  @keyframes answer-grow {
    0% {
      opacity: 0;
      color: var(--cobalt);
    }

    22% {
      opacity: 1;
      color: var(--cobalt);
    }

    55% {
      color: var(--cobalt);
    }

    100% {
      opacity: 1;
      color: var(--ink);
    }
  }

  .answer__sentence9 {
    display: none;
  }

  [data-grow='1'] .answer__sentence8 > .answer__sentence9 {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3800ms;
  }

  [data-grow='1'] .answer__sentence9 > .answer__reveal-kicker {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 3800ms;
  }

  [data-grow='1'] .answer__sentence9 > .answer__reveal-text {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 4040ms;
  }

  /* The realisation, set in the story's own serif — the line the whole
     card has been walking toward, so it carries more weight than the two
     explanatory lines above it without raising its voice further. */
  .answer__realise {
    display: none;
    margin: clamp(24px, 3.4vh, 34px) 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(21px, 2.4vw, 28px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.022em;
  }

  [data-grow='1'] .answer__sentence9 > .answer__realise {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 4520ms;
  }

  [data-grow='1'] .answer__sentence9 > .answer__turn {
    display: inline-block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 5060ms;
  }

  /* ====================================================
     Scene 11 — the end of Card 2.
     ==================================================== */

  /* Everything the card built goes, the constructed sentence included:
     this beat is the reader's own opening moment handed back, and it
     needs the column to itself to land as that rather than as one more
     thing stacked under the demonstration. */
  [data-close='1'] .answer__sentence8 > .answer__prompt,
  [data-close='1'] .answer__sentence9 > .answer__reveal-kicker,
  [data-close='1'] .answer__sentence9 > .answer__reveal-text,
  [data-close='1'] .answer__sentence9 > .answer__realise,
  [data-close='1'] .answer__sentence9 > .answer__turn {
    display: none;
  }

  .answer__sentence10 {
    display: none;
  }

  [data-close='1'] .answer__sentence9 > .answer__sentence10 {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 240ms;
  }

  /* Scene 1's headline, verbatim and deliberately quiet — a memory of
     where the reader came in, not a second title competing with the line
     that closes the card. */
  .answer__echo {
    display: none;
    margin: 0;
    font-family: var(--serif);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.022em;
  }

  .answer__echo-line,
  .answer__echo-sub {
    display: block;
    font-size: clamp(19px, 2.1vw, 24px);
  }

  .answer__echo-line {
    color: var(--muted);
  }

  .answer__echo-sub {
    color: var(--muted-light);
  }

  [data-close='1'] .answer__sentence10 > .answer__echo {
    display: block;
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 240ms;
  }

  /* The turn: what the reader now knows that they didn't when those same
     words first appeared. The second line takes the cobalt, since "it
     built it" is the fact the whole card exists to deliver. */
  .answer__closing {
    display: none;
    margin: clamp(26px, 3.6vh, 36px) 0 0;
    font-family: var(--serif);
    font-size: clamp(21px, 2.4vw, 28px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.022em;
  }

  .answer__closing-a,
  .answer__closing-b {
    display: block;
  }

  .answer__closing-a {
    color: var(--ink);
  }

  .answer__closing-b {
    color: var(--cobalt);
  }

  [data-close='1'] .answer__sentence10 > .answer__closing {
    display: block;
  }

  [data-close='1'] .answer__closing-a {
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 900ms;
  }

  [data-close='1'] .answer__closing-b {
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 1350ms;
  }

  [data-close='1'] .answer__sentence10 > .answer__reveal-text {
    display: block;
    margin-top: clamp(16px, 2.4vh, 22px);
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 1950ms;
  }

  /* The last thing the card says, and the largest — the only line here
     allowed to be bigger than the echo it answers. */
  .answer__last {
    display: none;
    margin: clamp(30px, 4.2vh, 44px) 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(24px, 2.9vw, 34px);
    font-weight: 500;
    line-height: 1.24;
    letter-spacing: -0.025em;
  }

  .answer__last-a,
  .answer__last-b {
    display: block;
  }

  [data-close='1'] .answer__sentence10 > .answer__last {
    display: block;
  }

  [data-close='1'] .answer__last-a {
    animation: answer-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
    animation-delay: 2560ms;
