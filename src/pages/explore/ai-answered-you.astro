  /* ====================================================
     Scene 7 — where the guess came from.
     ==================================================== */

  .answer__sentence6 {
    display: none;
  }

  /* Same hand-over as every earlier beat: hide Scene 6's own direct
     children (both its kickers, the token stack, its reveal text and its
