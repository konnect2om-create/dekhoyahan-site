---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { storyBySlug, storyTitle } from '../../data/stories';

// The Security story's permanent Explore route — a shell, deliberately.
//
// It exists so the story's Explore card links to a real address instead of
// a 404. The story itself is not built yet, so this page renders nothing
// but the site shell and the one sentence its card already makes: the
// headline, and the line under it.
//
// What it does NOT do, on purpose, until the story exists:
//   - emit a LearningResource. Structured data describes content a visitor
//     can read, and there is none here yet.
//   - emit a share card. There is nothing to share.
//   - appear in the sitemap (see NOT_INDEXABLE in astro.config.mjs).
// Title and description still come from this story's single entry in
// src/data/stories.ts, the same source every other story page reads, so
// there is no second copy of the copy to keep in step.
const story = storyBySlug('security-didnt-keep-changing')!;
---

<BaseLayout title={storyTitle(story)} description={story.description}>
  <div class="security-shell">
    <h1>{story.cardTitle}</h1>
    <p>{story.cardTeaser}</p>
  </div>
</BaseLayout>

<style>
  /* Matches the centred single-column measure the other Explore story
     pages open on. Nothing here anticipates the story's own layout. */
  .security-shell {
    max-width: 590px;
    margin: 0 auto;
    padding: clamp(40px, 7vh, 86px) 24px clamp(72px, 12vh, 132px);
  }

  .security-shell h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.03em;
  }

  .security-shell p {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
</style>
