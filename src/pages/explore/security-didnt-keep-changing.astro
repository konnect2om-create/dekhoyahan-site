</BaseLayout>

<style>
  .door {
    padding-bottom: clamp(60px, 9vh, 110px);
  }

  /* The library's opening grid, at the same max-width and the same top
     padding, so this story opens on the page at the height the others do.
     The gap is tighter than the two-beat stories use and the copy column
     is capped at its own measure, so the sentence and the door read as
     one composition rather than as two columns with a corridor between
     them. */
  .door__stage {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(24px, 4vh, 36px);
  }

  .door__copy,
  .door__visual {
    /* Grid items default to min-width: auto, which lets a long
       unbreakable line push a column wider than its track. */
    min-width: 0;
    text-align: left;
  }

  /* Focused when a beat lands and there is no turn left to hand focus to;
     it should never draw a ring of its own for that. */
  .door__lines:focus {
    outline: none;
  }

  /* The story's primary line, at the size and weight "Looks real." and
     "You chose this." carry in this slot. Deliberately not larger: the
     second half is the line that has to land, and it only lands if the
     whole statement, the line under it and the turn are visible at once. */
  .door__opening {
    margin: 0;
    max-width: 17ch;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(27px, 3.2vw, 38px);
    line-height: 1.18;
    letter-spacing: -0.028em;
  }

  /* The couplet: the claim, then the correction under it. The second line
     takes the quieter ink the other stories give the half of a pair that
     turns the first half around. */
  .door__opening > span,
  .door__opening > span > span {
    display: block;
  }

  .door__opening > span > span:nth-child(2) {
    color: var(--ink-soft);
  }

  /* The ending's own spacing. Everything in it is held further apart
     than the beats before it — the last screen is the one the reader is
     meant to sit with, and the room is most of what says so. */
  .door__close {
    margin-top: clamp(16px, 2.2vh, 22px);
  }

  /* The last thing said. The story's serif at full ink, a step above the
     sentence over it and a step below the statement above that, so the
     hierarchy runs opening / signature / support. Not a control: no
     circle, no arrow, nothing to press. */
  .door__signature {
    margin: clamp(34px, 5.4vh, 56px) 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(21px, 2vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Leaving the story, not continuing it: the aside's quiet type, the
     muted ink, a plain arrow and no saffron circle, set far enough below
     the signature that it never reads as the next step. */
  .door__again {
    display: inline-block;
    margin: clamp(40px, 6.4vh, 66px) 0 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.5;
    letter-spacing: 0.004em;
    text-decoration: none;
  }

  .door__again:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .door__sub {
    margin: clamp(14px, 2vh, 20px) 0 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  /* Where a beat reaches its own conclusion. The story's serif at full
     ink, one step down from the headline, so it reads as the sentence
     that matters on the screen without competing with the line that
     opened it. Two blocks, because the thought turns on its second half. */
  .door__lands {
    margin: clamp(16px, 2.4vh, 22px) 0 0;
    max-width: 30ch;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 22px);
    font-weight: 500;
    line-height: 1.34;
    letter-spacing: -0.016em;
  }

  .door__lands > span {
    display: block;
  }

  /* A question and the word for its answer. The question takes the
     aside's quiet type; the answer takes the story's serif at full ink,
     the same step down from the headline .door__lands uses — these are
     the only words in the story that are terminology, so they are the
     only ones set like a term. */
  .door__name {
    margin: clamp(14px, 2vh, 20px) 0 0;
    max-width: 34ch;
  }

  .door__name > span {
    display: block;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .door__name > strong {
    display: block;
    margin-top: 2px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 22px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.016em;
  }

  /* Scene 2's three steps: same type as the aside above, set one per
     line and a touch more open, because they are a sequence of things
     done in order rather than a sentence that happens to be long. */
  .door__steps > span {
    display: block;
  }

  .door__steps > span + span {
    margin-top: 3px;
  }

  /* Both states live in the DOM; only one group is ever un-hidden, so
     nothing is announced or focusable before its moment. */
  [hidden] {
    display: none !important;
  }

  /* The library's turn treatment, unchanged: serif, the saffron circle,
     the quiet underline on hover. */
  .door__turn {
    display: inline-block;
    margin: clamp(20px, 3vh, 30px) 0 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    cursor: pointer;
    white-space: nowrap;
  }

  .door__turn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
    margin-left: 7px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    vertical-align: middle;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .door__turn:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .door__turn:hover span {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .door__turn:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .door__visual {
    display: block;
  }

  /* No frame of its own. The asset is one composition — the lock, the two
     people, the door, the phone, the cloud, the building, the camera and
     the chain of smaller suppliers — and all of it is part of the
     question the scene asks, so nothing here crops it, scales it to fill
     a box, or clips it. The box is whatever width the column gives it and
     whatever height the picture's own ratio makes of that. */
  .door__scene {
    position: relative;
    width: 100%;
  }

  .door__art {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* The asset's own transparency is kept — no card, no panel, no
       backdrop, and no treatment of any kind over the artwork. It sits on
       the page's cream the way the other stories' artwork does, including
       the transparent margin it carries on its own left side. */
  }

  /* ---- The door the last two beats share ----

     One picture, one file, one element. Scene 2 shows all of it; scene 3
     moves in on the lock. The frame is the fixed window both beats look
     through: it is the asset's own ratio, so at rest the door fills it
     exactly with nothing cropped and nothing letterboxed, and it never
     changes size — which is what lets scene 3 be a move rather than a
     cut. Nothing moves on the page when the beat lands; only what is
     inside the window does. */
  .door__frame {
    width: 100%;
    aspect-ratio: 1122 / 1402;
    overflow: hidden;
  }

  .door__plain {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 0 0;
    /* Slow and single-curve on purpose: the reader should feel they
       stepped closer to the same door, not that a picture was swapped. */
    transition: transform 1100ms cubic-bezier(0.32, 0.7, 0.24, 1);
  }

  /* The close-up. The window lands on x 315-655, y 515-940 of the
     1122x1402 file: the deadbolt and the handle are the subject, the
     door's edge and its jamb hold the left, and a panel and a half of
     wood holds the right — enough to stay recognisably the same door
     without the rest of it competing. The left edge starts past the
     shrub, so nothing of it is caught in the corner.

     Same aspect ratio as the frame, so nothing is stretched; a scale and
     an offset, so nothing is resampled beyond the magnification itself.

         scale      1122 / 340   = 3.3
         translate  -315 / 1122  = -28.075%
                    -515 / 1402  = -36.734%   (percentages of the
                    element, applied before the scale) */
  [data-stage='3'] .door__plain {
    transform: scale(3.3) translate(-28.075%, -36.734%);
  }

  /* Scene 5 steps forward a little on the same picture — x 61-1061,
     y 64-1314 of the 1122x1402 file. Only the outermost soft edges of
     the two pots fall outside it; the plumber, the whole door and the
     step are all still there, which is the point: nothing about the
     place has changed. It is a small move on purpose. Anything strong
     enough to actually re-centre on the man would have to cut the door
     or a planter in half, and this beat needs both of them intact —
     the sentence is what moves the attention, not the camera.

         scale      1122 / 1000  = 1.122
         translate  -61 / 1122   = -5.437%
                    -64 / 1402   = -4.565%  */
  [data-stage='5'] .door__plain {
    transform: scale(1.122) translate(-5.437%, -4.565%);
  }

  /* Scene 7 moves onto the two of them: x 20-890, y 230-1317 of the same
     1122x1402 file. Both men are whole, from a little above their caps to
     their boots, and the door is still there behind them — but its
     pediment, the lamp and the far planter fall outside, so the pair is
     what the frame is about and the door is what they are standing at.
     A move on the picture already on screen; no second file.

         scale      1122 / 870   = 1.2897
         translate  -20 / 1122   = -1.783%
                    -230 / 1402  = -16.405%  */
  [data-stage='7'] .door__plain {
    transform: scale(1.2897) translate(-1.783%, -16.405%);
  }

  /* Scene 8 eases back out to the window scene 5 used — the whole ordinary
     porch, both men well inside it, nothing singled out. Deliberately the
     same framing as the beat that asked who you trusted: the same view,
     with two people in it now. Identical numbers to [data-stage='5']
     above, kept as their own rule rather than shared with it, because the
     two beats arrive at it from opposite directions and either one could
     be reframed without disturbing the other. */
  [data-stage='8'] .door__plain {
    transform: scale(1.122) translate(-5.437%, -4.565%);
  }

  /* The smart-lock picture's own window. Same idea as .door__frame, at
     this asset's own 1181x1332 rather than the other three's 1122x1402:
     the picture fills it exactly at rest, so scene 9 shows all of it with
     nothing cropped or letterboxed, and scene 10 can move in without the
     box changing size or anything on the page shifting. */
  .door__lockframe {
    width: 100%;
    aspect-ratio: 1181 / 1332;
    overflow: hidden;
  }

  .door__lockshot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 0 0;
    transition: transform 1100ms cubic-bezier(0.32, 0.7, 0.24, 1);
  }

  /* Scene 10 moves in on the phone and the lock: x 65-655, y 307-972 of
     the 1181x1332 file. The two of them and the space between them are
     the subject now, but the lit glass above, the door frame, the wood
     and the planter are all still in shot, so it is plainly the same
     door. Nothing is drawn on it.

         scale      1181 / 590   = 2.0017
         translate  -65 / 1181   = -5.504%
                    -307 / 1332  = -23.048%  */
  [data-stage='10'] .door__lockshot {
    transform: scale(2.0017) translate(-5.504%, -23.048%);
  }

  /* The landscape picture's own window, at its own 1536x1024 — the third
     shape in this story, and the same construction as the other two. It
     fills the box exactly at rest, so scene 11 shows all of it with
     nothing cropped, and scene 12 can move without the box changing size. */
  .door__cloudframe {
    width: 100%;
    aspect-ratio: 1536 / 1024;
    overflow: hidden;
  }

  .door__cloudshot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 0 0;
    transition: transform 1100ms cubic-bezier(0.32, 0.7, 0.24, 1);
  }

  /* Scene 12 shifts onto the company: x 160-1529, y 55-968 of the
     1536x1024 file. The building is the largest thing in frame now, but
     the door, the phone at its lock and the whole run of light between
     them are all still there — the beat is that the trust moved, not
     that the house did. Only the outer edge of the porch falls away.

         scale      1536 / 1369  = 1.122
         translate  -160 / 1536  = -10.417%
                    -55 / 1024   = -5.371%  */
  /* Scene 13 holds this framing without moving a pixel, and that is the
     beat: the reader is told the company depends on somebody else, and
     the picture shows nobody else. The absence is the point, so there is
     nothing to reveal and nothing to move toward — the same window, the
     same door, the same run of light, the same one company. */
  :is([data-stage='12'], [data-stage='13']) .door__cloudshot {
    transform: scale(1.122) translate(-10.417%, -5.371%);
  }

  /* The panoramic picture's own window, at its own 1950x807 — the fourth
     shape in this story and the same construction as the other three. It
     fills the box exactly at rest, so scenes 14 to 16 show all of it with
     nothing cropped, and scene 17 can move without the box changing size. */
  .door__chainframe {
    width: 100%;
    aspect-ratio: 1950 / 807;
    overflow: hidden;
  }

  .door__chainshot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 0 0;
    transition: transform 1100ms cubic-bezier(0.32, 0.7, 0.24, 1);
  }

  /* Scene 17 leans toward the far end: x 180-1926, y 43-766 of the
     1950x807 file. The second company gains a little size and sits nearer
     the edge of the frame, while the door, its lock, the link and the
     first company all stay in shot — the relationship has to stay
     complete for a sentence about it continuing to mean anything. Only
     the outermost sliver of the porch gives way.

         scale      1950 / 1746  = 1.11684
         translate  -180 / 1950  = -9.231%
                    -43 / 807    = -5.328%  */
  [data-stage='17'] .door__chainshot {
    transform: scale(1.11684) translate(-9.231%, -5.328%);
  }

  /* The door's own window, at its own 1448x1086 — the fifth shape in
     this story and the same construction as the other four. It fills the
     box exactly at rest, so scene 26 shows all of the picture with
     nothing cropped, and scene 27 can move without the box changing
     size. */
  .door__judgeframe {
    width: 100%;
    aspect-ratio: 1448 / 1086;
    overflow: hidden;
  }

  .door__judge {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 0 0;
    transition: transform 1100ms cubic-bezier(0.32, 0.7, 0.24, 1);
  }

  /* Scene 27 moves in on the thing the sentence is about: x 220-1120,
     y 120-795 of the 1448x1086 file. Her face and the frame drawn on it,
     the camera looking back, the lock and the handle are all nearer, and
     the door and its lamp stay whole — the beat is about what the system
     is doing, not about losing the place it happens in. What falls away
     is the ground: the step, the mat and her feet.

         scale      1448 / 900   = 1.6089
         translate  -220 / 1448  = -15.193%
                    -120 / 1086  = -11.050%  */
  /* Scene 28 holds this framing without moving a pixel. The beat is the
     reader being handed the word for what they have just watched happen,
     and the picture is already showing it — moving now would say
     something changed, and nothing has. */
  :is([data-stage='27'], [data-stage='28'], [data-stage='29'], [data-stage='30']) .door__judge {
    transform: scale(1.6089) translate(-15.193%, -11.050%);
  }

  /* ---- The beat arriving ----
     The library's settle, unchanged: the replacing copy, the turn and the
     picture all come in on the same curve at the same pace, so the change
     reads as one movement. The outgoing group is simply hidden — the two
     pictures share no frame and no ratio, and cross-fading them would
     draw attention to the swap rather than to what is now missing. */
  @keyframes door-in {
    from {
      opacity: 0;
      transform: translateY(9px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  [data-stage='2'] .door__opening span[data-line='two'],
  [data-stage='2'] .door__steps,
  [data-stage='2'] .door__turn[data-further],
  [data-stage='2'] .door__frame,
  [data-stage='3'] .door__opening span[data-line='three'],
  [data-stage='3'] .door__steps,
  [data-stage='3'] .door__turn[data-onward3],
