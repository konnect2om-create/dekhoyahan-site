---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { storyBySlug, storyTitle } from '../../data/stories';
import doorScene1 from '../../assets/security-door-scene1.webp';
import doorScene2 from '../../assets/security-door-scene2.webp';

// The Security story's permanent Explore route. Two beats.
//
// The opening construction is the one looks-real-is-it established and
// who-chose-what-you-saw reuses: one grid, the copy on the left and the
// picture on the right, centred against each other, stacking copy-first
// below 980px. Same shell, same spacing scale, same serif sizes, same
// turn treatment — nothing global is touched here.
//
// SCENE 1. The card has already said the sentence; the page says it again
// as its own opening, because the second half is the part that has to
// land slowly:
//
//     Security didn't keep changing.
//     What you trusted did.
//     And you probably didn't notice when it happened.
//     Start with your front door →
//
// Nothing is explained and nothing is named. The picture is a front door
// someone is knocking at. The circles around it are cropped and quieted
// on purpose: the visitor should be asking why this ordinary door
// matters, not reading a diagram.
//
// SCENE 2. Everything scene 1 put around the door is taken away, and what
// is left is the door:
//
//     You leave home.
//     You close the door.
//     You lock it.
//     Then you walk away.
//     Why? →
//
// Four things the reader has done a thousand times, in the order they do
// them, and then the question. Nothing is named and nothing is explained,
// because the point of this beat is the answer the reader gives
// themselves before the story gives them one.
//
// The picture is the other supplied asset, whole: an ordinary front door
// on its own. Going back to a plain door after the first scene's
// ecosystem is the beat — the complexity was real, and it is now
// entirely out of sight.
//
// The turn on scene 2 is real and focusable and wired to nothing, because
// scene 3 does not exist yet — the same convention where-is-the-5g.astro
// and who-chose-what-you-saw.astro use for their unbuilt scenes.
//
// Still deliberately absent until the story is finished: a
// LearningResource, a share card, and a sitemap entry (see NOT_INDEXABLE
// in astro.config.mjs). The manifest's question, shortAnswer and
// keyTakeaway are still marked provisional there, and are still rendered
// nowhere.
const story = storyBySlug('security-didnt-keep-changing')!;
---

<BaseLayout title={storyTitle(story)} description={story.description}>
  <div class="door" data-door data-stage="1">
    <div class="door__stage shell">
      <div class="door__copy">
        <!-- Announced when it changes, because the change is the story
             moving. One group today; the same container the later beats
             will replace their lines inside. -->
        <div class="door__lines" aria-live="polite" tabindex="-1">
          <h1 class="door__opening">
            <span data-line="one">
              <span>Security didn't keep changing.</span>
              <span>What you trusted did.</span>
            </span>

            <span data-line="two" hidden>You leave home.</span>
          </h1>

          <p class="door__sub" data-line="one">
            And you probably didn't notice when it happened.
          </p>

          <!-- Three steps in the order they happen, each on its own line,
               so the sequence reads as a sequence rather than a sentence. -->
          <p class="door__sub door__steps" data-line="two" hidden>
            <span>You close the door.</span>
            <span>You lock it.</span>
            <span>Then you walk away.</span>
          </p>
        </div>

        <!-- The same turn treatment every story in the library uses:
             serif, the saffron circle, the quiet underline on hover. -->
        <button type="button" class="door__turn" data-line="one" data-onward>
          Start with your front door <span aria-hidden="true">&rarr;</span>
        </button>

        <button type="button" class="door__turn" data-line="two" data-further hidden>
          Why? <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <!-- Locked to the crop's own frame, so later beats can happen
           inside the same box without anything moving under them. -->
      <div class="door__visual">
        <div class="door__scene">
          <Image
            class="door__art"
            src={doorScene1}
            alt="A front door, with the lock, the people, the phone, the cloud, the building, the camera and a chain of smaller suppliers connected to it all around."
            widths={[560, 760, 1000, 1336, 1672]}
            sizes="(max-width: 979px) 92vw, 52vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-line="one"
          />

          <!-- The same door, on its own. Whole asset, its own ratio,
               nothing cropped and nothing over it. -->
          <Image
            class="door__art door__plain"
            src={doorScene2}
            alt="An ordinary front door, closed, with a lock and a handle."
            widths={[420, 560, 760, 1122]}
            sizes="(max-width: 979px) 92vw, 480px"
            loading="eager"
            decoding="async"
            data-line="two"
            hidden
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .door {
    padding-bottom: clamp(60px, 9vh, 110px);
  }

  /* The library's opening grid, at the same max-width and the same top
     padding, so this story opens on the page at the height the others do.
     The gap is tighter than the two-beat stories use and the copy column
     is capped at its own measure, so the sentence and the door read as
     one composition rather than as two columns with a corridor between
     them. */
  .door__stage {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(24px, 4vh, 36px);
  }

  .door__copy {
    text-align: left;
  }

  /* Focused when a beat lands and there is no turn left to hand focus to;
     it should never draw a ring of its own for that. */
  .door__lines:focus {
    outline: none;
  }

  /* The story's primary line, at the size and weight "Looks real." and
     "You chose this." carry in this slot. Deliberately not larger: the
     second half is the line that has to land, and it only lands if the
     whole statement, the line under it and the turn are visible at once. */
  .door__opening {
    margin: 0;
    max-width: 17ch;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(27px, 3.2vw, 38px);
    line-height: 1.18;
    letter-spacing: -0.028em;
  }

  /* The couplet: the claim, then the correction under it. The second line
     takes the quieter ink the other stories give the half of a pair that
     turns the first half around. */
  .door__opening > span,
  .door__opening > span > span {
    display: block;
  }

  .door__opening > span > span:nth-child(2) {
    color: var(--ink-soft);
  }

  .door__sub {
    margin: clamp(14px, 2vh, 20px) 0 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  /* Scene 2's three steps: same type as the aside above, set one per
     line and a touch more open, because they are a sequence of things
     done in order rather than a sentence that happens to be long. */
  .door__steps > span {
    display: block;
  }

  .door__steps > span + span {
    margin-top: 3px;
  }

  /* Both states live in the DOM; only one group is ever un-hidden, so
     nothing is announced or focusable before its moment. */
  [hidden] {
    display: none !important;
  }

  /* The library's turn treatment, unchanged: serif, the saffron circle,
     the quiet underline on hover. */
  .door__turn {
    display: inline-block;
    margin: clamp(20px, 3vh, 30px) 0 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    cursor: pointer;
    white-space: nowrap;
  }

  .door__turn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
    margin-left: 7px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    vertical-align: middle;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .door__turn:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .door__turn:hover span {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .door__turn:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  .door__visual {
    display: block;
  }

  /* No frame of its own. The asset is one composition — the lock, the two
     people, the door, the phone, the cloud, the building, the camera and
     the chain of smaller suppliers — and all of it is part of the
     question the scene asks, so nothing here crops it, scales it to fill
     a box, or clips it. The box is whatever width the column gives it and
     whatever height the picture's own ratio makes of that. */
  .door__scene {
    position: relative;
    width: 100%;
  }

  .door__art {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* The asset's own transparency is kept — no card, no panel, no
       backdrop, and no treatment of any kind over the artwork. It sits on
       the page's cream the way the other stories' artwork does, including
       the transparent margin it carries on its own left side. */
  }

  /* Scene 2's door is portrait where scene 1's composition is landscape.
     It always fills whatever width it is given and takes its own height
     from that — the sizing decision is made by the column it sits in
     (below), never by cropping or stretching the picture. */
  .door__plain {
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  /* ---- The beat arriving ----
     The library's settle, unchanged: the replacing copy, the turn and the
     picture all come in on the same curve at the same pace, so the change
     reads as one movement. The outgoing group is simply hidden — the two
     pictures share no frame and no ratio, and cross-fading them would
     draw attention to the swap rather than to what is now missing. */
  @keyframes door-in {
    from {
      opacity: 0;
      transform: translateY(9px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  [data-stage='2'] .door__opening span[data-line='two'],
  [data-stage='2'] .door__steps,
  [data-stage='2'] .door__turn[data-further],
  [data-stage='2'] .door__plain {
    animation: door-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
  }

  [data-stage='2'] .door__steps {
    animation-delay: 150ms;
  }

  [data-stage='2'] .door__turn[data-further] {
    animation-delay: 300ms;
  }

  /* Cancelled one-for-one against the rules above — matched selector by
     selector, because a shorter selector here would lose on specificity
     and leave the movement running for the people who asked for none. */
  @media (prefers-reduced-motion: reduce) {
    [data-stage='2'] .door__opening span[data-line='two'],
    [data-stage='2'] .door__steps,
    [data-stage='2'] .door__turn[data-further],
    [data-stage='2'] .door__plain {
      animation: none;
    }

    [data-stage='2'] .door__steps,
    [data-stage='2'] .door__turn[data-further] {
      animation-delay: 0s;
    }

    .door__turn span {
      transition: none;
    }
  }

  @media (min-width: 980px) {
    /* Roughly 38 / 52 between the sentence and the picture, which is what
       it takes for the whole composition to be legible at this width —
       the supplier nodes on its right are the smallest things in it.

       The gap is deliberately tight, because the asset already brings a
       wide transparent margin on its left edge: that margin is the space
       between the two, and adding a real gutter on top of it would put
       the corridor back that this layout exists to avoid. */
    .door__stage {
      grid-template-columns: minmax(0, 38fr) minmax(0, 52fr);
      gap: clamp(16px, 2vw, 28px);
    }

    /* The column sets the measure here, so the sentence reaches the edge
       of its own half instead of stopping short inside it. */
    .door__opening {
      max-width: none;
    }

    /* Scene 2 has four short lines where scene 1 has a long statement, so
       the halves that suit the first scene would leave the door stranded
       across an empty middle. Both columns are sized to their contents
       instead and the pair stays anchored at the left, exactly where the
       sentence already was: the text does not move when the beat lands,
       and the door simply comes in closer. Which is also the beat — the
       composition contracts as everything around the door is taken away.

       The picture's column is its own rendered width (its height capped
       against the viewport, times its 0.8 ratio), so the track is the
       size of the door rather than the size of the source file. */
    [data-stage='2'] .door__stage {
      grid-template-columns: max-content min(52.8vh, 496px);
      justify-content: start;
    }
  }

  /* Stacked, copy first, the picture immediately under the turn — the
     same order and the same closeness the other stories keep below their
     stacking point. Full column width, its own ratio, nothing clipped. */
  @media (max-width: 979px) {
    .door__stage {
      gap: clamp(16px, 2.4vh, 24px);
    }

    /* Stacked, the door takes the column the way scene 1's composition
       does — but it is portrait, so on a wide stacked screen a full
       column would make it about 970px tall and push the page well past
       a screenful. The cap only bites above phone width: at 390 the
       column is already narrower than it, so the door is still the full
       width of the text there. */
    .door__plain {
      max-width: 420px;
    }
  }
</style>

<script define:vars={{ topic: 'security-didnt-keep-changing' }}>
  // Analytics: story_view only, through Cloudflare Zaraz, on the same
  // terms as every other Explore story — the story's content at least
  // half visible for a continuous second. No story_complete: there is no
  // completion to report yet, and firing one at the opening would make
  // the event mean something different here than it does everywhere
  // else. It arrives with the beat that actually ends the story.
  const root = document.querySelector('[data-door]');

  if (root instanceof HTMLElement) {
    let fired = false;
    let timer = null;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (timer === null) {
            timer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('story_view', { topic });
              observer.disconnect();
            }, 1000);
          }
        } else if (timer !== null) {
          clearTimeout(timer);
          timer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(root);
  }
</script>

<script>
  // The story's movement, one beat at a time: 1 -> 2. The turn that was
  // clicked is replaced by the group it reveals, and focus goes to
  // whatever replaced it, so the keyboard never lands on a hidden
  // control and never has to hunt for the next one.
  //
  // Deliberately not here: anything past the last turn. "Why? →" is real
  // and focusable and wired to nothing, because the state past it does
  // not exist yet.
  const story = document.querySelector('[data-door]');

  if (story instanceof HTMLElement) {
    // from -> [the control that advances it, the group it reveals]
    const BEATS = {
      1: ['[data-onward]', 'two'],
    };

    const advance = (from) => {
      const beat = BEATS[from];
      if (!beat || story.dataset.stage !== String(from)) return;
      const [, group] = beat;

      for (const el of story.querySelectorAll('[data-line]')) {
        el.hidden = el.getAttribute('data-line') !== group;
      }

      story.dataset.stage = String(from + 1);

      // The turn that replaced the one just used, or the copy itself
      // when a beat ends without one.
      const next = story.querySelector(`.door__turn[data-line="${group}"]`);
      const target = next instanceof HTMLElement ? next : story.querySelector('.door__lines');
      if (target instanceof HTMLElement) target.focus();
    };

    for (const [from, [selector]] of Object.entries(BEATS)) {
      const control = story.querySelector(selector);
      if (control instanceof HTMLElement) {
        control.addEventListener('click', () => advance(Number(from)));
      }
    }
  }
</script>
