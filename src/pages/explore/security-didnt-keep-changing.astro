    .door__lockshot,
    .door__cloudshot,
    .door__chainshot,
    .door__judge,
    .door__turn span {
      transition: none;
    }
  }

  @media (min-width: 980px) {
    /* Roughly 38 / 52 between the sentence and the picture, which is what
       it takes for the whole composition to be legible at this width —
       the supplier nodes on its right are the smallest things in it.

       The gap is deliberately tight, because the asset already brings a
       wide transparent margin on its left edge: that margin is the space
       between the two, and adding a real gutter on top of it would put
       the corridor back that this layout exists to avoid. */
    .door__stage {
      grid-template-columns: minmax(0, 38fr) minmax(0, 52fr);
      gap: clamp(16px, 2vw, 28px);
    }

    /* The column sets the measure here, so the sentence reaches the edge
       of its own half instead of stopping short inside it. */
    .door__opening {
      max-width: none;
    }

    /* Scene 2 has four short lines where scene 1 has a long statement, so
       the halves that suit the first scene would leave the door stranded
       across an empty middle. Both columns are sized to their contents
       instead and the pair stays anchored at the left, exactly where the
       sentence already was: the text does not move when the beat lands,
       and the door simply comes in closer. Which is also the beat — the
       composition contracts as everything around the door is taken away.

       The picture's column is its own rendered width (its height capped
       against the viewport, times its 0.8 ratio), so the track is the
       size of the door rather than the size of the source file.

       The copy column is a fixed measure rather than max-content across
       these two beats, and that is load-bearing: scene 3's headline is
       wider than scene 2's, so a content-sized track would grow by
       160px when the beat lands and shove the picture sideways —
       turning a move toward the door into a jump across the page. The
       width is scene 3's headline set on one line (about 11 times the
       headline's own font size, which is itself clamped against the
       viewport), so both beats share one column and the frame never
       moves. */
    :is([data-stage='2'], [data-stage='3'], [data-stage='4'], [data-stage='5'], [data-stage='6'], [data-stage='7'], [data-stage='8'], [data-stage='9'], [data-stage='10']) .door__stage {
      grid-template-columns: clamp(300px, 36vw, 424px) min(52.8vh, 496px);
      justify-content: start;
    }

    /* Scene 11's picture is landscape where every other one is portrait.
       The copy column keeps exactly the width the other beats give it —
       so nothing in the text moves when the beat lands — and the picture
       takes the rest of the row instead of the narrow portrait track,
       which a 1.5 image would otherwise sit in at half the size. */
    :is([data-stage='11'], [data-stage='12'], [data-stage='13'], [data-stage='14'], [data-stage='15'], [data-stage='16'], [data-stage='17'], [data-stage='18'], [data-stage='19'], [data-stage='20'], [data-stage='21'], [data-stage='22'], [data-stage='23'], [data-stage='24'], [data-stage='25'], [data-stage='26'], [data-stage='27'], [data-stage='28'], [data-stage='29'], [data-stage='30'], [data-stage='31']) .door__stage {
      grid-template-columns: clamp(300px, 36vw, 424px) minmax(0, 1fr);
      justify-content: start;
    }

    /* Scene 26 comes back to the door, and the door is close to square
       where the chain was almost three times as wide as it was tall.
       Handed the whole rest of the row it would stand about 640px and
       push the turn off the bottom, so this beat measures its own track
       against the viewport's height instead — the way the portrait beats
       do. The copy column is the identical clamp, so nothing in the text
       moves when the picture changes shape. */
    :is([data-stage='26'], [data-stage='27'], [data-stage='28'], [data-stage='29'], [data-stage='30']) .door__stage {
      grid-template-columns: clamp(300px, 36vw, 424px) min(62vh, 620px);
      justify-content: start;
    }

    /* One column, because there is nothing in the other one. The measure
       is a little wider than the beats kept, which is the only change
       the ending makes to the typography — it is a statement now rather
       than a line with a picture beside it. */
    /* Centred in the row and centred in what is left of the screen
       vertically: the block is short and the story area is tall, so
       without this it sits high with a long empty stretch under it.
       min-height is capped so the ending is still whole on a short
       laptop screen without the page having to scroll. */
    [data-stage='32'] .door__stage {
      grid-template-columns: minmax(0, 600px);
      justify-content: center;
      align-content: center;
      min-height: min(62vh, 520px);
      padding-top: 0;
    }


  }

  [data-stage='32'] .door__visual {
    display: none;
  }

  [data-stage='32'] .door__stage {
    justify-items: center;
    padding-top: clamp(2rem, 5vh, 3.5rem);
  }

  [data-stage='32'] .door__copy {
    width: min(100%, 600px);
  }

  [data-stage='32'] .door__opening {
    max-width: none;
  }

  [data-stage='32'] .door__opening span[data-line='thirtytwo'] > span:nth-child(2) {
    color: #2f3641;
  }

  /* Between the phone and the desktop split the story area is far taller
     than anything the ending puts in it, so the block would otherwise sit
     under the header with most of a screen of nothing beneath it. The
     stage takes the height the story area actually has and centres the
     block inside it, which is the same thing the desktop rule does — it
     just cannot be a fixed 520px here, because that is less than half of
     a tall tablet and centring inside it centres nothing. */
  @media (min-width: 600px) and (max-width: 979px) {
    [data-stage='32'] .door__stage {
      align-content: center;
      min-height: calc(100vh - 260px);
      padding-top: 0;
    }

    [data-stage='32'] .door__copy {
      width: min(100%, 540px);
    }
  }

  /* Stacked, copy first, the picture immediately under the turn — the
     same order and the same closeness the other stories keep below their
     stacking point. Full column width, its own ratio, nothing clipped. */
  @media (max-width: 979px) {
    .door__stage {
      gap: clamp(16px, 2.4vh, 24px);
    }

    /* Stacked, the door takes the column the way scene 1's composition
       does — but it is portrait, so on a wide stacked screen a full
       column would make it about 970px tall and push the page well past
       a screenful. The cap only bites above phone width: at 390 the
       column is already narrower than it, so the door is still the full
       width of the text there. */
    .door__frame,
    .door__lockframe {
      max-width: 420px;
    }

    /* Scene 3's turn is a whole sentence. Held on one line it is wider
       than a 320px screen, and because a grid item will not shrink below
       its content by default, that pushed the column — and the picture
       with it — past the viewport. It wraps here instead. */
    .door__turn {
      white-space: normal;
    }
  }

  /* Scene 7 carries the longest copy of the early beats — the statement,
     three short lines and then the two-part conclusion — and a portrait
     door underneath it. On the smallest screens that stack runs about
     30px past the fold: at 320x720 the copy ends at 385.6 and leaves
     334.4 for a frame that wants 364.9.

     So on those screens alone, and for this beat alone, the frame takes
     its size from the height that is left rather than from the width of
     the column. 36vh of width is 259 at 720, which the frame's own ratio
     makes 324 tall — about ten pixels clear of the bottom.

     Nothing is cropped and nothing is stretched: the frame keeps its
     1122/1402 ratio, the picture keeps object-fit: contain, and the
     whole door is still in it, just smaller. The gap between the turn
     and the picture is untouched, and so is every other beat, every
     other width and the copy itself. */
  @media (max-width: 359px) {
    [data-stage='7'] .door__frame {
      max-width: min(100%, 36vh);
    }
  }
</style>

<script define:vars={{ topic: 'security-didnt-keep-changing' }}>
  // Analytics: story_view only, through Cloudflare Zaraz, on the same
  // terms as every other Explore story — the story's content at least
  // half visible for a continuous second. No story_complete: there is no
  // completion to report yet, and firing one at the opening would make
  // the event mean something different here than it does everywhere
  // else. It arrives with the beat that actually ends the story, which
  // is scene 32 — the reader has reached the end when the last beat is
  // on screen, the same terms every other story in the library reports
  // completion on.
  const root = document.querySelector('[data-door]');

  if (root instanceof HTMLElement) {
    let fired = false;
    let timer = null;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (timer === null) {
            timer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('story_view', { topic });
              observer.disconnect();
            }, 1000);
          }
        } else if (timer !== null) {
          clearTimeout(timer);
          timer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(root);

    // story_complete, once, when the story reaches its last beat.
    let completeFired = false;
    const completeObserver = new MutationObserver(() => {
      if (completeFired) return;
      if (root.dataset.stage === '32') {
        completeFired = true;
        window.zaraz?.track('story_complete', { topic });
        completeObserver.disconnect();
      }
    });
    completeObserver.observe(root, { attributes: true, attributeFilter: ['data-stage'] });
  }
</script>

<script>
  // The story's movement, one beat at a time: 1 -> 2. The turn that was
  // clicked is replaced by the group it reveals, and focus goes to
  // whatever replaced it, so the keyboard never lands on a hidden
  // control and never has to hunt for the next one.
  //
  // Deliberately not here: anything past the last turn. "Why? →" is real
  // and focusable and wired to nothing, because the state past it does
  // not exist yet.
  const story = document.querySelector('[data-door]');

  if (story instanceof HTMLElement) {
    // from -> [the control that advances it, the group it reveals]
    const BEATS = {
      1: ['[data-onward]', 'two'],
      2: ['[data-further]', 'three'],
      3: ['[data-onward3]', 'four'],
      4: ['[data-onward4]', 'five'],
      5: ['[data-onward5]', 'six'],
      6: ['[data-onward6]', 'seven'],
      7: ['[data-onward7]', 'eight'],
      8: ['[data-onward8]', 'nine'],
      9: ['[data-onward9]', 'ten'],
      10: ['[data-onward10]', 'eleven'],
      11: ['[data-onward11]', 'twelve'],
      12: ['[data-onward12]', 'thirteen'],
      13: ['[data-onward13]', 'fourteen'],
      14: ['[data-onward14]', 'fifteen'],
      15: ['[data-onward15]', 'sixteen'],
      16: ['[data-onward16]', 'seventeen'],
      17: ['[data-onward17]', 'eighteen'],
      18: ['[data-onward18]', 'nineteen'],
      19: ['[data-onward19]', 'twenty'],
      20: ['[data-onward20]', 'twentyone'],
      21: ['[data-onward21]', 'twentytwo'],
      22: ['[data-onward22]', 'twentythree'],
      23: ['[data-onward23]', 'twentyfour'],
      24: ['[data-onward24]', 'twentyfive'],
      25: ['[data-onward25]', 'twentysix'],
      26: ['[data-onward26]', 'twentyseven'],
      27: ['[data-onward27]', 'twentyeight'],
      28: ['[data-onward28]', 'twentynine'],
      29: ['[data-onward29]', 'thirty'],
      30: ['[data-onward30]', 'thirtyone'],
      31: ['[data-onward31]', 'thirtytwo'],
    };

    const advance = (from) => {
      const beat = BEATS[from];
      if (!beat || story.dataset.stage !== String(from)) return;
      const [, group] = beat;

      // data-line takes a list, so one element can belong to more than
      // one beat — the door stays on screen from scene 2 into scene 3,
      // which is the only way the close-up can be a move rather than a
      // swap.
      for (const el of story.querySelectorAll('[data-line]')) {
        const groups = (el.getAttribute('data-line') || '').split(' ');
        el.hidden = !groups.includes(group);
      }

      story.dataset.stage = String(from + 1);

      // The turn that replaced the one just used, or the copy itself
      // when a beat ends without one.
      //
      // preventScroll, because the story must never move the page under
      // the reader: every beat is composed to sit where the last one
      // did, and the replacing turn is always in the same place near the
      // top of the copy, so there is nothing to scroll to. Without it a
      // beat landing while the previous one is still settling can scroll
      // the focused control into view and shift the whole composition.
      const next = story.querySelector(`.door__turn[data-line="${group}"]`);
      const target = next instanceof HTMLElement ? next : story.querySelector('.door__lines');
      if (target instanceof HTMLElement) target.focus({ preventScroll: true });
    };

    for (const [from, [selector]] of Object.entries(BEATS)) {
      const control = story.querySelector(selector);
      if (control instanceof HTMLElement) {
        control.addEventListener('click', () => advance(Number(from)));
      }
    }
  }
</script>
