<script define:vars={{ topic: 'security-didnt-keep-changing' }}>
  // Analytics: story_view only, through Cloudflare Zaraz, on the same
  // terms as every other Explore story — the story's content at least
  // half visible for a continuous second. No story_complete: there is no
  // completion to report yet, and firing one at the opening would make
  // the event mean something different here than it does everywhere
  // else. It arrives with the beat that actually ends the story.
  const root = document.querySelector('[data-door]');

  if (root instanceof HTMLElement) {
    let fired = false;
    let timer = null;

    const observer = new IntersectionObserver(
      (entries) => {
        if (fired) return;
        const entry = entries[0];

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (timer === null) {
            timer = window.setTimeout(() => {
              fired = true;
              window.zaraz?.track('story_view', { topic });
              observer.disconnect();
            }, 1000);
          }
        } else if (timer !== null) {
          clearTimeout(timer);
          timer = null;
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(root);
  }
</script>

<script>
  // The story's movement, one beat at a time: 1 -> 2. The turn that was
  // clicked is replaced by the group it reveals, and focus goes to
  // whatever replaced it, so the keyboard never lands on a hidden
  // control and never has to hunt for the next one.
  //
  // Deliberately not here: anything past the last turn. "Why? →" is real
  // and focusable and wired to nothing, because the state past it does
  // not exist yet.
  const story = document.querySelector('[data-door]');

  if (story instanceof HTMLElement) {
    // from -> [the control that advances it, the group it reveals]
    const BEATS = {
      1: ['[data-onward]', 'two'],
      2: ['[data-further]', 'three'],
      3: ['[data-onward3]', 'four'],
      4: ['[data-onward4]', 'five'],
      5: ['[data-onward5]', 'six'],
      6: ['[data-onward6]', 'seven'],
      7: ['[data-onward7]', 'eight'],
      8: ['[data-onward8]', 'nine'],
      9: ['[data-onward9]', 'ten'],
      10: ['[data-onward10]', 'eleven'],
      11: ['[data-onward11]', 'twelve'],
      12: ['[data-onward12]', 'thirteen'],
    };

    const advance = (from) => {
      const beat = BEATS[from];
      if (!beat || story.dataset.stage !== String(from)) return;
      const [, group] = beat;

      // data-line takes a list, so one element can belong to more than
      // one beat — the door stays on screen from scene 2 into scene 3,
      // which is the only way the close-up can be a move rather than a
      // swap.
      for (const el of story.querySelectorAll('[data-line]')) {
        const groups = (el.getAttribute('data-line') || '').split(' ');
        el.hidden = !groups.includes(group);
      }

      story.dataset.stage = String(from + 1);

      // The turn that replaced the one just used, or the copy itself
      // when a beat ends without one.
      //
      // preventScroll, because the story must never move the page under
      // the reader: every beat is composed to sit where the last one
      // did, and the replacing turn is always in the same place near the
      // top of the copy, so there is nothing to scroll to. Without it a
      // beat landing while the previous one is still settling can scroll
      // the focused control into view and shift the whole composition.
      const next = story.querySelector(`.door__turn[data-line="${group}"]`);
      const target = next instanceof HTMLElement ? next : story.querySelector('.door__lines');
      if (target instanceof HTMLElement) target.focus({ preventScroll: true });
    };

    for (const [from, [selector]] of Object.entries(BEATS)) {
      const control = story.querySelector(selector);
      if (control instanceof HTMLElement) {
        control.addEventListener('click', () => advance(Number(from)));
      }
    }
  }
</script>
