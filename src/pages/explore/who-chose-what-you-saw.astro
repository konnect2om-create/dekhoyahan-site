---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { storyPageMeta } from '../../data/storyMeta';
import scene1 from '../../assets/who-chose-what-you-saw-scene1.webp';

// The permanent "Who chose what you saw?" Explore route.
//
// OPENING BEAT ONLY. Two lines and a picture.
//
// The story is entered *after* the familiar action, not before it. The
// Explore card has already said "You chose it. / Who chose what you saw?",
// and the picture already shows the choice being made — a thumb resting on
// the middle of three things. So the opening does not ask for anything. It
// says what just happened, then quietly doubts it:
//
//     You chose this.
//     Did you? →
//
// That is the whole scene. There is deliberately no eyebrow, no instruction,
// no supporting line, nothing to select and nothing else competing with
// those two lines and the artwork — the contradiction only works if it
// arrives in a moment that feels completely ordinary.
//
// What the story eventually reveals — that something had already decided
// which three reached the screen — is absent from this page. Not in the
// copy, the artwork or the alt text.
//
// Built on the same opening construction /explore/looks-real-is-it/ uses,
// and the 5G and photo stories before it: one grid, the editorial column on
// the left, the visual stage on the right, both centred against each other,
// falling back to a single column (copy first) below the stacking point.
// "You chose this." holds the place "Looks real." holds there — the primary
// serif line the scene is built around.
//
// "Did you? →" is the library's own turn treatment (serif, saffron circle,
// quiet underline on hover) — the one every story uses to move to its next
// beat, rather than the pill those stories use to *start* a story, which
// this scene does not need: the story is already under way. The state past
// it does not exist yet, so a click is intentionally inert at this
// checkpoint — the same convention where-is-the-5g.astro uses for its
// unbuilt scenes.
//
// Title, description, canonical, share card and structured data all come
// from this story's entry in src/data/stories.ts, through the same
// storyPageMeta() every other story page reads. Canonical is left to
// BaseLayout's own default (the URL the page was built at), which is
// already this page's permanent address.
const meta = (await storyPageMeta('who-chose-what-you-saw', Astro.site))!;
---

<BaseLayout title={meta.title} description={meta.description} image={meta.image} schema={meta.schema}>
  <div class="chose" data-chose>
    <div class="chose__stage shell">
      <div class="chose__copy">
        <h1 class="chose__opening">You chose this.</h1>

        <button type="button" class="chose__turn" data-onward>
          Did you? <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <!-- ====================================================
           THE SCENE — the supplied phone/hand master, used as provided:
           transparent, on the page's own background, with no card, device
           frame, gradient or decoration behind it. It is already a
           photograph of a phone being held, with the choice already being
           made in it.

           Nothing is drawn on top of it. No ring, no highlight, no label,
           no arrow: the thumb on the middle item is what says which one was
           chosen, and anything added would be the page explaining a picture
           that is already clear.

           The box is locked to the master's own ratio, so nothing is
           cropped or letterboxed. -->
      <div class="chose__visual">
        <div class="chose__scene">
          <Image
            class="chose__art"
            src={scene1}
            alt="A hand holding a phone showing three things to watch, a thumb resting on the middle one."
            widths={[440, 580, 760, 1120, 1214]}
            sizes="(max-width: 979px) 78vw, 560px"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .chose {
    padding-bottom: clamp(60px, 9vh, 110px);
  }

  /* The opening construction looks-real-is-it established: one grid, copy
     and the visual sharing it, centred against each other. Same max-width
     and same top padding, so this story opens on the page at the same
     height that one does. */
  .chose__stage {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(32px, 5vh, 48px);
  }

  .chose__copy {
    text-align: left;
  }

  /* The story's primary line, at the same size and weight "Looks real."
     carries in this slot. */
  .chose__opening {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(27px, 3.4vw, 40px);
    line-height: 1.18;
    letter-spacing: -0.028em;
  }

  /* The library's turn treatment, unchanged: serif, the saffron circle,
     the quiet underline on hover. Sits a little further under the line
     here than mid-story turns do, because it is the only other thing in
     the column and the pause between the statement and the doubt is the
     point. */
  .chose__turn {
    display: inline-block;
    margin: clamp(20px, 3vh, 30px) 0 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    cursor: pointer;
    white-space: nowrap;
  }

  .chose__turn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
    margin-left: 7px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    vertical-align: middle;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .chose__turn:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chose__turn:hover span {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .chose__turn:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  /* ====================================================
     THE SCENE
     ==================================================== */

  .chose__visual {
    display: block;
  }

  /* Locked to the master's own frame (1214x1295) — no letterboxing and no
     cropping decision to make, the same way looks-real-is-it sizes its
     scene box to its photograph's ratio.

     Capped and centred rather than filling the column: the master is
     portrait, so at the full column width it would tower over the
     editorial line instead of balancing it. At this cap the picture covers
     a little more area than the café photograph does in the same slot. */
  .chose__scene {
    position: relative;
    aspect-ratio: 1214 / 1295;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .chose__art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Two columns at the same width looks-real-is-it opens its own at, in
     the same proportion: the editorial column narrower than the visual. */
  @media (min-width: 980px) {
    .chose__stage {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: clamp(36px, 4.5vw, 68px);
    }
  }

  /* Stacked, copy first — the picture takes most of the screen's width,
     the way the other stories' visuals do below their stacking point. */
  @media (max-width: 979px) {
    .chose__scene {
      max-width: min(78vw, 460px);
    }
  }
</style>

<script define:vars={{ topic: 'who-chose-what-you-saw', rootSelector: '[data-chose]' }}>
  // Analytics: story_view only, on the same visibility rule every other
  // Explore story uses — at least 50% of the story visible for a
  // continuous second.
  //
  // story_complete is deliberately absent. The editorial payoff this story
  // exists to deliver has not been built yet, so there is nothing a
  // visitor can reach that would honestly count as completing it. It gets
  // wired up when the final state exists, and not before.
  const root = document.querySelector(rootSelector);
  if (root instanceof HTMLElement) {
    let viewFired = false;
    let viewTimer = null;
    const viewObserver = new IntersectionObserver(
      (entries) => {
        if (viewFired) return;
        const entry = entries[0];
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (viewTimer === null) {
            viewTimer = window.setTimeout(() => {
              viewFired = true;
              window.zaraz?.track('story_view', { topic });
              viewObserver.disconnect();
            }, 1000);
          }
        } else if (viewTimer !== null) {
          clearTimeout(viewTimer);
          viewTimer = null;
        }
      },
      { threshold: 0.5 }
    );
    viewObserver.observe(root);
  }
</script>
