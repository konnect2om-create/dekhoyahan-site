---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { storyPageMeta } from '../../data/storyMeta';
import scene1 from '../../assets/who-chose-what-you-saw-scene1.webp';
import item1 from '../../assets/who-chose-what-you-saw-item1.webp';
import item2 from '../../assets/who-chose-what-you-saw-item2.webp';
import item3 from '../../assets/who-chose-what-you-saw-item3.webp';

// The permanent "Who chose what you saw?" Explore route. Two beats.
//
// SCENE 1 — the story is entered *after* the familiar action, not before
// it. The Explore card has already said "You chose it. / Who chose what you
// saw?", and the picture already shows the choice being made — a thumb
// resting on the middle of three things. So the opening does not ask for
// anything. It says what just happened, then quietly doubts it:
//
//     You chose this.
//     Did you? →
//
// No eyebrow, no instruction, nothing to select, nothing drawn over the
// artwork. The contradiction only works if it arrives in a moment that
// feels completely ordinary.
//
// SCENE 2 — the same three items, and what was behind them:
//
//     You picked one.
//     But these three were picked for you.
//     From what? →
//
// The mechanism is deliberately still unnamed. Nothing here says algorithm,
// recommendation, AI, ranking or personalisation, and nothing explains how
// the three were picked. The visitor sees *that* a prior selection happened
// before anything gets named — which is the whole reason this beat exists
// separately from the one that follows it.
//
// HOW THE SECOND BEAT IS BUILT. The three items are cut from the master at
// the exact rectangles they occupy in it (see ITEMS below) and sit at those
// same percentages, pixel-aligned on top of their own counterparts in the
// photograph. In scene 1 they are invisible and the photograph shows them.
// On the turn, they come up to full opacity as the photograph goes down to
// a ghost — so the three things the visitor was looking at appear to hold
// perfectly still while the phone and the hand recede from under them, and
// the field that was always behind them comes up.
//
// This beat reveals exactly one idea: that there is something behind the
// three. Not how much, not what, and not how it got there. So all that
// appears behind each item is a pair of edges, the way a card sitting on a
// stack shows the ones underneath it — no grid, no field, no count. The
// full extent of what the three were picked from belongs to the state after
// "From what? →", which is not built yet; showing it here would answer the
// question that turn is supposed to ask.
//
// The edges are plain slivers in the page's own ink. No photographs, icons,
// labels, counters or diagrams: anything drawn inside them would start
// explaining a mechanism this beat has not named.
//
// Built on the same opening construction /explore/looks-real-is-it/ uses,
// and the 5G and photo stories before it: one grid, the editorial column on
// the left, the visual stage on the right, both centred against each other,
// falling back to a single column (copy first) below the stacking point.
//
// Both turns use the library's own turn treatment (serif, saffron circle,
// quiet underline on hover) rather than the pill those stories use to
// *start* a story, which this scene does not need: the story is already
// under way. The state past "From what? →" does not exist yet, so a click
// there is intentionally inert — the same convention where-is-the-5g.astro
// uses for its unbuilt scenes.
//
// Title, description, canonical, share card and structured data all come
// from this story's entry in src/data/stories.ts, through the same
// storyPageMeta() every other story page reads. Canonical is left to
// BaseLayout's own default (the URL the page was built at), which is
// already this page's permanent address.
const meta = (await storyPageMeta('who-chose-what-you-saw', Astro.site))!;

// The three items, as they sit in the artwork: percentages of the master's
// own 1214x1295 frame, measured from it. The scene box is locked to that
// same ratio, which is what keeps each cut-out sitting exactly on its own
// counterpart in the photograph at every width.
const ITEMS = [
  { src: item1, alt: 'A woman on a hillside at sunrise.', top: 10.58, height: 23.78 },
  { src: item2, alt: 'A bowl of food on a table.', top: 35.83, height: 23.55 },
  { src: item3, alt: 'A cricketer playing a shot.', top: 60.85, height: 24.86 },
];

// Two edges behind each item, stepped back far enough to be seen and no
// further. Percentages of one item's own box, so they hold at every width.
const BEHIND = [
  { x: 3.4, y: 2.6, ink: 0.13 },
  { x: 6.6, y: 5.1, ink: 0.07 },
];

// THE FIELD, for the third beat. Real photographs rather than grey boxes —
// it has to look like content that could have turned up in a feed, because
// the moment only works if the visitor recognises it as more of the same
// kind of thing, not as a chart drawn over the story.
//
// PROVISIONAL. These tiles are still windows into the three items' own
// pictures, at varying zoom and handedness. That is the whole photographic
// stock this page has: the rest of the repository's images are other
// stories' artwork — cell towers, a digital seal, a padlock — and a feed
// built out of those would read as the technical diagram this beat must not
// be. It holds the composition and it reads correctly at a glance, but it
// cannot survive a stare: the same bowl and the same face recur if looked
// for, which undercuts "many genuinely different things".
//
// The fix is a supplied sheet of distinct thumbnails. Nothing else on the
// page changes when it arrives — it replaces the three sources this array
// is built from, and the grid, sizing, mask, opacity and placement all
// stay as they are.
const TILE = await Promise.all(
  [item1, item2, item3].map((src) => getImage({ src, width: 420, format: 'webp', quality: 68 }))
);

// Where in its picture each tile looks. Twenty windows across three
// photographs, each at its own zoom and some mirrored, which is what stops
// eighty-four tiles reading as three pictures repeated: the same ridge at a
// different crop, scale and handedness does not look like itself.
const LOOKS = [
  [8, 14], [62, 22], [35, 78], [88, 48], [18, 62],
  [72, 86], [46, 10], [95, 30], [26, 38], [55, 92],
  [12, 88], [80, 66], [40, 46], [68, 54], [22, 18],
  [92, 74], [50, 70], [14, 40], [76, 12], [34, 58],
];

// A fixed hash per position rather than a cycle. Cycles line up with the
// seven-column grid and print visible stripes of the same crop; this does
// not, and it is deterministic, so the field is identical on every build
// and every visit.
const FIELD = Array.from({ length: 7 * 12 }, (_, i) => {
  const h = (i * 2654435761) % 4294967296;
  const look = LOOKS[h % LOOKS.length];
  return {
    src: TILE[Math.floor(h / 7) % 3].src,
    look,
    zoom: 205 + (Math.floor(h / 97) % 11) * 13,
    flip: Math.floor(h / 1013) % 2 === 0,
  };
});
---

<BaseLayout title={meta.title} description={meta.description} image={meta.image} schema={meta.schema}>
  <div class="chose" data-chose data-stage="1">
    <div class="chose__stage shell">
      <div class="chose__copy">
        <!-- Announced when it changes, because the change is the story
             moving. The eyebrow-less, two-line opening is unchanged. -->
        <div class="chose__lines" aria-live="polite">
          <h1 class="chose__opening">
            <span data-line="one">You chose this.</span>
            <span data-line="two" hidden>You picked one.</span>
            <span data-line="three" hidden>From all of this.</span>
          </h1>

          <p class="chose__sub" data-line="two" hidden>But these three were picked for you.</p>

          <p class="chose__sub" data-line="three" hidden>Most of it never reached your screen.</p>

          <button type="button" class="chose__turn" data-line="one" data-onward>
            Did you? <span aria-hidden="true">&rarr;</span>
          </button>

          <button type="button" class="chose__turn" data-line="two" data-further hidden>
            From what? <span aria-hidden="true">&rarr;</span>
          </button>

          <button type="button" class="chose__turn" data-line="three" data-onward3 hidden>
            Why these three? <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </div>

      <!-- ====================================================
           THE SCENE — the supplied phone/hand master, used as provided:
           transparent, on the page's own background, with no card, device
           frame, gradient or decoration behind it. It is already a
           photograph of a phone being held, with the choice already being
           made in it.

           Nothing is drawn over it in scene 1 — no ring, highlight, label
           or arrow. The thumb on the middle item is what says which one was
           chosen.

           The box is locked to the master's own ratio and never changes
           size, so the second beat happens inside the same frame the first
           one occupied and no layout moves under it. -->
      <div class="chose__visual">
        <div class="chose__scene">
          <!-- Behind everything, and empty until the third beat. -->
          <div class="chose__field" aria-hidden="true">
            {FIELD.map((t) => (
              <span
                class="chose__tile"
                style={`background-image:url(${t.src});background-position:${t.look[0]}% ${t.look[1]}%;background-size:${t.zoom}%;scale:${t.flip ? '-1 1' : '1 1'}`}
              ></span>
            ))}
          </div>

          <Image
            class="chose__art"
            src={scene1}
            alt="A hand holding a phone showing three things to watch, a thumb resting on the middle one."
            widths={[440, 580, 760, 1120, 1214]}
            sizes="(max-width: 979px) 78vw, 560px"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />

          <!-- The same three, cut from the same picture, sitting exactly on
               top of themselves. Invisible and out of the accessibility
               tree in scene 1 — the photograph is already showing them, and
               a screen reader should not meet each one twice. -->
          <!-- The edges of whatever else is back there, one pair per item,
               sitting between the ghosted photograph and the three. Shown
               only in the second beat. -->
          <div class="chose__behind" aria-hidden="true">
            {ITEMS.map((item) =>
              BEHIND.map((b) => (
                <span
                  class="chose__edge"
                  style={`top:${item.top}%;height:${item.height}%;translate:${b.x}% ${b.y}%;background:rgba(17,21,28,${b.ink})`}
                ></span>
              ))
            )}
          </div>

          <div class="chose__items" aria-hidden="true">
            {ITEMS.map((item) => (
              <Image
                class="chose__item"
                src={item.src}
                alt={item.alt}
                widths={[280, 380, 534]}
                sizes="(max-width: 979px) 35vw, 250px"
                loading="eager"
                decoding="async"
                style={`top:${item.top}%;height:${item.height}%`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .chose {
    padding-bottom: clamp(60px, 9vh, 110px);
  }

  /* The opening construction looks-real-is-it established: one grid, copy
     and the visual sharing it, centred against each other. Same max-width
     and same top padding, so this story opens on the page at the same
     height that one does. */
  .chose__stage {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(32px, 5vh, 48px);
  }

  .chose__copy {
    text-align: left;
  }

  /* The story's primary line, at the same size and weight "Looks real."
     carries in this slot. */
  .chose__opening {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(27px, 3.4vw, 40px);
    line-height: 1.18;
    letter-spacing: -0.028em;
  }

  .chose__sub {
    margin: clamp(14px, 2vh, 20px) 0 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  /* Both states live in the DOM; only one group is ever un-hidden, so
     nothing is announced or focusable before its moment. */
  [hidden] {
    display: none !important;
  }

  /* The library's turn treatment, unchanged: serif, the saffron circle,
     the quiet underline on hover. Sits a little further under the line
     than mid-story turns do, because the pause between the statement and
     the doubt is the point. */
  .chose__turn {
    display: inline-block;
    margin: clamp(20px, 3vh, 30px) 0 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    cursor: pointer;
    white-space: nowrap;
  }

  .chose__turn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
    margin-left: 7px;
    border-radius: 50%;
    background: var(--saffron);
    color: #fff;
    font-size: 11px;
    vertical-align: middle;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .chose__turn:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chose__turn:hover span {
    transform: scale(1.08);
    box-shadow: 0 4px 10px rgba(232, 117, 36, 0.35);
  }

  .chose__turn:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 3px;
  }

  /* The second beat's copy arrives under the line that was already there —
     the same settle the other stories give copy that appears mid-scene,
     and the same pace as the picture behind it. */
  [data-stage='2'] .chose__opening span[data-line='two'],
  [data-stage='2'] .chose__sub,
  [data-stage='2'] .chose__turn[data-further],
  [data-stage='3'] .chose__opening span[data-line='three'],
  [data-stage='3'] .chose__sub,
  [data-stage='3'] .chose__turn[data-onward3] {
    animation: chose-in 520ms cubic-bezier(0.2, 0.78, 0.24, 1) both;
  }

  [data-stage='2'] .chose__sub {
    animation-delay: 180ms;
  }

  [data-stage='2'] .chose__turn[data-further] {
    animation-delay: 360ms;
  }

  /* "Most of it never reached your screen." is the beat that lands, so it
     waits until the field behind has actually arrived rather than racing
     it. The way onward follows that. */
  [data-stage='3'] .chose__sub {
    animation-delay: 620ms;
  }

  [data-stage='3'] .chose__turn[data-onward3] {
    animation-delay: 900ms;
  }

  @keyframes chose-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  /* ====================================================
     THE SCENE
     ==================================================== */

  .chose__visual {
    display: block;
  }

  /* Locked to the master's own frame (1214x1295) — no letterboxing and no
     cropping decision to make, the same way looks-real-is-it sizes its
     scene box to its photograph's ratio.

     Capped and centred rather than filling the column: the master is
     portrait, so at the full column width it would tower over the
     editorial line instead of balancing it. */
  .chose__scene {
    position: relative;
    aspect-ratio: 1214 / 1295;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .chose__art {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Matches the field coming up and the items coming forward, so the
       three changes read as one movement rather than three. */
    transition: opacity 900ms cubic-bezier(0.2, 0.72, 0.28, 1);
  }

  /* Second beat: the phone and the hand recede far enough that the three
     items are the only things in focus, but not to nothing — the ghost is
     what keeps the three sitting where they were rather than floating
     free while the doubt lands. */
  [data-stage='2'] .chose__art {
    opacity: 0.13;
  }

  /* Third beat: they go entirely. Their job was to say "this is your feed,
     and you are holding it", and by now that has been said and answered —
     what is left to see is the three against everything they came out of,
     and a phone drawn around them would only re-frame the scene as a
     device shot at the moment it stops being about the device.

     KNOWN GAP. This removes the phone and the hand, but not the thumb:
     it is part of the photograph inside items 2 and 3, which are cut from
     the master and cannot be un-occluded. With the hand gone it reads as a
     finger with nothing attached to it. Fixing it needs clean versions of
     the three pictures — the same three, without the thumb across them —
     at which point this rule is already correct and only the item sources
     change. */
  [data-stage='3'] .chose__art {
    opacity: 0;
  }

  /* ---- The three, cut from the picture and sitting on themselves ---- */

  .chose__items {
    position: absolute;
    inset: 0;
  }

  .chose__item {
    position: absolute;
    left: 27.68%;
    width: 43.99%;
    display: block;
    object-fit: fill;
    border-radius: 14px;
    opacity: 0;
    transition:
      opacity 900ms cubic-bezier(0.2, 0.72, 0.28, 1),
      box-shadow 900ms cubic-bezier(0.2, 0.72, 0.28, 1);
  }

  /* Full opacity, and lifted off the field by a shadow rather than by
     moving: they are the one thing on screen that does not shift. */
  :is([data-stage='2'], [data-stage='3']) .chose__item {
    opacity: 1;
    box-shadow: 0 18px 44px rgba(28, 34, 52, 0.22);
  }

  /* ---- A hint of what is behind them ---- */

  .chose__behind {
    position: absolute;
    inset: 0;
  }

  /* Each sits exactly where its item sits and is nudged back from it, so
     all that shows is a sliver down one side and along the bottom — the
     read is "there is another one under this", which is the entire idea
     this beat is allowed to reveal. Same rounding as the items so the
     edges belong to them. */
  .chose__edge {
    position: absolute;
    left: 27.68%;
    width: 43.99%;
    display: block;
    border-radius: 14px;
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.2, 0.72, 0.28, 1);
  }

  [data-stage='2'] .chose__edge {
    opacity: 1;
  }

  /* Spent: the third beat shows the actual thing these were standing in
     for, so the stand-in goes. */
  [data-stage='3'] .chose__edge {
    opacity: 0;
  }

  /* ---- The larger field, third beat ---- */

  .chose__field {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-content: start;
    gap: 2%;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1000ms cubic-bezier(0.2, 0.72, 0.28, 1);
    /* Fades out towards the edges rather than stopping at them, so what
       the three came from reads as continuing past the frame instead of
       being a panel of a known size. */
    mask-image: radial-gradient(
      ellipse 82% 78% at 50% 48%,
      #000 40%,
      rgba(0, 0, 0, 0.5) 72%,
      transparent 100%
    );
  }

  /* Held well back from full strength. These are photographs, and at full
     contrast eighty-four of them would fight the three in front and turn
     the scene into wallpaper. Quiet enough to read as "more of the same
     kind of thing", not so quiet that it becomes a grey diagram. */
  [data-stage='3'] .chose__field {
    opacity: 0.46;
  }

  .chose__tile {
    aspect-ratio: 534 / 308;
    border-radius: 3px;
    background-repeat: no-repeat;
  }

  /* The three lift towards the reader as the field arrives behind them —
     a few per cent, which at this size is a couple of pixels of growth and
     a deeper shadow. Enough to keep them plainly in front, not enough to
     read as a zoom. */
  [data-stage='3'] .chose__item {
    scale: 1.045;
    box-shadow: 0 26px 60px rgba(28, 34, 52, 0.3);
  }

  /* Nothing here is load-bearing: with motion reduced the same two states
     simply appear, fully formed. */
  @media (prefers-reduced-motion: reduce) {
    .chose__art,
    .chose__item,
    .chose__edge,
    .chose__field {
      transition: none;
    }

    [data-stage='2'] .chose__opening span[data-line='two'],
    [data-stage='2'] .chose__sub,
    [data-stage='2'] .chose__turn[data-further],
    [data-stage='3'] .chose__opening span[data-line='three'],
    [data-stage='3'] .chose__sub,
    [data-stage='3'] .chose__turn[data-onward3] {
      animation: none;
    }
  }

  /* Two columns at the same width looks-real-is-it opens its own at, in
     the same proportion: the editorial column narrower than the visual. */
  @media (min-width: 980px) {
    .chose__stage {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      gap: clamp(36px, 4.5vw, 68px);
    }
  }

  /* Stacked, copy first — the picture takes most of the screen's width,
     the way the other stories' visuals do below their stacking point. */
  @media (max-width: 979px) {
    .chose__scene {
      max-width: min(78vw, 460px);
    }
  }
</style>

<script>
  // The story's movement, one beat at a time: 1 -> 2 -> 3. Each turn shows
  // exactly one new thing and hands focus to the turn that replaced it.
  //
  // Deliberately not here: anything past "So what did? →". That button is
  // real and focusable and wired to nothing, because the state past it does
  // not exist yet — the same convention where-is-the-5g.astro uses for its
  // unbuilt scenes.
  const root = document.querySelector('[data-chose]');

  if (root instanceof HTMLElement) {
    // from -> [the control that advances it, the group it reveals]
    const BEATS = {
      1: ['[data-onward]', 'two'],
      2: ['[data-further]', 'three'],
    };

    const advance = (from) => {
      const beat = BEATS[from];
      if (!beat || root.dataset.stage !== String(from)) return;
      const [, group] = beat;
      root.dataset.stage = String(from + 1);

      // Only one group of copy is ever un-hidden, so nothing below the
      // current beat is announced or reachable by keyboard.
      for (const el of root.querySelectorAll('[data-line]')) {
        el.hidden = el.getAttribute('data-line') !== group;
      }

      // Stepping off the first beat, the three cut-outs become the real
      // thing on screen once the photograph behind them is a ghost, so
      // they take over its description rather than doubling it.
      if (from === 1) {
        root.querySelector('.chose__art')?.setAttribute('aria-hidden', 'true');
        root.querySelector('.chose__items')?.removeAttribute('aria-hidden');
      }

      // The control that was just used no longer exists, so focus would
      // fall to the document. Hand it to the one that replaced it, in the
      // same place, rather than losing the visitor's position.
      const next = root.querySelector(`[data-line="${group}"].chose__turn`);
      if (next instanceof HTMLElement) next.focus();
    };

    for (const [from, [selector]] of Object.entries(BEATS)) {
      root.querySelector(selector)?.addEventListener('click', () => advance(Number(from)));
    }
  }
</script>

<script define:vars={{ topic: 'who-chose-what-you-saw', rootSelector: '[data-chose]' }}>
  // Analytics: story_view only, on the same visibility rule every other
  // Explore story uses — at least 50% of the story visible for a
  // continuous second.
  //
  // story_complete is deliberately absent. The editorial payoff this story
  // exists to deliver has not been built yet — the mechanism is not even
  // named — so there is nothing a visitor can reach that would honestly
  // count as completing it. It gets wired up when the final state exists,
  // and not before.
  const root = document.querySelector(rootSelector);
  if (root instanceof HTMLElement) {
    let viewFired = false;
    let viewTimer = null;
    const viewObserver = new IntersectionObserver(
      (entries) => {
        if (viewFired) return;
        const entry = entries[0];
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (viewTimer === null) {
            viewTimer = window.setTimeout(() => {
              viewFired = true;
              window.zaraz?.track('story_view', { topic });
              viewObserver.disconnect();
            }, 1000);
          }
        } else if (viewTimer !== null) {
          clearTimeout(viewTimer);
          viewTimer = null;
        }
      },
      { threshold: 0.5 }
    );
    viewObserver.observe(root);
  }
</script>
