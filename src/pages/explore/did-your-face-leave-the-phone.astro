<script>
  document.querySelectorAll('[data-face]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;

    // One way, one time: Scene 1 -> Scene 2. There is nothing before it to
    // return to, so a second click is simply a no-op.
    root.querySelector('[data-show]')?.addEventListener('click', () => {
      if (root.dataset.stage !== '1') return;
      root.dataset.stage = '2';
    });

    // Scene 3. A flag of its own rather than a bumped stage, so everything
    // Scene 2 turned on stays on underneath it.
    root.querySelector('[data-kept]')?.addEventListener('click', () => {
      if (root.dataset.stage !== '2' || root.dataset.keeps === '1') return;
      root.dataset.keeps = '1';
    });

    // Scene 4. A flag of its own rather than a bumped stage, so everything
    // Scene 3 turned on stays on underneath it.
    root.querySelector('[data-where]')?.addEventListener('click', () => {
      if (root.dataset.keeps !== '1' || root.dataset.device === '1') return;
      root.dataset.device = '1';
    });

    // Scene 5. A flag of its own rather than a bumped stage, so everything
    // Scene 4 turned on stays on underneath it.
    root.querySelector('[data-left]')?.addEventListener('click', () => {
      if (root.dataset.device !== '1' || root.dataset.answer === '1') return;
      root.dataset.answer = '1';
    });

    // Scene 6. A flag of its own rather than a bumped stage, so everything
    // Scene 5 turned on stays on underneath it.
    root.querySelector('[data-difference]')?.addEventListener('click', () => {
      if (root.dataset.answer !== '1' || root.dataset.compare === '1') return;
      root.dataset.compare = '1';
    });

    // Scene 7. A flag of its own rather than a bumped stage, so everything
    // Scene 6 turned on stays on underneath it.
    root.querySelector('[data-flow]')?.addEventListener('click', () => {
      if (root.dataset.compare !== '1' || root.dataset.paths === '1') return;
      root.dataset.paths = '1';
    });

    // Scene 8 — the last beat of the card. The way on from here is a real
    // link to another story, not another flag.
    root.querySelector('[data-ask]')?.addEventListener('click', () => {
      if (root.dataset.paths !== '1' || root.dataset.final === '1') return;
      root.dataset.final = '1';
    });
  });
</script>

<script define:vars={{ topic: 'face-unlock', rootSelector: '[data-face]', finalAttr: 'final' }}>
  // Analytics: story_view (visibility, same pattern as hero_view/explore_view)
  // and story_complete (driven by this story's own existing completion flag —
  // root.dataset[finalAttr] reaching '1', the same signal the script above
  // already uses to gate the closing content — not a timer). Isolated from
  // the story's own script; only observes, never mutates.
  const root = document.querySelector(rootSelector);
  if (root instanceof HTMLElement) {
    let viewFired = false;
    let viewTimer = null;
    const viewObserver = new IntersectionObserver(
      (entries) => {
        if (viewFired) return;
        const entry = entries[0];
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (viewTimer === null) {
            viewTimer = window.setTimeout(() => {
              viewFired = true;
              window.zaraz?.track('story_view', { topic });
              viewObserver.disconnect();
            }, 1000);
          }
        } else if (viewTimer !== null) {
          clearTimeout(viewTimer);
          viewTimer = null;
        }
      },
      { threshold: 0.5 }
    );
    viewObserver.observe(root);

    let completeFired = false;
    const completeObserver = new MutationObserver(() => {
      if (completeFired) return;
      if (root.dataset[finalAttr] === '1') {
        completeFired = true;
        window.zaraz?.track('story_complete', { topic });
        completeObserver.disconnect();
      }
    });
    completeObserver.observe(root, { attributes: true, attributeFilter: ['data-' + finalAttr] });
  }
</script>
