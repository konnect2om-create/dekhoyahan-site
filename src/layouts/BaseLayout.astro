---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = "DekhoYahan — Understand the world that's arriving",
  description = "Some of it is already around us. Some of it is just beginning.",
  // Pages that own a permanent address — a Feature's story page, say —
  // declare it here; everything else is canonical at the URL it was
  // requested at.
  canonical = Astro.url.href,
  // A page that is meant to be shared supplies its own share picture.
  // Pages that don't simply carry no image tags, exactly as before.
  image = undefined,
  ogType = 'website',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="DekhoYahan" />
    <meta property="og:locale" content="en_US" />
    {image && (
      <>
        <meta property="og:image" content={image.src} />
        <meta property="og:image:alt" content={image.alt} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:type" content="image/jpeg" />
      </>
    )}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && (
      <>
        <meta name="twitter:image" content={image.src} />
        <meta name="twitter:image:alt" content={image.alt} />
      </>
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
